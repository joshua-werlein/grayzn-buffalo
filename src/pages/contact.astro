---
import Base from '../layouts/Base.astro';
const env = (Astro.locals as any).runtime?.env ?? {};
const sitekey = env.TURNSTILE_SITEKEY;
---
<Base
  title="Contact — Grayz'n Buffalo Bar & Grill"
  description="Contact Grayz'n Buffalo Bar & Grill in Mondovi, WI for questions, events, menu information, or general inquiries."
>
<section class="contact-page section-parchment">
  <div class="section-head interior-heading">
    <span class="kicker">To get in touch</span>
    <h1>Contact Us</h1>
    <span class="vintage-rule" aria-hidden="true"></span>
    <p>Questions, events, or just want to say hi — drop us a line or give us a call.</p>
  </div>
  <div class="contact-grid">
    <form id="contactForm" class="card">
      <label>Name <input name="name" required autocomplete="name" /></label>
      <label>Email <input name="email" type="email" required autocomplete="email" /></label>
      <label>Message <textarea name="message" rows="5" required></textarea></label>
      <div class="cf-turnstile" data-sitekey={sitekey}></div>
      <button class="btn btn-primary" type="submit">Send Message</button>
      <p id="formStatus" role="status"></p>
    </form>
    <div class="card info">
      <h3>Grayz'n Buffalo Bar &amp; Grill</h3>
      <p><a href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a></p>
      <p><a href="tel:+17159264431">(715) 926-4431</a></p>
      <p>Open daily · 10 AM – 2 AM</p>
      <iframe title="Map to Grayz'n Buffalo"
        src="https://www.google.com/maps?q=102+S+Eau+Claire+St,+Mondovi,+WI+54755&output=embed"
        loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        style="border:0;width:100%;height:260px;border-radius:10px;margin-top:14px"></iframe>
    </div>
  </div>
</section>
<div class="contact-landscape" aria-hidden="true"></div>
</Base>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    padding: clamp(34px, 6vw, 72px) clamp(18px, 5vw, 64px) clamp(42px, 7vw, 88px);
    border-top: 4px double var(--ink);
    background-color: var(--page-parchment);
    background-image: linear-gradient(rgba(246, 232, 204, .55), rgba(246, 232, 204, .55)), url('/parchment-texture.webp');
    background-size: auto, 512px 512px;
    color: var(--text);
  }

  .contact-page::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: 0;
    bottom: 0;
    left: 0;
    height: 28px;
    border-top: 1px solid rgba(94, 53, 28, .35);
    background: linear-gradient(180deg, rgba(94, 53, 28, .12), transparent);
    pointer-events: none;
  }

  .contact-landscape {
    min-height: clamp(300px, 42vw, 560px);
    border-top: 2px solid rgba(43, 27, 20, .38);
    background-color: #21130e;
    background-image: url('/footer-landscape.webp');
    background-position: center bottom;
    background-size: cover;
    background-repeat: no-repeat;
  }

  /* The shared footer includes this sign on interior pages; Contact has its own heading. */
  :global(body:has(.contact-page) .footer-contact) { display: none !important; }

  .contact-page .section-head {
    width: min(100%, 760px);
    margin: 0 auto clamp(24px, 4vw, 38px);
  }

  .contact-page .section-head .kicker { color: var(--denim); }
  .contact-page .section-head .vintage-rule {
    width: min(15rem, 70%);
    background: linear-gradient(90deg, transparent, var(--brick), transparent);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 34px);
    width: min(100%, 1100px);
    margin: 0 auto;
    align-items: start;
  }

  .card {
    min-width: 0;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid var(--rule);
    border-top: 5px double var(--brick);
    border-radius: var(--panel-radius);
    background: rgba(255, 248, 226, .64);
    box-shadow: var(--panel-shadow);
  }

  .card.info {
    border-top-color: var(--denim);
    background: rgba(231, 210, 168, .72);
    color: var(--ink);
    box-shadow: var(--panel-shadow-dark);
  }

  .card.info h3 {
    margin-bottom: 10px;
    color: var(--ink);
  }

  .card.info p {
    margin: 8px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }

  .card.info a {
    color: var(--ink);
    text-decoration-color: var(--brick);
    text-underline-offset: 3px;
  }

  form label {
    display: block;
    margin-bottom: 14px;
    padding-bottom: 7px;
    border-bottom: 1px dotted rgba(43, 27, 20, .38);
    color: var(--text);
    font-family: var(--label);
    font-size: .85rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  form input,
  form textarea {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: 5px;
    padding: 11px 12px;
    border: 1px solid rgba(43, 27, 20, .55);
    border-radius: var(--control-radius);
    background: rgba(255, 248, 226, .72);
    box-shadow: inset 0 1px 2px rgba(43, 27, 20, .08);
    color: var(--text);
    font-family: var(--body);
    font-size: 1rem;
  }

  form textarea { min-height: 136px; resize: vertical; }
  form input:focus,
  form textarea:focus { outline: none; border-color: var(--brick); box-shadow: 0 0 0 3px rgba(146, 44, 41, .18); }
  .cf-turnstile { min-height: 65px; margin-bottom: 16px; }
  #formStatus { margin-top: 12px; font-weight: 600; }

  .card.info iframe {
    display: block;
    width: 100%;
    height: clamp(220px, 24vw, 280px) !important;
    margin-top: 14px !important;
    border: 2px solid var(--ochre) !important;
    border-radius: var(--control-radius) !important;
    box-shadow: 2px 2px 0 rgba(43, 27, 20, .18);
  }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .contact-page { padding-inline: 14px; }
    .card { padding: 20px 16px; }
    .contact-landscape { min-height: 300px; }
  }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      status.textContent = out.ok ? 'Message sent — we\u2019ll get back to you!' : (out.error || 'Something went wrong. Give us a call instead.');
      if (out.ok) form.reset();
    } catch {
      status.textContent = 'Something went wrong. Give us a call instead.';
    }
  });
</script>
