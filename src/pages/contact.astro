---
import Base from '../layouts/Base.astro';
const env = (Astro.locals as any).runtime?.env ?? {};
const sitekey = env.TURNSTILE_SITEKEY;
---
<Base
  title="Contact — Grayz'n Buffalo Bar & Grill"
  description="Contact Grayz'n Buffalo Bar & Grill in Mondovi, WI for questions, events, menu information, or general inquiries."
>
<section class="contact-page section-parchment">
  <div class="section-head interior-heading">
    <span class="kicker">To get in touch</span>
    <h1>Contact Us</h1>
    <span class="vintage-rule" aria-hidden="true"></span>
    <p>Questions, events, or just want to say hi — drop us a line or give us a call.</p>
  </div>
  <div class="contact-grid">
    <form id="contactForm" class="card">
      <label>Name <input name="name" required autocomplete="name" /></label>
      <label>Email <input name="email" type="email" required autocomplete="email" /></label>
      <label>Message <textarea name="message" rows="5" required></textarea></label>
      <div class="cf-turnstile" data-sitekey={sitekey}></div>
      <button class="btn btn-primary" type="submit">Send Message</button>
      <p id="formStatus" role="status"></p>
    </form>
    <div class="card info">
      <h3>Grayz'n Buffalo Bar &amp; Grill</h3>
      <p><a href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a></p>
      <p><a href="tel:+17159264431">(715) 926-4431</a></p>
      <p>Open daily · 10 AM – 2 AM</p>
      <iframe title="Map to Grayz'n Buffalo"
        src="https://www.google.com/maps?q=102+S+Eau+Claire+St,+Mondovi,+WI+54755&output=embed"
        loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        style="border:0;width:100%;height:260px;border-radius:10px;margin-top:14px"></iframe>
    </div>
  </div>
</section>
</Base>

<style>
  .contact-page{padding-top:clamp(28px,4vw,48px)}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;max-width:1000px;margin:0 auto}
  .card{background:#fff;border-radius:14px;padding:28px;box-shadow:0 8px 22px rgba(36,22,16,.12)}
  .card.info h3{font-family:var(--display);margin-bottom:10px}
  .card.info p{margin:8px 0;color:var(--ink-2)}
  .card.info a{color:var(--crimson)}
  form label{display:block;margin-bottom:16px;font-family:var(--label);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}
  form input, form textarea{display:block;width:100%;margin-top:6px;padding:12px;border:2px solid rgba(36,22,16,.2);
    border-radius:8px;font-family:var(--body);font-size:1rem;background:var(--cream)}
  form input:focus, form textarea:focus{outline:none;border-color:var(--crimson)}
  #formStatus{margin-top:12px;font-weight:600}
  .cf-turnstile{margin-bottom:16px}
  @media (max-width:820px){ .contact-grid{grid-template-columns:1fr} }

  .contact-page{padding-top:clamp(32px,5vw,54px)}.contact-page .section-head{margin-bottom:28px}.contact-grid{max-width:var(--content-standard);gap:16px;align-items:start}
  .card{border:1px solid var(--rule);border-top:5px solid var(--brick);border-radius:var(--panel-radius);padding:clamp(20px,3vw,30px);background:var(--surface-parchment);box-shadow:var(--panel-shadow)}.card.info{border-top-color:var(--ochre);background:var(--surface-wood);color:var(--cream);box-shadow:var(--panel-shadow-dark)}
  .card.info h3{color:var(--cream)}.card.info p{color:var(--cream-2);padding-bottom:8px;border-bottom:1px solid var(--rule-light)}.card.info a{color:var(--cream);text-decoration-color:var(--ochre)}
  form label{color:var(--text);margin-bottom:14px}form input,form textarea{min-height:48px;margin-top:5px;padding:11px 12px;border:1px solid var(--rule);border-radius:var(--control-radius);background:var(--page-parchment);color:var(--text)}form textarea{min-height:136px;resize:vertical}form input:focus,form textarea:focus{border-color:var(--brick);box-shadow:0 0 0 3px rgba(146,44,41,.18)}
  .card.info iframe{border:2px solid var(--ochre)!important;border-radius:var(--panel-radius)!important;margin-top:6px!important}.cf-turnstile{min-height:65px}

  .contact-page{position:relative;background-color:var(--page-parchment);background-image:linear-gradient(90deg,rgba(94,53,28,.1) 0 1px,transparent 1px 34px),linear-gradient(0deg,rgba(94,53,28,.07) 0 1px,transparent 1px 34px),linear-gradient(110deg,#f4e7ce,#dbc397);border-top:5px double var(--ink);overflow:hidden}
  .contact-page::after{content:'';position:absolute;right:-60px;bottom:-80px;width:360px;height:310px;background:url('/logo-buffalo.webp') center / contain no-repeat;opacity:.06;filter:sepia(1);pointer-events:none}.contact-page > *{position:relative;z-index:1}
  .contact-page .section-head .kicker{color:var(--denim)}.contact-page .section-head .vintage-rule{width:15rem;background:linear-gradient(90deg,transparent,var(--brick),transparent)}
  .contact-grid{gap:clamp(18px,3vw,34px)}.card{border:2px solid var(--ink);border-top:6px double var(--brick);border-radius:0;box-shadow:4px 5px 0 rgba(43,27,20,.22),0 12px 24px rgba(43,27,20,.12);background-color:#f4e7ce;background-image:linear-gradient(90deg,rgba(84,48,24,.05),transparent 18%,transparent 82%,rgba(84,48,24,.05))}.card.info{border-top-color:var(--denim);background-color:#e7d2a8;background-image:linear-gradient(90deg,rgba(43,27,20,.08) 0 1px,transparent 1px 26px);color:var(--ink)}
  .card.info h3,.card.info p,.card.info a{color:var(--ink)}.card.info p{border-bottom-color:var(--rule)}.card.info a{text-decoration-color:var(--brick)}
  form label{padding-bottom:7px;border-bottom:1px dotted rgba(43,27,20,.38)}form input,form textarea{border-radius:0;border-color:rgba(43,27,20,.55);background:rgba(255,248,226,.58);box-shadow:inset 0 1px 2px rgba(43,27,20,.08)}.card.info iframe{border:5px solid #f7ecd6!important;border-radius:0!important;box-shadow:2px 2px 0 rgba(43,27,20,.22)}
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      status.textContent = out.ok ? 'Message sent — we\u2019ll get back to you!' : (out.error || 'Something went wrong. Give us a call instead.');
      if (out.ok) form.reset();
    } catch {
      status.textContent = 'Something went wrong. Give us a call instead.';
    }
  });
</script>
