<script>
  const heroBuffaloVideo = document.querySelector<HTMLVideoElement>('.buffalo-video');
  const heroBuffaloAnchor = document.querySelector<HTMLElement>('.buffalo-video-anchor');

  if (heroBuffaloVideo && heroBuffaloAnchor) {
    let buffaloTrackStarted = false;

    const startBuffaloTrack = () => {
      if (buffaloTrackStarted) return;
      buffaloTrackStarted = true;

      const duration = Number.isFinite(heroBuffaloVideo.duration) && heroBuffaloVideo.duration > 0
        ? heroBuffaloVideo.duration
        : 7.2;
      heroBuffaloAnchor.style.setProperty('--buffalo-motion-duration', `${duration}s`);
      heroBuffaloAnchor.style.setProperty('--buffalo-motion-delay', `-${Math.min(heroBuffaloVideo.currentTime, duration)}s`);
      heroBuffaloAnchor.classList.add('is-playing');
    };

    heroBuffaloVideo.addEventListener('playing', startBuffaloTrack, { once: true });
    if (!heroBuffaloVideo.paused && !heroBuffaloVideo.ended) startBuffaloTrack();
  }

  document.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.matches('.photo img')) return;
    // A failed thumbnail gets one retry against the full-size R2 object before the
    // tile is removed. The dataset flag stops a failing full-size image from
    // re-triggering the retry forever.
    if (!image.dataset.retriedFullSize && image.dataset.fullSrc) {
      image.dataset.retriedFullSize = 'true';
      image.src = image.dataset.fullSrc;
      return;
    }
    image.closest<HTMLElement>('.photo')?.remove();
  }, true);

  document.addEventListener('image-lightbox:open', (event) => {
    const trigger = (event as CustomEvent<{ trigger?: HTMLElement }>).detail?.trigger;
    trigger?.closest<HTMLElement>('.photo-stack')?.setAttribute('data-lightbox-paused', 'true');
  });
  document.addEventListener('image-lightbox:close', (event) => {
    const trigger = (event as CustomEvent<{ trigger?: HTMLElement }>).detail?.trigger;
    trigger?.closest<HTMLElement>('.photo-stack')?.removeAttribute('data-lightbox-paused');
  });

  const welcomePhotoStack = document.querySelector<HTMLElement>('#welcome .photo-stack');
  const prefersReducedWelcomeMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function showWelcomePhoto(slot: HTMLElement, nextIndex: number) {
    const photos = [...slot.querySelectorAll<HTMLButtonElement>('.photo')];
    if (photos.length < 2) return;

    photos.forEach((photo, photoIndex) => {
      const active = photoIndex === nextIndex;
      photo.classList.toggle('is-active', active);
      photo.toggleAttribute('inert', !active);
      photo.toggleAttribute('aria-hidden', !active);
      photo.tabIndex = active ? 0 : -1;
    });
  }

  if (welcomePhotoStack && !prefersReducedWelcomeMotion.matches) {
    [...welcomePhotoStack.querySelectorAll<HTMLElement>('.photo-position')].forEach((slot, slotIndex) => {
      const photos = [...slot.querySelectorAll<HTMLButtonElement>('.photo')];
      if (photos.length < 2) return;

      let currentIndex = 0;
      window.setTimeout(() => {
        window.setInterval(() => {
          if (welcomePhotoStack.dataset.lightboxPaused === 'true') return;
          currentIndex = (currentIndex + 1) % photos.length;
          showWelcomePhoto(slot, currentIndex);
        }, 12000);
      }, 5000 + (slotIndex * 1800));
    });
  }

  const social = document.getElementById('social');
  const feed = document.getElementById('fbFeed');
  const billboardMiddle = document.querySelector<HTMLElement>('.fb-billboard__middle');
  const billboardMiddleSlices = document.querySelector<HTMLElement>('.fb-billboard__middle-slices');
  const billboardBottomActions = document.querySelector<HTMLElement>('.fb-bottom-actions');
  const facebookCaptionAssets = [
    '/images/facebook/facebook-caption-1.webp',
    '/images/facebook/facebook-caption-2.webp',
    '/images/facebook/facebook-caption-3.webp',
    '/images/facebook/facebook-caption-4.webp',
  ];
  const normalizeFacebookCaption = (message?: string | null) =>
    message
      ?.split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean)
      .join('\n')
      .trim() ?? '';
  const trimFacebookLightboxText = (message?: string | null) => message?.trim() ?? '';
  const facebookDesktopQuery = window.matchMedia('(min-width: 1101px)');
  let billboardSliceSignature = '';
  const facebookWallSeams = [0, 115, 230, 344, 458, 572, 685, 790];

  function alignFacebookSectionToWallSeam() {
    if (!social) return;

    social.style.removeProperty('--social-wall-padding');
    const cta = social.querySelector<HTMLElement>('.social-cta');
    const minimumEnd = Math.max(
      social.offsetHeight,
      (cta?.offsetTop ?? 0) + (cta?.offsetHeight ?? 0) + 16,
    );
    const cycle = Math.floor(minimumEnd / 900);
    const nextSeam = [...facebookWallSeams.map((seam) => seam + (cycle * 900)), ...facebookWallSeams.map((seam) => seam + ((cycle + 1) * 900))]
      .find((seam) => seam >= minimumEnd);

    if (nextSeam === undefined) return;
    social.style.setProperty('--social-wall-padding', `${Math.max(0, nextSeam - social.offsetHeight)}px`);
  }

  function syncFacebookPostLinks() {
    if (!feed || !billboardBottomActions) return;

    const items = [...feed.querySelectorAll<HTMLElement>(':scope > .fb-item')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('#social .fb-post-link[data-fb-item-index]')]
      .sort((first, second) => Number(first.dataset.fbItemIndex) - Number(second.dataset.fbItemIndex));

    if (facebookDesktopQuery.matches) {
      billboardBottomActions.replaceChildren(...links);
      billboardBottomActions.dataset.count = String(links.length);
      return;
    }

    for (const link of links) {
      items[Number(link.dataset.fbItemIndex)]?.append(link);
    }
    billboardBottomActions.replaceChildren();
    delete billboardBottomActions.dataset.count;
  }

  function syncBillboardMiddleSlices() {
    if (!billboardMiddle || !billboardMiddleSlices) return;

    const width = billboardMiddle.clientWidth;
    const height = billboardMiddle.clientHeight;
    if (!width || !height) return;

    const sliceHeight = (width * 3) / 16;
    const sliceCount = facebookDesktopQuery.matches
      ? 3
      : Math.max(1, Math.ceil(height / sliceHeight));
    const signature = `${Math.round(width)}:${Math.round(height)}:${sliceCount}`;
    if (signature === billboardSliceSignature) return;

    const slices = document.createDocumentFragment();
    for (let index = 0; index < sliceCount; index += 1) {
      const slice = document.createElement('img');
      slice.className = 'fb-billboard__middle-slice';
      slice.src = '/images/facebook/facebook-billboard-middle.webp';
      slice.style.height = `${sliceHeight}px`;
      slice.dataset.slice = 'middle';
      slice.alt = '';
      slices.append(slice);
    }

    billboardMiddleSlices.replaceChildren(slices);
    billboardSliceSignature = signature;
  }

  if (billboardMiddle && billboardMiddleSlices) {
    const billboardSliceObserver = new ResizeObserver(syncBillboardMiddleSlices);
    billboardSliceObserver.observe(billboardMiddle);
    syncBillboardMiddleSlices();
  }

  facebookDesktopQuery.addEventListener('change', () => {
    syncFacebookPostLinks();
    requestAnimationFrame(alignFacebookSectionToWallSeam);
  });
  window.addEventListener('resize', alignFacebookSectionToWallSeam);
  // #social now renders (with fallback content) from first paint instead of waiting
  // for JS to reveal it, so the seam alignment that used to only run after the feed
  // swapped content must also run once against that initial server-rendered state.
  requestAnimationFrame(alignFacebookSectionToWallSeam);

  function showFacebookFallback() {
    if (!feed || !social) return;

    billboardBottomActions?.replaceChildren();
    feed.replaceChildren();

    const message = document.createElement('p');
    message.className = 'fb-unavailable';
    message.textContent = 'Follow us for the latest updates.';

    const arrow = document.createElement('span');
    arrow.className = 'fb-unavailable-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↓';

    message.append(arrow);
    feed.append(message);

    delete feed.dataset.count;
    requestAnimationFrame(alignFacebookSectionToWallSeam);
  }

  function loadFacebookFeed() {
    fetch('/api/facebook-feed', {
      headers: { Accept: 'application/json' },
    })
    .then((response) => (response.ok ? response.json() : null))
    .then((payload) => {
      if (
        !feed ||
        !social ||
        !Array.isArray(payload?.posts) ||
        payload.posts.length === 0
      ) {
        showFacebookFallback();
        return;
      }

      billboardBottomActions?.replaceChildren();
      feed.replaceChildren();

      for (const post of payload.posts.slice(0, 4)) {
        if (!post?.permalinkUrl) continue;

        const imageUrl = typeof post.imageUrl === 'string' ? post.imageUrl.trim() : '';
        const normalizedCaption = normalizeFacebookCaption(post.message);
        const rendersCaptionSheet = Boolean(imageUrl && normalizedCaption) || (!imageUrl && !normalizedCaption);
        const item = document.createElement('div');
        item.className = 'fb-item';
        item.classList.toggle('fb-item--without-caption', !rendersCaptionSheet);

        const card = document.createElement('article');
        card.className = 'fb-card';

        if (imageUrl) {
          const media = document.createElement('button');
          media.type = 'button';
          media.className = 'fb-media';
          media.dataset.lightboxSrc = imageUrl;
          media.dataset.lightboxAlt = 'Facebook post image';
          if (normalizedCaption) {
            media.dataset.lightboxCaption = normalizedCaption;
            media.dataset.lightboxLayout = 'facebook-caption';
          } else {
            media.dataset.lightboxLayout = 'facebook-image';
          }
          media.dataset.lightboxActionUrl = post.permalinkUrl;
          media.dataset.lightboxActionLabel = 'View on Facebook';
          media.dataset.lightboxActionNewTab = 'true';
          media.setAttribute('aria-label', 'View Facebook post image larger');
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = '';
          image.loading = 'lazy';
          media.append(image);
          card.append(media);
        } else {
          const textNotice = normalizedCaption
            ? document.createElement('button')
            : document.createElement('p');
          textNotice.className = 'fb-text-media';
          if (normalizedCaption && normalizedCaption.length <= 84) textNotice.classList.add('fb-text-media--short');
          textNotice.textContent = normalizedCaption || post.message || "Grayz'n Buffalo";
          if (textNotice instanceof HTMLButtonElement) {
            textNotice.type = 'button';
            // Keep original internal formatting for the modal, while removing only
            // leading and trailing blank space that would create empty parchment space.
            textNotice.dataset.lightboxText = trimFacebookLightboxText(post.message);
            textNotice.dataset.lightboxLayout = 'facebook-text';
            textNotice.dataset.lightboxActionUrl = post.permalinkUrl;
            textNotice.dataset.lightboxActionLabel = 'View on Facebook';
            textNotice.dataset.lightboxActionNewTab = 'true';
            textNotice.setAttribute('aria-label', 'Read full Facebook post');
          }
          card.append(textNotice);
        }

        const footer = document.createElement('div');
        footer.className = 'fb-footer';

        if (post.postedLabel) {
          const date = document.createElement('span');
          date.className = 'fb-date';
          date.textContent = post.postedLabel;
          footer.append(date);
        }

        card.append(footer);

        // Image posts receive the smaller caption card only when the API supplied
        // caption text. Text-only posts already render their text in the large card.
        // Keep the existing no-image/no-caption fallback card unchanged.
        if (rendersCaptionSheet) {
          const caption = document.createElement('div');
          caption.className = 'fb-caption';
          caption.style.setProperty('--caption-sheet', `url("${facebookCaptionAssets[feed.childElementCount]}")`);
          const captionText = document.createElement('p');
          captionText.textContent = normalizedCaption || 'See Facebook for full post details.';
          caption.append(captionText);
          item.append(caption);
        }

        item.append(card);

        const postLink = document.createElement('a');
        postLink.className = 'fb-post-link';
        postLink.href = post.permalinkUrl;
        postLink.target = '_blank';
        postLink.rel = 'noopener';
        postLink.dataset.fbItemIndex = String(feed.childElementCount);
        postLink.textContent = 'View Post';

        item.append(postLink);
        feed.append(item);
      }

      if (feed.childElementCount > 0) {
        feed.dataset.count = String(feed.childElementCount);
        syncFacebookPostLinks();
        requestAnimationFrame(alignFacebookSectionToWallSeam);
      } else {
        showFacebookFallback();
      }
    })
      .catch(showFacebookFallback);
  }

  function scheduleFacebookFeed() {
    const requestIdleCallback = (globalThis as typeof globalThis & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
    }).requestIdleCallback;

    if (requestIdleCallback) {
      requestIdleCallback(loadFacebookFeed, { timeout: 4000 });
    } else {
      setTimeout(loadFacebookFeed, 1500);
    }
  }

  if (document.readyState === 'complete') {
    scheduleFacebookFeed();
  } else {
    window.addEventListener('load', scheduleFacebookFeed, { once: true });
  }
