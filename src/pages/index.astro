  /* Barn-door Welcome and tavern-table Menu environments. */
  #welcome{box-sizing:border-box;aspect-ratio:1920 / 867;min-height:0;padding:clamp(34px,3vw,46px) clamp(16px,4vw,48px) clamp(16px,2vw,26px);background:#21160f url('/images/welcome/welcome-background.webp') center top / 100% 100% no-repeat;color:#f1d9a4}
  #welcome .welcome-grid{display:block;max-width:1280px;margin:0 auto}
  #welcome .welcome-copy{max-width:1080px;margin:0 auto;text-align:center}
  #welcome .welcome-title{grid-template-columns:minmax(44px,1fr) auto auto auto minmax(44px,1fr);max-width:1080px;margin:0 auto;color:#f1d9a4}
  #welcome .welcome-copy p{max-width:68ch;color:#f7e5bc;font-size:clamp(.98rem,1.3vw,1.1rem);line-height:1.42;text-shadow:0 1px 2px rgba(24,12,7,.75)}
  #welcome .welcome-intro{position:relative;top:-10px;margin:clamp(42px,3.4vw,52px) auto 0}
  #welcome .welcome-divider{position:relative;top:-10px;display:block;width:clamp(180px,15vw,230px);height:auto;margin:4px auto 0;pointer-events:none}
  #welcome .photo-stack{position:relative;top:-20px;display:grid;width:min(100%,950px);margin:6px auto 0;padding:0;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,1.8vw,24px);overflow:visible}
  #welcome .photo-position{--photo-tilt:-2deg;position:relative;height:clamp(238px,18vw,260px);min-width:0;transform:rotate(var(--photo-tilt));filter:drop-shadow(3px 8px 6px rgba(16,8,4,.5));transition:transform .2s ease,filter .2s ease}
  #welcome .photo-position--2{--photo-tilt:1.6deg;top:10px}
  #welcome .photo-position--3{--photo-tilt:-1.3deg;top:-5px}
  #welcome .photo-position--4{--photo-tilt:2.1deg;top:8px}
  #welcome .photo-position:hover{z-index:2;transform:translateY(-5px) rotate(0);filter:drop-shadow(4px 13px 10px rgba(16,8,4,.58))}
  /* The transparent windows differ slightly between the four paper holders. */
  #welcome .photo-viewport{position:absolute;z-index:0;top:var(--viewport-top);left:var(--viewport-left);width:var(--viewport-width);height:var(--viewport-height);overflow:hidden;isolation:isolate;clip-path:inset(0);background:#1f120b}
  #welcome .photo-position--1{--viewport-left:6.375%;--viewport-top:5.4%;--viewport-width:87.75%;--viewport-height:72.1%}
  #welcome .photo-position--2{--viewport-left:7.75%;--viewport-top:6.9%;--viewport-width:84.5%;--viewport-height:70.5%}
  #welcome .photo-position--3{--viewport-left:8.87%;--viewport-top:7.1%;--viewport-width:81.9%;--viewport-height:71.3%}
  #welcome .photo-position--4{--viewport-left:7%;--viewport-top:6%;--viewport-width:86.25%;--viewport-height:71.1%}
  #welcome .photo-position .photo{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;margin:0!important;padding:0;overflow:hidden;border:0!important;border-radius:0!important;background:#1f120b;box-shadow:none!important;opacity:0;pointer-events:none;transform:none!important;transition:opacity 1.1s ease;cursor:zoom-in}
  #welcome .photo-position .photo.is-active{opacity:1;pointer-events:auto}
  #welcome .photo-position .photo img{position:absolute;inset:0;display:block;width:100%;height:100%;border:0;object-fit:cover;filter:saturate(.88) sepia(.08) contrast(.96)}
  /* Viewports run ~82-88% wide by ~70-72% tall (moderately landscape-shaped), so a
     portrait source crops on the vertical axis; bias upward since food and faces
     usually sit above centre. Square/landscape sources crop far less severely and
     stay centred. */
  #welcome .photo-position .photo--portrait img{object-position:50% 35%}
  #welcome .photo-position .photo--square img{object-position:50% 50%}
  #welcome .photo-position .photo--landscape img{object-position:50% 50%}
  #welcome .photo-position .photo span{position:absolute;right:0;bottom:0;left:0;width:auto;padding:5px 7px;background:linear-gradient(transparent,rgba(25,13,7,.8));color:var(--cream);font-size:.62rem}
  #welcome .photo-holder{position:absolute;z-index:1;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none}
  #welcome .welcome-closing{position:relative;top:12px;max-width:760px;margin:10px auto 0;padding:0;color:#f1d9a4}
  #welcome .welcome-script{display:block;margin:0;color:#f1d9a4;text-align:center;text-shadow:0 1px 2px rgba(24,12,7,.85)}
