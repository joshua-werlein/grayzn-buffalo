---
import Base from '../layouts/Base.astro';
import SpecialsBoard from '../components/SpecialsBoard.astro';
import { getMenu, thumbKey } from '../lib/db';

const env = (Astro.locals as any).runtime?.env ?? {};
const { categories, items } = await getMenu(env);
const photoGroups = categories
  .map((category) => items.filter((item) => item.category_id === category.id && item.photo_key))
  .filter((group) => group.length > 0);
const stripPhotos = [] as typeof items;
const longestPhotoGroup = Math.max(0, ...photoGroups.map((group) => group.length));

// Lead with one photo from every category, then return for each category's
// second photo, third photo, and so on. This keeps the strip varied instead
// of showing a run of similar dishes from the same menu section.
for (let position = 0; position < longestPhotoGroup; position += 1) {
  for (const group of photoGroups) {
    const item = group[position];
    if (item) stripPhotos.push(item);
  }
}
---
<Base>
<header class="hero" id="top">
  <h1 class="sr-only">Grayz'n Buffalo Bar &amp; Grill — Mondovi, Wisconsin</h1>
  <div class="hero-copy">
    <div class="logo-wrap">
      <div class="sun" aria-hidden="true"></div>
      <img class="hero-logo charge" src="/logo-ink.webp" alt="" width="900" height="605" />
      <div class="ground-fill" aria-hidden="true"></div>
    </div>
    <p class="hero-tag rise d1">Burgers, Wraps, Pizzas &amp; cold ones — open daily 10 AM to 2 AM.</p>
    <div class="hero-ctas rise d2">
      <a class="btn btn-primary" href="/specials">Today's Special</a>
      <a class="btn btn-ghost" href="/menu">See the Menu</a>
    </div>
  </div>
</header>

{stripPhotos.length > 0 && (
  <section class="strip" aria-label="Menu photos">
    <div class="strip-track">
      <div class="strip-sequence">
        {stripPhotos.map((item) => (
          <div class="strip-item">
            <img src={`/img/${thumbKey(item.photo_key!)}`} alt={item.name} width="250" height="170" loading="eager" decoding="async" />
          </div>
        ))}
      </div>
      <div class="strip-sequence" aria-hidden="true">
        {stripPhotos.map((item) => (
          <div class="strip-item">
            <img src={`/img/${thumbKey(item.photo_key!)}`} alt="" width="250" height="170" loading="eager" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<section id="specials" class="dark">
  <div class="section-head reveal">
    <span class="kicker" style="color:var(--amber)">Fresh off the board</span>
    <h2 style="color:var(--gold)">Today's Specials</h2>
  </div>
  <SpecialsBoard />
</section>

<div class="checker" aria-hidden="true"></div>

<section id="welcome">
  <div class="welcome-grid">
    <div class="welcome-copy reveal">
      <span class="kicker">Welcome in</span>
      <h2>Small Town.<br />Big Appetite.</h2>
      <p>Right on Eau Claire Street in downtown Mondovi. Half-pound burgers, broasted chicken, and fries in checkered paper — with the kitchen running from 10 AM to 2 AM every day.</p>
      <p>Longtime locals knew us as Gumby's. New name, same bar.</p>
      <a class="btn btn-primary" href="/menu" style="margin-top:8px">Full Menu</a>
    </div>
    <div class="photo-stack reveal">
      <div class="photo"><img src="/food-pretzel.webp" alt="Soft pretzel and cheese" loading="lazy" /><span>Pretzel &amp; cheese</span></div>
      <div class="photo"><img src="/food-club.webp" alt="Club sandwich with waffle fries" loading="lazy" /><span>Club on waffle fries</span></div>
      <div class="photo ph"><span>Photo: Grayz'n burger</span></div>
      <div class="photo ph"><span>Photo: the bar</span></div>
    </div>
  </div>
</section>

<div class="checker" aria-hidden="true"></div>

<section id="menu-preview" style="background:var(--cream-2)">
  <div class="section-head reveal">
    <h2>The Menu</h2>
    <span class="kicker">From the kitchen</span>
    <p>The daily lineup while the grill's on — and the late-night menu after it shuts down.</p>
  </div>
  <div class="menu-cards">
    <article class="menu-card reveal">
      <h3>Daily Menu</h3>
      <p>Full kitchen while the grill is running.</p>
      <a class="link-arrow" href="/menu">Daily menu →</a>
    </article>
    <article class="menu-card reveal">
      <h3>Late Night</h3>
      <p>After the grill shuts down, the oven keeps going — pizza, pizza fries, appetizers.</p>
      <a class="link-arrow" href="/menu#late-night">Late night menu →</a>
    </article>
    <article class="menu-card reveal">
      <h3>Specials</h3>
      <p>A different deal every day — Mexican Night included.</p>
      <a class="link-arrow" href="/specials">This week's board →</a>
    </article>
  </div>
</section>

<div class="checker" aria-hidden="true"></div>

<section id="social" hidden>
  <div class="section-head reveal">
    <h2>The Latest</h2>
    <span class="kicker">Straight from Facebook</span>
    <p>For today&rsquo;s specials, see the <a href="/specials">Specials</a>.</p>
  </div>
  <div class="fb-grid reveal" id="fbFeed">
    <p style="text-align:center;color:var(--ink-2)">Recent posts appear here once the Facebook feed Worker is connected.</p>
  </div>
  <div style="text-align:center;margin-top:34px" class="reveal">
    <a class="btn btn-primary" href="https://www.facebook.com/grayznbuffalo/">Follow the Grayz'n Buffalo</a>
  </div>
</section>

<section id="visit" class="dark">
  <h2 class="visit-heading reveal">Come See the Grayz'n Buffalo</h2>
  <div class="map-frame reveal">
    <iframe title="Map to Grayz'n Buffalo"
      src="https://www.google.com/maps?q=102+S+Eau+Claire+St,+Mondovi,+WI+54755&output=embed"
      loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <div class="visit-cols reveal">
    <div class="visit-block"><h4>Address</h4><p><a href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a></p></div>
    <div class="visit-block"><h4>Phone</h4><p><a href="tel:+17159264431">(715) 926-4431</a></p></div>
    <div class="visit-block"><h4>Hours</h4><p>Open daily · 10 AM – 2 AM</p></div>
  </div>
</section>
</Base>

<style>
  .hero{position:relative;overflow:hidden;min-height:min(84vh,720px);
    min-height:min(84dvh,720px);
    display:flex;align-items:flex-end;justify-content:center;text-align:center;
    background:linear-gradient(180deg,#2f7fc1 0%,#5db4e4 40%,#a7dcf0 68%,#cfeadf 92%)}
  .sun{position:absolute;left:50%;top:76.4%;transform:translate(-50%,-50%);
    width:112%;aspect-ratio:1;border-radius:50%;z-index:0;
    background:radial-gradient(circle,#fffbe6 0%,#ffe98a 42%,rgba(255,233,138,0) 70%)}
  .ground-fill{
    position:absolute;left:-1500px;right:-1500px;top:76.4%;bottom:-1500px;
    background:linear-gradient(to bottom,
      rgba(90,150,70,0) 0px,
      #4f8c3f 16px,
      #47843a 90px,
      #3f7d32 100%);
    z-index:1;
  }
  .hero-copy{position:relative;z-index:3;padding:0 24px;padding-bottom:7vh;max-width:900px;margin:0 auto}
  .logo-wrap{position:relative;width:min(78vw,560px);margin:0 auto;z-index:1}
  .hero-logo{position:relative;z-index:2;display:block;width:100%;height:auto;
     filter:drop-shadow(0 0 22px rgba(255,255,255,.55))}
  .hero-tag{position:relative;z-index:1;font-size:clamp(1.05rem,2.4vw,1.4rem);color:var(--cream);
    text-shadow:0 1px 10px rgba(36,22,16,.5);font-weight:600;margin-top:30px;letter-spacing:.01em}
  .hero-ctas{position:relative;z-index:1;margin-top:38px;display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .rise{opacity:0;transform:translateY(26px);animation:rise .9s ease forwards}
  .rise.d1{animation-delay:.75s}.rise.d2{animation-delay:.95s}
  @keyframes rise{to{opacity:1;transform:translateY(0)}}
  .charge{opacity:0;transform:scale(.42) translateY(14px);
    animation:charge 1.15s cubic-bezier(.19,.74,.36,1) forwards;will-change:transform,opacity}
  @keyframes charge{
    0%{opacity:0;transform:scale(.42) translateY(14px)}
    55%{opacity:1}
    82%{transform:scale(1.045) translateY(-2px)}
    100%{opacity:1;transform:scale(1) translateY(0)}
  }
  .strip{background:var(--ink);padding:18px 0;overflow:hidden}
  .strip-track{display:flex;width:max-content;animation:slide 36s linear infinite}
  .strip-sequence{display:flex;gap:16px;padding-right:16px;flex:none}
  .strip:hover .strip-track{animation-play-state:paused}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .strip-item{width:250px;height:170px;border-radius:10px;overflow:hidden;flex:none;
    border:3px solid var(--cream);box-shadow:0 6px 16px rgba(0,0,0,.4);
    position:relative;background:linear-gradient(150deg,var(--amber),var(--crimson))}
  .strip-item img{width:100%;height:100%;object-fit:cover;display:block}
  .strip-item.ph{display:flex;align-items:center;justify-content:center;
    font-family:var(--label);font-weight:600;font-size:.75rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--cream);text-shadow:0 1px 6px rgba(0,0,0,.5)}
  .dark{background:var(--ink);color:var(--cream)}
  .welcome-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,5vw,64px);max-width:1120px;margin:0 auto;align-items:center}
  .welcome-copy h2{text-align:left}
  .welcome-copy .kicker{display:block;text-align:left}
  .welcome-copy p{margin:14px 0;color:var(--ink-2)}
  .photo-stack{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .photo{aspect-ratio:4/5;border-radius:12px;position:relative;overflow:hidden;
    background:linear-gradient(160deg,var(--amber),var(--crimson));
    box-shadow:0 10px 26px rgba(36,22,16,.22);display:flex;align-items:flex-end;transition:transform .3s ease}
  .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .photo:hover{transform:translateY(-6px)}
  .photo:nth-child(2){margin-top:34px}
  .photo span{position:relative;width:100%;padding:10px 12px;font-family:var(--label);font-weight:600;font-size:.8rem;
    letter-spacing:.12em;text-transform:uppercase;color:var(--cream);
    background:linear-gradient(transparent,rgba(36,22,16,.78))}
  .menu-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px;max-width:1120px;margin:0 auto}
  .menu-card{background:var(--cream);border-radius:14px;padding:30px 26px;border-top:6px solid var(--crimson);
    box-shadow:0 8px 22px rgba(36,22,16,.12);transition:transform .25s ease, box-shadow .25s ease}
  .menu-card:nth-child(2){border-top-color:var(--amber)}
  .menu-card:nth-child(3){border-top-color:var(--denim)}
  .menu-card:hover{transform:translateY(-7px);box-shadow:0 16px 34px rgba(36,22,16,.18)}
  .menu-card h3{font-family:var(--display);font-size:1.35rem;margin-bottom:8px}
  .menu-card p{color:var(--ink-2);font-size:.98rem;margin-bottom:16px}
  .link-arrow{font-family:var(--label);font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--crimson);text-decoration:none;font-size:.92rem}
  .link-arrow:hover{text-decoration:underline}
  .section-head p a{color:var(--crimson);font-weight:700;text-underline-offset:3px;text-decoration-thickness:1.5px}
  .section-head p a:hover,.section-head p a:focus-visible{color:var(--ink);text-decoration-thickness:2px}
  #social .section-head .kicker,#menu-preview .section-head .kicker{display:block;margin:-2px 0 10px}
  .visit-heading{color:var(--gold);text-align:center;max-width:900px;margin:0 auto 32px}
  .map-frame{border-radius:14px;width:100%;max-width:1100px;height:clamp(300px,42vw,440px);
    margin:0 auto;overflow:hidden;border:2px solid rgba(247,234,211,.2)}
  .map-frame iframe{display:block;width:100%;height:100%;border:0}
  .visit-cols{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,4vw,48px);
    max-width:900px;margin:38px auto 0;text-align:center;
  }
  .visit-block h4{font-family:var(--label);font-weight:700;letter-spacing:.2em;text-transform:uppercase;font-size:.85rem;color:var(--amber);margin-bottom:6px}
  .visit-block p{color:var(--cream-2);white-space:nowrap}
  .visit-block:first-child p{white-space:normal}
  .visit-block a{color:var(--gold);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px;}
  .visit-block a:hover,
  .visit-block a:focus-visible{color:var(--cream);text-decoration-thickness:2px;}
  @media (max-width:900px){ .welcome-grid{grid-template-columns:1fr} }
  @media (max-width:800px){ .visit-cols{grid-template-columns:1fr;gap:20px} .visit-block p{white-space:normal} }
  @media (max-width:480px){ .hero{min-height:min(72vh,640px);min-height:min(72dvh,640px)} .logo-wrap{width:min(88vw,560px)} }
  @media (prefers-reduced-motion: reduce){
    .rise,.charge,.strip-track{animation:none;opacity:1;transform:none}
  }
</style>

<style is:global>
  /* Feed cards are created in the browser, so these selectors must not carry Astro's scope attribute. */
  #social{--fb-card-header-bg:#fffdf8}
  #social .fb-grid{display:grid;grid-template-columns:repeat(4,minmax(280px,1fr));gap:22px;max-width:1360px;margin:0 auto;align-items:stretch}
  #social .fb-grid[data-count="1"]{max-width:400px;grid-template-columns:1fr}
  #social .fb-grid[data-count="2"]{max-width:820px;grid-template-columns:repeat(2,minmax(280px,1fr))}
  #social .fb-grid[data-count="3"]{max-width:1020px;grid-template-columns:repeat(3,minmax(280px,1fr))}
  #social .fb-card{height:100%;overflow:hidden;border:1px solid var(--ink);border-radius:14px;background:#fffdf8;box-shadow:0 8px 22px rgba(36,22,16,.12);transition:transform .2s ease,box-shadow .2s ease}
  #social .fb-card:hover{transform:translateY(-5px);box-shadow:0 14px 30px rgba(36,22,16,.2)}
  #social .fb-card-link{display:flex;flex-direction:column;height:100%;color:var(--ink);text-decoration:none}
  #social .fb-card-link:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  #social .fb-card-header{display:flex;align-items:center;min-height:64px;max-height:180px;overflow:auto;padding:13px 16px;border-bottom:1px solid var(--ink);background:var(--fb-card-header-bg);color:var(--ink-2)}
  #social .fb-card-header p{margin:0;white-space:pre-line;font-size:.96rem;line-height:1.38}
  #social .fb-card img{display:block;width:100%;height:clamp(340px,31vw,460px);object-fit:contain;background:var(--cream-2)}
  #social .fb-text-media{display:flex;align-items:center;justify-content:center;height:clamp(340px,31vw,460px);padding:24px;background:var(--cream-2);color:var(--ink);font-family:var(--display);font-size:clamp(1.2rem,2vw,1.7rem);line-height:1.25;text-align:center}
  #social .fb-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:54px;padding:10px 12px 10px 14px;border-top:1px solid var(--ink);background:#fffdf8}
  #social .fb-footer .fb-date{font-family:var(--label);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);font-size:.76rem;line-height:1.1}
  #social .fb-footer .fb-link{display:inline-block;flex:none;padding:7px 10px;border-radius:999px;background:var(--btn-crimson);color:var(--cream);font-family:var(--label);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.75rem;line-height:1}
  #social .fb-card-link:hover .fb-link,#social .fb-card-link:focus-visible .fb-link{background:var(--btn-crimson-hover)}
  @media (max-width:1180px){#social .fb-grid,#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:820px;grid-template-columns:repeat(2,minmax(280px,1fr))}}
  @media (max-width:650px){#social .fb-grid,#social .fb-grid[data-count="2"],#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:400px;grid-template-columns:1fr}#social .fb-card img,#social .fb-text-media{height:clamp(320px,110vw,440px)}}
</style>

<script>
  const social = document.getElementById('social');
  const feed = document.getElementById('fbFeed');

  fetch('/api/facebook-feed', { headers: { Accept: 'application/json' } })
    .then((response) => response.ok ? response.json() : null)
    .then((payload) => {
      if (!feed || !social || !Array.isArray(payload?.posts) || payload.posts.length === 0) return;

      feed.replaceChildren();
      for (const post of payload.posts) {
        if (!post?.permalinkUrl) continue;
        const card = document.createElement('article');
        card.className = 'fb-card';
        const cardLink = document.createElement('a');
        cardLink.className = 'fb-card-link';
        cardLink.href = post.permalinkUrl;
        cardLink.target = '_blank';
        cardLink.rel = 'noopener';
        cardLink.setAttribute('aria-label', "Open Facebook post from Grayz'n Buffalo");

        const header = document.createElement('div');
        header.className = 'fb-card-header';
        if (post.message) {
          const caption = document.createElement('p');
          caption.textContent = post.message;
          header.append(caption);
        }
        cardLink.append(header);

        if (post.imageUrl) {
          const image = document.createElement('img');
          image.src = post.imageUrl;
          image.alt = post.message ? `Facebook post: ${post.message}` : '';
          image.loading = 'lazy';
          cardLink.append(image);
        } else {
          const fallback = document.createElement('div');
          fallback.className = 'fb-text-media';
          fallback.setAttribute('aria-hidden', 'true');
          fallback.textContent = "Grayz'n Buffalo";
          cardLink.append(fallback);
        }

        const footer = document.createElement('div');
        footer.className = 'fb-footer';
        if (post.postedLabel) {
          const date = document.createElement('span');
          date.className = 'fb-date';
          date.textContent = post.postedLabel;
          footer.append(date);
        }
        const linkLabel = document.createElement('span');
        linkLabel.className = 'fb-link';
        linkLabel.textContent = 'View Post';
        footer.append(linkLabel);
        cardLink.append(footer);
        card.append(cardLink);
        feed.append(card);
      }

      if (feed.childElementCount > 0) {
        feed.dataset.count = String(feed.childElementCount);
        social.hidden = false;
      }
    })
    .catch(() => {
      // A failed feed request leaves this optional section hidden.
    });
</script>
