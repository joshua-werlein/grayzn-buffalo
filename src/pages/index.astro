  #welcome .welcome-script::before,#welcome .welcome-script::after{content:none}
  #welcome .welcome-script__full{display:none}
  #welcome .welcome-script__compact{position:relative;display:block;width:8.5em;height:1.3em;overflow:hidden}
  #welcome .welcome-script__compact span{position:absolute;inset:0;display:block;opacity:0;transform:translateY(3px);animation:welcome-tagline-cycle 15s ease-in-out infinite}
  #welcome .welcome-script__compact span:nth-child(2){animation-delay:5s}
