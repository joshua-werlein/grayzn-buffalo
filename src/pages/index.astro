  #visit{display:flex;flex-direction:column;gap:22px;padding-block:clamp(42px,6vw,72px);background:var(--surface-wood)}
  .visit-heading{order:1;max-width:var(--content-wide);width:100%;margin:0 auto;color:var(--cream);text-align:left;font-size:clamp(2rem,3.6vw,3.1rem)}
  .visit-kicker{order:2;align-self:flex-start;color:var(--ochre);max-width:var(--content-wide);width:100%;margin-inline:auto}
  .visit-cols{order:3;display:grid;grid-template-columns:1fr;gap:14px;max-width:none;width:100%;margin:0;text-align:left}
  .visit-block{padding:0 0 13px;border-bottom:1px solid var(--rule-light)}
  .visit-block h3{color:var(--ochre);margin-bottom:2px;letter-spacing:.15em}
  .visit-block p,.visit-block:first-child p{color:var(--cream);white-space:normal;margin:0}
  .visit-block a{color:var(--cream);text-decoration-color:var(--ochre)}
  .map-frame{order:4;width:100%;max-width:none;height:clamp(250px,46vw,360px);margin:0;border:2px solid var(--ochre);border-radius:var(--panel-radius);box-shadow:var(--panel-shadow-dark)}

  @media (min-width:900px){
    #visit{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr);column-gap:clamp(32px,6vw,76px);align-items:start}
    .visit-kicker,.visit-heading{grid-column:1;width:auto;margin:0}
    .visit-cols{grid-column:1;grid-row:3}
    .map-frame{grid-column:2;grid-row:1 / span 3;height:100%;min-height:330px}
  }
  @media (max-width:900px){
    .welcome-grid{grid-template-columns:1fr;gap:24px}
    .welcome-copy{max-width:54ch}
    .photo-stack{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(160px,46vw,240px);max-width:660px;margin-inline:auto}
    .photo:nth-child(3){grid-column:1 / -1;width:58%;justify-self:center}
  }
  @media (max-width:620px){
    .menu-cards{grid-template-columns:1fr;gap:12px}
    .menu-card{min-height:0}
    .menu-card p{margin-bottom:14px}
    .welcome-title{grid-template-columns:minmax(16px,1fr) auto auto auto minmax(16px,1fr);gap:6px}
    .welcome-title h2{font-size:clamp(1.4rem,7.1vw,1.8rem)}
  }

  /* Printed paper, posted photos, and railroad-stationery surfaces. */
  .hero-after,#welcome{position:relative;background-color:var(--page-parchment);background-image:radial-gradient(rgba(77,45,24,.1) .65px,transparent .75px),linear-gradient(90deg,rgba(111,65,29,.07),transparent 15%,transparent 85%,rgba(111,65,29,.06));background-size:5px 5px,100% 100%}
  .welcome-copy h2{font-family:var(--display);line-height:1.05}.welcome-copy p{max-width:35ch}
  .photo-stack{gap:0;padding:16px 22px 28px}
  .photo{border:8px solid #f6ecd8;border-radius:0;box-shadow:2px 3px 0 rgba(76,45,24,.22),7px 10px 18px rgba(43,27,20,.2);overflow:visible;background:#f6ecd8}
  .photo img{inset:0;width:100%;height:100%;border:1px solid rgba(57,35,21,.32)}
  .photo:nth-child(1){z-index:1;transform:rotate(-3deg) translateY(18px);margin-right:-28px}.photo:nth-child(2){z-index:2;transform:rotate(1.8deg) translateY(-7px);margin-inline:-18px}.photo:nth-child(3){z-index:1;transform:rotate(-1.7deg) translateY(22px);margin-left:-28px}
  .photo:hover,.photo.welcome-photo-reveal.in:hover{transform:translateY(-5px) rotate(0)}
  #menu-preview{background-color:#d9c39a;background-image:repeating-linear-gradient(90deg,rgba(74,45,23,.05) 0 1px,transparent 1px 28px),linear-gradient(120deg,rgba(255,248,225,.45),rgba(134,87,40,.08));border-top:2px solid rgba(64,37,20,.25);border-bottom:2px solid rgba(64,37,20,.25)}
  .menu-card{border:2px solid var(--ink);border-radius:0;box-shadow:4px 4px 0 rgba(43,27,20,.25),0 10px 20px rgba(43,27,20,.12);background-color:var(--surface-parchment);background-image:linear-gradient(90deg,rgba(97,55,25,.05),transparent 16%,transparent 84%,rgba(97,55,25,.04));min-height:260px}
  .menu-card::after{content:'★';display:block;margin-top:14px;color:var(--ochre);font-size:1rem}.menu-card:hover{transform:translateY(-4px) rotate(-.25deg)}
  .home-social{background-color:var(--surface-aged);background-image:radial-gradient(rgba(77,45,24,.08) .6px,transparent .75px);background-size:5px 5px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  #visit{position:relative;isolation:isolate;background-color:var(--surface-parchment);background-image:linear-gradient(90deg,rgba(86,48,25,.12) 0 1px,transparent 1px 30px),linear-gradient(0deg,rgba(86,48,25,.09) 0 1px,transparent 1px 30px),linear-gradient(105deg,#f3e5c9,#d7bd8d);color:var(--ink);border:0}
  #visit::after{content:'';position:absolute;z-index:-1;right:clamp(10px,6vw,90px);bottom:-18px;width:min(42vw,360px);height:260px;background:url('/logo-buffalo.webp') center / contain no-repeat;opacity:.075;filter:sepia(1) contrast(.8)}
  .visit-heading{color:var(--ink);font-family:var(--display)}.visit-kicker{color:var(--brick)}.visit-cols{border-top:0;padding-top:16px}.visit-block{border-bottom:1px dashed var(--rule)}.visit-block h3{color:var(--brick)}.visit-block p,.visit-block:first-child p,.visit-block a{color:var(--ink)}
  .map-frame{border:6px solid #f7ecd6;border-radius:0;box-shadow:3px 3px 0 rgba(43,27,20,.3),9px 12px 22px rgba(43,27,20,.14)}
  /* The content group is separate from its scene so desktop can move it without moving the shared landscape. */
  #visit{display:block;padding:0;background:transparent}
  #visit::after{display:none}
  .visit-content{display:flex;flex-direction:column;gap:22px;padding:clamp(42px,6vw,72px) clamp(18px,4vw,64px);background-color:var(--surface-parchment);background-image:linear-gradient(90deg,rgba(86,48,25,.12) 0 1px,transparent 1px 30px),linear-gradient(0deg,rgba(86,48,25,.09) 0 1px,transparent 1px 30px),linear-gradient(105deg,#f3e5c9,#d7bd8d)}
  .visit-content .visit-heading{order:1;max-width:var(--content-wide);width:100%;margin:0 auto;text-align:left;font-size:clamp(2rem,3.6vw,3.1rem)}
  .visit-content .visit-kicker{order:2;align-self:flex-start;max-width:var(--content-wide);width:100%;margin-inline:auto}
  .visit-content .visit-cols{order:3;display:grid;grid-template-columns:1fr;gap:14px;max-width:none;width:100%;margin:0;text-align:left}
  .visit-content .visit-block{padding:0 0 13px;border-bottom:1px solid var(--rule-light)}
  .visit-content .visit-block a:hover,.visit-content .visit-block a:focus-visible{color:#21130e;font-weight:700;text-decoration-thickness:2px}
  .visit-content .map-frame{order:4;width:100%;max-width:none;height:clamp(250px,46vw,360px);margin:0}
  @media (min-width:900px){.visit-content{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr);column-gap:clamp(32px,6vw,76px);align-items:start}.visit-content .visit-kicker,.visit-content .visit-heading{grid-column:1;width:auto;margin:0}.visit-content .visit-cols{grid-column:1;grid-row:3}.visit-content .map-frame{grid-column:2;grid-row:1 / span 3;height:100%;min-height:330px}}

  /* The intro reads as one posted-paper composition: daily boards flank the mark. */
  .hero-after{padding:clamp(26px,4vw,52px) 24px clamp(22px,3vw,36px);text-align:center}
  .hero-after__layout{display:grid;grid-template-columns:minmax(220px,.9fr) minmax(300px,1.28fr) minmax(220px,.9fr);grid-template-areas:"lunch brand dinner";align-items:stretch;gap:clamp(20px,3.5vw,52px);max-width:var(--content-wide);margin:0 auto}
  .daily-special{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:center;min-width:0;min-height:220px;padding:clamp(22px,2.8vw,34px) clamp(18px,2.5vw,30px);background-color:#173747;background-image:radial-gradient(rgba(247,236,214,.13) .65px,transparent .8px),linear-gradient(115deg,rgba(0,0,0,.16),transparent 22%,transparent 76%,rgba(0,0,0,.13));background-size:5px 5px,100% 100%;color:#f6ecd8;border:2px solid var(--ochre);box-shadow:4px 5px 0 rgba(43,27,20,.28),0 10px 22px rgba(43,27,20,.2);text-align:center}
  .daily-special::before{content:"";position:absolute;z-index:-1;inset:6px;border:1px solid rgba(235,194,109,.62);pointer-events:none}
  .daily-special--lunch{grid-area:lunch;border-top:2px solid var(--ochre)}
  .daily-special--dinner{grid-area:dinner;border-top:2px solid var(--ochre)}
  .daily-special__label{display:flex;justify-content:center;gap:10px;margin:0;color:#f6ecd8;font-family:var(--label);font-weight:700;font-size:clamp(.8rem,1.2vw,.95rem);letter-spacing:.14em;text-transform:uppercase;line-height:1.25}
  .daily-special__label span{display:inline;margin:0;color:var(--ochre);font-size:.88em;letter-spacing:0}
  .daily-special__hours{margin:6px 0 14px;padding-bottom:11px;border-bottom:1px dashed rgba(246,236,216,.64);color:#ead9b9;font-family:var(--label);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .daily-special h2{margin:0 0 8px;color:#f8efd8;font-family:var(--display);font-size:clamp(1.35rem,2.15vw,2rem);line-height:1.05}
  .daily-special__description{margin:0 auto;color:#f6ecd8;line-height:1.35}
  .daily-special__tag{display:inline-block;margin-top:14px;padding:4px 9px;border:1px solid rgba(235,194,109,.75);color:var(--ochre);font-family:var(--label);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:transparent}
  .hero-after__brand{grid-area:brand;align-self:center;min-width:0}
  .hero-after__brand .logo-bar-stage{width:min(100%,400px);height:150px}
  .hero-after__brand .hero-actions{margin-top:-26px;padding:14px 10px 0}
  .hero-after .home-specials__cta{margin-top:clamp(18px,2.5vw,28px);color:var(--ink)}

  #welcome{padding:clamp(40px,6vw,72px) 24px clamp(48px,7vw,84px);border-bottom:1px solid rgba(91,48,27,.25)}
  .welcome-grid{display:block;max-width:var(--content-wide);margin:0 auto}
  .welcome-copy{max-width:760px;margin:0 auto;text-align:center;padding:0}
  .welcome-copy p{max-width:62ch;margin:0 auto;color:var(--text-muted);font-size:clamp(1rem,1.45vw,1.15rem);line-height:1.45}
  .welcome-title{margin:clamp(18px,2.5vw,28px) 0 12px}
  .welcome-copy .welcome-title + p{font-size:clamp(.95rem,1.25vw,1.04rem)}
  .photo-stack{grid-template-columns:.95fr 1.15fr .95fr;grid-auto-rows:clamp(220px,22vw,310px);max-width:900px;margin:clamp(20px,3vw,32px) auto 0;padding:16px 34px 28px}

  @media (max-width:900px){
    .hero-after__layout{grid-template-columns:1fr;grid-template-areas:"brand" "lunch" "dinner";max-width:520px;gap:20px}
    .hero-after__brand{padding-bottom:2px}
    .daily-special{padding:26px 28px}
    .photo-stack{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(170px,48vw,260px);max-width:660px}
  }
  @media (max-width:620px){
    .hero-after{padding-inline:16px}
    .hero-after__brand .logo-bar-stage{width:min(65vw,280px);height:auto}
    .hero-after__brand .hero-actions{margin-top:0;padding-top:18px}
    #welcome{padding-inline:16px}
    .welcome-copy p{max-width:36ch}
    .photo-stack{padding-inline:20px}
  }

  /* Final poster proportions: the center returns to its pre-composition mark scale. */
  .opening-poster{position:relative;z-index:1;isolation:isolate;overflow:visible;margin-top:0}
  .hero-after{isolation:isolate;overflow:hidden;padding:clamp(14px,2.25vw,28px) clamp(18px,4vw,64px) clamp(20px,3vw,32px);background:transparent;background-image:none}
  .hero-after__layout{position:relative;z-index:2;grid-template-columns:minmax(280px,1fr) minmax(400px,460px) minmax(280px,1fr);gap:clamp(32px,4vw,64px);max-width:1360px}
  .hero-after__brand{position:relative;isolation:isolate}
  .hero-after__brand::before{content:"";position:absolute;z-index:0;inset:48px -14% -4px;background:radial-gradient(ellipse at 50% 46%,color-mix(in srgb,var(--cream) 64%,transparent) 0%,color-mix(in srgb,var(--cream) 36%,transparent) 50%,transparent 74%);filter:blur(8px);opacity:0;pointer-events:none;animation:logo-bar-haze-fade .4s ease 1.65s forwards}
  .logo-bar-stage,.hero-after__brand .hero-actions,.hero-after__brand .home-specials__cta{position:relative;z-index:1}
  .logo-bar-grill{position:relative;z-index:1}
  @keyframes logo-bar-haze-fade{to{opacity:1}}
  .daily-special{min-height:300px;padding:clamp(26px,3vw,38px) clamp(22px,2.75vw,34px)}
  .hero-after__brand{align-self:start}
  .hero-after__brand .logo-bar-stage{width:min(50vw,400px);height:150px}
  .hero-after__brand .hero-actions{display:flex;flex:1;align-items:center;justify-content:center;margin-top:0;padding:0 24px 8px}
  .hero-after__brand .hero-tag{margin:0}
  .hero-tag span{display:block}
  .hero-after__brand .home-specials__cta{margin-top:4px}

  .welcome-title{grid-template-columns:minmax(24px,1fr) auto auto auto minmax(24px,1fr);margin:0 0 16px}
  .welcome-title h2{font-size:clamp(1.55rem,2.65vw,2.5rem);white-space:nowrap}
  .welcome-intro{max-width:62ch!important}
  .photo-stack{grid-template-columns:repeat(5,minmax(0,1fr));grid-auto-rows:clamp(170px,16vw,238px);gap:10px;max-width:1100px;margin:clamp(22px,3vw,34px) auto 0;padding:20px 32px 30px}
  .photo{margin:0!important;width:auto!important;grid-column:auto!important;justify-self:stretch!important}
  .photo:nth-child(1){z-index:1;transform:rotate(-2.8deg) translateY(12px)}
  .photo:nth-child(2){z-index:2;transform:rotate(2deg) translateY(-5px)}
  .photo:nth-child(3){z-index:1;transform:rotate(-1.9deg) translateY(15px)}
  .photo:nth-child(4){z-index:2;transform:rotate(2.5deg) translateY(-8px)}
  .photo:nth-child(5){z-index:1;transform:rotate(-2.2deg) translateY(10px)}
  .welcome-closing{max-width:660px;margin:14px auto 0;text-align:center;color:var(--text-muted)}
  .welcome-closing > p:first-child{margin:0;font-size:clamp(.95rem,1.3vw,1.08rem)}
  .welcome-script{margin:10px 0 0;color:var(--denim);font-family:var(--body);font-size:clamp(1.25rem,2.1vw,1.7rem);font-style:italic;font-weight:600;line-height:1.2}
  .welcome-flourish{display:block;margin:4px auto 0;color:var(--brick);font-size:2rem;line-height:1;transform:rotate(-12deg)}

  @media (max-width:900px){
    .hero-after__layout{grid-template-columns:1fr;grid-template-areas:"brand" "lunch" "dinner";max-width:560px;gap:20px}
    .hero-after__brand{align-self:auto}
    .daily-special{min-height:220px}
    .photo-stack{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(170px,48vw,260px);max-width:660px}
    .photo:nth-child(5){grid-column:1 / -1;width:58%!important;justify-self:center!important}
  }
  @media (max-width:620px){ .welcome-title h2{white-space:normal} .photo-stack{padding-inline:20px} }

  /* The center poster aligns to the boards; the link uses the lower breathing room. */
  .hero-after__brand{height:300px;display:flex;flex-direction:column}
  .hero-after__brand .logo-bar-stage{transform:translateY(72px)}
  .hero-after__brand .home-specials__cta{margin-top:auto;margin-bottom:0;align-self:center}
   @media (min-width:1100px){ .hero-after__brand .hero-actions{margin-top:36px} }
  .daily-special{transition:transform .22s ease,box-shadow .22s ease,filter .22s ease}
  .daily-special:hover{transform:translateY(-6px) rotate(-.3deg);box-shadow:6px 9px 0 rgba(43,27,20,.26),0 16px 28px rgba(43,27,20,.25);filter:brightness(1.07)}
  .daily-special--dinner:hover{transform:translateY(-6px) rotate(.3deg)}

  .welcome-gumby{margin-top:clamp(18px,2.5vw,28px)!important;font-size:clamp(.95rem,1.25vw,1.04rem)!important}
  .photo-stack{display:block;width:100vw;max-width:none;margin:clamp(24px,3vw,36px) 0 0 calc(50% - 50vw);padding:40px 0 48px;overflow:hidden}
  .photo-track{--marquee-entry-offset:clamp(220px,22vw,340px);display:flex;width:max-content;animation:welcome-photo-marquee 105s linear 5.7s both infinite}
  .photo-sequence{display:flex;align-items:center;gap:clamp(12px,1.8vw,24px);padding-right:clamp(12px,1.8vw,24px);flex:none}
  .photo{flex:none;display:block;width:clamp(180px,15vw,245px)!important;height:clamp(160px,14vw,220px);margin:0!important;overflow:visible;transform:none!important;transition:transform .2s ease,box-shadow .2s ease}
  .photo--landscape{width:clamp(220px,19vw,300px)!important}.photo--square{width:clamp(175px,14vw,230px)!important}.photo--portrait{width:clamp(160px,12vw,195px)!important}
  .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .photo:nth-child(odd){transform:rotate(-3.1deg) translateY(13px)!important}.photo:nth-child(even){transform:rotate(2.7deg) translateY(-9px)!important}
  .photo:nth-child(3n){transform:rotate(-1.7deg) translateY(3px)!important}.photo:nth-child(4n){transform:rotate(3.5deg) translateY(-15px)!important}
  .photo:hover{transform:translateY(-12px) rotate(0)!important;z-index:4;box-shadow:3px 5px 0 rgba(76,45,24,.25),10px 14px 22px rgba(43,27,20,.26)}
  .welcome-closing{margin:10px auto 0;padding-bottom:clamp(18px,3vw,32px)}
  .welcome-flourish{display:none}
  .photo{background-color:#ead9b7;background-image:radial-gradient(rgba(89,57,31,.11) .6px,transparent .8px);background-size:4px 4px}
  .photo::after{content:"";position:absolute;pointer-events:none;inset:-5px;border:1px solid rgba(112,72,35,.2);opacity:.55;transform:rotate(.2deg)}
  .photo-stack[data-lightbox-paused="true"] .photo-track{animation-play-state:paused}
  @keyframes welcome-photo-marquee{from{transform:translateX(calc(-1 * var(--marquee-entry-offset)))}to{transform:translateX(calc(-50% - var(--marquee-entry-offset)))}}

  /* The lower poster assembles after the hero mark: boards settle with the second line of copy, then Welcome follows. */
  .hero-after,#welcome{overflow-x:clip}
  .welcome-grid{position:relative;z-index:2}
  .hero-after{overflow:visible}
  .daily-special--lunch,.daily-special--dinner{opacity:0;will-change:transform,opacity}
  .daily-special--lunch{animation:poster-board-left .9s cubic-bezier(.2,.72,.25,1) 1.65s both}
  .daily-special--dinner{animation:poster-board-right .9s cubic-bezier(.2,.72,.25,1) 1.65s both}
  @keyframes poster-board-left{from{opacity:0;transform:translateX(calc(-100% - 8vw))}to{opacity:1;transform:translateX(0)}}
  @keyframes poster-board-right{from{opacity:0;transform:translateX(calc(100% + 8vw))}to{opacity:1;transform:translateX(0)}}

  .welcome-title h2,.welcome-title__rule,.welcome-title__star,.welcome-intro,.welcome-gumby,.photo-stack,.welcome-closing{opacity:0;will-change:transform,opacity}
  .hero-after .home-specials__cta{opacity:0;transform:translateY(6px);will-change:transform,opacity;animation:poster-cta .45s ease 2.58s both}
  @keyframes poster-cta{to{opacity:1;transform:translateY(0)}}
  .welcome-title h2{animation:poster-rise .7s cubic-bezier(.2,.72,.25,1) 3.12s both}
  .welcome-title__rule,.welcome-title__star{animation-duration:.7s;animation-timing-function:cubic-bezier(.2,.72,.25,1);animation-delay:3.12s;animation-fill-mode:both}
  .welcome-title__rule:first-child,.welcome-title__star:nth-child(2){animation-name:poster-rule-left}
  .welcome-title__star:nth-child(4),.welcome-title__rule:last-child{animation-name:poster-rule-right}
  .welcome-intro{animation:poster-rise .55s cubic-bezier(.2,.72,.25,1) 3.97s both}
  .welcome-gumby{animation:poster-rise .55s cubic-bezier(.2,.72,.25,1) 4.67s both}
  .photo-stack{animation:welcome-photo-composition .8s cubic-bezier(.2,.72,.25,1) 5.37s both}
  .welcome-closing{animation:poster-rise .5s cubic-bezier(.2,.72,.25,1) 6.24s both}
  .hero-after::after{content:"";position:absolute;z-index:3;right:clamp(18px,4vw,64px);bottom:0;left:clamp(18px,4vw,64px);height:1px;background:linear-gradient(to right,transparent 0%,var(--ochre) 18%,var(--ochre) 82%,transparent 100%);opacity:.62;pointer-events:none}
  @keyframes hero-welcome-divider{to{opacity:1}}
  @keyframes poster-rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
  @keyframes welcome-photo-composition{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
