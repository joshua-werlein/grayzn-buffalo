  @media (prefers-reduced-motion:reduce){
    .daily-special--lunch,.daily-special--dinner,.hero-after .home-specials__cta,.hero-after__brand::before,.welcome-title h2,.welcome-title__rule,.welcome-title__star,.welcome-intro,.welcome-gumby,.photo-stack,.welcome-closing{animation:none;opacity:1;transform:none}
