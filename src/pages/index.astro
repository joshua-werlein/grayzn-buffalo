---
import Base from '../layouts/Base.astro';
import { getMenu, getWeeklySpecialsForDateRange, getWelcomePhotos, thumbKey, type Item, type WelcomePhoto } from '../lib/db';
import { calendarDatesFrom, calendarDayOfWeek, chicagoCalendarDate, formatWeeklyBoardDate } from '../lib/weekly-specials';

const env = (Astro.locals as any).runtime?.env ?? {};
const { categories, items } = await getMenu(env);
const today = chicagoCalendarDate();
const upcomingDates = calendarDatesFrom(today, 7);
const weeklySpecials = upcomingDates.length
  ? await getWeeklySpecialsForDateRange(env, upcomingDates[0], upcomingDates[upcomingDates.length - 1])
  : [];
const hasWeeklyContent = (day: { day_of_week: number; lunch_content: string; all_day_1_content: string; all_day_2_content: string; nightly_content: string }) => Boolean(day.lunch_content || day.all_day_1_content || day.all_day_2_content || (day.day_of_week >= 1 && day.day_of_week <= 5 && day.nightly_content));
const weeklyHomeDays = upcomingDates.flatMap((date) => {
  const weekly = weeklySpecials.find((special) => special.week_start_date <= date && special.week_end_date >= date);
  const day = weekly?.days.find((specialDay) => specialDay.day_of_week === calendarDayOfWeek(date));
  return day && hasWeeklyContent(day) ? [{ date, day }] : [];
});
const welcomePhotos = await getWelcomePhotos(env);
type WelcomeTile =
  | { source: 'client-upload'; photo: WelcomePhoto; menuItem: null }
  | { source: 'menu-fallback'; photo: WelcomePhoto; menuItem: Item };
// Welcome uploads lead; unique active menu photos fill the remainder by category.
const usedWelcomePhotoKeys = new Set<string>();
const usedWelcomeMenuItems = new Set<number>();
const welcomeTiles: WelcomeTile[] = welcomePhotos.flatMap((photo): WelcomeTile[] => {
  // Client uploads lead the photo line and always outrank menu fallbacks.
  if (!photo.photo_key || usedWelcomePhotoKeys.has(photo.photo_key)) return [];
  usedWelcomePhotoKeys.add(photo.photo_key);
  return [{ photo, source: 'client-upload' as const, menuItem: null }];
});

// The menu sequence cycles through each public category before returning for
// another photo, so a long category cannot visually monopolize the marquee.
const categoryPhotoQueues = categories.map((category) => {
  const queue = [] as typeof items;
  for (const item of items) {
    if (item.category_id !== category.id || item.active !== 1 || !item.photo_key || usedWelcomePhotoKeys.has(item.photo_key) || usedWelcomeMenuItems.has(item.id)) continue;
    usedWelcomePhotoKeys.add(item.photo_key);
    usedWelcomeMenuItems.add(item.id);
    queue.push(item);
  }
  return queue;
});
for (let round = 0; categoryPhotoQueues.some((queue) => round < queue.length); round += 1) {
  for (const queue of categoryPhotoQueues) {
    const fallback = queue[round];
    if (!fallback?.photo_key) continue;
    welcomeTiles.push({
      source: 'menu-fallback' as const,
      photo: {
        slot: welcomeTiles.length + 1,
        photo_key: fallback.photo_key,
        alt: fallback.name,
        caption: '',
        orientation: fallback.photo_orientation ?? 'portrait',
      },
      menuItem: fallback,
    });
  }
}
// The Welcome composition always has at most four HOLDERS, but a holder can cycle
// through several photos. Collect up to twelve tiles (three per holder) so there is
// enough material for the rotation in index's client script to actually rotate;
// holder count is derived separately so it never exceeds four regardless of the cap.
const cappedWelcomeTiles = welcomeTiles.slice(0, 12);
const welcomeSlotCount = Math.min(4, cappedWelcomeTiles.length);
const welcomePhotoSlots = Array.from({ length: welcomeSlotCount }, (_, slotIndex) =>
  cappedWelcomeTiles.filter((_, tileIndex) => tileIndex % welcomeSlotCount === slotIndex),
);
const welcomeHolderAssets = [
  '/images/welcome/photo1.webp',
  '/images/welcome/photo2.webp',
  '/images/welcome/photo3.webp',
  '/images/welcome/photo4.webp',
];
---
<Base>
<header class="hero" id="top">
  <h1 class="sr-only">Grayz'n Buffalo Bar &amp; Grill — Mondovi, Wisconsin</h1>
  <div class="hero-copy">
    <div class="logo-stage" aria-hidden="true">
      <img class="logo-layer logo-wordmark" src="/logo-wordmark.webp" alt="" width="900" height="605" decoding="async" />
      <div class="buffalo-video-anchor logo-layer">
        <video
          class="buffalo-video"
          autoplay
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/Kling-buffalo-hero-slow-alpha.webm" type="video/webm" />
        </video>
      </div>
    </div>
  </div>
<div class="opening-poster">
<section class="hero-after">
  <div class="hero-after__layout">
    <div class="hero-after__brand">
      <div class="logo-bar-stage" aria-hidden="true">
        <img class="logo-bar-grill" src="/logo-bar-grill.webp" alt="" width="900" height="605" decoding="async" />
      </div>
      <div class="hero-actions">
        <p class="hero-tag hero-tag-enter"><span>Open daily 10 AM to 2 AM.</span></p>
      </div>
    </div>
  </div>
</section>
</div>
</header>

<section class="home-weekly" aria-labelledby="home-weekly-title">
  <div class="home-weekly__card home-weekly__card--stacked-preview">
    <p class="home-weekly__label"><span aria-hidden="true">★</span> ALL WEEK SPECIALS <span aria-hidden="true">★</span></p>
    {weeklyHomeDays.length > 0 ? (
      <><h2 id="home-weekly-title">Upcoming Specials</h2><div class="home-weekly__days">{weeklyHomeDays.map(({ date, day }) => {
        const weekendSpecialLabel = day.day_of_week === 6 ? 'Saturday Special' : day.day_of_week === 0 ? 'Sunday Special' : 'Lunch';
        const allDaySpecials = [day.all_day_1_content, day.all_day_2_content].filter(Boolean);
        const isWeekend = day.day_of_week === 0 || day.day_of_week === 6;
        return <article class:list={['home-weekly__day', { 'is-today': date === today, 'is-weekend': isWeekend }]}>{date === today && <span class="home-weekly__today">TODAY</span>}<h3><span class="home-weekly__date-long">{formatWeeklyBoardDate(date)}</span><span class="home-weekly__date-compact">{formatWeeklyBoardDate(date, true)}</span></h3><div class="home-weekly__fields">{day.lunch_content && <section class="home-weekly__service home-weekly__service--lunch"><p class="home-weekly__field-label">{weekendSpecialLabel}</p><p class="home-weekly__field-value">{day.lunch_content}</p></section>}{allDaySpecials.length > 0 && <section class="home-weekly__service home-weekly__service--all-day"><p class="home-weekly__field-label">All Day Specials</p><div class="home-weekly__all-day-values"><div class="home-weekly__all-day-stack">{allDaySpecials.map((content, index) => <p class:list={['home-weekly__field-value', { 'has-divider': index > 0 }]}>{content}</p>)}</div></div></section>}{!isWeekend && day.nightly_content && <section class="home-weekly__service home-weekly__service--nightly"><p class="home-weekly__field-label">Nightly</p><p class="home-weekly__field-value">{day.nightly_content}</p></section>}</div></article>;
      })}</div>{weeklyHomeDays.length <= 3 && <p class="home-weekly__more-soon">More specials coming soon.</p>}</>
    ) : <><h2 id="home-weekly-title">Upcoming Specials</h2><p class="home-weekly__fallback">No specials are posted right now. Check back soon.</p></>}
    <a class="home-weekly__cta" href="/specials">MORE DETAILS <span aria-hidden="true">→</span></a>
  </div>
</section>

<section id="welcome" class="section-parchment">
  <div class="welcome-grid">
    <div class="welcome-copy">
      <div class="welcome-title">
        <span class="welcome-title__rule" aria-hidden="true"></span>
        <span class="welcome-title__star" aria-hidden="true">★</span>
        <h2>WELCOME TO GRAYZ'N BUFFALO</h2>
        <span class="welcome-title__star" aria-hidden="true">★</span>
        <span class="welcome-title__rule" aria-hidden="true"></span>
      </div>
      <p class="welcome-intro">Proudly rooted in Mondovi, Wisconsin — where the people are friendly,<br /> the stories are plentiful, and the buffalo spirit runs strong.<br /> We’re glad you’re here. Pull up a chair and make yourself at home.</p>
    </div>
    <img class="welcome-divider" src="/images/welcome/center-divider.webp" alt="" aria-hidden="true" width="700" height="233" />
    {welcomePhotoSlots.length > 0 && (
      <div class="photo-stack" role="region" aria-label="Welcome and menu photos" tabindex="0">
        {welcomePhotoSlots.map((slot, slotIndex) => (
          <div class={`photo-position photo-position--${slotIndex + 1}`}>
            <div class="photo-viewport">
            {slot.map((tile, photoIndex) => {
        const { photo, menuItem } = tile;
        const photoKey = photo.photo_key;
        if (!photoKey) return null;
        const menuAction =
          tile.source === 'menu-fallback' &&
          menuItem?.active === 1 &&
          menuItem.photo_key === photoKey
            ? {
                url: `/menu#menu-item-${menuItem.id}`,
                label: `See ${menuItem.name} on the Menu`,
              }
            : null;
        return (
          <button
            class={`photo photo--${photo.orientation}${photoIndex === 0 ? ' is-active' : ''}`}
            type="button"
            data-lightbox-src={`/img/${photoKey}`}
            data-lightbox-alt={photo.alt}
            data-lightbox-action-url={menuAction?.url}
            data-lightbox-action-label={menuAction?.label}
            aria-label={photo.alt ? `View larger photo: ${photo.alt}` : 'View larger photo'}
            aria-hidden={photoIndex === 0 ? undefined : 'true'}
            inert={photoIndex === 0 ? undefined : true}
            tabindex={photoIndex === 0 ? undefined : -1}
          >
            <img src={`/img/${thumbKey(photoKey)}`} data-full-src={`/img/${photoKey}`} alt={photo.alt} loading="lazy" />
            {photo.caption && <span>{photo.caption}</span>}
          </button>
        );
      })}
            </div>
            <img class="photo-holder" src={welcomeHolderAssets[slotIndex % welcomeHolderAssets.length]} alt="" aria-hidden="true" />
          </div>
        ))}
      </div>
    )}
    <div class="welcome-closing">
      <p class="welcome-script">
        <span class="sr-only">Good Food. Cold Drinks. Great People.</span>
        <span class="welcome-script__visual" aria-hidden="true">
          <img class="welcome-script__flourish" src="/images/welcome/side-flourish.webp" alt="" width="320" height="107" />
          <span class="welcome-script__full">Good Food. Cold Drinks. Great People.</span>
          <span class="welcome-script__compact">
            <span>Good Food.</span>
            <span>Cold Drinks.</span>
            <span>Great People.</span>
          </span>
          <img class="welcome-script__flourish welcome-script__flourish--right" src="/images/welcome/side-flourish.webp" alt="" width="320" height="107" />
        </span>
      </p>
    </div>
  </div>
</section>

<section id="menu-preview">
  <div class="section-head menu-heading reveal">
    <span class="menu-heading__rule" aria-hidden="true"></span>
    <span class="menu-heading__star" aria-hidden="true">★</span>
    <h2>The Menu</h2>
    <span class="menu-heading__star" aria-hidden="true">★</span>
    <span class="menu-heading__rule" aria-hidden="true"></span>
    <span class="kicker">From the kitchen</span>
    <p>The daily lineup while the grill's on — plus a late-night menu available after 10 PM.</p>
  </div>
  <div class="menu-cards">
    <a class="menu-card menu-card--daily reveal" href="/menu">
      <p class="menu-card__eyebrow">Kitchen Window</p>
      <h3>Daily Menu</h3>
      <p>Full kitchen while the grill is running.</p>
    </a>
    <a class="menu-card menu-card--late reveal" href="/menu#late-night">
      <p class="menu-card__eyebrow">After the Grill</p>
      <h3>Late Night</h3>
      <p>Available after 10 PM — pizza, pizza fries, appetizers.</p>
    </a>
    <a class="menu-card menu-card--specials reveal" href="/specials">
      <p class="menu-card__eyebrow">Every Day</p>
      <h3>Specials</h3>
      <p>A different deal every day — Mexican Night included.</p>
    </a>
  </div>
</section>

<section id="social" class="home-social">
  <div class="section-head social-heading">
    <span class="social-heading__rule" aria-hidden="true"></span>
    <span class="social-heading__star" aria-hidden="true">★</span>
    <h2>The Latest</h2>
    <span class="social-heading__star" aria-hidden="true">★</span>
    <span class="social-heading__rule" aria-hidden="true"></span>
    <span class="kicker">Straight from Facebook</span>
  </div>
  <div class="fb-billboard">
    <div class="fb-billboard__top"></div>
    <div class="fb-billboard__middle">
      <div class="fb-billboard__middle-slices" aria-hidden="true"></div>
      <div class="fb-grid" id="fbFeed">
        <p class="fb-unavailable">Follow us for the latest updates.<span class="fb-unavailable-arrow" aria-hidden="true">↓</span></p>
      </div>
    </div>
    <div class="fb-billboard__bottom">
      <div class="fb-bottom-actions"></div>
    </div>
  </div>
  <div class="social-cta">
    <a class="btn btn-primary" href="https://www.facebook.com/grayznbuffalo/">Follow the Grayz'n Buffalo</a>
  </div>
</section>

<Fragment slot="home-footer">
<section id="visit" class="section-tavern">
  <div class="visit-content">
  <h2 class="visit-heading reveal">Come See the Grayz'n Buffalo</h2>
  <span class="kicker visit-kicker reveal">Find us downtown</span>
  <div class="map-frame reveal">
    <iframe title="Map to Grayz'n Buffalo"
      src="https://www.google.com/maps?q=102+S+Eau+Claire+St,+Mondovi,+WI+54755&output=embed"
      loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <div class="visit-cols reveal">
    <div class="visit-block"><h3>Address</h3><p><a href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a></p></div>
    <div class="visit-block"><h3>Phone</h3><p><a href="tel:+17159264431">(715) 926-4431</a></p></div>
    <div class="visit-block"><h3>Hours</h3><p>Open daily · 10 AM – 2 AM</p></div>
  </div>
  </div>
</section>
</Fragment>
</Base>

<style>
  .hero{--hero-scene-height:min(84dvh,720px);position:relative;z-index:2;isolation:isolate;overflow:hidden;min-height:0;padding-top:var(--hero-scene-height);display:block;text-align:center;background:var(--page-parchment)}
  .hero::before{content:"";position:absolute;z-index:0;inset:0;background:url('/grayznBackground.webp') center bottom / cover no-repeat;mask-image:linear-gradient(to bottom,#000 0%,#000 70%,rgba(0,0,0,.55) 85%,transparent 97%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 70%,rgba(0,0,0,.55) 85%,transparent 97%);pointer-events:none}
  .hero::after{content:none}
  .hero-copy{position:absolute;inset:0;z-index:3;pointer-events:none}
  .logo-stage{--wordmark-y:-105px;--buffalo-y:0px;
    display:block;position:absolute;top:clamp(180px,45vw,210px);left:0;right:0;
    width:min(95%,500px);aspect-ratio:900 / 605;margin:0 auto}
  .logo-layer{position:absolute;top:var(--layer-y);left:0;width:100%;height:100%;pointer-events:none}
  .logo-wordmark{--layer-y:var(--wordmark-y);z-index:2;transform:scale(1.02);transform-origin:center;opacity:0;animation:logo-layer-fade .4s ease 1.25s forwards;will-change:opacity}
  .logo-buffalo-video{--buffalo-scale:.86;display:block;width:100%;height:100%;opacity:1;transform:scale(.2);transform-origin:center bottom;animation:buffalo-scale-charge 1.65s cubic-bezier(.16,.78,.28,1) forwards;animation-fill-mode:forwards;backface-visibility:hidden;will-change:transform}
  .logo-bar-stage{display:flex;align-items:center;justify-content:center;position:relative;width:min(80vw,360px);height:clamp(90px,20vw,150px);margin:0 auto;pointer-events:none}
  .logo-bar-grill{display:block;width:100%;height:auto;transform:translateY(5px);opacity:0;pointer-events:none;animation:logo-bar-fade .4s ease 1.65s forwards;will-change:opacity}
  .hero-after{padding:0;background:var(--cream)}
  .hero-actions{margin-top:-30px;padding:clamp(18px,4vw,28px) 24px clamp(30px,5vw,44px);text-align:center}
  .hero-tag{font-size:clamp(1.05rem,2.4vw,1.4rem);color:var(--ink);
    font-weight:600;letter-spacing:.01em}
  @media (min-width:1100px){
    .hero{--hero-scene-height:542px;min-height:0}
    .hero-copy{position:absolute;inset:0;max-width:none;margin:0;padding:0}
    .logo-stage{--wordmark-y:-74px;--buffalo-y:8px;
      display:block;position:absolute;top:190px;left:0;right:0;width:min(78vw,560px);aspect-ratio:900 / 605;margin:0 auto;pointer-events:none}
    .logo-wordmark{--layer-y:var(--wordmark-y);z-index:2;transform:scale(1.23);transform-origin:center}
    
    .logo-buffalo{--buffalo-scale:.8}
    .logo-wordmark{opacity:0;animation:logo-layer-fade .4s ease 1.25s forwards;will-change:opacity}
    .logo-bar-stage{display:flex;align-items:center;justify-content:center;position:relative;width:min(50vw,400px);height:150px;margin:0 auto;pointer-events:none}
    .logo-bar-grill{display:block;width:100%;height:auto;transform:translateY(2px);opacity:0;pointer-events:none;animation:logo-bar-fade .4s ease 1.65s forwards;will-change:opacity}
  }
  .hero-tag-enter{opacity:0;animation:hero-tag-fade .4s ease 2.15s forwards}
  @keyframes hero-tag-fade{to{opacity:1}}
  .buffalo-video-anchor {
    --layer-y: var(--buffalo-y);
    --buffalo-start-y: clamp(112px, 11vw, 144px);
    --buffalo-end-y: clamp(28px, 4vw, 56px);
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    transform: translateY(var(--buffalo-start-y));
    will-change: transform;
  }

  .buffalo-video-anchor.is-playing {
    animation: buffalo-vertical-track var(--buffalo-motion-duration, 7.2s) linear var(--buffalo-motion-delay, 0s) both;
  }

  .buffalo-video {
    display: block;
    width: 132%;
    height: auto;
    object-fit: contain;
    transform-origin:center bottom;
  }
  @keyframes buffalo-vertical-track {
    from { transform: translateY(var(--buffalo-start-y)); }
    to { transform: translateY(var(--buffalo-end-y)); }
  }
  @keyframes logo-layer-fade{to{opacity:1}}
  @keyframes logo-bar-fade{to{opacity:1}}
  .dark{background:var(--ink);color:var(--cream)}
  #welcome{padding-block:clamp(34px,5vw,58px)}
  .welcome-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(420px,1.2fr);gap:clamp(24px,3vw,42px);max-width:1240px;margin:0 auto;align-items:start}
  .welcome-copy{max-width:38ch}
  .welcome-copy h2{text-align:left}
  .welcome-copy .kicker{display:block;text-align:left}
  .welcome-copy p{margin:14px 0;color:var(--ink-2)}
  .photo-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(160px,16vw,220px);gap:12px;align-content:start}
  .photo{height:100%;max-height:220px;min-height:0;aspect-ratio:4/3;border:0;border-radius:12px;position:relative;overflow:hidden;
    background:var(--cream-2);
    box-shadow:0 10px 26px rgba(36,22,16,.22);display:flex;align-items:flex-end;transition:transform .3s ease;cursor:zoom-in}
  .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.84) sepia(.08) contrast(.94) brightness(1.04)}
  .photo:hover{transform:translateY(-6px)}
  .photo:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
  .photo span{position:relative;width:100%;padding:10px 12px;font-family:var(--label);font-weight:600;font-size:.8rem;
    letter-spacing:.12em;text-transform:uppercase;color:var(--cream);
    background:linear-gradient(transparent,rgba(36,22,16,.78))}
  .menu-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px;max-width:1120px;margin:0 auto}
  .menu-card{background:var(--cream);border-radius:14px;padding:30px 26px;border-top:6px solid var(--crimson);
    box-shadow:0 8px 22px rgba(36,22,16,.12);transition:transform .25s ease, box-shadow .25s ease}
  .menu-card:nth-child(2){border-top-color:var(--amber)}
  .menu-card:nth-child(3){border-top-color:var(--denim)}
  .menu-card:hover{transform:translateY(-7px);box-shadow:0 16px 34px rgba(36,22,16,.18)}
  .menu-card h3{font-family:var(--display);font-size:1.35rem;margin-bottom:8px}
  .menu-card p{color:var(--ink-2);font-size:.98rem;margin-bottom:16px}
  .link-arrow{font-family:var(--label);font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--btn-crimson);text-decoration:none;font-size:.92rem}
  .link-arrow:hover{text-decoration:underline}
  .section-head p a{color:var(--btn-crimson);font-weight:700;text-underline-offset:3px;text-decoration-thickness:1.5px}
  .section-head p a:hover,.section-head p a:focus-visible{color:var(--ink);text-decoration-thickness:2px}
  #social .section-head .kicker,#menu-preview .section-head .kicker{display:block;margin:-2px 0 10px}
  .visit-heading{color:var(--gold);text-align:center;max-width:900px;margin:0 auto 32px}
  .map-frame{border-radius:14px;width:100%;max-width:1100px;height:clamp(300px,42vw,440px);
    margin:0 auto;overflow:hidden;border:2px solid rgba(247,234,211,.2)}
  .map-frame iframe{display:block;width:100%;height:100%;border:0}
  .visit-cols{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,4vw,48px);
    max-width:900px;margin:38px auto 0;text-align:center;
  }
  .visit-block h3{font-family:var(--label);font-weight:700;letter-spacing:.2em;text-transform:uppercase;font-size:.85rem;color:var(--amber);margin-bottom:6px}
  .visit-block p{color:var(--cream-2);white-space:nowrap}
  .visit-block:first-child p{white-space:normal}
  .visit-block a{color:var(--gold);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px;}
  .visit-block a:hover,
  .visit-block a:focus-visible{color:var(--cream);text-decoration-thickness:2px;}
  @media (min-width:1100px) {
    .buffalo-video {
      width: 132%;
    }
  }
  @media (max-width:900px){ .welcome-grid{grid-template-columns:1fr} .welcome-copy{max-width:52ch}.photo-stack{grid-template-columns:1fr;grid-auto-rows:clamp(180px,62vw,280px)}.photo-stack .photo{max-height:280px} }
  @media (max-width:800px){ .visit-cols{grid-template-columns:1fr;gap:20px} .visit-block p{white-space:normal} }
  @media (max-width:1099px){
    .hero{--hero-scene-height:clamp(460px,55svh,500px);min-height:0}
    .logo-bar-stage{height:clamp(90px,20vw,150px)}
    .hero-actions{padding:0 20px 24px}
  }
  @media (max-width:480px){
    .hero{--hero-scene-height:max(clamp(460px,55svh,480px),min(109vw,522px));min-height:0}
