<style is:global>
  /* Feed cards are created in the browser, so these selectors must not carry Astro's scope attribute. */
  #social{position:relative;isolation:isolate;padding-block:clamp(50px,7vw,86px);background-color:var(--surface-parchment);background-image:linear-gradient(rgba(247,237,216,.64),rgba(247,237,216,.64)),linear-gradient(105deg,rgba(117,78,37,.035),transparent 28%,rgba(117,78,37,.03) 76%,transparent),url('/parchment-texture.webp');background-size:100% 100%,100% 100%,512px 512px;background-repeat:no-repeat,no-repeat,repeat}
  #social::before,#social::after{content:"";position:absolute;z-index:0;right:0;left:0;height:6px;pointer-events:none}
  #social::before{top:0;background:linear-gradient(to bottom,rgba(67,42,23,.62) 0 1px,transparent 1px 4px,rgba(104,68,34,.3) 4px 5px,transparent 5px)}
  #social::after{bottom:0;background:linear-gradient(to top,rgba(67,42,23,.62) 0 1px,transparent 1px 4px,rgba(104,68,34,.3) 4px 5px,transparent 5px)}
  #social > *{position:relative;z-index:1}
  #social .section-head{position:relative;margin-bottom:clamp(30px,4vw,48px)}
  #social .section-head::after{content:'—  ★  —';display:block;margin-top:12px;color:var(--brick);font-family:var(--label);font-size:1rem;letter-spacing:.42em;line-height:1}
  #social .fb-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(26px,3vw,44px) clamp(18px,2.4vw,32px);max-width:1320px;margin:0 auto;padding:14px 18px 24px;align-items:start}
  #social .fb-grid[data-count="1"]{max-width:390px;grid-template-columns:1fr}
  #social .fb-grid[data-count="2"]{max-width:720px;grid-template-columns:repeat(2,minmax(0,1fr))}
  #social .fb-grid[data-count="3"]{max-width:1020px;grid-template-columns:repeat(3,minmax(0,1fr))}
  /* The generated sheets are the cards themselves; only the whole sheet rotates. */
  #social .fb-card{--post-tilt:-1deg;--post-hover-tilt:-.4deg;--poster-sheet:url('/images/facebook/fb-poster-1.webp');--poster-inset:clamp(18px,1.65vw,22px);position:relative;z-index:0;display:flex;flex-direction:column;min-width:0;aspect-ratio:2 / 3;overflow:visible;padding:var(--poster-inset);background:var(--poster-sheet) center / 100% 100% no-repeat;border:0;box-shadow:2px 4px 3px rgba(65,40,22,.22),8px 15px 22px rgba(43,27,20,.24);transform:rotate(var(--post-tilt));transition:transform .2s ease,box-shadow .2s ease}
  #social .fb-card::before{display:none}
  #social .fb-card::after{content:"";position:absolute;z-index:2;top:-11px;left:50%;width:16px;height:16px;border:1px solid #4a351e;border-radius:50%;background:radial-gradient(circle at 31% 25%,#d7b465 0 11%,#a47b37 31%,#765326 58%,#48321e 100%);box-shadow:inset -2px -2px 2px rgba(52,31,14,.4),inset 1px 1px 1px rgba(238,210,133,.52),2px 4px 4px rgba(43,27,20,.48);transform:translateX(-50%);pointer-events:none}
  #social .fb-card:nth-child(4n + 2){--poster-sheet:url('/images/facebook/fb-poster-2.webp');--post-tilt:.6deg;--post-hover-tilt:.25deg;transform:translateY(-10px) rotate(var(--post-tilt))}
  #social .fb-card:nth-child(4n + 3){--poster-sheet:url('/images/facebook/fb-poster-3.webp');--post-tilt:-.4deg;--post-hover-tilt:-.15deg;transform:translateY(5px) rotate(var(--post-tilt))}
  #social .fb-card:nth-child(4n + 4){--poster-sheet:url('/images/facebook/fb-poster-4.webp');--post-tilt:.8deg;--post-hover-tilt:.35deg;transform:translateY(-4px) rotate(var(--post-tilt))}
  #social .fb-card:hover{transform:translateY(-3px) rotate(var(--post-hover-tilt));box-shadow:2px 5px 3px rgba(65,40,22,.22),10px 20px 27px rgba(43,27,20,.27)}
  #social .fb-card:nth-child(2):hover{transform:translateY(-13px) rotate(var(--post-hover-tilt))}
  #social .fb-card:nth-child(3):hover{transform:translateY(2px) rotate(var(--post-hover-tilt))}
  #social .fb-card:nth-child(4):hover{transform:translateY(-7px) rotate(var(--post-hover-tilt))}
  #social .fb-card-header{display:block;max-height:72px;overflow:auto;padding:2px 3px 6px;color:var(--ink);font-size:.92rem;line-height:1.35}
  #social .fb-card-header:empty{display:none}
  #social .fb-card-header p{margin:0;white-space:pre-line}
  /* The printed artwork and metadata stay parallel with the one rotating poster sheet. */
  #social .fb-card-header,#social .fb-media,#social .fb-media img,#social .fb-footer{transform:none}
  #social .fb-media{position:relative;z-index:0;display:grid;flex:1 1 auto;min-height:0;width:100%;margin-top:8px;padding:0;border:0;background:transparent;box-shadow:none;cursor:zoom-in}
  #social .fb-media:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
  #social .fb-media img{display:block;width:100%;height:100%;min-height:0;object-fit:contain;filter:sepia(.05) saturate(.96) contrast(.99);background:transparent}
  #social .fb-text-media{display:flex;flex:1 1 auto;align-items:center;justify-content:center;min-height:0;padding:16px;background:transparent;color:var(--ink);font-family:var(--display);font-size:clamp(1.1rem,1.6vw,1.45rem);line-height:1.25;text-align:center}
  #social .fb-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:36px;padding:6px 3px 0;color:var(--ink);font-family:var(--label);font-size:.76rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #social .fb-date{color:var(--text-muted)}
  #social .fb-post-link{color:var(--brick);text-decoration:underline;text-decoration-color:var(--ochre);text-decoration-thickness:1px;text-underline-offset:3px;white-space:nowrap}
  #social .fb-post-link:hover,#social .fb-post-link:focus-visible{color:var(--ink);text-decoration-thickness:2px}
  #social .fb-unavailable{grid-column:1 / -1;justify-self:center;width:min(100%,34rem);margin:6px auto 0;padding:30px;border:2px solid rgba(83,51,26,.55);background:#f0dfbd;box-shadow:3px 4px 0 rgba(43,27,20,.18);color:var(--text-muted);text-align:center;font-size:1.05rem}
  #social .fb-unavailable-arrow{display:block;margin-top:8px;color:var(--brick);font-family:var(--display);font-size:2rem;line-height:1}
  #social .social-cta{margin-top:clamp(30px,4vw,46px);text-align:center}
  #social .social-cta .btn{position:relative;border:1px solid rgba(238,224,196,.56);background:var(--brick);box-shadow:inset 0 1px rgba(255,255,255,.2),0 3px 0 rgba(67,30,24,.35);color:var(--cream)}
  #social .social-cta .btn::before,#social .social-cta .btn::after{content:'★';margin:0 10px;color:var(--gold);font-size:.75em}
  #social .social-cta .btn:hover,#social .social-cta .btn:focus-visible{background:var(--brick-hover);transform:translateY(-2px);box-shadow:inset 0 1px rgba(255,255,255,.2),0 5px 0 rgba(67,30,24,.35)}
  @media (max-width:1100px){#social .fb-grid,#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:760px;grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:600px){#social .fb-grid,#social .fb-grid[data-count="2"],#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:440px;grid-template-columns:1fr;gap:30px;padding-inline:22px}#social .fb-card,#social .fb-card:nth-child(n){--post-tilt:-.7deg;--post-hover-tilt:-.3deg;transform:rotate(var(--post-tilt))}#social .fb-card:nth-child(even){--post-tilt:.7deg;--post-hover-tilt:.3deg}#social .fb-card::after{top:-10px;width:15px;height:15px}#social .fb-card:hover,#social .fb-card:nth-child(n):hover{transform:translateY(-2px) rotate(var(--post-hover-tilt))}}
  @media (prefers-reduced-motion:reduce){#social .fb-card{transition:none}#social .fb-card:hover,#social .fb-card:nth-child(n):hover{transform:rotate(var(--post-tilt))}}
</style>

<script>
  document.addEventListener('error', (event) => {
    const image = event.target;
    if (image instanceof HTMLImageElement && image.matches('.photo img')) {
      image.closest<HTMLElement>('.photo')?.remove();
    }
  }, true);

  document.addEventListener('image-lightbox:open', (event) => {
    const trigger = (event as CustomEvent<{ trigger?: HTMLElement }>).detail?.trigger;
    trigger?.closest<HTMLElement>('.photo-stack')?.setAttribute('data-lightbox-paused', 'true');
  });
  document.addEventListener('image-lightbox:close', (event) => {
    const trigger = (event as CustomEvent<{ trigger?: HTMLElement }>).detail?.trigger;
    trigger?.closest<HTMLElement>('.photo-stack')?.removeAttribute('data-lightbox-paused');
  });

  const social = document.getElementById('social');
  const feed = document.getElementById('fbFeed');

  function showFacebookFallback() {
    if (!feed || !social) return;

    feed.replaceChildren();

    const message = document.createElement('p');
    message.className = 'fb-unavailable';
    message.textContent = 'Follow us for the latest updates.';

    const arrow = document.createElement('span');
    arrow.className = 'fb-unavailable-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↓';

    message.append(arrow);
    feed.append(message);

    delete feed.dataset.count;
    social.hidden = false;
  }

  function loadFacebookFeed() {
    fetch('/api/facebook-feed', {
      headers: { Accept: 'application/json' },
    })
    .then((response) => (response.ok ? response.json() : null))
    .then((payload) => {
      if (
        !feed ||
        !social ||
        !Array.isArray(payload?.posts) ||
        payload.posts.length === 0
      ) {
        showFacebookFallback();
        return;
      }

      feed.replaceChildren();

      for (const post of payload.posts.slice(0, 4)) {
        if (!post?.permalinkUrl) continue;

        const card = document.createElement('article');
        card.className = 'fb-card';

        const header = document.createElement('div');
        header.className = 'fb-card-header';

        if (post.message) {
          const caption = document.createElement('p');
          caption.textContent = post.message;
          header.append(caption);
        }

        card.append(header);

        if (post.imageUrl) {
          const media = document.createElement('button');
          media.type = 'button';
          media.className = 'fb-media';
          media.dataset.lightboxSrc = post.imageUrl;
          media.dataset.lightboxAlt = post.message ? `Facebook post: ${post.message}` : 'Facebook post image';
          media.dataset.lightboxActionUrl = post.permalinkUrl;
          media.dataset.lightboxActionLabel = 'View on Facebook';
          media.dataset.lightboxActionNewTab = 'true';
          media.setAttribute('aria-label', 'View Facebook post image larger');
          const image = document.createElement('img');
          image.src = post.imageUrl;
          image.alt = post.message ? `Facebook post: ${post.message}` : '';
          image.loading = 'lazy';
          media.append(image);
          card.append(media);
        } else {
          const fallback = document.createElement('div');
          fallback.className = 'fb-text-media';
          fallback.setAttribute('aria-hidden', 'true');
          fallback.textContent = "Grayz'n Buffalo";
          card.append(fallback);
        }

        const footer = document.createElement('div');
        footer.className = 'fb-footer';

        if (post.postedLabel) {
          const date = document.createElement('span');
          date.className = 'fb-date';
          date.textContent = post.postedLabel;
          footer.append(date);
        }

        const postLink = document.createElement('a');
        postLink.className = 'fb-post-link';
        postLink.href = post.permalinkUrl;
        postLink.target = '_blank';
        postLink.rel = 'noopener';
        postLink.textContent = 'View Post';
        footer.append(postLink);

        card.append(footer);
        feed.append(card);
      }

      if (feed.childElementCount > 0) {
        feed.dataset.count = String(feed.childElementCount);
        social.hidden = false;
      } else {
        showFacebookFallback();
      }
    })
      .catch(showFacebookFallback);
  }

  function scheduleFacebookFeed() {
    const requestIdleCallback = (globalThis as typeof globalThis & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
    }).requestIdleCallback;

    if (requestIdleCallback) {
      requestIdleCallback(loadFacebookFeed, { timeout: 4000 });
    } else {
      setTimeout(loadFacebookFeed, 1500);
    }
  }

  if (document.readyState === 'complete') {
    scheduleFacebookFeed();
  } else {
    window.addEventListener('load', scheduleFacebookFeed, { once: true });
  }
</script>
