---
import Base from '../layouts/Base.astro';
import SpecialsBoard from '../components/SpecialsBoard.astro';
import { getMenu, getWelcomePhotos, thumbKey } from '../lib/db';

const env = (Astro.locals as any).runtime?.env ?? {};
const { categories, items } = await getMenu(env);
const welcomePhotos = await getWelcomePhotos(env);
// Keep these separate from the opening strip: a stable selection of the last
// four menu photos fills any empty Welcome slot without animation or timers.
const welcomeFallbackPhotos = items
  .filter((item) => item.photo_key)
  .sort((a, b) => b.id - a.id)
  .slice(0, 4);
const welcomeTiles = welcomePhotos.map((photo, index) => {
  // A stored welcome photo key is the authoritative record of a client upload.
  // Only an empty welcome slot may borrow an active menu item's image.
  if (photo.photo_key) return { photo, source: 'client-upload' as const, menuItem: null };
  const fallback = welcomeFallbackPhotos[index];
  return fallback?.photo_key
    ? {
        source: 'menu-fallback' as const,
        photo: {
          slot: photo.slot,
          photo_key: fallback.photo_key,
          alt: fallback.name,
          caption: photo.caption,
          orientation: fallback.photo_orientation ?? 'portrait',
        },
        menuItem: fallback,
      }
    : null;
});
const visibleWelcomeTiles = welcomeTiles.filter((photo): photo is NonNullable<typeof photo> => photo !== null);
const photoGroups = categories
  .map((category) => items.filter((item) => item.category_id === category.id && item.photo_key))
  .filter((group) => group.length > 0);
const stripPhotos = [] as typeof items;
const longestPhotoGroup = Math.max(0, ...photoGroups.map((group) => group.length));

// Lead with one photo from every category, then return for each category's
// second photo, third photo, and so on. This keeps the strip varied instead
// of showing a run of similar dishes from the same menu section.
for (let position = 0; position < longestPhotoGroup; position += 1) {
  for (const group of photoGroups) {
    const item = group[position];
    if (item) stripPhotos.push(item);
  }
}
---
<Base>
<header class="hero" id="top">
  <h1 class="sr-only">Grayz'n Buffalo Bar &amp; Grill — Mondovi, Wisconsin</h1>
  <div class="hero-copy">
    <div class="logo-stage" aria-hidden="true">
      <img class="logo-layer logo-wordmark" src="/logo-wordmark.webp" alt="" width="900" height="605" decoding="async" />
      <div class="buffalo-anchor logo-layer">
        <img class="logo-buffalo" src="/logo-buffalo.webp" alt="" width="900" height="605" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</header>

<section class="hero-after">
  <div class="logo-bar-stage" aria-hidden="true">
    <img class="logo-bar-grill" src="/logo-bar-grill.webp" alt="" width="900" height="605" decoding="async" />
  </div>
  <div class="hero-actions">
    <p class="hero-tag hero-tag-enter">Burgers, Wraps, Pizzas &amp; cold ones — open daily 10 AM to 2 AM.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary hero-cta-enter hero-cta-left" href="/specials">Today's Special</a>
      <a class="btn btn-ghost hero-cta-enter hero-cta-right" href="/menu">See the Menu</a>
    </div>
  </div>

  {stripPhotos.length > 0 && (
    <div class="strip" role="region" aria-label="Menu photos" tabindex="0">
    <div class="strip-track">
      <div class="strip-sequence">
        {stripPhotos.map((item) => (
          <div class="strip-item">
            <img data-photo-route src={`/img/${thumbKey(item.photo_key!)}`} alt={item.name} width="250" height="170" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <div class="strip-sequence" aria-hidden="true">
        {stripPhotos.map((item) => (
          <div class="strip-item">
            <img data-photo-route src={`/img/${thumbKey(item.photo_key!)}`} alt="" width="250" height="170" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
    </div>
  )}
</section>

<script>
  document.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.matches('img[data-photo-route]')) return;
    if (image.dataset.photoRetried === 'true') return;

    image.dataset.photoRetried = 'true';
    const url = new URL(image.src, window.location.href);
    url.searchParams.set('retry', '1');
    image.src = url.toString();
  }, true);
</script>

<section id="specials" class="dark">
  <div class="section-head reveal">
    <h2 style="color:var(--gold)">Today's Specials</h2>
    <span class="kicker" style="color:var(--amber)">Fresh from the kitchen</span>
  </div>
  <SpecialsBoard />
</section>

<div class="checker" aria-hidden="true"></div>

<section id="welcome">
  <div class="welcome-grid">
    <div class="welcome-copy reveal">
      <h2>Small Town.<br />Big Appetite.</h2>
      <span class="kicker">Welcome</span>
      <p>Right on Eau Claire Street in downtown Mondovi. Burgers, Pizzas, Wraps, and fries in checkered paper.</p>
      <p>Longtime locals knew us as Gumby's. New name, same bar.</p>
    </div>
    {visibleWelcomeTiles.length > 0 && (
      <div class="photo-stack">
      {visibleWelcomeTiles.map((tile) => {
        const { photo, menuItem } = tile;
        const photoKey = photo.photo_key;
        if (!photoKey) return null;
        const menuAction =
          tile.source === 'menu-fallback' &&
          menuItem?.active === 1 &&
          menuItem.photo_key === photoKey
            ? {
                url: `/menu#menu-item-${menuItem.id}`,
                label: `See ${menuItem.name} on the Menu`,
              }
            : null;
        return (
          <button
            class="photo reveal welcome-photo-reveal"
            type="button"
            data-lightbox-src={`/img/${photoKey}`}
            data-lightbox-alt={photo.alt}
            data-lightbox-action-url={menuAction?.url}
            data-lightbox-action-label={menuAction?.label}
            aria-label={photo.alt ? `View larger photo: ${photo.alt}` : 'View larger photo'}
          >
            <img src={`/img/${thumbKey(photoKey)}`} alt={photo.alt} loading="lazy" />
            {photo.caption && <span>{photo.caption}</span>}
          </button>
        );
      })}
      </div>
    )}
  </div>
</section>

<div class="checker" aria-hidden="true"></div>

<section id="menu-preview" style="background:var(--cream-2)">
  <div class="section-head reveal">
    <h2>The Menu</h2>
    <span class="kicker">From the kitchen</span>
    <p>The daily lineup while the grill's on — and the late-night menu after it shuts down.</p>
  </div>
  <div class="menu-cards">
    <article class="menu-card reveal">
      <h3>Daily Menu</h3>
      <p>Full kitchen while the grill is running.</p>
      <a class="link-arrow" href="/menu">Daily menu →</a>
    </article>
    <article class="menu-card reveal">
      <h3>Late Night</h3>
      <p>After the grill shuts down, the oven keeps going — pizza, pizza fries, appetizers.</p>
      <a class="link-arrow" href="/menu#late-night">Late night menu →</a>
    </article>
    <article class="menu-card reveal">
      <h3>Specials</h3>
      <p>A different deal every day — Mexican Night included.</p>
      <a class="link-arrow" href="/specials">This week's Specials →</a>
    </article>
  </div>
</section>

<div class="checker" aria-hidden="true"></div>

<section id="social" hidden>
  <div class="section-head reveal">
    <h2>The Latest</h2>
    <span class="kicker">Straight from Facebook</span>
  </div>
  <div class="fb-grid reveal" id="fbFeed">
    <p style="text-align:center;color:var(--ink-2)">Recent posts appear here once the Facebook feed Worker is connected.</p>
  </div>
  <div style="text-align:center;margin-top:34px" class="reveal">
    <a class="btn btn-primary" href="https://www.facebook.com/grayznbuffalo/">Follow the Grayz'n Buffalo</a>
  </div>
</section>

<section id="visit" class="dark">
  <h2 class="visit-heading reveal">Come See the Grayz'n Buffalo</h2>
  <div class="map-frame reveal">
    <iframe title="Map to Grayz'n Buffalo"
      src="https://www.google.com/maps?q=102+S+Eau+Claire+St,+Mondovi,+WI+54755&output=embed"
      loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <div class="visit-cols reveal">
    <div class="visit-block"><h3>Address</h3><p><a href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a></p></div>
    <div class="visit-block"><h3>Phone</h3><p><a href="tel:+17159264431">(715) 926-4431</a></p></div>
    <div class="visit-block"><h3>Hours</h3><p>Open daily · 10 AM – 2 AM</p></div>
  </div>
</section>
</Base>

<style>
  .hero{position:relative;overflow:hidden;min-height:min(84vh,720px);
    min-height:min(84dvh,720px);
    display:flex;align-items:flex-end;justify-content:center;text-align:center;
    background:url('/grayznBackground.webp') center bottom / cover no-repeat}
  .hero-copy{position:absolute;inset:0;z-index:3;pointer-events:none}
  .logo-stage{--wordmark-y:-105px;--buffalo-y:0px;
    display:block;position:absolute;top:clamp(180px,45vw,210px);left:0;right:0;
    width:min(95vw,500px);aspect-ratio:900 / 605;margin:0 auto}
  .logo-layer{position:absolute;top:var(--layer-y);left:0;width:100%;height:100%;pointer-events:none}
  .logo-wordmark{--layer-y:var(--wordmark-y);z-index:2;transform:scale(1.02);transform-origin:center;opacity:0;animation:logo-layer-fade .4s ease 1.65s forwards;will-change:opacity}
  .buffalo-anchor{--layer-y:var(--buffalo-y);--buffalo-anchor-start-y:-64px;--buffalo-anchor-24-y:-49.05px;--buffalo-anchor-48-y:-34.11px;--buffalo-anchor-72-y:-19.16px;--buffalo-anchor-final-y:-1.72px;z-index:1;transform:translateY(var(--buffalo-anchor-start-y));animation:buffalo-anchor-charge 1.65s cubic-bezier(.16,.78,.28,1) forwards;animation-fill-mode:forwards;will-change:transform}
  .logo-buffalo{--buffalo-scale:.86;display:block;width:100%;height:100%;opacity:1;transform:scale(.2);transform-origin:center bottom;animation:buffalo-scale-charge 1.65s cubic-bezier(.16,.78,.28,1) forwards;animation-fill-mode:forwards;backface-visibility:hidden;will-change:transform}
  .logo-bar-stage{display:block;position:relative;width:min(95vw,500px);height:58px;margin:0 auto;pointer-events:none}
  .logo-bar-grill{display:block;width:100%;height:auto;transform:translateY(-78.5%) scale(1.04);transform-origin:center 78.5%;opacity:0;pointer-events:none;animation:logo-bar-fade .4s ease 1.95s forwards;will-change:opacity}
  .hero-after{padding:0;background:var(--cream)}
  .hero-actions{padding:clamp(18px,4vw,28px) 24px clamp(30px,5vw,44px);text-align:center}
  .hero-tag{font-size:clamp(1.05rem,2.4vw,1.4rem);color:var(--ink);
    font-weight:600;letter-spacing:.01em}
  .hero-ctas{margin-top:22px;display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  @media (min-width:1100px){
    .hero{min-height:542px}
    .hero-copy{position:absolute;inset:0;max-width:none;margin:0;padding:0}
    .logo-stage{--wordmark-y:-74px;--buffalo-y:8px;
      display:block;position:absolute;top:190px;left:0;right:0;width:min(78vw,560px);aspect-ratio:900 / 605;margin:0 auto;pointer-events:none}
    .logo-wordmark{--layer-y:var(--wordmark-y);z-index:2;transform:scale(1.23);transform-origin:center}
    .buffalo-anchor{--layer-y:var(--buffalo-y);--buffalo-anchor-start-y:-96px;--buffalo-anchor-24-y:-74.88px;--buffalo-anchor-48-y:-53.76px;--buffalo-anchor-72-y:-32.64px;--buffalo-anchor-final-y:-8px;z-index:1}
    .logo-buffalo{--buffalo-scale:.8}
    .logo-wordmark{opacity:0;animation:logo-layer-fade .4s ease 1.65s forwards;will-change:opacity}
    .logo-bar-stage{--bar-y:10px;display:block;position:relative;width:min(78vw,560px);height:90px;margin:0 auto;pointer-events:none}
    .logo-bar-grill{display:block;width:100%;height:auto;transform:translateY(calc(-78.5% + var(--bar-y))) scale(1.15);transform-origin:center 78.5%;opacity:0;pointer-events:none;animation:logo-bar-fade .4s ease 1.95s forwards;will-change:opacity}
  }
  .hero-tag-enter{opacity:0;animation:hero-tag-fade .4s ease 2.25s forwards}
  .hero-cta-enter{opacity:1;animation:hero-cta-slide 1.8s cubic-bezier(.08,.9,.2,1) 2.25s forwards}
  .hero-cta-left{transform:translateX(-100vw)}
  .hero-cta-right{transform:translateX(100vw)}
  @keyframes hero-tag-fade{to{opacity:1}}
  @keyframes hero-cta-slide{to{opacity:1;transform:translateX(0)}}
  @keyframes buffalo-anchor-charge{
    0%{transform:translateY(var(--buffalo-anchor-start-y))}
    24%{transform:translateY(var(--buffalo-anchor-24-y));animation-timing-function:cubic-bezier(.15,.8,.45,1)}
    48%{transform:translateY(var(--buffalo-anchor-48-y));animation-timing-function:linear}
    72%{transform:translateY(var(--buffalo-anchor-72-y));animation-timing-function:cubic-bezier(.2,.7,.65,.9)}
    100%{transform:translateY(var(--buffalo-anchor-final-y))}
  }
  @keyframes buffalo-scale-charge{
    0%{transform:scale(.2)}
    24%{transform:scale(.32);animation-timing-function:cubic-bezier(.15,.8,.45,1)}
    48%{transform:scale(.6);animation-timing-function:linear}
    72%{transform:scale(.74);animation-timing-function:cubic-bezier(.2,.7,.65,.9)}
    100%{transform:scale(var(--buffalo-scale))}
  }
  @keyframes logo-layer-fade{to{opacity:1}}
  @keyframes logo-bar-fade{to{opacity:1}}
  .strip{background:var(--ink);padding:18px 0;overflow:hidden}
  .strip-track{display:flex;width:max-content;animation:slide 36s linear infinite}
  .strip-sequence{display:flex;gap:16px;padding-right:16px;flex:none}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .strip-item{width:250px;height:170px;border-radius:10px;overflow:hidden;flex:none;
    border:3px solid var(--cream);box-shadow:0 6px 16px rgba(0,0,0,.4);
    position:relative;background:linear-gradient(150deg,var(--amber),var(--crimson))}
  .strip-item img{width:100%;height:100%;object-fit:cover;display:block}
  .strip-item.ph{display:flex;align-items:center;justify-content:center;
    font-family:var(--label);font-weight:600;font-size:.75rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--cream);text-shadow:0 1px 6px rgba(0,0,0,.5)}
  .dark{background:var(--ink);color:var(--cream)}
  #welcome{padding-block:clamp(34px,5vw,58px)}
  .welcome-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(420px,1.2fr);gap:clamp(24px,3vw,42px);max-width:1240px;margin:0 auto;align-items:start}
  .welcome-copy{max-width:38ch}
  .welcome-copy h2{text-align:left}
  .welcome-copy .kicker{display:block;text-align:left}
  .welcome-copy p{margin:14px 0;color:var(--ink-2)}
  .photo-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(160px,16vw,220px);gap:12px;align-content:start}
  .photo{height:100%;max-height:220px;min-height:0;aspect-ratio:4/3;border:0;border-radius:12px;position:relative;overflow:hidden;
    background:var(--cream-2);
    box-shadow:0 10px 26px rgba(36,22,16,.22);display:flex;align-items:flex-end;transition:transform .3s ease;cursor:zoom-in}
  .photo.welcome-photo-reveal{opacity:0;transform:translateX(56px);transition:opacity .65s ease,transform .65s cubic-bezier(.19,.74,.36,1)}
  .photo.welcome-photo-reveal.in{opacity:1;transform:translateX(0)}
  .photo.welcome-photo-reveal:nth-child(2){transition-delay:.14s}
  .photo.welcome-photo-reveal:nth-child(3){transition-delay:.28s}
  .photo.welcome-photo-reveal:nth-child(4){transition-delay:.42s}
  .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .photo:hover{transform:translateY(-6px)}
  .photo.welcome-photo-reveal.in:hover{transform:translateY(-6px)}
  .photo:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
  .photo span{position:relative;width:100%;padding:10px 12px;font-family:var(--label);font-weight:600;font-size:.8rem;
    letter-spacing:.12em;text-transform:uppercase;color:var(--cream);
    background:linear-gradient(transparent,rgba(36,22,16,.78))}
  .menu-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px;max-width:1120px;margin:0 auto}
  .menu-card{background:var(--cream);border-radius:14px;padding:30px 26px;border-top:6px solid var(--crimson);
    box-shadow:0 8px 22px rgba(36,22,16,.12);transition:transform .25s ease, box-shadow .25s ease}
  .menu-card:nth-child(2){border-top-color:var(--amber)}
  .menu-card:nth-child(3){border-top-color:var(--denim)}
  .menu-card:hover{transform:translateY(-7px);box-shadow:0 16px 34px rgba(36,22,16,.18)}
  .menu-card h3{font-family:var(--display);font-size:1.35rem;margin-bottom:8px}
  .menu-card p{color:var(--ink-2);font-size:.98rem;margin-bottom:16px}
  .link-arrow{font-family:var(--label);font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--btn-crimson);text-decoration:none;font-size:.92rem}
  .link-arrow:hover{text-decoration:underline}
  .section-head p a{color:var(--btn-crimson);font-weight:700;text-underline-offset:3px;text-decoration-thickness:1.5px}
  .section-head p a:hover,.section-head p a:focus-visible{color:var(--ink);text-decoration-thickness:2px}
  #social .section-head .kicker,#menu-preview .section-head .kicker{display:block;margin:-2px 0 10px}
  .visit-heading{color:var(--gold);text-align:center;max-width:900px;margin:0 auto 32px}
  .map-frame{border-radius:14px;width:100%;max-width:1100px;height:clamp(300px,42vw,440px);
    margin:0 auto;overflow:hidden;border:2px solid rgba(247,234,211,.2)}
  .map-frame iframe{display:block;width:100%;height:100%;border:0}
  .visit-cols{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,4vw,48px);
    max-width:900px;margin:38px auto 0;text-align:center;
  }
  .visit-block h3{font-family:var(--label);font-weight:700;letter-spacing:.2em;text-transform:uppercase;font-size:.85rem;color:var(--amber);margin-bottom:6px}
  .visit-block p{color:var(--cream-2);white-space:nowrap}
  .visit-block:first-child p{white-space:normal}
  .visit-block a{color:var(--gold);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px;}
  .visit-block a:hover,
  .visit-block a:focus-visible{color:var(--cream);text-decoration-thickness:2px;}
  @media (max-width:900px){ .welcome-grid{grid-template-columns:1fr} .welcome-copy{max-width:52ch}.photo-stack{grid-template-columns:1fr;grid-auto-rows:clamp(180px,62vw,280px)}.photo-stack .photo{max-height:280px} }
  @media (max-width:800px){ .visit-cols{grid-template-columns:1fr;gap:20px} .visit-block p{white-space:normal} }
  @media (max-width:1099px){
    .hero{min-height:clamp(460px,55svh,500px);background-position:center bottom}
    .logo-bar-stage{height:50px}
    .hero-actions{padding:12px 20px 24px}
    .hero-ctas{margin-top:14px;gap:12px;flex-wrap:nowrap}
    .hero-ctas .btn{padding:12px 18px;font-size:.92rem}
  }
  @media (max-width:480px){ .hero{min-height:clamp(460px,55svh,480px)} }
  @media (prefers-reduced-motion: reduce){
    .hero-tag-enter,.hero-cta-enter,.strip-track{animation:none;opacity:1;transform:none}
    .buffalo-anchor{animation:none;transform:translateY(var(--buffalo-anchor-final-y))}
    .logo-buffalo{animation:none;opacity:1;transform:scale(var(--buffalo-scale))}
    .logo-wordmark{animation:none;opacity:1}
    .logo-bar-grill{animation:none;opacity:1}
    .strip{overflow-x:auto;overscroll-behavior-x:contain}
    .strip-sequence[aria-hidden="true"]{display:none}
    .photo.welcome-photo-reveal{opacity:1;transform:none;transition:none}
  }
  @media (hover: hover) and (pointer: fine){
    .strip:hover .strip-track,
    .strip:focus .strip-track{animation-play-state:paused}
    .strip:focus-visible{outline:2px solid var(--cream);outline-offset:-2px}
  }
</style>

<style is:global>
  /* Feed cards are created in the browser, so these selectors must not carry Astro's scope attribute. */
  #social .fb-grid{display:grid;grid-template-columns:repeat(4,minmax(280px,1fr));gap:22px;max-width:1360px;margin:0 auto;align-items:stretch}
  #social .fb-grid[data-count="1"]{max-width:400px;grid-template-columns:1fr}
  #social .fb-grid[data-count="2"]{max-width:820px;grid-template-columns:repeat(2,minmax(280px,1fr))}
  #social .fb-grid[data-count="3"]{max-width:1020px;grid-template-columns:repeat(3,minmax(280px,1fr))}
  #social .fb-card{height:100%;overflow:hidden;border:0;border-top:6px solid var(--flame);border-radius:14px;background:var(--cream-2);box-shadow:0 8px 22px rgba(36,22,16,.12);transition:transform .25s ease,box-shadow .25s ease}
  #social .fb-card:nth-child(2){border-top-color:var(--denim)}
  #social .fb-card:nth-child(3){border-top-color:var(--amber)}
  #social .fb-card:nth-child(4){border-top-color:var(--crimson)}
  #social .fb-card:hover{transform:translateY(-7px);box-shadow:0 16px 34px rgba(36,22,16,.18)}
  #social .fb-card-header{display:flex;flex:none;align-items:center;min-height:64px;max-height:180px;overflow:auto;padding:13px 16px;background:var(--cream-2);color:var(--ink)}
  #social .fb-card-header p{margin:0;white-space:pre-line;font-size:.96rem;font-weight:500;line-height:1.38}
  #social .fb-media{display:block;flex:1 1 auto;width:100%;padding:0;border:0;background:var(--cream-2);cursor:zoom-in}
  #social .fb-media:focus-visible{outline:3px solid var(--gold);outline-offset:-3px}
  #social .fb-media img{display:block;width:100%;height:clamp(340px,31vw,460px);object-fit:contain;background:var(--cream-2)}
  #social .fb-text-media{display:flex;flex:1 1 auto;align-items:center;justify-content:center;height:clamp(340px,31vw,460px);padding:24px;background:var(--cream-2);color:var(--ink);font-family:var(--display);font-size:clamp(1.2rem,2vw,1.7rem);line-height:1.25;text-align:center}
  #social .fb-footer{display:flex;flex:none;align-items:center;justify-content:center;min-height:54px;padding:10px 14px;background:var(--cream-2);text-align:center}
  #social .fb-footer .fb-date{font-family:var(--label);font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--ink);font-size:.85rem;line-height:1.1}
  #social .fb-unavailable{grid-column:1 / -1;justify-self:center;width:min(100%,36rem);margin:4px auto 10px;padding:28px;display:flex;border-radius:14px;flex-direction:column;align-items:center;gap:8px;background:var(--cream-2);box-shadow:0 8px 22px rgba(36,22,16,.12);color:var(--ink-2);text-align:center;font-size:1.05rem;}
  #social .fb-unavailable-arrow{color:var(--btn-crimson);font-family:var(--display);font-size:2rem;line-height:1;}
  @media (max-width:1180px){#social .fb-grid,#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:820px;grid-template-columns:repeat(2,minmax(280px,1fr))}}
  @media (max-width:650px){#social .fb-grid,#social .fb-grid[data-count="2"],#social .fb-grid[data-count="3"],#social .fb-grid[data-count="4"]{max-width:400px;grid-template-columns:1fr}#social .fb-media img,#social .fb-text-media{height:clamp(320px,110vw,440px)}}
</style>

<script>
  const social = document.getElementById('social');
  const feed = document.getElementById('fbFeed');

  function showFacebookFallback() {
    if (!feed || !social) return;

    feed.replaceChildren();

    const message = document.createElement('p');
    message.className = 'fb-unavailable';
    message.textContent = 'Follow us for the latest updates.';

    const arrow = document.createElement('span');
    arrow.className = 'fb-unavailable-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↓';

    message.append(arrow);
    feed.append(message);

    delete feed.dataset.count;
    social.hidden = false;
  }

  function loadFacebookFeed() {
    fetch('/api/facebook-feed', {
      headers: { Accept: 'application/json' },
    })
    .then((response) => (response.ok ? response.json() : null))
    .then((payload) => {
      if (
        !feed ||
        !social ||
        !Array.isArray(payload?.posts) ||
        payload.posts.length === 0
      ) {
        showFacebookFallback();
        return;
      }

      feed.replaceChildren();

      for (const post of payload.posts) {
        if (!post?.permalinkUrl) continue;

        const card = document.createElement('article');
        card.className = 'fb-card';

        const header = document.createElement('div');
        header.className = 'fb-card-header';

        if (post.message) {
          const caption = document.createElement('p');
          caption.textContent = post.message;
          header.append(caption);
        }

        card.append(header);

        if (post.imageUrl) {
          const media = document.createElement('button');
          media.type = 'button';
          media.className = 'fb-media';
          media.dataset.lightboxSrc = post.imageUrl;
          media.dataset.lightboxAlt = post.message ? `Facebook post: ${post.message}` : 'Facebook post image';
          media.dataset.lightboxActionUrl = post.permalinkUrl;
          media.dataset.lightboxActionLabel = 'View on Facebook';
          media.dataset.lightboxActionNewTab = 'true';
          media.setAttribute('aria-label', 'View Facebook post image larger');
          const image = document.createElement('img');
          image.src = post.imageUrl;
          image.alt = post.message ? `Facebook post: ${post.message}` : '';
          image.loading = 'lazy';
          media.append(image);
          card.append(media);
        } else {
          const fallback = document.createElement('div');
          fallback.className = 'fb-text-media';
          fallback.setAttribute('aria-hidden', 'true');
          fallback.textContent = "Grayz'n Buffalo";
          card.append(fallback);
        }

        const footer = document.createElement('div');
        footer.className = 'fb-footer';

        if (post.postedLabel) {
          const date = document.createElement('span');
          date.className = 'fb-date';
          date.textContent = post.postedLabel;
          footer.append(date);
        }

        card.append(footer);
        feed.append(card);
      }

      if (feed.childElementCount > 0) {
        feed.dataset.count = String(feed.childElementCount);
        social.hidden = false;
      } else {
        showFacebookFallback();
      }
    })
      .catch(showFacebookFallback);
  }

  function scheduleFacebookFeed() {
    const requestIdleCallback = (globalThis as typeof globalThis & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
    }).requestIdleCallback;

    if (requestIdleCallback) {
      requestIdleCallback(loadFacebookFeed, { timeout: 4000 });
    } else {
      setTimeout(loadFacebookFeed, 1500);
    }
  }

  if (document.readyState === 'complete') {
    scheduleFacebookFeed();
  } else {
    window.addEventListener('load', scheduleFacebookFeed, { once: true });
  }
</script>
