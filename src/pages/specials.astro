---
import Base from '../layouts/Base.astro';
import { getSpecials, getSetting } from '../lib/db';

const env = (Astro.locals as any).runtime?.env ?? {};
const [specials, deliveryPaused] = await Promise.all([
  getSpecials(env),
  getSetting(env, 'delivery_paused', '0'),
]);

const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const week = [...specials].sort((a, b) => a.day_of_week - b.day_of_week);
const deliveryPausedFlag = deliveryPaused === '1';

// Recurring deals — hardcoded constants (stable, like delivery). No prices.
const recurring = [
  { name: 'Lunch Specials', when: '11 AM – 1:30 PM' },
  { name: 'Nightly Specials', when: '5 – 10 PM' },
  { name: 'Happy Hour', when: 'Mon–Fri · 5 – 6:30 PM' },
  { name: 'Mexican Night', when: 'Tuesdays · 5 – 10 PM' },
];
---
<Base
  title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI"
  description="This week's daily specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI — a different deal every day, plus Mexican Night on Tuesdays, happy hour, lunch and nightly specials."
>
<section class="specials-page">
  <div class="section-head">
    <h2>This Week's Specials</h2>
    <span class="kicker">Fresh from the kitchen</span>
    <p>A different deal every day of the week. Staff post the details to Facebook — this is the full lineup.</p>
  </div>

  <!-- ── The whole week, all at once ─────────────────────────────── -->
  <ul class="week" aria-label="Daily specials">
    {week.map((s) => (
      <li class="day-card" data-day={s.day_of_week}>
        <span class="day-name">{DAYS[s.day_of_week]}</span>
        <div class="day-services">
          <section class="day-service lunch-service">
            <p class="service-label">Lunch Special <span>11 AM–1:30 PM</span></p>
            <h3>{s.lunch_name || 'Lunch special'}</h3>
            <p class="day-desc">{s.lunch_description || 'Ask at the bar about today’s lunch special.'}</p>
            {s.lunch_tag && <span class="tag-pill">{s.lunch_tag}</span>}
          </section>
          <section class="day-service night-service">
            <p class="service-label">Nightly Special <span>5–10 PM</span></p>
            <h3>{s.night_name || 'Nightly special'}</h3>
            <p class="day-desc">{s.night_description || 'Ask at the bar about tonight’s special.'}</p>
            {s.night_tag && <span class="tag-pill">{s.night_tag}</span>}
          </section>
        </div>
      </li>
    ))}
  </ul>

  <!-- ── Every week (recurring) ──────────────────────────────────── -->
  <div class="recurring-head">
    <span class="kicker">Every week</span>
    <h3 class="recurring-title">On the regular</h3>
  </div>
  <ul class="recurring" aria-label="Recurring specials">
    {recurring.map((r) => (
      <li class="rec-card">
        <span class="rec-name">{r.name}</span>
        <span class="rec-when">{r.when}</span>
      </li>
    ))}
  </ul>

  <!-- ── Delivery (mirrors the pause switch) ─────────────────────── -->
  <div class={`delivery-block${deliveryPausedFlag ? ' paused' : ''}`}>
    {deliveryPausedFlag ? (
      <p><strong>Delivery is paused right now</strong> — call us for details.</p>
    ) : (
      <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>
    )}
  </div>

  <!-- ── CTA ─────────────────────────────────────────────────────── -->
  <div class="specials-cta">
    <a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a>
    <a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a>
  </div>
</section>
</Base>

<script>
  // Mark today from the visitor's local clock (server time is UTC).
  const today = new Date().getDay();
  const card = document.querySelector(`.day-card[data-day="${today}"]`);
  if (card) {
    card.classList.add('is-today');
    card.parentElement?.prepend(card);
    const badge = document.createElement('span');
    badge.className = 'today-badge';
    badge.textContent = 'Today';
    card.prepend(badge);
  }
</script>

<style>
  .specials-page{background:var(--ink);color:var(--cream);min-height:70vh;padding-top:clamp(28px,4vw,48px)}
  .specials-page .section-head .kicker{color:var(--amber)}
  .specials-page .section-head h2{color:var(--gold)}
  .specials-page .section-head p{color:var(--cream-2)}

  /* ── week grid ── */
  .week{list-style:none;margin:0 auto;padding:0;max-width:1120px;
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .day-card{position:relative;background:#2c1c13;border:1px solid rgba(247,234,211,.14);
    border-radius:14px;padding:22px 24px;
    box-shadow:0 6px 18px rgba(0,0,0,.3)}
  .day-name{font-family:var(--label);font-weight:700;letter-spacing:.18em;
    text-transform:uppercase;font-size:.8rem;color:var(--amber)}
  .day-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:12px}
  .day-service{padding:13px;border-radius:9px;background:rgba(0,0,0,.13);border-top:4px solid var(--amber)}
  .day-service.night-service{border-top-color:var(--crimson)}
  .service-label{font-family:var(--label);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-size:.76rem}
  .service-label span{display:block;color:var(--cream-2);font-size:.68rem;letter-spacing:.07em;margin-top:2px}
  .day-card h3{font-family:var(--display);font-weight:400;font-size:1.18rem;
    line-height:1.15;color:var(--cream)}
  .day-desc{color:var(--cream-2);font-size:.95rem;margin:0}
  .tag-pill{align-self:flex-start;margin-top:4px;font-family:var(--label);font-weight:700;
    letter-spacing:.1em;text-transform:uppercase;font-size:.72rem;
    background:var(--gold);color:var(--ink);padding:4px 12px;border-radius:999px}

  /* today */
  .day-card.is-today{grid-column:1 / -1;max-width:820px;width:100%;justify-self:center;
    border-color:var(--gold);box-shadow:0 0 0 2px var(--gold),0 8px 22px rgba(0,0,0,.4)}
  .today-badge{position:absolute;top:-10px;right:14px;font-family:var(--label);font-weight:700;
    letter-spacing:.12em;text-transform:uppercase;font-size:.68rem;
    background:var(--crimson);color:#fff5e9;padding:3px 12px;border-radius:999px;
    box-shadow:0 3px 8px rgba(0,0,0,.35)}

  /* ── recurring ── */
  .recurring-head{text-align:center;max-width:760px;margin:56px auto 22px}
  .recurring-head .kicker{color:var(--amber)}
  .recurring-title{font-family:var(--display);font-weight:400;color:var(--gold);
    font-size:clamp(1.5rem,3.5vw,2.1rem);margin-top:6px}
  .recurring{list-style:none;margin:0 auto;padding:0;max-width:1120px;
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
  .rec-card{background:transparent;border:1.5px solid rgba(255,182,39,.4);
    border-radius:12px;padding:18px 20px;text-align:center;
    display:flex;flex-direction:column;gap:5px}
  .rec-name{font-family:var(--display);font-weight:400;font-size:1.15rem;color:var(--cream)}
  .rec-when{font-family:var(--label);font-weight:600;letter-spacing:.06em;
    text-transform:uppercase;font-size:.82rem;color:var(--amber)}

  /* ── delivery ── */
  .delivery-block{max-width:820px;margin:44px auto 0;text-align:center;
    background:rgba(255,210,63,.12);border:1.5px solid var(--gold);
    border-radius:12px;padding:16px 22px}
  .delivery-block p{margin:0;color:var(--cream);font-size:1.02rem}
  .delivery-block strong{color:var(--gold)}
  .delivery-block.paused{background:rgba(215,38,61,.14);border-color:var(--crimson)}
  .delivery-block.paused strong{color:#ff9fae}

  /* ── cta ── */
  .specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:44px auto 0}

  @media (max-width:680px){
    .week{grid-template-columns:1fr}
    .day-card.is-today{grid-column:auto}
    .day-services{grid-template-columns:1fr}
  }
</style>
