---
import Base from '../layouts/Base.astro';
import SpecialGroup from '../components/SpecialGroup.astro';
import MexicanNightMenu from '../components/MexicanNightMenu.astro';
import { getSetting } from '../lib/db';
import { getWeeklySpecialsForDateRange, getMexicanNight, visibleGroups, DAY_NAMES } from '../lib/specials-store';
import { chicagoCalendarDate, formatWeeklyDateRange } from '../lib/weekly-specials';
const env = (Astro.locals as any).runtime?.env ?? {};
const today=chicagoCalendarDate();
const [weeklySpecials,deliveryDisplay,mexican]=await Promise.all([getWeeklySpecialsForDateRange(env,today,'9999-12-31'),getSetting(env,'delivery_display','available'),getMexicanNight(env)]);
const weekDateFor=(start:string,dow:number) => {const date=new Date(`${start}T12:00:00Z`); date.setUTCDate(date.getUTCDate()+((dow-date.getUTCDay()+7)%7)); return date.toISOString().slice(0,10);};
const weeks=weeklySpecials.flatMap(week=>{
  const days=[0,1,2,3,4,5,6].map(day=>({day,date:weekDateFor(week.week_start_date,day),groups:visibleGroups(week.collection.groups,day)}))
    .filter(day=>day.date>=today && day.date<=week.week_end_date && day.groups.length).sort((a,b)=>a.date.localeCompare(b.date));
  return days.length ? [{...week,days}] : [];
});
const mexicanGroups=mexican ? visibleGroups(mexican.groups) : [];

// Show the detailed Mexican Night section Sun–Tue all day and Wed before 2 AM Chicago time.
// The recurring "Mexican Night" card stays visible all week regardless.
const mexicanNightVisible = (() => {
  if (!mexican || mexicanGroups.length === 0) return false;
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    weekday: 'short',
    hour: 'numeric',
    hour12: false,
  }).formatToParts(new Date());
  const dayStr = parts.find(p => p.type === 'weekday')?.value ?? '';
  const hourStr = parts.find(p => p.type === 'hour')?.value ?? '0';
  const hour = parseInt(hourStr, 10) % 24;
  const day = ({Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6} as Record<string,number>)[dayStr] ?? 0;
  // Visible: Sun(0) Mon(1) Tue(2) all day; Wed(3) before 2 AM
  return day <= 2 || (day === 3 && hour < 2);
})();

const recurring=[{name:'Lunch Specials',when:'11 AM – 1:30 PM'},{name:'Nightly Specials',when:'5 – 10 PM'},{name:'Friday Fish',when:'Fridays · 5 – 10 PM'},{name:'Happy Hour',when:'Mon–Fri · 5 – 6:30 PM'},{name:'Mexican Night',when:mexican?.schedule || 'Tuesdays · 5 – 10 PM'}];
---
<Base title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI" description="This week's and upcoming specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI.">
<section class="specials-page">
  <div class="section-head interior-heading"><span class="kicker">Fresh from the kitchen</span><h1>Weekly Specials</h1><span class="vintage-rule" aria-hidden="true"/></div>
  {weeks.length ? weeks.map((week,index)=>{
    const range=formatWeeklyDateRange(week.week_start_date,week.week_end_date);
    const current=week.week_start_date.localeCompare(today)!==1 && week.week_end_date.localeCompare(today)!==-1;
    const label=current ? 'This Week' : index===0 || (index===1 && weeks[0].week_start_date.localeCompare(today)!==1) ? 'Next Week' : '';
    return <section class="week-block" aria-labelledby={`week-heading-${week.id}`}><h2 class="week-block__heading" id={`week-heading-${week.id}`}>{label ? `${label} · ${range}` : range}</h2><ul class="week" aria-label={`Weekly specials, ${range}`}>{week.days.map(({day,date,groups})=><li class:list={['day-card',{'is-today':date===today}]}><div class="day-header"><span class="day-name">{DAY_NAMES[day]}</span>{date===today && <span class="today-badge">Today</span>}</div><div class="normalized-services">{groups.map(group=><SpecialGroup group={group} mexicanAvailable={mexicanNightVisible}/>)}</div></li>)}</ul></section>;
  }) : <div class="weekly-notice" role="status"><strong>No current weekly specials are posted.</strong><p>Please check Facebook or call us for the current specials.</p></div>}
  {mexicanNightVisible && <div id="mexican-night" class="section-anchor"></div>}
  {mexicanNightVisible && <section class="mexican-menu" aria-labelledby="mexican-heading"><div class="section-head"><h2 id="mexican-heading">{mexican!.title}</h2>{mexican!.schedule && <p>{mexican!.schedule}</p>}</div><MexicanNightMenu groups={mexicanGroups}/></section>}
  <div class="recurring-head"><span class="kicker">Every week</span><h3 class="recurring-title">On the regular</h3></div>
  <ul class="recurring" aria-label="Recurring specials">{recurring.map(item=><li class="rec-card"><span class="rec-name">{item.name==='Mexican Night' && mexicanNightVisible ? <a href="#mexican-night">{item.name}</a> : item.name}</span><span class="rec-when">{item.when}</span></li>)}</ul>
  {deliveryDisplay!=='hidden' && <div class:list={['delivery-block',{paused:deliveryDisplay==='unavailable'}]}>{deliveryDisplay==='unavailable' ? <p><strong>Delivery is unavailable at this time</strong> — call us for details.</p> : <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>}</div>}
  <div class="specials-cta"><a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a><a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a></div>
</section>
</Base>
<style>
  /* ── Page background: matches menu-top exactly ─────────────────────────── */
  .specials-page{
    --footer-blend-height:clamp(40px,3vw,56px);
    position:relative;color:var(--text);min-height:70vh;
    padding:clamp(28px,5vw,68px) clamp(14px,4vw,56px) calc(var(--footer-blend-height) + clamp(12px,1.5vw,20px));
    background-color:var(--surface-parchment);
    background-image:linear-gradient(to bottom,rgba(91,50,24,.08) 0,rgba(91,50,24,.08) calc(100% - var(--footer-blend-height)),rgba(91,50,24,0) 100%),url('/parchment-texture.webp');
    background-position:center top,left bottom;
    background-size:auto,512px 512px;
    background-repeat:no-repeat,repeat;
  }

  /* ── Interior heading ──────────────────────────────────────────────────── */
  .interior-heading{margin-bottom:clamp(18px,3vw,30px)}
  .interior-heading .kicker{display:block;color:var(--brick);font-size:.82rem}
  .interior-heading h1{
    margin:8px 0 5px;color:#291912;
    font-size:clamp(2.4rem,6vw,5rem);
    line-height:.98;letter-spacing:.025em;text-transform:uppercase;
  }
  .interior-heading .vintage-rule{
    width:min(100%,28rem);height:5px;margin-top:18px;
    background:linear-gradient(to bottom,#291912 0 1px,transparent 1px 3px,#291912 3px 4px,transparent 4px);
  }

  /* ── Week blocks ───────────────────────────────────────────────────────── */
  .week-block{max-width:1320px;margin:0 auto 28px;padding:0}
  .week-block:last-of-type{margin-bottom:0}
  .week-block__heading{
    margin:0 0 14px;
    font:400 clamp(1.15rem,2.4vw,1.5rem) var(--display);
    color:var(--denim);text-align:center;
  }
  .week{list-style:none;margin:0 auto;padding:0;display:grid;grid-template-columns:1fr;gap:10px}

  /* ── Day cards ─────────────────────────────────────────────────────────── */
  .day-card{
    position:relative;display:flex;flex-direction:column;gap:8px;
    border:1px solid rgba(41,25,18,.18);border-left:7px solid var(--ochre);
    background:#f8ecd3;
    box-shadow:var(--panel-shadow);
    padding:8px 14px 10px;
  }
  .day-card:nth-child(even){border-left-color:var(--brick)}
  .day-card.is-today{
    border:1px solid var(--brick);border-left:8px solid var(--brick);
    box-shadow:0 0 0 2px var(--ochre),4px 5px 0 rgba(43,27,20,.18);
  }
  .today-badge{
    background:var(--brick);color:var(--cream);border:1px solid rgba(41,25,18,.18);
    padding:3px 10px;font:700 .68rem var(--label);letter-spacing:.12em;text-transform:uppercase;flex-shrink:0;
  }
  .day-header{
    display:flex;align-items:center;justify-content:space-between;
    gap:12px;padding-bottom:7px;border-bottom:1px solid rgba(41,25,18,.18);
  }
  .day-name{font:700 .9rem var(--label);letter-spacing:.18em;text-transform:uppercase;color:var(--denim)}

  /* ── Normalized services grid ──────────────────────────────────────────── */
  .normalized-services{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));
    gap:18px;align-items:start;
  }

  /* ── Weekly notice ─────────────────────────────────────────────────────── */
  .weekly-notice{
    max-width:820px;margin:0 auto;padding:20px;
    border:2px solid var(--ochre);background:rgba(178,138,79,.08);text-align:center;
  }
  .weekly-notice p{margin:6px 0 0}

  /* ── Mexican night detail section ──────────────────────────────────────── */
  .section-anchor{scroll-margin-top:100px}
  .mexican-menu{max-width:1320px;margin:32px auto;padding:20px;border:2px solid var(--ochre);background:rgba(178,138,79,.06)}
  .mexican-menu .section-head h2{color:#291912}

  /* ── Recurring ─────────────────────────────────────────────────────────── */
  .recurring-head{text-align:center;max-width:760px;margin:40px auto 16px}
  .recurring-head .kicker{color:var(--brick)}
  .recurring-title{font:400 clamp(1.5rem,3.5vw,2.1rem) var(--display);color:var(--denim);margin-top:6px}
  .recurring{
    list-style:none;margin:0 auto;padding:0;
    max-width:var(--content-wide);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;
  }
  .rec-card{
    border:1px solid rgba(41,25,18,.22);background:#f8ecd3;
    padding:14px;text-align:center;display:flex;flex-direction:column;gap:5px;
  }
  .rec-name{font:400 1.15rem var(--display);color:#291912}
  .rec-name a{color:inherit}
  .rec-when{font:600 .82rem var(--label);letter-spacing:.06em;text-transform:uppercase;color:var(--denim)}

  /* ── Delivery block ────────────────────────────────────────────────────── */
  .delivery-block{
    max-width:820px;margin:44px auto 0;text-align:center;
    background:rgba(178,138,79,.1);border:1px solid var(--ochre);padding:14px 18px;
  }
  .delivery-block p{margin:0}
  .delivery-block strong{color:var(--denim)}
  .delivery-block.paused{border-color:var(--crimson)}
  .delivery-block.paused strong{color:var(--crimson)}

  /* ── CTA ───────────────────────────────────────────────────────────────── */
  .specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:30px auto 0}

  .allday-values .has-divider{margin-top:6px;padding-top:6px;border-top:1px dashed var(--rule);width:fit-content}

  @media (max-width:680px){
    .day-card{padding:8px 12px 10px}
    .day-header{flex-wrap:wrap;gap:6px}
    .normalized-services{grid-template-columns:1fr}
  }
</style>
