---
import Base from '../layouts/Base.astro';
import SpecialGroup from '../components/SpecialGroup.astro';
import MexicanNightMenu from '../components/MexicanNightMenu.astro';
import { getSetting } from '../lib/db';
import { getWeeklySpecialsForDateRange, getMexicanNight, visibleGroups, DAY_NAMES } from '../lib/specials-store';
import { chicagoCalendarDate, formatWeeklyDateRange } from '../lib/weekly-specials';
import { mexicanNightDetailVisible } from '../lib/mexican-night-visibility.js';
const env = (Astro.locals as any).runtime?.env ?? {};
const today=chicagoCalendarDate();
const [weeklySpecials,deliveryDisplay,mexican]=await Promise.all([getWeeklySpecialsForDateRange(env,today,'9999-12-31'),getSetting(env,'delivery_display','available'),getMexicanNight(env)]);
const weekDateFor=(start:string,dow:number) => {const date=new Date(`${start}T12:00:00Z`); date.setUTCDate(date.getUTCDate()+((dow-date.getUTCDay()+7)%7)); return date.toISOString().slice(0,10);};
const weeks=weeklySpecials.flatMap(week=>{
  const days=[0,1,2,3,4,5,6].map(day=>({day,date:weekDateFor(week.week_start_date,day),groups:visibleGroups(week.collection.groups,day)}))
    .filter(day=>day.date>=today && day.date<=week.week_end_date && day.groups.length).sort((a,b)=>a.date.localeCompare(b.date));
  return days.length ? [{...week,days}] : [];
});
const mexicanGroups=mexican ? visibleGroups(mexican.groups) : [];

// Show the detailed Mexican Night section only when this week's menu has been
// published (updated_at falls in the current Sun–Sat week) and it is still
// within the visible window: Sun–Tue all day, Wed before 2 AM Chicago time.
// The recurring "Mexican Night" card stays visible all week regardless.
const mexicanNightVisible = mexicanGroups.length > 0 && mexicanNightDetailVisible(mexican?.updated_at);

const recurring=[{name:'Lunch Specials',when:'11 AM – 1:30 PM'},{name:'Nightly Specials',when:'5 – 10 PM'},{name:'Friday Fish',when:'Fridays · 5 – 10 PM'},{name:'Happy Hour',when:'Mon–Fri · 5 – 6:30 PM'},{name:'Mexican Night',when:mexican?.schedule || 'Tuesdays · 5 – 10 PM'}];
---
<Base title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI" description="This week's and upcoming specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI.">
<section class="specials-page">
  <div class="specials-sheet">
    <svg class="corner-flourish corner-flourish--tl" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
    <svg class="corner-flourish corner-flourish--tr" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
    <svg class="corner-flourish corner-flourish--bl" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
    <svg class="corner-flourish corner-flourish--br" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
    <div class="section-head interior-heading"><span class="kicker">Fresh from the kitchen</span><h1>Weekly Specials</h1><span class="vintage-rule" aria-hidden="true"/></div>
    {weeks.length ? weeks.map((week,index)=>{
      const range=formatWeeklyDateRange(week.week_start_date,week.week_end_date);
      const current=week.week_start_date.localeCompare(today)!==1 && week.week_end_date.localeCompare(today)!==-1;
      const label=current ? 'This Week' : index===0 || (index===1 && weeks[0].week_start_date.localeCompare(today)!==1) ? 'Next Week' : '';
      return <section class="week-block" aria-labelledby={`week-heading-${week.id}`}><h2 class="week-block__heading" id={`week-heading-${week.id}`}>{label && <span class="wk-label">{label}</span>}<span class="wk-range">{range}</span></h2><ul class="week" aria-label={`Weekly specials, ${range}`}>{week.days.map(({day,date,groups})=><li class:list={['day-card',{'is-today':date===today}]}><div class="day-header"><span class="day-name">{DAY_NAMES[day]}</span>{date===today && <span class="today-badge">Today</span>}</div><div class="day-body"><div class="normalized-services">{groups.map(group=><SpecialGroup group={group} mexicanAvailable={mexicanNightVisible}/>)}</div></div></li>)}</ul></section>;
    }) : <div class="weekly-notice" role="status"><strong>No current weekly specials are posted.</strong><p>Please check Facebook or call us for the current specials.</p></div>}
    {mexicanNightVisible && <div id="mexican-night" class="section-anchor"/>}
    {mexicanNightVisible && (
      <section class="mexican-placard" aria-labelledby="mexican-heading">
        <svg class="corner-flourish corner-flourish--tl" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
        <svg class="corner-flourish corner-flourish--tr" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
        <svg class="corner-flourish corner-flourish--bl" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
        <svg class="corner-flourish corner-flourish--br" viewBox="0 0 72 72" aria-hidden="true"><path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3"/><path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7"/></svg>
        <div class="mexican-placard__head">
          <span class="kicker">{mexican!.schedule || 'Tuesdays · 5 – 10 PM'}</span>
          <h2 id="mexican-heading">{mexican!.title}</h2>
          <span class="vintage-rule" aria-hidden="true"/>
        </div>
        <MexicanNightMenu groups={mexicanGroups}/>
      </section>
    )}
    <div class="recurring-head"><span class="kicker">Every week</span><h3 class="recurring-title">On the regular</h3></div>
    <ul class="recurring" aria-label="Recurring specials">{recurring.map(item=><li class="rec-card"><span class="rec-name">{item.name==='Mexican Night' && mexicanNightVisible ? <a href="#mexican-night">{item.name}</a> : item.name}</span><span class="rec-when">{item.when}</span></li>)}</ul>
    {deliveryDisplay!=='hidden' && <div class:list={['delivery-block',{paused:deliveryDisplay==='unavailable'}]}>{deliveryDisplay==='unavailable' ? <p><strong>Delivery is unavailable at this time</strong> — call us for details.</p> : <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>}</div>}
    <div class="specials-cta"><a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a><a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a></div>
  </div>
</section>
</Base>
<style>
/* ── Page background blends into footer landscape ── */
.specials-page{
  --footer-blend-height:clamp(40px,3vw,56px);
  position:relative;min-height:70vh;
  padding:clamp(28px,5vw,68px) clamp(14px,4vw,56px) calc(var(--footer-blend-height) + clamp(12px,1.5vw,20px));
  background-color:var(--surface-parchment);
  background-image:linear-gradient(to bottom,rgba(91,50,24,.08) 0,rgba(91,50,24,.08) calc(100% - var(--footer-blend-height)),rgba(91,50,24,0) 100%),url('/parchment-texture.webp');
  background-position:center top,left bottom;
  background-size:auto,512px 512px;
  background-repeat:no-repeat,repeat;
}

/* ── Sheet frame ── */
.specials-sheet{
  position:relative;isolation:isolate;
  width:min(100%,1320px);margin:0 auto;
  padding:clamp(30px,5vw,64px) clamp(20px,5.5vw,68px) clamp(38px,6vw,72px);
  color:#291912;
  background-color:#f8ecd3;
  background-image:radial-gradient(rgba(74,40,19,.055) .65px,transparent .8px),linear-gradient(105deg,rgba(143,91,37,.055),transparent 30%,rgba(143,91,37,.035) 78%,transparent);
  background-size:5px 5px,100% 100%;
  border:6px double #291912;
  box-shadow:0 12px 30px rgba(53,29,14,.24);
}
.specials-sheet>:not(.corner-flourish){position:relative;z-index:1}

/* ── Corner flourishes ── */
.corner-flourish{
  position:absolute;z-index:0;
  width:clamp(46px,4.5vw,66px);height:auto;
  color:var(--brick);fill:none;
  stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  opacity:.65;pointer-events:none;
}
.corner-flourish--tl{top:11px;left:11px}
.corner-flourish--tr{top:11px;right:11px;transform:scaleX(-1)}
.corner-flourish--bl{bottom:11px;left:11px;transform:scaleY(-1)}
.corner-flourish--br{right:11px;bottom:11px;transform:scale(-1)}

/* ── Interior heading ── */
.interior-heading{margin-bottom:clamp(24px,4vw,40px)}
.interior-heading .kicker{display:block;color:var(--brick);font-size:.82rem}
.interior-heading h1{
  margin:8px 0 5px;color:#291912;
  font-size:clamp(2.6rem,7vw,5.2rem);
  line-height:.96;letter-spacing:.025em;text-transform:uppercase;
}
.interior-heading .vintage-rule{
  width:min(100%,28rem);height:5px;margin-top:18px;
  background:linear-gradient(to bottom,#291912 0 1px,transparent 1px 3px,#291912 3px 4px,transparent 4px);
}

/* ── Week blocks ── */
.week-block{margin:0 0 40px}
.week-block+.week-block{padding-top:32px;border-top:1px solid rgba(41,25,18,.15)}

/* Week heading — ornamental center-diamond rule like menu h2 */
.week-block__heading{
  position:relative;display:block;margin:0 0 20px;padding:0 0 14px;
  text-align:center;
  background:linear-gradient(to right,rgba(24,62,80,.32) 0 calc(50% - 10px),transparent calc(50% - 10px) calc(50% + 10px),rgba(24,62,80,.32) calc(50% + 10px) 100%) left bottom/100% 1px no-repeat;
}
.week-block__heading::before{
  content:'';position:absolute;left:50%;bottom:-3px;
  width:7px;height:7px;background:var(--denim);
  transform:translateX(-50%) rotate(45deg);
}
.wk-label{
  display:block;
  font:700 .72rem/1 var(--label);letter-spacing:.26em;text-transform:uppercase;
  color:var(--brick);margin-bottom:5px;
}
.wk-range{
  display:block;
  font:400 clamp(1.3rem,2.6vw,2rem)/1 var(--display);
  color:var(--denim);text-transform:uppercase;letter-spacing:.02em;
}

/* ── Week grid ── */
.week{
  list-style:none;margin:0;padding:0;
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));
  gap:12px;
}

/* ── Day card — posted notice ── */
.day-card{
  display:flex;flex-direction:column;
  background-color:#f8ecd3;
  background-image:radial-gradient(rgba(74,40,19,.04) .55px,transparent .65px);
  background-size:5px 5px;
  border:1px solid rgba(41,25,18,.22);
  box-shadow:2px 3px 0 rgba(41,25,18,.13);
  overflow:hidden;
}
.day-card.is-today{
  border-color:var(--brick);
  box-shadow:0 0 0 2px var(--ochre),3px 4px 0 rgba(41,25,18,.18);
}

/* Dark header band */
.day-header{
  background:#291912;padding:7px 14px 8px;
  display:flex;align-items:center;justify-content:space-between;gap:10px;flex-shrink:0;
}
.day-card.is-today .day-header{background:var(--brick)}
.day-name{font:400 1rem/1 var(--display);text-transform:uppercase;letter-spacing:.04em;color:#f8ecd3}

/* Pinned label badge */
.today-badge{
  background:rgba(248,236,211,.18);color:#f8ecd3;
  border:1px solid rgba(248,236,211,.32);
  padding:2px 8px;font:700 .66rem/1.4 var(--label);letter-spacing:.14em;text-transform:uppercase;flex-shrink:0;
}

/* Card body */
.day-body{padding:10px 14px 12px;flex:1}

/* ── Normalized services grid ── */
.normalized-services{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));
  gap:14px;align-items:start;
}

/* ── Weekly notice ── */
.weekly-notice{
  max-width:820px;margin:0 auto;padding:20px;
  border:2px solid var(--ochre);background:rgba(178,138,79,.08);text-align:center;
}
.weekly-notice p{margin:6px 0 0}

/* ── Scroll anchor ── */
.section-anchor{scroll-margin-top:100px}

/* ── Mexican Night placard ── */
.mexican-placard{
  position:relative;isolation:isolate;
  margin:44px 0 36px;
  padding:clamp(24px,4vw,44px) clamp(20px,4.5vw,44px) clamp(28px,5vw,48px);
  background-color:#1c100a;
  background-image:
    radial-gradient(rgba(230,185,90,.03) .65px,transparent .8px),
    linear-gradient(150deg,rgba(160,100,30,.09),transparent 45%,rgba(160,100,30,.06) 85%,transparent);
  background-size:5px 5px,100% 100%;
  border:2px solid var(--ochre);
  box-shadow:inset 0 0 80px rgba(0,0,0,.22),0 4px 14px rgba(0,0,0,.3);
  color:var(--cream);
}
.mexican-placard>:not(.corner-flourish){position:relative;z-index:1}
.mexican-placard .corner-flourish{color:var(--ochre);opacity:.5}

/* Mexican placard heading */
.mexican-placard__head{text-align:center;margin-bottom:clamp(18px,3vw,30px)}
.mexican-placard__head .kicker{color:var(--ochre)}
.mexican-placard__head h2{
  font:400 clamp(2rem,4.5vw,3.4rem)/1 var(--display);
  color:var(--cream);margin:8px 0 0;text-transform:uppercase;letter-spacing:.03em;
}
.mexican-placard .vintage-rule{
  width:min(100%,18rem);height:3px;margin-top:14px;
  background:linear-gradient(90deg,transparent,var(--ochre),transparent);
  display:block;
}

/* ── Recurring section ── */
.recurring-head{text-align:center;max-width:760px;margin:44px auto 20px}
.recurring-head .kicker{color:var(--brick)}
.recurring-title{
  font:400 clamp(1.5rem,3.5vw,2.1rem) var(--display);
  color:var(--denim);margin-top:6px;text-transform:uppercase;
}
.recurring{
  list-style:none;margin:0 auto;padding:0;
  max-width:var(--content-wide);
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px;
}
.rec-card{
  padding:14px 16px;
  border-top:3px solid var(--denim);border:1px solid rgba(41,25,18,.2);border-top-width:3px;border-top-color:var(--denim);
  background:#f8ecd3;text-align:center;display:flex;flex-direction:column;gap:6px;
  box-shadow:1px 2px 0 rgba(41,25,18,.1);
}
.rec-card:nth-child(even){border-top-color:var(--brick)}
.rec-name{font:400 1.1rem/1.2 var(--display);color:#291912}
.rec-name a{color:inherit;text-underline-offset:3px}
.rec-when{font:700 .75rem/1.3 var(--label);letter-spacing:.09em;text-transform:uppercase;color:var(--denim)}

/* ── Delivery block ── */
.delivery-block{
  max-width:820px;margin:40px auto 0;text-align:center;
  background:rgba(178,138,79,.1);
  border:1px solid var(--ochre);border-top:3px solid var(--ochre);
  padding:14px 18px;
}
.delivery-block p{margin:0}
.delivery-block strong{color:var(--denim)}
.delivery-block.paused{border-color:var(--crimson);border-top-color:var(--crimson)}
.delivery-block.paused strong{color:var(--crimson)}

/* ── CTA ── */
.specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:36px auto 0}

/* ── Responsive ── */
@media(max-width:760px){
  .specials-sheet{padding:24px 14px 40px;border-width:4px;box-shadow:0 8px 20px rgba(53,29,14,.2)}
  .corner-flourish{width:38px;stroke-width:2.4;opacity:.55}
  .corner-flourish--tl{top:8px;left:8px}
  .corner-flourish--tr{top:8px;right:8px}
  .corner-flourish--bl{bottom:8px;left:8px}
  .corner-flourish--br{right:8px;bottom:8px}
  .week{grid-template-columns:1fr}
  .normalized-services{grid-template-columns:1fr}
  .day-body{padding:8px 12px 10px}
  .mexican-placard{margin:32px 0 28px}
}
</style>
