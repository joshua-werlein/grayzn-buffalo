---
import Base from '../layouts/Base.astro';
import SpecialGroup from '../components/SpecialGroup.astro';
import MexicanNightMenu from '../components/MexicanNightMenu.astro';
import { getSetting } from '../lib/db';
import { getWeeklySpecialsForDateRange, getMexicanNight, visibleGroups, DAY_NAMES } from '../lib/specials-store';
import { chicagoCalendarDate, formatWeeklyDateRange } from '../lib/weekly-specials';
import { mexicanNightDetailVisible } from '../lib/mexican-night-visibility.js';
const env = (Astro.locals as any).runtime?.env ?? {};
const today=chicagoCalendarDate();
const [weeklySpecials,deliveryDisplay,mexican]=await Promise.all([getWeeklySpecialsForDateRange(env,today,'9999-12-31'),getSetting(env,'delivery_display','available'),getMexicanNight(env)]);
const weekDateFor=(start:string,dow:number) => {const date=new Date(`${start}T12:00:00Z`); date.setUTCDate(date.getUTCDate()+((dow-date.getUTCDay()+7)%7)); return date.toISOString().slice(0,10);};
const weeks=weeklySpecials.flatMap(week=>{
  const days=[0,1,2,3,4,5,6].map(day=>({day,date:weekDateFor(week.week_start_date,day),groups:visibleGroups(week.collection.groups,day)}))
    .filter(day=>day.date>=today && day.date<=week.week_end_date && day.groups.length).sort((a,b)=>a.date.localeCompare(b.date));
  return days.length ? [{...week,days}] : [];
});
const mexicanGroups=mexican ? visibleGroups(mexican.groups) : [];

// Show the detailed Mexican Night section only when this week's menu has been
// published (updated_at falls in the current Sun–Sat week) and it is still
// within the visible window: Sun–Tue all day, Wed before 2 AM Chicago time.
// The recurring "Mexican Night" card stays visible all week regardless.
const mexicanNightVisible = mexicanGroups.length > 0 && mexicanNightDetailVisible(mexican?.updated_at);

const recurring=[{name:'Lunch Specials',when:'11 AM – 1:30 PM'},{name:'Nightly Specials',when:'5 – 10 PM'},{name:'Friday Fish',when:'Fridays · 5 – 10 PM'},{name:'Happy Hour',when:'Mon–Fri · 5 – 6:30 PM'},{name:'Mexican Night',when:mexican?.schedule || 'Tuesdays · 5 – 10 PM'}];

// Helpers
const cardDate = (dateStr: string) => new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(`${dateStr}T12:00:00Z`));
const PC = ['denim','brick','saddle'] as const;
---
<Base title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI" description="This week's and upcoming specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI.">
<section class="specials-page">
  <div class="specials-sheet">
    <svg class="corner-flourish corner-flourish--top-left" viewBox="0 0 72 72" aria-hidden="true">
      <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
      <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
    </svg>
    <svg class="corner-flourish corner-flourish--top-right" viewBox="0 0 72 72" aria-hidden="true">
      <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
      <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
    </svg>
    <svg class="corner-flourish corner-flourish--bottom-left" viewBox="0 0 72 72" aria-hidden="true">
      <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
      <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
    </svg>
    <svg class="corner-flourish corner-flourish--bottom-right" viewBox="0 0 72 72" aria-hidden="true">
      <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
      <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
    </svg>

    <div class="section-head interior-heading">
      <span class="kicker">Fresh from the kitchen</span>
      <h1>Weekly Specials</h1>
      <span class="vintage-rule" aria-hidden="true"/>
    </div>

    {weeks.length ? weeks.map((week,wi)=>{
      const range=formatWeeklyDateRange(week.week_start_date,week.week_end_date);
      const current=week.week_start_date.localeCompare(today)!==1 && week.week_end_date.localeCompare(today)!==-1;
      const label=current ? 'This Week' : wi===0 || (wi===1 && weeks[0].week_start_date.localeCompare(today)!==1) ? 'Next Week' : '';
      const todayCard=week.days.find(d=>d.date===today);
      const gridDays=todayCard ? week.days.filter(d=>d.date!==today) : week.days;
      return (
        <section class="week-section" aria-labelledby={`wh-${week.id}`}>
          <h2 class="week-section__heading" id={`wh-${week.id}`}>
            {label && <span class="wk-badge">{label}</span>}
            <span class="wk-range">{range}</span>
          </h2>

          {todayCard && (
            <article class="placard placard--today" aria-label={`Today, ${DAY_NAMES[todayCard.day]}, ${cardDate(todayCard.date)}`}>
              <div class="today-hd">
                <div class="today-hd__meta">
                  <span class="placard-day">{DAY_NAMES[todayCard.day]}</span>
                  <time class="placard-date" datetime={todayCard.date}>{cardDate(todayCard.date)}</time>
                </div>
                <span class="today-stamp" aria-label="Today">Today</span>
              </div>
              <div class="today-body">
                {todayCard.groups.map(group=><SpecialGroup group={group} mexicanAvailable={mexicanNightVisible}/>)}
              </div>
            </article>
          )}

          {gridDays.length > 0 && (
            <ul class="week-grid" aria-label={`${todayCard ? 'Rest of week' : 'Weekly specials'}, ${range}`}>
              {gridDays.map(({day,date,groups},i)=>(
                <li>
                  <article class:list={['placard',`placard--${PC[i%3]}`]} aria-label={`${DAY_NAMES[day]}, ${cardDate(date)}`}>
                    <div class="card-hd">
                      <span class="placard-day">{DAY_NAMES[day]}</span>
                      <time class="placard-date" datetime={date}>{cardDate(date)}</time>
                    </div>
                    <div class="card-body">
                      {groups.map(group=><SpecialGroup group={group} mexicanAvailable={mexicanNightVisible}/>)}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    }) : <div class="no-specials" role="status"><strong>No current weekly specials are posted.</strong><p>Please check Facebook or call us for the current specials.</p></div>}

    {mexicanNightVisible && <div id="mexican-night" class="mex-anchor"/>}
    {mexicanNightVisible && (
      <article class="placard placard--mexican" aria-labelledby="mex-title">
        <div class="mex-hd">
          <span class="mex-kicker">{mexican!.schedule || 'Tuesdays · 5 – 10 PM'}</span>
          <h2 id="mex-title" class="mex-title">{mexican!.title}</h2>
          <span class="mex-rule" aria-hidden="true"/>
        </div>
        <div class="mex-body">
          <MexicanNightMenu groups={mexicanGroups}/>
        </div>
      </article>
    )}

    <section class="recurring-section" aria-label="Recurring specials">
      <div class="recurring-hd">
        <span class="kicker">Every week</span>
        <h3 class="recurring-title">On the Regular</h3>
      </div>
      <ul class="recurring-grid">
        {recurring.map(item=>(
          <li class="rec-placard">
            <span class="rec-name">{item.name==='Mexican Night' && mexicanNightVisible ? <a href="#mexican-night">{item.name}</a> : item.name}</span>
            <span class="rec-when">{item.when}</span>
          </li>
        ))}
      </ul>
    </section>

    {deliveryDisplay!=='hidden' && <div class:list={['delivery-block',{paused:deliveryDisplay==='unavailable'}]}>{deliveryDisplay==='unavailable' ? <p><strong>Delivery is unavailable at this time</strong> — call us for details.</p> : <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>}</div>}
    <div class="specials-cta"><a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a><a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a></div>

  </div>
</section>
</Base>
<style>
/* ── Page shell ── */
.specials-page{
  --footer-blend-height:clamp(40px,3vw,56px);
  padding:clamp(28px,5vw,68px) clamp(14px,4vw,56px) calc(var(--footer-blend-height) + clamp(12px,1.5vw,20px));
  background-color:var(--surface-parchment);
  background-image:linear-gradient(to bottom,rgba(91,50,24,.08) 0,rgba(91,50,24,.08) calc(100% - var(--footer-blend-height)),rgba(91,50,24,0) 100%),url('/parchment-texture.webp');
  background-position:center top,left bottom;
  background-size:auto,512px 512px;
  background-repeat:no-repeat,repeat;
}

/* ── Menu-sheet treatment — mirrors menu.astro ── */
.specials-sheet{
  position:relative;
  isolation:isolate;
  width:min(100%,1280px);
  margin:0 auto;
  padding:clamp(30px,5vw,68px) clamp(20px,5.5vw,72px) clamp(38px,6vw,76px);
  color:#291912;
  background-color:#f8ecd3;
  background-image:radial-gradient(rgba(74,40,19,.055) .65px,transparent .8px),linear-gradient(105deg,rgba(143,91,37,.055),transparent 30%,rgba(143,91,37,.035) 78%,transparent);
  background-size:5px 5px,100% 100%;
  border:7px double #291912;
  box-shadow:0 12px 30px rgba(53,29,14,.24);
}
.specials-sheet > :not(.corner-flourish){position:relative;z-index:1}

/* ── Corner flourishes ── */
.corner-flourish{
  position:absolute;z-index:0;
  width:clamp(48px,5vw,70px);height:auto;
  color:var(--brick);fill:none;
  stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  opacity:.68;pointer-events:none;
}
.corner-flourish--top-left{top:11px;left:11px}
.corner-flourish--top-right{top:11px;right:11px;transform:scaleX(-1)}
.corner-flourish--bottom-left{bottom:11px;left:11px;transform:scaleY(-1)}
.corner-flourish--bottom-right{right:11px;bottom:11px;transform:scale(-1)}

/* ── Interior heading — matches Menu page ── */
.interior-heading{margin-bottom:clamp(22px,3vw,34px);max-width:none}
.interior-heading .kicker{display:block;color:var(--brick);font-size:.82rem}
.interior-heading h1{
  margin:8px 0 5px;color:#291912;
  font:400 clamp(2.5rem,5.5vw,4.8rem)/.98 var(--display);
  letter-spacing:.025em;text-transform:uppercase;
}
.interior-heading .vintage-rule{
  width:min(100%,40rem);height:5px;margin:18px auto 0;
  background:linear-gradient(to bottom,#291912 0 1px,transparent 1px 3px,#291912 3px 4px,transparent 4px);
}

/* ── Week section ── */
.week-section{margin-bottom:clamp(18px,3vw,32px);padding:0}
.week-section+.week-section{padding-top:clamp(18px,3vw,32px);border-top:1px solid rgba(41,25,18,.15)}
.week-section__heading{
  display:flex;align-items:center;gap:12px;margin:0 0 14px;
  font:700 .78rem/1 var(--label);letter-spacing:.18em;text-transform:uppercase;
  color:rgba(41,25,18,.48);
}
.week-section__heading::after{content:'';flex:1;height:1px;background:rgba(41,25,18,.15)}
.wk-badge{color:var(--brick);flex-shrink:0}
.wk-range{flex-shrink:0}

/* ── Shared placard ── */
.placard{display:flex;flex-direction:column;overflow:hidden}
.placard-day{
  font:400 clamp(1.1rem,2vw,1.65rem)/1 var(--display);
  text-transform:uppercase;letter-spacing:.04em;
}
.placard-date{
  display:block;font:600 .82rem/1 var(--label);
  letter-spacing:.1em;text-transform:uppercase;margin-top:4px;opacity:.7;
}

/* ── TODAY card — full width ── */
.placard--today{
  background:#1a3d50;border:2px solid var(--ochre);
  box-shadow:4px 5px 0 rgba(0,0,0,.3);
  margin-bottom:clamp(10px,2vw,16px);
  --sg-label:var(--ochre);--sg-time:rgba(244,229,197,.65);
  --sg-text:#f0ddb8;--sg-rule:rgba(244,229,197,.14);--sg-link:var(--ochre);
}
.today-hd{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  padding:10px 20px 12px;background:rgba(0,0,0,.22);
  border-bottom:1px solid rgba(244,229,197,.12);
}
.today-hd__meta{flex:1;min-width:0}
.placard--today .placard-day{font-size:clamp(1.4rem,3vw,2.4rem);color:#f0ddb8;line-height:.92}
.placard--today .placard-date{font-size:.88rem;color:var(--ochre);opacity:1;margin-top:5px}
.today-stamp{
  display:inline-flex;align-items:center;
  background:var(--brick);color:#f0ddb8;
  font:700 .72rem/1 var(--label);letter-spacing:.2em;text-transform:uppercase;
  padding:6px 15px;border:1px solid rgba(244,229,197,.25);
  transform:rotate(-1.2deg);box-shadow:2px 2px 0 rgba(0,0,0,.25);
  flex-shrink:0;align-self:flex-start;
}
.today-body{
  padding:14px 20px 18px;
  display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));
  gap:16px 28px;align-items:start;align-content:start;
}

/* Zero out global section{padding} that bleeds into SpecialGroup.astro's <section> */
.today-body :global(.special-group),
.card-body :global(.special-group){padding:0}

/* ── Full-width day card header/body ── */
.card-hd{
  padding:10px 20px 12px;background:rgba(0,0,0,.2);
  border-bottom:1px solid rgba(244,229,197,.1);
}
.card-body{
  padding:14px 20px 18px;
  display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));
  gap:16px 28px;align-items:start;align-content:start;
}

/* ── DENIM ── */
.placard--denim{
  background:#1a3d50;box-shadow:3px 4px 0 rgba(0,0,0,.24);
  --sg-label:var(--ochre);--sg-time:rgba(244,229,197,.6);
  --sg-text:#ecd8b4;--sg-rule:rgba(244,229,197,.12);--sg-link:var(--ochre);
}
.placard--denim .placard-day{color:#f0ddb8}
.placard--denim .placard-date{color:rgba(244,229,197,.6)}

/* ── BRICK ── */
.placard--brick{
  background:#6e2a27;box-shadow:3px 4px 0 rgba(0,0,0,.24);
  --sg-label:#f0c97a;--sg-time:rgba(244,229,197,.6);
  --sg-text:#f0e0c4;--sg-rule:rgba(244,229,197,.12);--sg-link:#f0c97a;
}
.placard--brick .card-hd{border-bottom-color:rgba(244,229,197,.1)}
.placard--brick .placard-day{color:#f0ddb8}
.placard--brick .placard-date{color:rgba(244,229,197,.6)}

/* ── SADDLE ── */
.placard--saddle{
  background:#b07a2e;box-shadow:3px 4px 0 rgba(0,0,0,.22);
  --sg-label:#291912;--sg-time:rgba(41,25,18,.62);
  --sg-text:#1a0e06;--sg-rule:rgba(41,25,18,.2);--sg-link:#291912;
}
.placard--saddle .card-hd{background:rgba(0,0,0,.12);border-bottom-color:rgba(41,25,18,.18)}
.placard--saddle .placard-day{color:#1a0e06}
.placard--saddle .placard-date{color:rgba(41,25,18,.62)}

/* ── Week list — one full-width row per day ── */
.week-grid{
  list-style:none;margin:0;padding:0;
  display:flex;flex-direction:column;gap:10px;
}
.week-grid>li{display:block;min-width:0}
.week-grid .placard{width:100%}

/* ── No specials ── */
.no-specials{
  max-width:820px;margin:0 auto;padding:24px;
  border:2px solid var(--ochre);background:rgba(178,138,79,.08);text-align:center;
}
.no-specials p{margin:6px 0 0}

/* ── Mexican Night ── */
.mex-anchor{scroll-margin-top:100px}
.placard--mexican{
  margin:clamp(18px,3vw,36px) 0 clamp(14px,2.5vw,26px);
  background:#3d1218;
  background-image:linear-gradient(150deg,rgba(180,60,40,.12),transparent 50%,rgba(160,60,30,.08) 90%,transparent);
  border:2px solid var(--ochre);box-shadow:4px 5px 0 rgba(0,0,0,.38);
  --sg-label:var(--ochre);--sg-time:rgba(244,229,197,.6);
  --sg-text:var(--cream);--sg-rule:rgba(244,229,197,.14);--sg-link:var(--ochre);
}
.mex-hd{
  text-align:center;
  padding:clamp(20px,3.5vw,36px) clamp(18px,3vw,40px) clamp(18px,3vw,32px);
  background:rgba(0,0,0,.28);border-bottom:1px solid rgba(178,138,79,.28);
}
.mex-kicker{
  display:block;color:var(--ochre);
  font:700 .82rem/1 var(--label);letter-spacing:.2em;text-transform:uppercase;
  margin-bottom:8px;
}
.mex-title{
  font:400 clamp(2.4rem,5vw,3.8rem)/1 var(--display);
  color:var(--cream);text-transform:uppercase;letter-spacing:.03em;margin:0;
}
.mex-rule{
  display:block;width:min(100%,16rem);height:3px;margin:14px auto 0;
  background:linear-gradient(90deg,transparent,var(--ochre),transparent);
}
.mex-body{padding:clamp(18px,3vw,36px) clamp(16px,3.5vw,48px) clamp(22px,4vw,44px)}

/* ── On the Regular ── */
.recurring-section{margin-top:clamp(22px,3.5vw,38px);padding:0}
.recurring-hd{text-align:center;margin-bottom:18px}
.recurring-hd .kicker{display:block;color:var(--brick);font-size:.82rem}
.recurring-title{
  font:400 clamp(1.4rem,3vw,1.9rem)/1 var(--display);
  color:var(--denim);text-transform:uppercase;margin-top:6px;
}
.recurring-grid{
  list-style:none;margin:0 auto;padding:0;
  max-width:var(--content-wide);
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;
}
.rec-placard{
  --rec-tint:var(--denim);
  padding:16px 18px;
  background:color-mix(in srgb,var(--rec-tint) 6%,rgba(248,236,211,.7));
  border:1px solid rgba(41,25,18,.18);border-top:3px solid var(--denim);
  text-align:center;display:flex;flex-direction:column;gap:6px;
  box-shadow:2px 2px 0 rgba(41,25,18,.08);
}
.rec-placard:nth-child(2n){--rec-tint:var(--brick);border-top-color:var(--brick)}
.rec-placard:nth-child(3n){--rec-tint:var(--ochre);border-top-color:#b07a2e}
.rec-name{font:400 1.2rem/1.2 var(--display);color:#291912}
.rec-name a{color:inherit;text-underline-offset:3px}
.rec-when{font:600 .88rem/1.3 var(--label);letter-spacing:.06em;text-transform:uppercase;color:var(--denim)}

/* ── Delivery ── */
.delivery-block{
  max-width:820px;margin:32px auto 0;text-align:center;
  background:rgba(178,138,79,.1);
  border:1px solid var(--ochre);border-top:3px solid var(--ochre);
  padding:14px 18px;
}
.delivery-block p{margin:0}
.delivery-block strong{color:var(--denim)}
.delivery-block.paused{border-color:var(--crimson);border-top-color:var(--crimson)}
.delivery-block.paused strong{color:var(--crimson)}

/* ── CTA ── */
.specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:32px auto 0}

/* ── Responsive ── */
@media(max-width:760px){
  .specials-page{--footer-blend-height:clamp(32px,10vw,44px);padding:18px 10px calc(var(--footer-blend-height) + 14px)}
  .specials-sheet{padding:28px 16px 44px;border-width:5px;box-shadow:0 8px 20px rgba(53,29,14,.2)}
  .corner-flourish{width:40px;stroke-width:2.4;opacity:.58}
  .corner-flourish--top-left{top:8px;left:8px}
  .corner-flourish--top-right{top:8px;right:8px}
  .corner-flourish--bottom-left{bottom:8px;left:8px}
  .corner-flourish--bottom-right{right:8px;bottom:8px}
}
@media(max-width:640px){
  .today-hd{padding:9px 14px 10px}
  .today-body{padding:12px 14px 16px;gap:12px;grid-template-columns:1fr}
  .card-hd{padding:8px 14px 10px}
  .card-body{padding:12px 14px 16px;gap:12px;grid-template-columns:1fr}
  .mex-body{padding:14px 14px 20px}
  .recurring-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
