---
import Base from '../layouts/Base.astro';
import { getApplicableWeeklySpecial, getSetting, type WeeklySpecialDay } from '../lib/db';
import { chicagoCalendarDate, chicagoWeekday, formatWeeklyDateRange } from '../lib/weekly-specials';
const env = (Astro.locals as any).runtime?.env ?? {};
const today = chicagoCalendarDate();
const todayDay = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].indexOf(chicagoWeekday());
const [weekly, deliveryDisplay] = await Promise.all([getApplicableWeeklySpecial(env, today), getSetting(env, 'delivery_display', 'available')]);
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const emptyDay = (day_of_week: number): WeeklySpecialDay => ({ day_of_week, lunch_content: '', all_day_1_content: '', all_day_2_content: '', nightly_content: '' });
const week = weekly.status === 'current'
  ? DAYS.map((_, index) => weekly.special.days.find((day) => day.day_of_week === index) ?? emptyDay(index))
  : [];
const range = weekly.status === 'missing' ? '' : formatWeeklyDateRange(weekly.special.week_start_date, weekly.special.week_end_date);
const recurring = [{ name: 'Lunch Specials', when: '11 AM – 1:30 PM' }, { name: 'Nightly Specials', when: '5 – 10 PM' }, { name: 'Friday Fish', when: 'Fridays · 5 – 10 PM' }, { name: 'Happy Hour', when: 'Mon–Fri · 5 – 6:30 PM' }, { name: 'Mexican Night', when: 'Tuesdays · 5 – 10 PM' }];
---
<Base title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI" description="This week's specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI.">
<section class="specials-page section-tavern">
  <div class="section-head interior-heading"><span class="kicker">Fresh from the kitchen</span><h1>This Week's Specials</h1><span class="vintage-rule" aria-hidden="true"></span>
    {weekly.status === 'current' ? <p>Weekly Specials — {range}</p> : weekly.status === 'expired' ? <p>Weekly Specials — {range} · Expired</p> : <p>Check Facebook or call us for the current specials.</p>}
  </div>
  {weekly.status === 'current' ? (
    <ul class="week" aria-label={`Weekly specials, ${range}`}>
      {week.map((special) => <li class:list={['day-card', { 'is-today': special.day_of_week === todayDay }]}>
        {special.day_of_week === todayDay && <span class="today-badge">Today</span>}<span class="day-name">{DAYS[special.day_of_week]}</span>
        <div class="day-services">
          <section class="day-service lunch-service"><p class="service-label">Lunch <span>11 AM–1:30 PM</span></p><p class="day-desc">{special.lunch_content || 'Ask at the bar about today’s lunch special.'}</p></section>
          {special.all_day_1_content && <section class="day-service"><p class="service-label">All Day Special 1</p><p class="day-desc">{special.all_day_1_content}</p></section>}
          {special.all_day_2_content && <section class="day-service"><p class="service-label">All Day Special 2</p><p class="day-desc">{special.all_day_2_content}</p></section>}
          <section class="day-service night-service"><p class="service-label">Nightly Special <span>5–10 PM</span></p><p class="day-desc night-lines">{special.nightly_content || 'Ask at the bar about tonight’s special.'}</p></section>
        </div>
      </li>)}
    </ul>
  ) : <div class="weekly-notice" role="status"><strong>{weekly.status === 'expired' ? 'These specials have ended.' : 'No current weekly specials are posted.'}</strong><p>These specials have ended. Please check Facebook or call us for the current specials.</p></div>}
  <div class="recurring-head"><span class="kicker">Every week</span><h3 class="recurring-title">On the regular</h3></div>
  <ul class="recurring" aria-label="Recurring specials">{recurring.map((item) => <li class="rec-card"><span class="rec-name">{item.name}</span><span class="rec-when">{item.when}</span></li>)}</ul>
  {deliveryDisplay !== 'hidden' && <div class:list={['delivery-block', { paused: deliveryDisplay === 'unavailable' }]}>{deliveryDisplay === 'unavailable' ? <p><strong>Delivery is unavailable at this time</strong> — call us for details.</p> : <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>}</div>}
  <div class="specials-cta"><a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a><a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a></div>
</section>
</Base>
<style>
  .specials-page{background-color:var(--denim);background-image:linear-gradient(115deg,rgba(255,255,255,.045),transparent 30%,rgba(0,0,0,.2)),repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 5px);border-top:4px solid #112b38;color:var(--cream);min-height:70vh;padding-top:clamp(32px,5vw,54px)}.specials-page .section-head{padding-bottom:18px;border-bottom:1px solid var(--rule-light);margin-bottom:28px}.specials-page .section-head .kicker,.specials-page .section-head :is(h1,h2){color:var(--cream)}.specials-page .section-head p{color:var(--ochre)}.specials-page .vintage-rule{background:linear-gradient(90deg,transparent,var(--ochre),transparent)}.week{list-style:none;margin:0 auto;padding:0;max-width:var(--content-wide);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.day-card{position:relative;border:2px solid rgba(235,216,177,.65);border-left:7px solid var(--ochre);border-radius:0;background:rgba(11,38,50,.48);box-shadow:3px 4px 0 rgba(10,22,28,.38);padding:18px 20px}.day-card:nth-child(even){border-left-color:var(--brick)}.day-card.is-today{border:2px solid var(--cream);border-left:8px solid var(--brick);box-shadow:0 0 0 2px var(--ochre),4px 5px 0 rgba(10,22,28,.42)}.today-badge{position:absolute;top:-12px;right:12px;background:var(--brick);border:1px solid var(--cream);padding:3px 12px;font:700 .68rem var(--label);letter-spacing:.12em;text-transform:uppercase}.day-name{font:700 .8rem var(--label);letter-spacing:.18em;text-transform:uppercase;color:var(--amber)}.day-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin-top:10px;border-top:1px solid rgba(235,216,177,.5)}.day-service{padding:13px 0}.day-service + .day-service{padding-left:16px;border-left:1px solid rgba(235,216,177,.5)}.service-label{font:700 .76rem var(--label);letter-spacing:.14em;text-transform:uppercase;color:var(--cream)}.service-label span{display:block;font-size:.68rem;letter-spacing:.07em;margin-top:2px}.day-desc{margin:0;color:var(--cream);white-space:pre-line}.day-allday{margin-top:12px;padding:12px 14px;border:1px solid var(--rule-light);border-left:4px solid var(--ochre);background:rgba(196,151,75,.08)}.weekly-notice{max-width:820px;margin:0 auto;padding:20px;border:2px solid var(--ochre);background:rgba(11,38,50,.48);text-align:center}.weekly-notice p{margin:6px 0 0}.recurring-head{text-align:center;max-width:760px;margin:40px auto 16px}.recurring-head .kicker{color:var(--amber)}.recurring-title{font:400 clamp(1.5rem,3.5vw,2.1rem) var(--display);color:var(--gold);margin-top:6px}.recurring{list-style:none;margin:0 auto;padding:0;max-width:var(--content-wide);display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.rec-card{border:1px solid rgba(235,216,177,.5);background:rgba(11,38,50,.32);padding:14px;text-align:center;display:flex;flex-direction:column;gap:5px}.rec-name{font:400 1.15rem var(--display);color:var(--cream)}.rec-when{font:600 .82rem var(--label);letter-spacing:.06em;text-transform:uppercase;color:var(--amber)}.delivery-block{max-width:820px;margin:44px auto 0;text-align:center;background:rgba(7,29,40,.35);border:1px solid var(--ochre);padding:14px 18px}.delivery-block p{margin:0}.delivery-block strong{color:var(--gold)}.delivery-block.paused{border-color:var(--crimson)}.specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:30px auto 0}@media (max-width:680px){.week{grid-template-columns:1fr}.day-service + .day-service{padding-left:0;margin-top:12px;padding-top:12px;border-left:0;border-top:1px solid rgba(235,216,177,.5)}}
</style>
