---
import Base from '../layouts/Base.astro';
import SpecialGroup from '../components/SpecialGroup.astro';
import { getSetting } from '../lib/db';
import { getWeeklySpecialsForDateRange, getMexicanNight, visibleGroups, DAY_NAMES } from '../lib/specials-store';
import { chicagoCalendarDate, formatWeeklyDateRange } from '../lib/weekly-specials';
const env = (Astro.locals as any).runtime?.env ?? {};
const today=chicagoCalendarDate();
const [weeklySpecials,deliveryDisplay,mexican]=await Promise.all([getWeeklySpecialsForDateRange(env,today,'9999-12-31'),getSetting(env,'delivery_display','available'),getMexicanNight(env)]);
const weekDateFor=(start:string,dow:number) => {const date=new Date(`${start}T12:00:00Z`); date.setUTCDate(date.getUTCDate()+((dow-date.getUTCDay()+7)%7)); return date.toISOString().slice(0,10);};
const weeks=weeklySpecials.flatMap(week=>{
  const days=[0,1,2,3,4,5,6].map(day=>({day,date:weekDateFor(week.week_start_date,day),groups:visibleGroups(week.collection.groups,day)}))
    .filter(day=>day.date>=today && day.date<=week.week_end_date && day.groups.length).sort((a,b)=>a.date.localeCompare(b.date));
  return days.length ? [{...week,days}] : [];
});
const mexicanGroups=mexican ? visibleGroups(mexican.groups) : [];
const recurring=[{name:'Lunch Specials',when:'11 AM – 1:30 PM'},{name:'Nightly Specials',when:'5 – 10 PM'},{name:'Friday Fish',when:'Fridays · 5 – 10 PM'},{name:'Happy Hour',when:'Mon–Fri · 5 – 6:30 PM'},{name:'Mexican Night',when:mexican?.schedule || 'Tuesdays · 5 – 10 PM'}];
---
<Base title="Specials — Grayz'n Buffalo Bar & Grill, Mondovi WI" description="This week's and upcoming specials at Grayz'n Buffalo Bar & Grill in Mondovi, WI.">
<section class="specials-page section-tavern">
  <div class="section-head interior-heading"><span class="kicker">Fresh from the kitchen</span><h1>Weekly Specials</h1><span class="vintage-rule" aria-hidden="true"/></div>
  {weeks.length ? weeks.map((week,index)=>{
    const range=formatWeeklyDateRange(week.week_start_date,week.week_end_date);
    const current=week.week_start_date.localeCompare(today)!==1 && week.week_end_date.localeCompare(today)!==-1;
    const label=current ? 'This Week' : index===0 || (index===1 && weeks[0].week_start_date.localeCompare(today)!==1) ? 'Next Week' : '';
    return <section class="week-block" aria-labelledby={`week-heading-${week.id}`}><h2 class="week-block__heading" id={`week-heading-${week.id}`}>{label ? `${label} · ${range}` : range}</h2><ul class="week" aria-label={`Weekly specials, ${range}`}>{week.days.map(({day,date,groups})=><li class:list={['day-card',{'is-today':date===today}]}><div class="day-header"><span class="day-name">{DAY_NAMES[day]}</span>{date===today && <span class="today-badge">Today</span>}</div><div class="normalized-services">{groups.map(group=><SpecialGroup group={group} mexicanAvailable={mexicanGroups.length>0}/>)}</div></li>)}</ul></section>;
  }) : <div class="weekly-notice" role="status"><strong>No current weekly specials are posted.</strong><p>Please check Facebook or call us for the current specials.</p></div>}
  <div id="mexican-night" class="section-anchor"></div>
  {mexican && mexicanGroups.length>0 && <section class="mexican-menu" aria-labelledby="mexican-heading"><div class="section-head"><h2 id="mexican-heading">{mexican.title}</h2>{mexican.schedule && <p>{mexican.schedule}</p>}</div><div class="normalized-services">{mexicanGroups.map(group=><SpecialGroup group={group}/>)}</div></section>}
  <div class="recurring-head"><span class="kicker">Every week</span><h3 class="recurring-title">On the regular</h3></div>
  <ul class="recurring" aria-label="Recurring specials">{recurring.map(item=><li class="rec-card"><span class="rec-name">{item.name==='Mexican Night' && mexicanGroups.length>0 ? <a href="#mexican-night">{item.name}</a> : item.name}</span><span class="rec-when">{item.when}</span></li>)}</ul>
  {deliveryDisplay!=='hidden' && <div class:list={['delivery-block',{paused:deliveryDisplay==='unavailable'}]}>{deliveryDisplay==='unavailable' ? <p><strong>Delivery is unavailable at this time</strong> — call us for details.</p> : <p><strong>Delivery</strong> — Monday–Friday, 11 AM – 1:30 PM, within Mondovi city limits.</p>}</div>}
  <div class="specials-cta"><a class="btn btn-primary" href="tel:+17159264431">Call (715) 926-4431</a><a class="btn btn-ghost" href="https://www.facebook.com/grayznbuffalo/" target="_blank" rel="noopener">See it on Facebook</a></div>
</section>
</Base>
<style>
  .specials-page{position:relative;background-color:var(--denim);background-image:linear-gradient(115deg,rgba(255,255,255,.045),transparent 30%,rgba(0,0,0,.2)),repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 5px);border-top:4px solid #112b38;color:var(--cream);min-height:70vh;padding-top:clamp(32px,5vw,54px)}.specials-page::after{content:"";position:absolute;right:0;bottom:0;left:0;height:5px;background:linear-gradient(to bottom,#112b38 0 1px,transparent 1px 3px,rgba(178,138,79,.86) 3px 4px,transparent 4px);pointer-events:none}.specials-page .section-head{padding-bottom:12px;border-bottom:1px solid var(--rule-light);margin-bottom:14px}.specials-page .section-head .kicker,.specials-page .section-head :is(h1,h2){color:var(--cream)}.specials-page .section-head p{color:var(--ochre)}.specials-page .vintage-rule{background:linear-gradient(90deg,transparent,var(--ochre),transparent)}.week{list-style:none;margin:0 auto;padding:0;max-width:1380px;display:grid;grid-template-columns:1fr;gap:10px}.day-card{position:relative;display:flex;flex-direction:column;gap:8px;border:2px solid rgba(235,216,177,.65);border-left:7px solid var(--ochre);border-radius:0;background:rgba(11,38,50,.48);box-shadow:3px 4px 0 rgba(10,22,28,.38);padding:8px 14px 10px}.day-card:nth-child(even){border-left-color:var(--brick)}.day-card.is-today{border:2px solid var(--cream);border-left:8px solid var(--brick);box-shadow:0 0 0 2px var(--ochre),4px 5px 0 rgba(10,22,28,.42)}.today-badge{background:var(--brick);border:1px solid var(--cream);padding:3px 10px;font:700 .68rem var(--label);letter-spacing:.12em;text-transform:uppercase;flex-shrink:0}.day-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:7px;border-bottom:1px solid rgba(235,216,177,.28)}.day-name{font:700 .9rem var(--label);letter-spacing:.18em;text-transform:uppercase;color:var(--amber)}.day-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:6px 16px;align-items:start}.day-card.is-weekend .day-services{grid-template-columns:minmax(0,1fr) minmax(0,2fr)}.day-service{min-width:0;padding:0}.service-label{font:700 .82rem var(--label);letter-spacing:.14em;text-transform:uppercase;color:var(--cream)}.service-label span{display:block;font-size:.72rem;letter-spacing:.07em;margin-top:2px}.day-desc{margin:0;color:var(--cream);white-space:pre-line;overflow-wrap:anywhere;font-size:clamp(1rem,1.05vw,1.1rem)}.no-special{margin:0;color:var(--cream);font-size:clamp(1rem,1.05vw,1.1rem)}.weekly-notice{max-width:820px;margin:0 auto;padding:20px;border:2px solid var(--ochre);background:rgba(11,38,50,.48);text-align:center}.weekly-notice p{margin:6px 0 0}.recurring-head{text-align:center;max-width:760px;margin:40px auto 16px}.recurring-head .kicker{color:var(--amber)}.recurring-title{font:400 clamp(1.5rem,3.5vw,2.1rem) var(--display);color:var(--gold);margin-top:6px}.recurring{list-style:none;margin:0 auto;padding:0;max-width:var(--content-wide);display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.rec-card{border:1px solid rgba(235,216,177,.5);background:rgba(11,38,50,.32);padding:14px;text-align:center;display:flex;flex-direction:column;gap:5px}.rec-name{font:400 1.15rem var(--display);color:var(--cream)}.rec-when{font:600 .82rem var(--label);letter-spacing:.06em;text-transform:uppercase;color:var(--amber)}.delivery-block{max-width:820px;margin:44px auto 0;text-align:center;background:rgba(7,29,40,.35);border:1px solid var(--ochre);padding:14px 18px}.delivery-block p{margin:0}.delivery-block strong{color:var(--gold)}.delivery-block.paused{border-color:var(--crimson)}.specials-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin:30px auto 0}@media (max-width:680px){.day-card{padding:8px 12px 10px}.day-header{flex-wrap:wrap;gap:6px}.day-services,.day-card.is-weekend .day-services{grid-template-columns:1fr}}
  .week-block{max-width:1380px;margin:0 auto 24px;padding:0}.week-block:last-of-type{margin-bottom:0}.week-block__heading{margin:0 0 14px;font:400 clamp(1.15rem,2.4vw,1.5rem) var(--display);color:var(--gold);text-align:center}.allday-values .has-divider{margin-top:6px;padding-top:6px;border-top:1px dashed var(--rule-light);width:fit-content}
</style>

<style>.normalized-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:18px;align-items:start}.section-anchor{scroll-margin-top:100px}.mexican-menu{max-width:1380px;margin:32px auto;padding:20px;border:2px solid var(--ochre)}.rec-name a{color:inherit}@media(max-width:680px){.normalized-services{grid-template-columns:1fr}}</style>
