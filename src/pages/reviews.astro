---
import Base from '../layouts/Base.astro';
import displayFont from '@fontsource/alfa-slab-one/files/alfa-slab-one-latin-400-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import boldFont from '@fontsource/barlow/files/barlow-latin-700-normal.woff2?url';
import labelFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import { isAuthed } from '../lib/auth';
import {
  REVIEW_CATEGORIES, REVIEW_DESCRIPTION_LIMIT, REVIEW_HEADERS, reviewCategory, reviewCsrf, reviewImageUrl,
  reviewPreviewEnabled, reviewResponse, type ReviewCategory,
} from '../lib/review-preview';
import { runtimeEnv } from '../lib/runtime-env';

const env = runtimeEnv(Astro.locals);
if (!reviewPreviewEnabled(Astro.url, env) || !await isAuthed(Astro.cookies, env)) return reviewResponse('Not found', 404);
for (const [name, value] of Object.entries(REVIEW_HEADERS)) Astro.response.headers.set(name, value);

const requestedCategory = Astro.url.searchParams.get('category');
const category = reviewCategory(requestedCategory) ? requestedCategory : null;
const requestedPage = Number(Astro.url.searchParams.get('page'));
const page = Number.isSafeInteger(requestedPage) && requestedPage >= 1 && requestedPage <= 10000 ? requestedPage : 1;
const pageSize = 18;
type GalleryPhoto = {
  id: string; category: ReviewCategory; description: string;
  small_width: number; medium_width: number; medium_height: number;
};
let photos: GalleryPhoto[] = [];
let unavailable = false;
try {
  const db = env.DB.withSession('first-primary');
  const statement = db.prepare(
    `SELECT id, category, description, small_width, medium_width, medium_height
     FROM review_photos WHERE status = 'approved' ${category ? 'AND category = ?' : ''}
     ORDER BY updated_at DESC, id DESC LIMIT ? OFFSET ?`,
  );
  const result = await statement.bind(...(category ? [category] : []), pageSize + 1, (page - 1) * pageSize).all();
  photos = result.results;
} catch {
  unavailable = true;
}
const href = (filter: ReviewCategory | null, number = 1) => {
  const params = new URLSearchParams();
  if (filter) params.set('category', filter);
  if (number > 1) params.set('page', String(number));
  return `/reviews${params.size ? `?${params}` : ''}#gallery`;
};
const results: Record<string, string> = {
  submitted: 'Thanks for sharing! Your photos are pending staff review.',
  duplicate: 'At least one of these photos was already submitted. Remove the duplicate and try again.',
  'invalid-form': 'Choose up to three photos, describe each one, and confirm you have permission to share them.',
  'invalid-photo': 'A photo could not be read. Try another JPEG, PNG, or WebP file.',
  'too-large': 'Each photo must be 5 MB or smaller.',
  verification: 'Verification failed. Try the verification again before submitting.',
  unavailable: 'Photo submissions are temporarily unavailable. Please try again later.',
};
const result = Astro.url.searchParams.get('result') ?? '';
const feedback = Object.hasOwn(results, result) ? results[result] : '';
const canUpload = Boolean(env.REVIEW_PHOTOS && env.REVIEW_IMAGES && env.TURNSTILE_SITEKEY && env.TURNSTILE_SECRET && !unavailable);
const csrf = await reviewCsrf(Astro.cookies, env, 'upload');
// Google Maps matched the place ID against the business name, street address
// and phone number. Recheck the dated snapshot before enabling public access.
const googlePlaceId = 'ChIJAwP5xdDv-IcRiYQJPU_9snY';
const googleProfile = `https://www.google.com/maps/search/?api=1&query=Grayz%27n+Buffalo+Bar+%26+Grill%2C+Mondovi%2C+WI&query_place_id=${googlePlaceId}`;
const googleWriteReview = `https://search.google.com/local/writereview?placeid=${googlePlaceId}`;
---

<Base title="Photos & Reviews — Grayz'n Buffalo Bar & Grill" description="See what’s on the table at Grayz’n Buffalo and share photos from your visit.">
  <Fragment slot="head">
    {[displayFont, bodyFont, boldFont, labelFont].map(font => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
  </Fragment>
  <div class="reviews-page">
    <header class="reviews-heading">
      <p class="kicker">Grayz’n Buffalo Bar &amp; Grill</p>
      <h1>Photos &amp; Reviews</h1>
      <span class="vintage-rule" aria-hidden="true"></span>
      <p>Private staff preview for testing photo submissions and moderation.</p>
    </header>

    <div class="reviews-sheet">
      <section id="gallery" aria-labelledby="gallery-title">
        <div class="gallery-heading">
          <h2 id="gallery-title">From our guests</h2>
          <a href="#submit-photo">Share a photo <span aria-hidden="true">↓</span></a>
        </div>
        <nav class="review-filters" aria-label="Photo categories">
          <a href={href(null)} aria-current={!category ? 'true' : undefined}>All photos</a>
          {(Object.entries(REVIEW_CATEGORIES) as [ReviewCategory, string][]).map(([key, label]) => (
            <a href={href(key)} aria-current={category === key ? 'true' : undefined}>{label}</a>
          ))}
        </nav>

        {unavailable ? <p class="gallery-empty">The gallery is temporarily unavailable.</p>
          : photos.length ? (
            <ul class="review-gallery" role="list">
              {photos.slice(0, pageSize).map(photo => (
                <li>
                  <button type="button" data-lightbox-src={reviewImageUrl(photo.id, 'large')}
                    data-lightbox-alt={photo.description} aria-label={`View larger photo: ${photo.description}`}>
                    <img src={reviewImageUrl(photo.id, 'small')}
                      srcset={photo.medium_width > photo.small_width ? `${reviewImageUrl(photo.id, 'small')} ${photo.small_width}w, ${reviewImageUrl(photo.id, 'medium')} ${photo.medium_width}w` : undefined}
                      sizes="(max-width: 560px) calc(100vw - clamp(28px, 8vw, 96px) - 20px), (max-width: 900px) calc((100vw - clamp(28px, 8vw, 96px) - 58px) / 2), calc((min(100vw, 1160px) - clamp(28px, 8vw, 96px) - 96px) / 3)"
                      width={photo.medium_width} height={photo.medium_height} alt="" loading="lazy" decoding="async" />
                  </button>
                  <p>{photo.description}</p>
                  <span>{REVIEW_CATEGORIES[photo.category]}</span>
                </li>
              ))}
            </ul>
          ) : <p class="gallery-empty">No photos to show here yet.</p>}
        {(page > 1 || photos.length > pageSize) && (
          <nav class="review-paging" aria-label="Gallery pages">
            {page > 1 && <a href={href(category, page - 1)}>Previous</a>}
            {photos.length > pageSize && <a href={href(category, page + 1)}>Next</a>}
          </nav>
        )}
      </section>

      <aside class="google-reviews" aria-labelledby="google-title">
        <div>
          <h2 id="google-title">Google reviews</h2>
          <p><strong>4.6 out of 5</strong> from 291 Google reviews on November 22, 2026.</p>
        </div>
        <div class="review-links">
          <a class="btn btn-primary" href={googleProfile}>Read Google reviews</a>
          <a class="btn btn-primary" href={googleWriteReview}>Write a review</a>
        </div>
      </aside>

      <section id="submit-photo" class="review-submission" aria-labelledby="submission-title">
        <h2 id="submission-title">Share a photo</h2>
        <p id="photo-limits">Send up to three JPEG, PNG, or WebP photos. Each can be up to 5 MB and 24 megapixels. We review photos before sharing them.</p>
        {feedback && <p class="review-feedback" role={result === 'submitted' ? 'status' : 'alert'}>{feedback}</p>}
        {canUpload ? (
          <form method="post" action="/api/review-photos" enctype="multipart/form-data" aria-describedby="photo-limits">
            <input type="hidden" name="csrf" value={csrf} />
            <label>Category
              <select name="category" required>
                <option value="">Choose a category</option>
                {Object.entries(REVIEW_CATEGORIES).map(([key, label]) => <option value={key}>{label}</option>)}
              </select>
            </label>
            {[1, 2, 3].map(index => (
              <fieldset>
                <legend>Photo {index}{index > 1 && ' (optional)'}</legend>
                <input type="file" name="photo" aria-label={`Choose photo ${index}`}
                  accept="image/jpeg,image/png,image/webp" required={index === 1} />
                <label>Description for photo {index}
                  <input name={`description${index}`} maxlength={REVIEW_DESCRIPTION_LIMIT}
                    placeholder="For example, a pepperoni pizza on the bar" required={index === 1} />
                </label>
              </fieldset>
            ))}
            <p>We store originals privately. They may contain camera location data. We remove camera metadata from the copies displayed on the site. To request removal, <a href="/contact">contact us</a>.</p>
            <label class="review-consent">
              <input type="checkbox" name="consent" value="yes" required />
              <span>I took these photos or have permission to share them, including from anyone pictured. I give Grayz’n Buffalo permission to show approved photos and descriptions in its gallery and on its menu.</span>
            </label>
            <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITEKEY} data-size="compact"></div>
            <button class="btn btn-primary" type="submit">Submit photos</button>
          </form>
        ) : <p>Photo submissions are temporarily unavailable.</p>}
      </section>
    </div>
  </div>
</Base>
{canUpload && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .reviews-page {background:var(--surface-parchment) url('/parchment-texture.webp');color:var(--ink)}
  .reviews-heading {text-align:center;padding:clamp(38px,7vw,88px) 20px;background:var(--ink);color:var(--cream);border-block-end:4px solid var(--gold)}
  .reviews-heading .kicker {color:var(--gold)}
  .reviews-heading h1 {font:400 clamp(1.9rem,6vw,4.5rem)/1.12 var(--display);margin:12px 0}
  .reviews-heading p:last-child {margin:10px auto 0;max-width:32rem}
  .reviews-sheet {max-width:1160px;margin-inline:auto;padding:clamp(28px,5vw,64px) clamp(14px,4vw,48px)}
  .reviews-sheet > section {padding:0}
  h2 {font:400 clamp(1.3rem,3vw,2.05rem)/1.25 var(--display);margin:0 0 10px}
  .gallery-heading,.google-reviews {display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:baseline}
  .reviews-sheet a:not(.btn) {color:var(--btn-crimson);text-decoration:underline;text-underline-offset:3px;font-weight:700}
  .review-filters,.review-paging {display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 18px}
  .review-filters a {padding:9px 16px;border:1px solid var(--rule);border-radius:4px;background:var(--cream)}
  .review-filters a[aria-current] {background:var(--ink);color:var(--cream);text-decoration:none}
  .review-gallery {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;list-style:none;margin:0;padding:0}
  .review-gallery li {background:var(--cream);padding:9px 9px 12px;border:1px solid var(--rule);box-shadow:0 4px 8px #27180f23;overflow-wrap:anywhere}
  .review-gallery button {display:block;width:100%;padding:0;border:0;background:var(--ink);cursor:zoom-in}
  .review-gallery img {display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain}
  .review-gallery p {margin:8px 3px 1px;font-weight:600}
  .review-gallery span {display:block;margin-inline:3px;font-size:.9rem}
  .gallery-empty {padding:20px;border:1px dashed var(--rule)}
  .google-reviews {margin:clamp(30px,6vw,68px) 0;padding:clamp(16px,3vw,32px);border-block:2px solid var(--rule);background:var(--cream)}
  .google-reviews p {margin:0}
  .review-links {display:flex;flex-wrap:wrap;gap:8px}
  .review-submission {max-width:650px;margin-inline:auto}
  .review-submission form {display:grid;gap:14px;margin-top:16px}
  .review-submission fieldset {min-width:0;margin:0;padding:10px 12px 12px;border:1px solid var(--rule)}
  .review-submission input:not([type=checkbox]),.review-submission select {display:block;max-width:100%;width:100%;margin:5px 0 8px;padding:8px;border:1px solid var(--rule);background:var(--cream);color:var(--ink);font:inherit}
  .review-consent {display:flex;gap:10px;align-items:flex-start}
  .review-consent input {margin-top:5px;width:18px;height:18px;flex:none}
  .review-submission button {justify-self:start}
  .review-submission .cf-turnstile {min-height:140px}
  .review-feedback {padding:12px;border-inline-start:4px solid var(--btn-crimson);background:var(--cream)}
  .reviews-sheet :is(a,button,input,select):focus-visible {outline:3px solid var(--ink);outline-offset:3px}
  @media (max-width:900px) {.review-gallery {grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:560px) {
    .review-gallery {grid-template-columns:1fr}
    :global(body:has(.reviews-page) .delivery-notice) {width:100%}
  }
  @media (max-width:350px) {
    .reviews-heading h1 {min-height:2.24em}
    .reviews-heading p:last-child {min-height:3.2em}
  }
</style>
