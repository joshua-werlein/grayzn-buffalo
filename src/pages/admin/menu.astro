---
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { thumbKey } from '../../lib/db';

const env = (Astro.locals as any).runtime?.env ?? {};
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');

/** Remove both variants from R2. Never throws — an orphaned object is not
 *  worth failing a request over, and the row is already gone by then. */
async function dropPhoto(key: string | null | undefined) {
  if (!key || !env.PHOTOS) return;
  await Promise.allSettled([
    env.PHOTOS.delete(key),
    env.PHOTOS.delete(thumbKey(key)),
  ]);
}

let notice = '';
let problem = '';

// Photo upload/remove goes to /api/menu-photo so the page can update in place.
// These handlers cover everything else.
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = f.get('action');
  try {
    if (action === 'add') {
      const result = await env.DB.prepare(
        'INSERT INTO items (category_id, name, description, late_night, sort) VALUES (?1, ?2, ?3, ?4, COALESCE((SELECT MAX(sort)+1 FROM items WHERE category_id=?1), 0))'
      ).bind(
        Number(f.get('category_id')),
        String(f.get('name')),
        String(f.get('description') ?? ''),
        f.get('late_night') ? 1 : 0
      ).run();

      const id = Number(result.meta?.last_row_id);
      if (Astro.request.headers.get('accept')?.includes('application/json')) {
        return new Response(JSON.stringify({ ok: true, id, message: 'Item added.' }), {
          headers: { 'content-type': 'application/json' },
        });
      }
      notice = 'Item added.';

    } else if (action === 'edit') {
      await env.DB.prepare(
        'UPDATE items SET name = ?2, description = ?3, category_id = ?4, late_night = ?5 WHERE id = ?1'
      ).bind(
        Number(f.get('id')),
        String(f.get('name')),
        String(f.get('description') ?? ''),
        Number(f.get('category_id')),
        f.get('late_night') ? 1 : 0
      ).run();
      notice = 'Changes saved.';

    } else if (action === 'delete') {
      const id = Number(f.get('id'));
      const row: any = await env.DB.prepare('SELECT photo_key FROM items WHERE id = ?1').bind(id).first();
      await env.DB.prepare('DELETE FROM items WHERE id = ?1').bind(id).run();
      await dropPhoto(row?.photo_key);
      notice = 'Item removed.';

    } else if (action === 'toggle') {
      await env.DB.prepare('UPDATE items SET active = 1 - active WHERE id = ?1').bind(Number(f.get('id'))).run();
      notice = 'Item updated.';
    }
  } catch (e: any) {
    problem = e?.message ?? 'Something went wrong. Check the database connection — see README.';
    if (Astro.request.headers.get('accept')?.includes('application/json')) {
      return new Response(JSON.stringify({ ok: false, error: problem }), {
        status: 500,
        headers: { 'content-type': 'application/json' },
      });
    }
  }
}

let categories: any[] = [], items: any[] = [];
try {
  categories = (await env.DB.prepare('SELECT * FROM categories ORDER BY sort').all()).results ?? [];
  items = (await env.DB.prepare('SELECT * FROM items ORDER BY category_id, sort').all()).results ?? [];
} catch {}
---
<Base title="Admin · Menu — Grayz'n Buffalo">
<section>
  <div class="section-head">
    <h2>Menu Items</h2>
    <p class="back back-top"><a href="/admin">← Back to admin</a></p>
    {notice && <p class="flash ok">{notice}</p>}
    {problem && <p class="flash bad">{problem}</p>}
  </div>

  <div class="admin-wrap">
    <form method="post" class="card add-form" id="add-item-form">
      <h3>Add an item</h3>
      <div class="field">
        <label for="add-cat">Section</label>
        <select id="add-cat" name="category_id" required>
          {categories.map((c:any) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="add-name">Item name</label>
        <input id="add-name" name="name" required />
      </div>
      <div class="field wide">
        <label for="add-desc">Description <span class="hint">optional</span></label>
        <input id="add-desc" name="description" />
      </div>
      <div class="field wide check">
        <label for="add-late">
          <input id="add-late" type="checkbox" name="late_night" value="1" />
          Available late night <span class="hint">(after the grill closes — pizza, pizza fries, appetizers)</span>
        </label>
      </div>
      <div class="field wide add-photo-field">
        <span class="field-label">Photo <span class="hint">optional</span></span>
        <div class="pick">
          <label class="pick-btn">
            <span>Take a photo</span>
            <input type="file" accept="image/*" capture="environment" data-add-photo />
          </label>
          <label class="pick-btn">
            <span>Choose from gallery</span>
            <input type="file" accept="image/*" data-add-photo />
          </label>
        </div>
        <p class="add-photo-status" id="add-photo-status">No photo selected.</p>
      </div>
      <input type="hidden" name="action" value="add" />
      <button class="btn btn-primary" type="submit">Add item</button>
    </form>

    <nav class="jump-card" aria-label="Jump to menu section">
      <p>Jump to section</p>
      <div class="jump-links">
        {categories.map((c:any) => (
          <a href={`#cat-${slug(c.name)}`}>{c.name}</a>
        ))}
      </div>
    </nav>

    {categories.map((c:any) => (
      <div class="cat" id={`cat-${slug(c.name)}`}>
        <h3>{c.name}</h3>
        <ul>
          {items.filter((i:any) => i.category_id === c.id).map((i:any) => (
            <li id={`item-${i.id}`} class={i.active ? '' : 'inactive'}>
              <div class="row">
                <div class="thumb">
                  <img
                    data-thumb-for={i.id}
                    src={i.photo_key ? `/img/${thumbKey(i.photo_key)}` :  undefined}
                    alt=""
                    width="56"
                    height="44"
                    loading="lazy"
                    hidden={!i.photo_key}
                  />
                  <span class="no-photo" data-empty-for={i.id} hidden={!!i.photo_key} aria-hidden="true">—</span>
                </div>
                <div class="who">
                  <strong>{i.name}</strong>
                  {i.late_night === 1 && <span class="late-badge">Late night</span>}
                  {i.description
                    ? <span class="desc">{i.description}</span>
                    : <span class="desc muted">No description yet</span>}
                </div>
                <div class="row-actions">
                  <form method="post">
                    <input type="hidden" name="action" value="toggle" />
                    <input type="hidden" name="id" value={i.id} />
                    <button type="submit">{i.active ? 'Hide' : 'Show'}</button>
                  </form>
                  <form method="post" onsubmit="return confirm('Delete this item and its photo?')">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={i.id} />
                    <button class="danger" type="submit">Delete</button>
                  </form>
                </div>
              </div>

              <details class="editor">
                <summary>Edit</summary>

                <form method="post" class="edit-form">
                  <input type="hidden" name="action" value="edit" />
                  <input type="hidden" name="id" value={i.id} />
                  <div class="field">
                    <label for={`n-${i.id}`}>Item name</label>
                    <input id={`n-${i.id}`} name="name" value={i.name} required />
                  </div>
                  <div class="field">
                    <label for={`c-${i.id}`}>Section</label>
                    <select id={`c-${i.id}`} name="category_id">
                      {categories.map((cc:any) => (
                        <option value={cc.id} selected={cc.id === i.category_id}>{cc.name}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field wide">
                    <label for={`d-${i.id}`}>Description <span class="hint">optional</span></label>
                    <input id={`d-${i.id}`} name="description" value={i.description ?? ''} />
                  </div>
                  <div class="field wide check">
                    <label for={`l-${i.id}`}>
                      <input id={`l-${i.id}`} type="checkbox" name="late_night" value="1" checked={i.late_night === 1} />
                      Available late night
                    </label>
                  </div>
                  <button class="btn btn-primary" type="submit">Save changes</button>
                </form>

                <div class="photo-card">
                  <p class="photo-title">Photo</p>

                  <div class="preview">
                    <img
                      data-preview-for={i.id}
                      data-full-url={i.photo_key ? `/img/${i.photo_key}` : undefined}
                      src={i.photo_key ? `/img/${thumbKey(i.photo_key)}` : undefined}
                      alt={`Current photo for ${i.name}`}
                      loading="lazy"
                      hidden={!i.photo_key}
                    />
                    <p class="preview-empty" data-preview-empty={i.id} hidden={!!i.photo_key}>
                      No photo yet.
                    </p>
                  </div>

                  <div class="pick">
                    <label class="pick-btn">
                      <span>Take a photo</span>
                      <input type="file" accept="image/*" capture="environment" data-upload={i.id} />
                    </label>
                    <label class="pick-btn">
                      <span>Choose from gallery</span>
                      <input type="file" accept="image/*" data-upload={i.id} />
                    </label>
                  </div>

                  <div class="photo-tools" data-rotate-tools={i.id} hidden={!i.photo_key}>
                    <button class="rotate-photo" type="button" data-rotate={i.id} data-degrees="-90">Rotate left</button>
                    <button class="rotate-photo" type="button" data-rotate={i.id} data-degrees="90">Rotate right</button>
                  </div>

                  <button
                    class="danger remove-photo"
                    type="button"
                    data-remove={i.id}
                    hidden={!i.photo_key}
                  >Remove photo</button>

                  <noscript>
                    <p class="hint">Photo uploads need JavaScript turned on.</p>
                  </noscript>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="back"><a href="/admin">← Back to admin</a></p>
  </div>
</section>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
</Base>

<script>
  import { convertPhoto, PhotoError } from '../../lib/photo-client';

  const toastEl = document.getElementById('toast')!;
  const addForm = document.querySelector<HTMLFormElement>('#add-item-form');
  const addPhotoStatus = document.querySelector<HTMLElement>('#add-photo-status');
  let pendingAddPhoto: File | null = null;
  let toastTimer: number | undefined;

  function toast(message: string, kind: 'ok' | 'bad' | 'busy' = 'ok') {
    window.clearTimeout(toastTimer);
    toastEl.textContent = message;
    toastEl.className = `toast show ${kind}`;
    toastEl.hidden = false;
    if (kind !== 'busy') {
      toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 3200);
    }
  }

  const carriedNotice = sessionStorage.getItem('menuNotice');
  if (carriedNotice) {
    sessionStorage.removeItem('menuNotice');
    toast(carriedNotice, 'ok');
  }

  document.querySelectorAll<HTMLInputElement>('input[data-add-photo]').forEach((input) => {
    input.addEventListener('change', () => {
      const file = input.files?.[0] ?? null;
      if (!file) return;
      pendingAddPhoto = file;
      document.querySelectorAll<HTMLInputElement>('input[data-add-photo]').forEach((other) => {
        if (other !== input) other.value = '';
      });
      if (addPhotoStatus) addPhotoStatus.textContent = `Selected: ${file.name}`;
    });
  });

  async function uploadPhoto(id: string, file: File, rotation = 0) {
    const { full, thumb } = await convertPhoto(file, rotation);
    const body = new FormData();
    body.append('id', id);
    body.append('full', full, 'photo.webp');
    body.append('thumb', thumb, 'photo@600.webp');

    const res = await fetch('/api/menu-photo', { method: 'POST', body });
    const data = await res.json();
    if (!res.ok || !data.ok) throw new Error(data.error ?? 'Upload failed. Try again.');
    return data as { thumbUrl: string; fullUrl: string; message?: string };
  }

  addForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = addForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;

    try {
      toast('Adding item…', 'busy');
      const res = await fetch('/admin/menu', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: new FormData(addForm),
      });
      const data = await res.json();
      if (!res.ok || !data.ok || !data.id) throw new Error(data.error ?? 'Could not add the item.');

      if (pendingAddPhoto) {
        toast('Resizing and uploading photo…', 'busy');
        await uploadPhoto(String(data.id), pendingAddPhoto);
      }

      sessionStorage.setItem('menuNotice', pendingAddPhoto ? 'Item and photo added.' : 'Item added.');
      location.href = `/admin/menu#item-${data.id}`;
    } catch (err) {
      toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      if (submit) submit.disabled = false;
    }
  });

  function paint(id: string, thumbUrl: string | null, fullUrl: string | null = null) {
    const thumb = document.querySelector<HTMLImageElement>(`[data-thumb-for="${id}"]`);
    const empty = document.querySelector<HTMLElement>(`[data-empty-for="${id}"]`);
    const preview = document.querySelector<HTMLImageElement>(`[data-preview-for="${id}"]`);
    const previewEmpty = document.querySelector<HTMLElement>(`[data-preview-empty="${id}"]`);
    const remove = document.querySelector<HTMLElement>(`[data-remove="${id}"]`);
    const rotateTools = document.querySelector<HTMLElement>(`[data-rotate-tools="${id}"]`);

    if (thumbUrl) {
      const bust = `${thumbUrl}${thumbUrl.includes('?') ? '&' : '?'}v=${Date.now()}`;
      if (thumb) { thumb.src = bust; thumb.hidden = false; }
      if (preview) {
        preview.src = bust;
        preview.hidden = false;
        if (fullUrl) preview.dataset.fullUrl = fullUrl;
      }
      if (empty) empty.hidden = true;
      if (previewEmpty) previewEmpty.hidden = true;
      if (remove) remove.hidden = false;
      if (rotateTools) rotateTools.hidden = false;
    } else {
      if (thumb) { thumb.hidden = true; thumb.removeAttribute('src'); }
      if (preview) {
        preview.hidden = true;
        preview.removeAttribute('src');
        delete preview.dataset.fullUrl;
      }
      if (empty) empty.hidden = false;
      if (previewEmpty) previewEmpty.hidden = false;
      if (remove) remove.hidden = true;
      if (rotateTools) rotateTools.hidden = true;
    }
  }

  function lock(id: string, busy: boolean) {
    document.querySelectorAll<HTMLInputElement>(`[data-upload="${id}"]`).forEach((el) => { el.disabled = busy; });
    document.querySelectorAll<HTMLButtonElement>(`[data-rotate="${id}"], [data-remove="${id}"]`).forEach((el) => { el.disabled = busy; });
  }

  document.querySelectorAll<HTMLInputElement>('input[data-upload]').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      const id = input.dataset.upload!;
      if (!file) return;

      lock(id, true);
      toast('Resizing photo…', 'busy');
      try {
        const data = await uploadPhoto(id, file);
        paint(id, data.thumbUrl, data.fullUrl);
        toast(data.message ?? 'Photo saved.', 'ok');
      } catch (err) {
        toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      } finally {
        lock(id, false);
        input.value = '';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button[data-rotate]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.rotate!;
      const degrees = Number(btn.dataset.degrees ?? 0);
      const preview = document.querySelector<HTMLImageElement>(`[data-preview-for="${id}"]`);
      const fullUrl = preview?.dataset.fullUrl;
      if (!fullUrl) return toast('The original photo could not be loaded.', 'bad');

      lock(id, true);
      toast('Rotating photo…', 'busy');
      try {
        const source = await fetch(fullUrl, { cache: 'no-store' });
        if (!source.ok) throw new Error('The original photo could not be loaded.');
        const blob = await source.blob();
        const file = new File([blob], 'photo.webp', { type: blob.type || 'image/webp' });
        const data = await uploadPhoto(id, file, degrees);
        paint(id, data.thumbUrl, data.fullUrl);
        toast('Photo rotated.', 'ok');
      } catch (err) {
        toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      } finally {
        lock(id, false);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button[data-remove]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.remove!;
      if (!confirm('Remove this photo?')) return;

      lock(id, true);
      toast('Removing…', 'busy');
      try {
        const body = new FormData();
        body.append('id', id);
        body.append('remove', '1');
        const res = await fetch('/api/menu-photo', { method: 'POST', body });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error ?? 'Could not remove the photo.');
        paint(id, null);
        toast(data.message ?? 'Photo removed.', 'ok');
      } catch (err) {
        toast((err as Error).message, 'bad');
      } finally {
        lock(id, false);
      }
    });
  });
</script>

<style>
  .admin-wrap{max-width:780px;margin:0 auto}

  .flash{font-family:var(--label);font-weight:700;letter-spacing:.04em;
    padding:10px 16px;border-radius:8px;display:inline-block;margin-top:10px}
  .flash.ok{background:var(--gold);color:var(--ink)}
  .flash.bad{background:#8d1626;color:var(--cream)}

  .card{background:#fff;border-radius:12px;padding:18px;
    box-shadow:0 6px 16px rgba(36,22,16,.1)}
  .add-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:32px}
  .add-form h3{grid-column:1/-1;font-family:var(--display);font-size:1.2rem}
  .add-form button{grid-column:1/-1;justify-self:start}
  .field-label{font-family:var(--label);font-weight:600;letter-spacing:.1em;text-transform:uppercase;font-size:.78rem;color:var(--ink-2)}
  .add-photo-status{font-size:.85rem;color:var(--ink-2);opacity:.75}

  .field{display:flex;flex-direction:column;gap:5px}
  .field.wide{grid-column:1/-1}
  .field label{font-family:var(--label);font-weight:600;letter-spacing:.1em;
    text-transform:uppercase;font-size:.78rem;color:var(--ink-2)}
  .field input,.field select{padding:10px;border:2px solid rgba(36,22,16,.2);
    border-radius:8px;background:var(--cream);font-family:var(--body);width:100%}
  .field input:focus-visible,.field select:focus-visible{outline:2px solid var(--crimson);outline-offset:1px}
  .hint{font-weight:500;text-transform:none;letter-spacing:0;
    color:var(--ink-2);opacity:.75;font-size:.8rem}

  /* checkbox rows read as a normal-case control, not an uppercase field label */
  .field.check label{display:flex;align-items:center;gap:10px;
    text-transform:none;letter-spacing:0;font-weight:600;font-size:.95rem;color:var(--ink)}
  .field.check input{width:auto;padding:0;flex:0 0 auto;
    width:20px;height:20px;accent-color:var(--crimson)}

  .jump-card{margin:0 0 22px;padding:14px;border-radius:10px;background:var(--ink);color:var(--cream);
    box-shadow:0 6px 16px rgba(36,22,16,.18)}
  .jump-card p{margin:0 0 10px;font-family:var(--label);font-weight:700;letter-spacing:.08em;
    text-transform:uppercase;font-size:.78rem}
  .jump-links{display:flex;gap:8px;flex-wrap:wrap}
  .jump-links a{flex:1 1 auto;padding:9px 12px;border:1px solid var(--cream-2);border-radius:7px;
    background:var(--cream);color:var(--ink);font-family:var(--label);font-weight:700;
    letter-spacing:.04em;text-align:center;text-decoration:none;white-space:nowrap}
  .jump-links a:hover{background:var(--gold)}
  .jump-links a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
  .cat{scroll-margin-top:90px}
  .cat h3{font-family:var(--display);margin:26px 0 8px}
  .cat ul{list-style:none}
  .cat li{padding:12px 4px;border-bottom:1px dashed rgba(36,22,16,.25)}
  .cat li.inactive{opacity:.45}

  .row{display:flex;align-items:center;gap:12px}
  .thumb{flex:0 0 56px;height:44px;border-radius:6px;overflow:hidden;
    background:rgba(36,22,16,.08);display:grid;place-items:center}
  .thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .no-photo{color:var(--ink-2);opacity:.5}
  .who{flex:1;min-width:0}
  .who strong{display:block}
  .late-badge{display:inline-block;font-family:var(--label);font-weight:700;
    letter-spacing:.08em;text-transform:uppercase;font-size:.62rem;
    background:var(--ink);color:var(--cream);padding:2px 7px;border-radius:999px;
    margin:2px 0}
  .desc{color:var(--ink-2);font-size:.9rem}
  .desc.muted{opacity:.55;font-style:italic}

  .row-actions{display:flex;gap:8px;flex-shrink:0}
  .row-actions button,.remove-photo,.rotate-photo{padding:6px 12px;border-radius:6px;
    border:2px solid var(--ink);background:transparent;cursor:pointer;
    font-family:var(--label);font-weight:600;letter-spacing:.08em;
    text-transform:uppercase;font-size:.75rem}
  .row-actions .danger,.remove-photo{border-color:var(--crimson);color:var(--crimson)}

  .editor{margin-top:10px}
  .editor summary{cursor:pointer;font-family:var(--label);font-weight:600;
    letter-spacing:.1em;text-transform:uppercase;font-size:.75rem;
    color:var(--ink-2);padding:4px 0}
  .editor summary:focus-visible{outline:2px solid var(--crimson);outline-offset:2px}
  .edit-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;
    background:#fff;border-radius:12px;padding:16px;margin:10px 0;
    box-shadow:0 4px 12px rgba(36,22,16,.08)}
  .edit-form button{grid-column:1/-1;justify-self:start}

  /* ---- photo card ---- */
  .photo-card{background:#fff;border-radius:12px;padding:16px;margin:10px 0;
    box-shadow:0 4px 12px rgba(36,22,16,.08);
    display:flex;flex-direction:column;gap:12px;align-items:flex-start}
  .photo-title{font-family:var(--label);font-weight:600;letter-spacing:.1em;
    text-transform:uppercase;font-size:.78rem;color:var(--ink-2)}
  .preview{width:100%;max-width:420px;aspect-ratio:4/3;border-radius:10px;overflow:hidden;
    background:rgba(36,22,16,.08);display:grid;place-items:center}
  .preview img{width:100%;height:100%;object-fit:cover;object-position:center;border-radius:10px;display:block;
    border:2px solid rgba(36,22,16,.15)}
  .preview-empty{color:var(--ink-2);opacity:.6;font-style:italic;font-size:.9rem}
 .thumb img[hidden],
  .preview img[hidden]{display:none}
  .pick,.photo-tools{display:flex;gap:10px;flex-wrap:wrap}
  .rotate-photo{border:2px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;
