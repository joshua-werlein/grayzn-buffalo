---
import { runtimeEnv } from '../../lib/runtime-env';
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { thumbKey } from '../../lib/db';
import { normalizeMenuCase } from '../../lib/text-case.js';
import { getPizzaOptions, pizzaOptionsFromForm, PIZZA_SIZES, PIZZA_CRUSTS } from '../../lib/pizza-options.js';
import { getMenuSauces } from '../../lib/menu-sauces';
import { SAUCES_SECTION, SIDES_SECTION, getSectionSort, sectionIndex, sectionName, effectiveSectionSort, validSectionSort, saveSectionSortStatement, interleave } from '../../lib/menu-sections';
import {
  getMenuOptions, wrapOptionsFromForm, saladOptionsFromForm, substituteSidesFromForm, isSaladCategory,
  WRAP_OPTIONS_KEY, SALAD_OPTIONS_KEY, SUBSTITUTE_SIDES_KEY, SALAD_SHELL_NOTE, SUBSTITUTE_SIDES_NOTE,
} from '../../lib/menu-options.js';

const env = runtimeEnv(Astro.locals);
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const wantsJson = Astro.request.headers.get('accept')?.includes('application/json');
const jsonResponse = (body: Record<string, unknown>, status = 200) =>
  new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
if (!(await isAuthed(Astro.cookies, env))) {
  // In-page saves need JSON, not the sign-in page's HTML. Nothing was saved either way.
  if (wantsJson) return jsonResponse({ ok: false, code: 'auth', error: 'Your session expired, so this change was not saved. Sign in again, then make the change again.' }, 401);
  return Astro.redirect(Astro.request.method === 'POST' ? '/admin?next=/admin/menu&expired=1' : '/admin?next=/admin/menu');
}
// Line breaks arrive as CRLF from forms but LF from page attributes; compare without CR.
const noCr = (value: unknown) => String(value ?? '').replace(/\r/g, '');
async function saveOptions(key: string, value: unknown, form: FormData) {
  const loaded = form.get('options_snapshot');
  const conflict = 'Someone else changed these options since you opened the page. Your changes were not saved. Refresh the page to review the latest options.';
  if (loaded === null) throw new Error(conflict);
  let result;
  try {
    result = await env.DB.prepare(
      "INSERT INTO settings (key, value) SELECT ?1, ?2 WHERE COALESCE((SELECT value FROM settings WHERE key = ?1), '') = ?3 ON CONFLICT(key) DO UPDATE SET value = excluded.value"
    ).bind(key, JSON.stringify(value), String(loaded)).run();
  } catch {
    throw new Error('Could not save these options. Please try again.');
  }
  if (!Number(result.meta?.changes ?? 0)) throw new Error(conflict);
}

/** Remove both variants from R2. Never throws — an orphaned object is not
 *  worth failing a request over, and the row is already gone by then. */
async function dropPhoto(key: string | null | undefined) {
  if (!key || !env.PHOTOS) return;
  await Promise.allSettled([
    env.PHOTOS.delete(key),
    env.PHOTOS.delete(thumbKey(key)),
  ]);
}

// Compact status codes used in ?sm= query param (PRG pattern for section actions).
const SM_MESSAGES: Record<string, { ok: boolean; text: string }> = {
  s1: { ok: true,  text: 'Section added.' },
  s2: { ok: true,  text: 'Section updated.' },
  s3: { ok: true,  text: 'Section order saved.' },
  s4: { ok: true,  text: 'Section deleted.' },
  e1: { ok: false, text: 'Section name is required.' },
  e2: { ok: false, text: 'Section name must be 60 characters or fewer.' },
  e3: { ok: false, text: 'Invalid section.' },
  e4: { ok: false, text: 'Remove all items from this section before deleting it.' },
  e5: { ok: false, text: 'Something went wrong. Check the database connection — see README.' },
  e6: { ok: false, text: 'Sauces order must be a whole number from 0 to 999.' },
  e7: { ok: false, text: 'Substitute Sides order must be a whole number from 0 to 999.' },
  e8: { ok: false, text: 'That section was deleted by someone else. Nothing was saved.' },
  e9: { ok: false, text: 'Someone else changed this section since you opened the page. Your changes were not saved. Review the section below and make your change again.' },
  e10: { ok: false, text: 'Someone else changed the section order since you opened the page. Nothing was saved. Review the order below and try again.' },
};
// Thrown inside the order batch when a section moved or was deleted since the page loaded.
const STALE_ORDER = 'Section order changed.';
let notice = '';
let problem = '';
let pizzaDraft: FormData | null = null;
// Shared Menu options (Wraps, Salads, Substitute Sides): the form being corrected after an error.
let optionsDraft: { action: string; form: FormData } | null = null;
// The saved item text, returned so the editor shows the house capitalization.
let saved: Record<string, unknown> | null = null;

// Photo upload/remove goes to /api/menu-photo so the page can update in place.
// These handlers cover everything else.
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = f.get('action');
  const isSectionAction = ['add-section', 'edit-section', 'reorder-sections', 'delete-section'].includes(String(action));
  try {
    if (action === 'pizza-options') {
      if (Astro.request.headers.get('origin') !== Astro.url.origin) {
        return new Response('Invalid request origin.', { status: 403 });
      }
      pizzaDraft = f;
      const options = pizzaOptionsFromForm(f);
      await saveOptions('menu_pizza_options', options, f);
      return Astro.redirect('/admin/menu?pizza=saved#pizza-options', 303);
    } else if (action === 'wrap-options' || action === 'salad-options' || action === 'substitute-sides') {
      if (Astro.request.headers.get('origin') !== Astro.url.origin) {
        return new Response('Invalid request origin.', { status: 403 });
      }
      optionsDraft = { action, form: f };
      const [key, read, anchor] = action === 'wrap-options' ? [WRAP_OPTIONS_KEY, wrapOptionsFromForm, 'wrap-options']
        : action === 'salad-options' ? [SALAD_OPTIONS_KEY, saladOptionsFromForm, 'salad-options']
        : [SUBSTITUTE_SIDES_KEY, substituteSidesFromForm, 'substitute-sides-options'];
      const value = read(f);
      await saveOptions(key, value, f);
      return Astro.redirect(`/admin/menu?options=${anchor}#${anchor}`, 303);
    } else if (action === 'section-details') {
      throw new Error('This page is out of date. Nothing was saved. Refresh the page, then edit the section in Manage Sections.');
    } else if (action === 'add') {
      const result = await env.DB.prepare(
        'INSERT INTO items (category_id, name, description, late_night, sort) VALUES (?1, ?2, ?3, ?4, COALESCE((SELECT MAX(sort)+1 FROM items WHERE category_id=?1), 0))'
      ).bind(
        Number(f.get('category_id')),
        normalizeMenuCase(String(f.get('name'))),
        normalizeMenuCase(String(f.get('description') ?? '')),
        f.get('late_night') ? 1 : 0
      ).run();

      const addResponse = wantsJson
        ? new Response(JSON.stringify({ ok: true, id: Number(result.meta?.last_row_id), message: 'Item added.' }), {
          headers: { 'content-type': 'application/json' },
        })
        : null;
      if (addResponse) return addResponse;
      notice = 'Item added.';

    } else if (action === 'edit') {
      const id = Number(f.get('id'));
      const categoryId = Number(f.get('category_id'));
      const lateNight = f.get('late_night') ? 1 : 0;
      const name = normalizeMenuCase(String(f.get('name')));
      const description = normalizeMenuCase(String(f.get('description') ?? ''));
      // The editor sends the values it loaded. The row is updated only if it still holds
      // them, so an older tab cannot overwrite a newer save. A section change puts the
      // item at the end of its new section, where the page also shows it.
      const loaded = ['was_name', 'was_description', 'was_category_id', 'was_late_night'].map(k => f.get(k));
      let changes = 0;
      if (!loaded.includes(null)) {
        try {
          const result = await env.DB.prepare(
            `UPDATE items SET name = ?2, description = ?3, late_night = ?5, category_id = ?4,
               sort = CASE WHEN category_id = ?4 THEN sort ELSE COALESCE((SELECT MAX(sort) + 1 FROM items WHERE category_id = ?4), 0) END
             WHERE id = ?1 AND REPLACE(name, char(13), '') = ?6 AND REPLACE(COALESCE(description, ''), char(13), '') = ?7 AND category_id = ?8 AND late_night = ?9`
          ).bind(id, name, description, categoryId, lateNight,
            noCr(loaded[0]), noCr(loaded[1]), Number(loaded[2]), Number(loaded[3]) ? 1 : 0).run();
          changes = Number(result.meta?.changes ?? 0);
        } catch (e: any) {
          if (/FOREIGN KEY/i.test(String(e?.message))) throw new Error('That section was deleted by someone else. Your changes were not saved. Refresh the page and choose another section.');
          throw e;
        }
      }
      if (!changes) {
        const exists = await env.DB.prepare('SELECT 1 AS found FROM items WHERE id = ?1').bind(id).first();
        const error = !exists
          ? 'This item was deleted by someone else. Your changes were not saved.'
          : loaded.includes(null)
            ? 'This page is out of date. Your changes were not saved. Refresh the page, then make your change again.'
            : 'Someone else changed this item since you opened it. Your changes were not saved. Refresh the page to see the latest version, then make your change again.';
        if (wantsJson) return jsonResponse({ ok: false, code: exists ? 'conflict' : 'deleted', error }, exists ? 409 : 404);
        throw new Error(error);
      }
      saved = { name, description, category_id: categoryId, late_night: lateNight };
      notice = 'Saved.';

    } else if (action === 'delete') {
      const id = Number(f.get('id'));
      const row: any = await env.DB.prepare('SELECT photo_key FROM items WHERE id = ?1').bind(id).first();
      const result = await env.DB.prepare('DELETE FROM items WHERE id = ?1').bind(id).run();
      if (!Number(result.meta?.changes ?? 0)) throw new Error('This item was deleted by someone else. Nothing was removed.');
      await dropPhoto(row?.photo_key);
      notice = 'Item removed.';

    } else if (action === 'toggle') {
      // The button sends the visibility staff asked for, so repeating Hide keeps an item hidden.
      const active = f.get('active');
      if (active !== '0' && active !== '1') throw new Error('This page is out of date. Refresh the page, then try again.');
      const result = await env.DB.prepare('UPDATE items SET active = ?2 WHERE id = ?1').bind(Number(f.get('id')), Number(active)).run();
      if (!Number(result.meta?.changes ?? 0)) {
        const error = 'This item was deleted by someone else.';
        if (wantsJson) return jsonResponse({ ok: false, code: 'deleted', error }, 404);
        throw new Error(error);
      }
      saved = { active: Number(active) };
      notice = active === '1' ? 'Item shown.' : 'Item hidden.';

    } else if (action === 'add-section') {
      const name = normalizeMenuCase(String(f.get('name') ?? '').trim());
      if (!name) throw new Error('Section name is required.');
      if (name.length > 60) throw new Error('Section name must be 60 characters or fewer.');
      await env.DB.prepare(
        'INSERT INTO categories (name, subtitle, note, sort) VALUES (?1, ?2, ?3, COALESCE((SELECT MAX(sort)+1 FROM categories), 0))'
      ).bind(name, String(f.get('subtitle') ?? '').trim(), String(f.get('note') ?? '').trim()).run();
      return Astro.redirect('/admin/menu?sm=s1', 303);

    } else if (action === 'edit-section') {
      const id = Number(f.get('category_id'));
      if (!Number.isInteger(id) || id <= 0) throw new Error('Invalid section.');
      const name = normalizeMenuCase(String(f.get('name') ?? '').trim());
      if (!name) throw new Error('Section name is required.');
      if (name.length > 60) throw new Error('Section name must be 60 characters or fewer.');
      // Updated only if the section still has the values the edit panel loaded.
      const loaded = ['was_name', 'was_subtitle', 'was_note'].map(k => f.get(k));
      if (loaded.includes(null)) throw new Error(SM_MESSAGES.e9.text);
      const result = await env.DB.prepare(
        `UPDATE categories SET name = ?2, subtitle = ?3, note = ?4
         WHERE id = ?1 AND REPLACE(name, char(13), '') = ?5 AND REPLACE(subtitle, char(13), '') = ?6 AND REPLACE(note, char(13), '') = ?7`
      ).bind(id, name, String(f.get('subtitle') ?? '').trim(), String(f.get('note') ?? '').trim(),
        noCr(loaded[0]), noCr(loaded[1]), noCr(loaded[2])).run();
      if (!Number(result.meta?.changes ?? 0)) {
        const exists = await env.DB.prepare('SELECT 1 AS found FROM categories WHERE id = ?1').bind(id).first();
        throw new Error(exists ? SM_MESSAGES.e9.text : SM_MESSAGES.e8.text);
      }
      return Astro.redirect('/admin/menu?sm=s2', 303);

    } else if (action === 'reorder-sections') {
      const rows = Array.from(f.entries())
        .filter(([key]) => key.startsWith('sort_'))
        .map(([key, val]) => {
          const id = Number(key.slice(5));
          const sort = Number(val);
          if (!Number.isInteger(id) || id <= 0 || !Number.isFinite(sort) || sort < 0) return null;
          const was = f.get(`was_${id}`);
          return { id, sort: Math.round(sort), was: was === null ? null : Number(was) };
        })
        .filter(Boolean) as { id: number; sort: number; was: number | null }[];
      // Only numbers staff changed are written, and only if those sections still have the
      // numbers this page showed, so an older tab cannot undo someone else's reorder.
      const updates = rows.filter(r => r.was !== null && r.sort !== r.was);
      const unchangedSince = updates.map((_, i) => `(id = ?${i * 2 + 1} AND sort = ?${i * 2 + 2})`).join(' OR ');
      const unchangedArgs = updates.flatMap(r => [r.id, r.was]);
      const countUnchanged = () => env.DB.prepare(`SELECT COUNT(*) AS n FROM categories WHERE ${unchangedSince}`).bind(...unchangedArgs);
      // Runs first in the batch (one transaction): json('stale') raises an error that rolls the
      // whole batch back when any changed section moved or was deleted since the page loaded.
      const guard = updates.length ? [env.DB.prepare(
        `SELECT json(CASE WHEN (SELECT COUNT(*) FROM categories WHERE ${unchangedSince}) = ?${unchangedArgs.length + 1} THEN '0' ELSE 'stale' END) AS guard`
      ).bind(...unchangedArgs, updates.length)] : [];
      const virtualGuards: any[] = [];
      const virtualStatements: any[] = [];
      for (const [field, section, label] of [['sort_sauces', SAUCES_SECTION, 'Sauces'], ['sort_sides', SIDES_SECTION, 'Substitute Sides']] as const) {
        if (!f.has(field)) continue;
        const sort = validSectionSort(f.get(field));
        if (sort === null) throw new Error(`${label} order must be a whole number from 0 to 999.`);
        if (String(sort) === String(f.get(`${field}_was`) ?? '').trim()) continue;
        // Compare the raw saved setting, including an absent row, inside the same transaction.
        const loaded = f.get(`${field}_snapshot`);
        if (loaded === null) throw new Error(STALE_ORDER);
        virtualGuards.push(env.DB.prepare(
          "SELECT json(CASE WHEN COALESCE((SELECT value FROM settings WHERE key = ?1), '') = ?2 THEN '0' ELSE 'stale' END) AS guard"
        ).bind(section.sortKey, String(loaded)));
        virtualStatements.push(saveSectionSortStatement(env, section, sort));
      }
      // A form without the loaded numbers (a tab opened before this check) may not change any.
      if (rows.some(r => r.was === null)) {
        const current = new Map(((await env.DB.prepare('SELECT id, sort FROM categories').all()).results ?? []).map((c: any) => [Number(c.id), Number(c.sort)]));
        if (rows.some(r => r.was === null && current.get(r.id) !== r.sort)) throw new Error(STALE_ORDER);
      }
      const statements = [
        ...guard,
        ...virtualGuards,
        ...updates.map(({ id, sort }) => env.DB.prepare('UPDATE categories SET sort = ?2 WHERE id = ?1').bind(id, sort)),
        ...virtualStatements,
      ];
      if (statements.length) {
        try { await env.DB.batch(statements); }
        catch (e) {
          if (/malformed JSON/i.test(String((e as any)?.message))) throw new Error(STALE_ORDER);
          if (updates.length && Number((await countUnchanged().first())?.n) !== updates.length) throw new Error(STALE_ORDER);
          throw e;
        }
      }
      return Astro.redirect('/admin/menu?sm=s3', 303);

    } else if (action === 'delete-section') {
      const id = Number(f.get('category_id'));
      if (!Number.isInteger(id) || id <= 0) throw new Error('Invalid section.');
      const itemCount: any = await env.DB.prepare(
        'SELECT COUNT(*) as n FROM items WHERE category_id = ?1'
      ).bind(id).first();
      if (Number(itemCount?.n ?? 1) > 0) throw new Error('Remove all items from this section before deleting it.');
      const result = await env.DB.prepare('DELETE FROM categories WHERE id = ?1').bind(id).run();
      if (!Number(result.meta?.changes ?? 0)) throw new Error(SM_MESSAGES.e8.text);
      return Astro.redirect('/admin/menu?sm=s4', 303);
    }
    if (wantsJson) {
      return new Response(JSON.stringify({ ok: true, action, id: Number(f.get('id')), message: notice, ...(saved ?? {}) }), {
        headers: { 'content-type': 'application/json' },
      });
    }
  } catch (e: any) {
    const msg: string = e?.message ?? '';
    if (isSectionAction) {
      let code = 'e5';
      if (msg === 'Section name is required.') code = 'e1';
      else if (msg === 'Section name must be 60 characters or fewer.') code = 'e2';
      else if (msg === 'Invalid section.') code = 'e3';
      else if (msg === 'Remove all items from this section before deleting it.') code = 'e4';
      else if (msg === 'Sauces order must be a whole number from 0 to 999.') code = 'e6';
      else if (msg === SM_MESSAGES.e8.text) code = 'e8';
      else if (msg === SM_MESSAGES.e9.text) code = 'e9';
      else if (msg === STALE_ORDER) code = 'e10';
      else if (msg === 'Substitute Sides order must be a whole number from 0 to 999.') code = 'e7';
      return Astro.redirect(`/admin/menu?sm=${code}`, 303);
    }
    problem = msg || 'Something went wrong. Check the database connection — see README.';
    if (wantsJson) {
      return new Response(JSON.stringify({ ok: false, error: problem }), {
        status: 500,
        headers: { 'content-type': 'application/json' },
      });
    }
  }
}

// Decode one-time section feedback carried through the PRG redirect.
const smCode = Astro.url.searchParams.get('sm');
const smResult = smCode ? (SM_MESSAGES[smCode] ?? null) : null;
const sectionNotice = smResult?.ok ? smResult.text : '';
const sectionProblem = smResult && !smResult.ok ? smResult.text : '';

let categories: any[] = [], items: any[] = [];
try {
  categories = (await env.DB.prepare('SELECT * FROM categories ORDER BY sort, id').all()).results ?? [];
  items = (await env.DB.prepare('SELECT * FROM items ORDER BY category_id, sort, id').all()).results ?? [];
} catch {}
// Display values and concurrency tokens come from one read, so a save between two
// reads can never pair old form values with a newer token.
const settingsKeys = ['menu_pizza_options', WRAP_OPTIONS_KEY, SALAD_OPTIONS_KEY, SUBSTITUTE_SIDES_KEY, SAUCES_SECTION.sortKey, SIDES_SECTION.sortKey];
let settingsRows: { key: string; value: string }[] = [];
try {
  settingsRows = (await env.DB.prepare(`SELECT key, value FROM settings WHERE key IN (${settingsKeys.map((_, i) => `?${i + 1}`).join(',')})`).bind(...settingsKeys).all()).results ?? [];
} catch {}
const optionsSnapshots = Object.fromEntries(settingsKeys.map(key => [key, String(settingsRows.find(row => row.key === key)?.value ?? '')]));
const settingsView = { DB: { prepare: () => ({ bind: (key: string) => ({ first: async () => settingsRows.find(row => row.key === key) ?? null }) }) } };
const pizzaOptions = await getPizzaOptions(settingsView);
// The Sauces row in Manage Sections, at the position the public Menu uses.
const [menuSauces, savedSaucesSort, savedSidesSort, wrapOptions, saladOptions, sidesOptions] = await Promise.all([
  getMenuSauces(env), getSectionSort(settingsView, SAUCES_SECTION), getSectionSort(settingsView, SIDES_SECTION),
  getMenuOptions(settingsView, WRAP_OPTIONS_KEY), getMenuOptions(settingsView, SALAD_OPTIONS_KEY), getMenuOptions(settingsView, SUBSTITUTE_SIDES_KEY),
]);
const saucesSnapshot = optionsSnapshots[SAUCES_SECTION.sortKey];
const sidesSnapshot = optionsSnapshots[SIDES_SECTION.sortKey];
const saucesOrder = effectiveSectionSort(categories, savedSaucesSort, SAUCES_SECTION);
const sidesOrder = effectiveSectionSort(categories, savedSidesSort, SIDES_SECTION);
const SAUCES_ROW = { sauces: true } as const;
const SIDES_ROW = { sides: true } as const;
const saucesName = sectionName(categories, SAUCES_SECTION);
const sidesName = sectionName(categories, SIDES_SECTION);
const orderRows: any[] = interleave<any, object>(categories, [
  { index: sectionIndex(categories, savedSaucesSort, SAUCES_SECTION), block: SAUCES_ROW },
  { index: sectionIndex(categories, savedSidesSort, SIDES_SECTION), block: SIDES_ROW },
]);
// Option editors show what staff typed after a failed save, otherwise the saved values.
const draftFor = (action: string) => (optionsDraft?.action === action ? optionsDraft.form : null);
const lines = (form: FormData | null, name: string, saved: string[]) => (form ? String(form.get(name) ?? '') : saved.join('\n'));
const wrapNotesText = lines(draftFor('wrap-options'), 'wrap_notes', wrapOptions.notes);
const saladDressingsText = lines(draftFor('salad-options'), 'salad_dressings', saladOptions.dressings);
const saladGreensText = lines(draftFor('salad-options'), 'salad_greens', saladOptions.greens);
const saladShellNames: string[] = draftFor('salad-options')?.getAll('salad_shells').map(String) ?? saladOptions.shells;
const saladItems = items.filter((i: any) => categories.some((c: any) => c.id === i.category_id && isSaladCategory(c.name)));
const isShell = (name: string) => saladShellNames.some(n => n.trim().toLowerCase() === name.trim().toLowerCase());
const sidesText = lines(draftFor('substitute-sides'), 'substitute_sides', sidesOptions.sides);
const sidesLateNight = draftFor('substitute-sides') ? draftFor('substitute-sides')!.get('substitute_sides_late_night') === 'on' : sidesOptions.lateNight;
const optionsSaved = Astro.url.searchParams.get('options');
const optionsProblem = (action: string) => (optionsDraft?.action === action ? problem : '');
const pizzaEditor = pizzaDraft ? {
  sizes: pizzaDraft.getAll('pizza_sizes'), crusts: pizzaDraft.getAll('pizza_crusts'),
  toppingsText: String(pizzaDraft.get('pizza_toppings') ?? ''),
} : { ...pizzaOptions, toppingsText: pizzaOptions.toppings.join('\n') };
---
<Base title="Admin · Menu — Grayz'n Buffalo">
<section class="menu-admin">
  <div class="section-head">
    <h2>Menu Items</h2>
    <p>Find an item, update its details, or add a photo.</p>
    {notice && <p class="flash ok">{notice}</p>}
    {problem && <p class="flash bad">{problem}</p>}
  </div>

  <div class="admin-wrap">
    <details class="pizza-manager" id="pizza-options" open={Astro.url.searchParams.get('pizza') === 'saved' || (!!problem && !!pizzaDraft)}>
      <summary>Pizza sizes, crusts &amp; additional toppings</summary>
      {Astro.url.searchParams.get('pizza') === 'saved' && <p class="flash ok" role="status">Pizza options saved.</p>}
      <form method="post" class="card pizza-form">
        <input type="hidden" name="action" value="pizza-options" /><input type="hidden" name="options_snapshot" value={pizzaDraft ? String(pizzaDraft.get('options_snapshot') ?? '') : optionsSnapshots['menu_pizza_options']} />
        <p>These choices apply to all pizzas on the Daily and Late Night menus. Pizza Fries is excluded and keeps its own sizes. Keep each pizza’s ingredients in its item description below.</p>
        <fieldset><legend>Pizza sizes</legend><div class="pizza-checks">{PIZZA_SIZES.map(size => <label><input type="checkbox" name="pizza_sizes" value={size} checked={pizzaEditor.sizes.includes(size)} /> {size}</label>)}</div></fieldset>
        <fieldset><legend>Crust options</legend><div class="pizza-checks">{PIZZA_CRUSTS.map(crust => <label><input type="checkbox" name="pizza_crusts" value={crust} checked={pizzaEditor.crusts.includes(crust)} /> {crust}</label>)}</div></fieldset>
        <div class="field"><label for="pizza-toppings">Additional topping choices</label><textarea id="pizza-toppings" name="pizza_toppings" rows="8" maxlength="3240" aria-describedby="pizza-toppings-help">{pizzaEditor.toppingsText}</textarea><p id="pizza-toppings-help">One topping name per line, up to 40 toppings (80 characters each). The starting list contains the 20 choices from the original printed menu. Edit this list when choices change.</p></div>
        <button class="btn btn-primary" type="submit">Save pizza options</button>
      </form>
    </details>
    <details class="pizza-manager options-manager" id="wrap-options" open={optionsSaved === 'wrap-options' || !!optionsProblem('wrap-options')}>
      <summary>Wrap options</summary>
      {optionsSaved === 'wrap-options' && <p class="flash ok" role="status">Wrap options saved.</p>}
      <form method="post" class="card pizza-form">
        <input type="hidden" name="action" value="wrap-options" /><input type="hidden" name="options_snapshot" value={draftFor('wrap-options') ? String(draftFor('wrap-options')!.get('options_snapshot') ?? '') : optionsSnapshots[WRAP_OPTIONS_KEY]} />
        <p>Shown in a panel above the wraps on the public Menu. Keep each wrap’s ingredients in its item description. Leave empty to hide the panel.</p>
        <div class="field"><label for="wrap-notes">Wrap notes</label><textarea id="wrap-notes" name="wrap_notes" rows="4" maxlength="1200" aria-describedby="wrap-notes-help">{wrapNotesText}</textarea><p id="wrap-notes-help">One note per line, up to 6 notes (160 characters each), saved as typed. The starting notes come from the printed menu. No prices.</p></div>
        <button class="btn btn-primary" type="submit">Save wrap options</button>
      </form>
    </details>
    <details class="pizza-manager options-manager" id="salad-options" open={optionsSaved === 'salad-options' || !!optionsProblem('salad-options')}>
      <summary>Salad dressings, greens &amp; shells</summary>
      {optionsSaved === 'salad-options' && <p class="flash ok" role="status">Salad options saved.</p>}
      <form method="post" class="card pizza-form">
        <input type="hidden" name="action" value="salad-options" /><input type="hidden" name="options_snapshot" value={draftFor('salad-options') ? String(draftFor('salad-options')!.get('options_snapshot') ?? '') : optionsSnapshots[SALAD_OPTIONS_KEY]} />
        <p>Shown in a panel above the salads on the public Menu. Keep each salad’s ingredients in its item description.</p>
        <div class="field"><label for="salad-dressings">Dressing choices</label><textarea id="salad-dressings" name="salad_dressings" rows="8" maxlength="3000" aria-describedby="salad-dressings-help">{saladDressingsText}</textarea><p id="salad-dressings-help">One dressing per line, up to 30 (80 characters each). The starting list is the 12 dressings on the printed menu.</p></div>
        <div class="field"><label for="salad-greens">Greens choices</label><textarea id="salad-greens" name="salad_greens" rows="3" maxlength="400" aria-describedby="salad-greens-help">{saladGreensText}</textarea><p id="salad-greens-help">One per line, up to 6. Shown as “Choice of Iceberg or Spinach Mix.”</p></div>
        <fieldset><legend>Salads that come with a shell</legend>
          <p>Marked with † on the Menu, with “{SALAD_SHELL_NOTE}”</p>
          {saladItems.length ? <div class="pizza-checks">{saladItems.map((i: any) => <label><input type="checkbox" name="salad_shells" value={i.name} checked={isShell(i.name)} /> {i.name}</label>)}</div> : <p>There are no items in Salads yet.</p>}
        </fieldset>
        <button class="btn btn-primary" type="submit">Save salad options</button>
      </form>
    </details>
    <details class="pizza-manager options-manager" id="substitute-sides-options" open={optionsSaved === 'substitute-sides-options' || !!optionsProblem('substitute-sides')}>
      <summary>Substitute sides</summary>
      {optionsSaved === 'substitute-sides-options' && <p class="flash ok" role="status">Substitute sides saved.</p>}
      <form method="post" class="card pizza-form">
        <input type="hidden" name="action" value="substitute-sides" /><input type="hidden" name="options_snapshot" value={draftFor('substitute-sides') ? String(draftFor('substitute-sides')!.get('options_snapshot') ?? '') : optionsSnapshots[SUBSTITUTE_SIDES_KEY]} />
        <p>Shown as the {sidesName} section on the Daily Menu, under “{SUBSTITUTE_SIDES_NOTE}” Set its position in Manage Sections. Leave empty to hide the section.</p>
        <fieldset><legend>Late Night Menu</legend><div class="pizza-checks"><label><input type="checkbox" name="substitute_sides_late_night" checked={sidesLateNight} /> Also show {sidesName} on the Late Night Menu</label></div></fieldset>
        <div class="field"><label for="substitute-sides">Substitute side choices</label><textarea id="substitute-sides" name="substitute_sides" rows="5" maxlength="1200" aria-describedby="substitute-sides-help">{sidesText}</textarea><p id="substitute-sides-help">One line per choice group, up to 8 lines (120 characters each), saved as typed. The starting list comes from the printed menu. No prices.</p></div>
        <button class="btn btn-primary" type="submit">Save substitute sides</button>
      </form>
    </details>
    <details class="add-disclosure" id="add-item-panel">
      <summary>Add Item <span aria-hidden="true">＋</span></summary>
    <form method="post" class="card add-form" id="add-item-form">
      <h3>Add an item</h3>
      <div class="field">
        <label for="add-cat">Section</label>
        <select id="add-cat" name="category_id" required>
          {categories.map((c:any) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="add-name">Item name</label>
        <input id="add-name" name="name" required />
      </div>
      <div class="field wide">
        <label for="add-desc">Description <span class="hint">optional</span></label>
        <textarea id="add-desc" name="description" rows="3"></textarea>
      </div>
      <div class="field wide check">
        <label for="add-late">
          <input id="add-late" type="checkbox" name="late_night" value="1" />
          Add to Late Night menu <span class="hint">(Item stays on the Daily menu and also appears on the Late Night menu.)</span>
        </label>
      </div>
      <div class="field wide add-photo-field">
        <span class="field-label">Photo <span class="hint">optional</span></span>
        <div class="pick">
          <label class="pick-btn">
            <span>Take a photo</span>
            <input type="file" accept="image/*" capture="environment" data-add-photo />
          </label>
          <label class="pick-btn">
            <span>Choose from gallery</span>
            <input type="file" accept="image/*" data-add-photo />
          </label>
        </div>
        <img id="add-photo-preview" class="add-photo-preview" alt="Selected photo preview" hidden />
        <p class="add-photo-status" id="add-photo-status" role="status">No photo selected.</p>
        <button id="clear-add-photo" type="button" hidden>Clear selected photo</button>
      </div>
      <input type="hidden" name="action" value="add" />
      <button class="btn btn-primary" type="submit">Add item</button>
      <p id="add-recovery" class="wide" hidden><a href="/admin/menu">Open the created item to retry its photo</a></p>
    </form>
    </details>

    <details class="section-manager" id="section-manager" open={!!(sectionNotice || sectionProblem)}>
      <summary>Manage Sections</summary>
      <div class="section-manager__body">

        {sectionNotice && <p class="flash ok sm-flash">{sectionNotice}</p>}
        {sectionProblem && <p class="flash bad sm-flash">{sectionProblem}</p>}

        <form method="post" id="sm-order-form" class="sm-order-form" autocomplete="off">
          <input type="hidden" name="action" value="reorder-sections" />
          <p class="sm-hint">Edit order numbers and save, or use the Edit button to rename, add details, or delete a section.</p>
          <table class="sm-table">
            <thead><tr><th>Order</th><th>Name</th><th></th></tr></thead>
            <tbody>
              {orderRows.map((c: any) => c === SAUCES_ROW ? (
                <tr class="sm-sauces-row">
                  <td><input class="sm-sort-input" type="number" name="sort_sauces" value={saucesOrder} min="0" max="999" step="1" aria-label={`Sort order for ${saucesName}`} /><input type="hidden" name="sort_sauces_was" value={saucesOrder} /><input type="hidden" name="sort_sauces_snapshot" value={saucesSnapshot} /></td>
                  <td class="sm-name-cell">{saucesName}<span class="sm-sub">{menuSauces.length ? `${menuSauces.length} sauces from Wing Wednesday · goes after sections with the same or a lower number` : 'Hidden on the Menu: the Wing Wednesday sauce list is empty'}{saucesName !== 'Sauces' && ' · named this because another section is called Sauces'}</span></td>
                  <td><a class="sm-sauces-link" href="/admin/specials">Edit sauces</a></td>
                </tr>
              ) : c === SIDES_ROW ? (
                <tr class="sm-sides-row">
                  <td><input class="sm-sort-input" type="number" name="sort_sides" value={sidesOrder} min="0" max="999" step="1" aria-label={`Sort order for ${sidesName}`} /><input type="hidden" name="sort_sides_was" value={sidesOrder} /><input type="hidden" name="sort_sides_snapshot" value={sidesSnapshot} /></td>
                  <td class="sm-name-cell">{sidesName}<span class="sm-sub">{sidesOptions.sides.length ? `${sidesOptions.sides.length} choices · ${sidesOptions.lateNight ? 'Daily and Late Night' : 'Daily Menu'} · goes after sections with the same or a lower number` : 'Hidden on the Menu: the substitute sides list is empty'}{sidesName !== 'Substitute Sides' && ' · named this because another section is called Substitute Sides'}</span></td>
                  <td><a class="sm-sauces-link" href="#substitute-sides-options">Edit sides</a></td>
                </tr>
              ) : (
                <tr>
                  <td><input class="sm-sort-input" type="number" name={`sort_${c.id}`} value={c.sort} min="0" max="999" aria-label={`Sort order for ${c.name}`} /><input type="hidden" name={`was_${c.id}`} value={c.sort} /></td>
                  <td class="sm-name-cell">{c.name}{c.subtitle && <span class="sm-sub">{c.subtitle}</span>}</td>
                  <td><button type="button" class="sm-edit-btn" data-id={String(c.id)} data-name={c.name} data-subtitle={c.subtitle ?? ''} data-note={c.note ?? ''}>Edit</button></td>
                </tr>
              ))}
            </tbody>
          </table>
          <button type="submit" class="btn btn-ghost sm-save-order">Save order</button>
        </form>

        <div class="sm-edit-panel" id="sm-edit-panel" hidden>
          <h3 class="sm-panel-heading">Edit section</h3>
          <form method="post" id="sm-edit-form" autocomplete="off">
            <input type="hidden" name="category_id" id="sm-edit-id" />
            <input type="hidden" name="was_name" id="sm-was-name" /><input type="hidden" name="was_subtitle" id="sm-was-subtitle" /><input type="hidden" name="was_note" id="sm-was-note" />
            <div class="field"><label for="sm-name">Section name</label><input id="sm-name" name="name" required maxlength="60" /></div>
            <div class="field"><label for="sm-subtitle">Subtitle / Serving Hours <span class="hint">optional</span></label><input id="sm-subtitle" name="subtitle" maxlength="120" /></div>
            <div class="field"><label for="sm-note">Section note <span class="hint">optional</span></label><textarea id="sm-note" name="note" rows="2" maxlength="240"></textarea></div>
            <div class="sm-edit-actions">
              <button type="submit" name="action" value="edit-section" class="btn btn-primary">Save section</button>
              <button type="button" id="sm-cancel" class="btn btn-ghost">Cancel</button>
              <button type="submit" name="action" value="delete-section" class="sm-delete" formnovalidate>Delete section</button>
            </div>
          </form>
        </div>

        <div class="sm-add-block">
          <h3 class="sm-panel-heading">Add a new section</h3>
          <form method="post" class="sm-add-form">
            <input type="hidden" name="action" value="add-section" />
            <div class="field"><label for="sm-new-name">Section name</label><input id="sm-new-name" name="name" required maxlength="60" placeholder="e.g. Wraps" /></div>
            <div class="field"><label for="sm-new-subtitle">Subtitle / Serving Hours <span class="hint">optional</span></label><input id="sm-new-subtitle" name="subtitle" maxlength="120" /></div>
            <div class="field"><label for="sm-new-note">Section note <span class="hint">optional</span></label><textarea id="sm-new-note" name="note" rows="2" maxlength="240"></textarea></div>
            <button type="submit" class="btn btn-primary">Add section</button>
          </form>
        </div>

      </div>
    </details>

    <div class="menu-filters" id="menu-filters" hidden>
      <div class="field filter-search"><label for="item-search">Find an item</label><input id="item-search" type="search" placeholder="Search name or description" /></div>
      <div class="filter-options">
        <div class="field"><label for="filter-section">Section</label><select id="filter-section"><option value="">All sections</option>{categories.map((c:any)=><option value={c.id}>{c.name}</option>)}</select></div>
        <div class="field"><label for="filter-visibility">Status</label><select id="filter-visibility"><option value="all">All items</option><option value="visible">Visible</option><option value="hidden">Hidden</option></select></div>
        <label class="filter-late"><input type="checkbox" id="filter-late" /> Late Night only</label>
      </div>
      <div class="filter-feedback"><p id="filter-count" role="status" aria-live="polite"></p><button type="button" id="clear-filters">Clear filters</button></div>
    </div>

    <nav class="jump-card" aria-label="Jump to menu section" hidden>
      <p>Jump to section</p>
      <div class="jump-links">
        {categories.map((c:any) => (
          <a href={`#cat-${slug(c.name)}`}>{c.name}</a>
        ))}
      </div>
    </nav>

    {categories.map((c:any) => (
      <div class="cat" id={`cat-${slug(c.name)}`} data-category-id={c.id}>
        <h3>{c.name}</h3>
        <ul>
          {items.filter((i:any) => i.category_id === c.id).map((i:any) => (
            <li id={`item-${i.id}`} class:list={['menu-item', { inactive: !i.active }]} data-item-name={i.name} data-description={i.description ?? ''} data-section={i.category_id} data-active={i.active} data-late={i.late_night}>
              <div class="row">
                <div class="thumb">
                  <img
                    data-thumb-for={i.id}
                    src={i.photo_key ? `/img/${thumbKey(i.photo_key)}` :  undefined}
                    alt=""
                    width="56"
                    height="44"
                    loading="lazy"
                    hidden={!i.photo_key}
                  />
                  <span class="no-photo" data-empty-for={i.id} hidden={!!i.photo_key} aria-hidden="true">—</span>
                </div>
                <div class="who">
                  <strong>{i.name}</strong>
                  <span class="item-section">{c.name}</span>
                  <span class="hidden-badge" hidden={!!i.active}>Hidden</span>
                  <span class="photo-state" data-photo-state={i.id}>{i.photo_key ? 'Photo added' : 'No photo'}</span>
                  {i.late_night === 1 && <span class="late-badge">Late night</span>}
                  {i.description
                    ? <span class="desc">{i.description}</span>
                    : <span class="desc muted">No description yet</span>}
                </div>
                <div class="row-actions">
                  <form method="post" autocomplete="off">
                    <input type="hidden" name="action" value="toggle" />
                    <input type="hidden" name="id" value={i.id} />
                    <input type="hidden" name="active" value={i.active ? '0' : '1'} />
                    <button type="submit">{i.active ? 'Hide' : 'Show'}</button>
                  </form>

                </div>
              </div>

              <details class="editor">
                <summary aria-label={`Edit ${i.name}`}>Edit item &amp; photo</summary>

                <form method="post" class="edit-form" autocomplete="off">
                  <input type="hidden" name="action" value="edit" />
                  <input type="hidden" name="id" value={i.id} />
                  {/* The values this editor loaded; the save is refused if someone else changed them. */}
                  <input type="hidden" name="was_name" value={i.name} />
                  <input type="hidden" name="was_description" value={i.description ?? ''} />
                  <input type="hidden" name="was_category_id" value={i.category_id} />
                  <input type="hidden" name="was_late_night" value={i.late_night ? '1' : '0'} />
                  <div class="field">
                    <label for={`n-${i.id}`}>Item name</label>
                    <input id={`n-${i.id}`} name="name" value={i.name} required />
                  </div>
                  <div class="field">
                    <label for={`c-${i.id}`}>Section</label>
                    <select id={`c-${i.id}`} name="category_id">
                      {categories.map((cc:any) => (
                        <option value={cc.id} selected={cc.id === i.category_id}>{cc.name}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field wide">
                    <label for={`d-${i.id}`}>Description <span class="hint">optional</span></label>
                    <textarea id={`d-${i.id}`} name="description" rows="3">{i.description ?? ''}</textarea>
                  </div>
                  <div class="field wide check">
                    <label for={`l-${i.id}`}>
                      <input id={`l-${i.id}`} type="checkbox" name="late_night" value="1" checked={i.late_night === 1} />
                      Add to Late Night menu <span class="hint">(Item stays on the Daily menu and also appears on the Late Night menu.)</span>
                    </label>
                  </div>
                  <button class="btn btn-primary" type="submit">Save changes</button>
                </form>

                <div class="photo-card">
                  <p class="photo-title">Photo</p><p class="photo-help">Choosing a photo saves it immediately. Choose again to replace it.</p>

                  <div class="preview">
                    <img
                      data-preview-for={i.id}
                      data-full-url={i.photo_key ? `/img/${i.photo_key}` : undefined}
                      src={i.photo_key ? `/img/${thumbKey(i.photo_key)}` : undefined}
                      alt={`Current photo for ${i.name}`}
                      loading="lazy"
                      hidden={!i.photo_key}
                    />
                    <p class="preview-empty" data-preview-empty={i.id} hidden={!!i.photo_key}>
                      No photo yet.
                    </p>
                  </div>

                  <div class="pick">
                    <label class="pick-btn">
                      <span>Take a photo</span>
                      <input type="file" accept="image/*" capture="environment" data-upload={i.id} />
                    </label>
                    <label class="pick-btn">
                      <span>Choose from gallery</span>
                      <input type="file" accept="image/*" data-upload={i.id} />
                    </label>
                  </div>

                  <div class="photo-tools" data-rotate-tools={i.id} hidden={!i.photo_key}>
                    <button class="rotate-photo" type="button" data-rotate={i.id} data-degrees="-90">Rotate left</button>
                    <button class="rotate-photo" type="button" data-rotate={i.id} data-degrees="90">Rotate right</button>
                  </div>

                  <button
                    class="danger remove-photo"
                    type="button"
                    data-remove={i.id}
                    hidden={!i.photo_key}
                  >Remove photo</button>

                  <noscript>
                    <p class="hint">Photo uploads need JavaScript turned on.</p>
                  </noscript>
                </div>
                <div class="delete-zone">
                  <p>Remove this item permanently</p>
                  <form method="post">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={i.id} />
                    <button class="danger" type="submit">Delete</button>
                  </form>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}

  </div>
</section>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
</Base>

<script>
  import { convertPhoto, PhotoError } from '../../lib/photo-client';

  const toastEl = document.getElementById('toast')!;
  const addForm = document.querySelector<HTMLFormElement>('#add-item-form');
  const addPhotoStatus = document.querySelector<HTMLElement>('#add-photo-status');
  let pendingAddPhoto: File | null = null;
  let previewUrl: string | null = null;
  const addPreview = document.getElementById('add-photo-preview') as HTMLImageElement | null;
  const clearPhoto = document.getElementById('clear-add-photo') as HTMLButtonElement | null;
  const clearPreview = () => {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    if (addPreview) { addPreview.hidden = true; addPreview.removeAttribute('src'); }
  };
  clearPhoto?.addEventListener('click', () => {
    clearPreview(); pendingAddPhoto = null;
    document.querySelectorAll<HTMLInputElement>('[data-add-photo]').forEach(input => input.value = '');
    if (addPhotoStatus) addPhotoStatus.textContent = 'No photo selected.';
    clearPhoto.hidden = true;
  });
  addPreview?.addEventListener('error', () => { clearPreview(); if (addPhotoStatus) addPhotoStatus.textContent = 'Preview unavailable. The selected photo will be checked when you add the item.'; });
  let toastTimer: number | undefined;

  function toast(message: string, kind: 'ok' | 'bad' | 'busy' = 'ok') {
    window.clearTimeout(toastTimer);
    toastEl.textContent = message;
    toastEl.className = `toast show ${kind}`;
    toastEl.hidden = false;
    if (kind !== 'busy') {
      toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 3200);
    }
  }

  const carriedNotice = sessionStorage.getItem('menuNotice');
  if (carriedNotice) {
    sessionStorage.removeItem('menuNotice');
    toast(carriedNotice, 'ok');
  }
  const createdItem = new URL(location.href).searchParams.get('created');
  if (createdItem) {
    history.replaceState(null, '', `${location.pathname}${location.hash}`);
  }

  // PRG cleanup: remove ?sm=... from the URL and auto-hide the section flash.
  const smParam = new URL(location.href).searchParams.get('sm');
  if (smParam) {
    history.replaceState(null, '', location.pathname + (location.hash || ''));
    setTimeout(() => {
      document.querySelectorAll<HTMLElement>('.sm-flash').forEach(el => {
        el.style.transition = 'opacity .4s';
        el.style.opacity = '0';
        setTimeout(() => { el.hidden = true; }, 400);
      });
    }, 4000);
  }

  document.querySelectorAll<HTMLInputElement>('input[data-add-photo]').forEach((input) => {
    input.addEventListener('change', () => {
      const file = input.files?.[0] ?? null;
      if (!file) return;
      pendingAddPhoto = file;
      clearPreview();
      if (file.type.startsWith('image/') && file.size <= 12 * 1024 * 1024 && addPreview) {
        previewUrl = URL.createObjectURL(file); addPreview.src = previewUrl; addPreview.hidden = false;
      }
      if (clearPhoto) clearPhoto.hidden = false;
      document.querySelectorAll<HTMLInputElement>('input[data-add-photo]').forEach((other) => {
        if (other !== input) other.value = '';
      });
      if (addPhotoStatus) addPhotoStatus.textContent = `Selected: ${file.name}`;
    });
  });

  async function uploadPhoto(id: string, file: File, rotation = 0) {
    const { full, thumb, width, height } = await convertPhoto(file, rotation);
    const body = new FormData();
    body.append('id', id);
    body.append('full', full, 'photo.webp');
    body.append('thumb', thumb, 'photo@600.webp');
    body.append('width', String(width));
    body.append('height', String(height));

    const res = await fetch('/api/menu-photo', { method: 'POST', body });
    const data = await readJson(res);
    if (!res.ok || !data.ok) throw new Error(data.error ?? 'Upload failed. Try again.');
    return data as { thumbUrl: string; fullUrl: string; message?: string };
  }

  addForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = addForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;

    let createdId: number | null = null;
    try {
      toast('Adding item…', 'busy');
      const res = await fetch('/admin/menu', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: new FormData(addForm),
      });
      const data = await readJson(res);
      if (!res.ok || !data.ok || !data.id) throw new Error(data.error ?? 'Could not add the item.');

      createdId = Number(data.id);
      if (pendingAddPhoto) {
        toast('Resizing and uploading photo…', 'busy');
        await uploadPhoto(String(data.id), pendingAddPhoto);
      }

      sessionStorage.setItem('menuNotice', pendingAddPhoto ? 'Item and photo added.' : 'Item added.');
      // A hash-only navigation does not reload this page, leaving the busy
      // toast and disabled submit button in place. The short-lived query
      // parameter forces a real request; the page then removes it above.
      location.assign(`/admin/menu?created=${data.id}#item-${data.id}`);
    } catch (err) {
      toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      if (createdId) {
        const recovery = document.getElementById('add-recovery');
        const link = recovery?.querySelector('a');
        if (link) link.href = `/admin/menu?created=${createdId}#item-${createdId}`;
        if (recovery) recovery.hidden = false;
        if (addPhotoStatus) addPhotoStatus.textContent = 'The item was created, but its photo was not saved. Open the item below to retry; do not add it again.';
      } else if (submit) submit.disabled = false;
    }
  });

  // Existing items update in place. Adding is deliberately different: its
  // redirect is what reveals the newly created item in its section.
  /** A save's JSON reply. An expired session or an unexpected HTML page becomes a clear
   *  error instead of a JSON parse failure; nothing is ever reported as saved. */
  async function readJson(res: Response): Promise<any> {
    const data = res.headers.get('content-type')?.includes('application/json') ? await res.json().catch(() => null) : null;
    if (res.status === 401) throw new Error(data?.error ?? 'Your session expired, so this change was not saved. Sign in again, then make the change again.');
    if (!data) throw new Error('This change could not be confirmed as saved. Refresh the page to check, then try again.');
    return data;
  }

  document.querySelectorAll<HTMLFormElement>('form[method="post"]').forEach((form) => {
    if (form === addForm || form.closest('.section-manager') || form.closest('.pizza-manager') || form.closest('.options-manager') || !form.querySelector('input[name="action"]')) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const action = form.querySelector<HTMLInputElement>('input[name="action"]')?.value;
      const id = form.querySelector<HTMLInputElement>('input[name="id"]')?.value;
      if (!action || !id) return;
      if (action === 'delete' && !confirm('Delete this item and its photo?')) return;

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      try {
        toast(action === 'delete' ? 'Removing item…' : 'Saving…', 'busy');
        const submitted = new FormData(form);
        const res = await fetch('/admin/menu', {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: submitted,
        });
        const data = await readJson(res);
        if (!res.ok || !data.ok) throw new Error(data.error ?? 'Could not update the item.');

        const item = document.getElementById(`item-${id}`);
        if (action === 'delete') {
          item?.remove();
        } else if (action === 'toggle') {
          // The server reports the visibility it saved; the button then offers the opposite.
          const isNowActive = Number(data.active) === 1;
          item?.classList.toggle('inactive', !isNowActive);
          if (item) item.dataset.active = isNowActive ? '1' : '0';
          const hiddenBadge = item?.querySelector<HTMLElement>('.hidden-badge');
          if (hiddenBadge) hiddenBadge.hidden = isNowActive;
          const nextState = form.querySelector<HTMLInputElement>('input[name="active"]');
          if (nextState) nextState.value = isNowActive ? '0' : '1';
          if (submit) submit.textContent = isNowActive ? 'Hide' : 'Show';
        } else if (action === 'edit') {
          // Show the saved text, which uses the house capitalization.
          const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]');
          const descInput = form.querySelector<HTMLTextAreaElement>('textarea[name="description"]');
          const select = form.querySelector<HTMLSelectElement>('select[name="category_id"]');
          const lateBox = form.querySelector<HTMLInputElement>('input[name="late_night"]');
          // Submitted line breaks are CRLF; the textarea's own value uses LF.
          const lines = (value: unknown) => String(value ?? '').replace(/\r\n?/g, '\n');
          const savedName = typeof data.name === 'string' ? data.name : String(submitted.get('name') ?? '');
          const savedDescription = typeof data.description === 'string' ? data.description : String(submitted.get('description') ?? '');
          const lateNight = data.late_night !== undefined ? Number(data.late_night) === 1 : submitted.get('late_night') !== null;
          const categoryId = String(data.category_id ?? submitted.get('category_id') ?? '');
          // A response must not replace a newer draft typed while it was saving.
          const nameKept = !!nameInput && nameInput.value !== submitted.get('name');
          const descKept = !!descInput && lines(descInput.value) !== lines(submitted.get('description'));
          if (nameInput && !nameKept) nameInput.value = savedName;
          if (descInput && !descKept) descInput.value = lines(savedDescription);
          const newerDraft = nameKept || descKept || (!!select && select.value !== submitted.get('category_id')) ||
            (!!lateBox && lateBox.checked !== (submitted.get('late_night') !== null));
          // The next save from this editor must match what is saved now.
          const loaded: Record<string, string> = { was_name: savedName, was_description: savedDescription, was_category_id: categoryId, was_late_night: lateNight ? '1' : '0' };
          for (const [field, value] of Object.entries(loaded)) {
            const input = form.querySelector<HTMLInputElement>(`input[name="${field}"]`);
            if (input) input.value = value;
          }
          if (!newerDraft) {
            // Saved values become the editor's starting point, then the editor closes.
            if (nameInput) nameInput.defaultValue = nameInput.value;
            if (descInput) descInput.defaultValue = descInput.value;
            if (lateBox) lateBox.defaultChecked = lateBox.checked;
            if (select) for (const option of select.options) option.defaultSelected = option.selected;
            const editor = form.closest<HTMLDetailsElement>('details.editor');
            if (editor) editor.open = false;
          }
          const name = savedName.trim();
          const description = savedDescription.trim();
          const strong = item?.querySelector<HTMLElement>('.who strong');
          const desc = item?.querySelector<HTMLElement>('.desc');
          if (strong) strong.textContent = name;
          if (item) {
            item.dataset.itemName = name; item.dataset.description = description;
            item.dataset.section = categoryId; item.dataset.late = lateNight ? '1' : '0';
            const categoryLabel = item.querySelector<HTMLElement>('.item-section');
            const categoryOption = select ? [...select.options].find(option => option.value === categoryId) : null;
            if (categoryLabel && categoryOption) categoryLabel.textContent = categoryOption.textContent ?? '';
            item.querySelector('summary')?.setAttribute('aria-label', `Edit ${name}`);
          }
          if (desc) {
            desc.textContent = description || 'No description yet';
            desc.classList.toggle('muted', !description);
          }
          const badge = item?.querySelector<HTMLElement>('.late-badge');
          if (lateNight && !badge) {
            const newBadge = document.createElement('span');
            newBadge.className = 'late-badge';
            newBadge.textContent = 'Late night';
            strong?.after(newBadge);
          } else if (!lateNight) {
            badge?.remove();
          }
          const destination = categoryId
            ? document.querySelector<HTMLElement>(`.cat[data-category-id="${categoryId}"] ul`)
            : null;
          if (item && destination && item.parentElement !== destination) destination.append(item);
        }
        applyFilters();
        toast(data.message ?? 'Item updated.', 'ok');
      } catch (err) {
        toast((err as Error).message, 'bad');
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  });

  function paint(id: string, thumbUrl: string | null, fullUrl: string | null = null) {
    const thumb = document.querySelector<HTMLImageElement>(`[data-thumb-for="${id}"]`);
    const empty = document.querySelector<HTMLElement>(`[data-empty-for="${id}"]`);
    const preview = document.querySelector<HTMLImageElement>(`[data-preview-for="${id}"]`);
    const previewEmpty = document.querySelector<HTMLElement>(`[data-preview-empty="${id}"]`);
    const remove = document.querySelector<HTMLElement>(`[data-remove="${id}"]`);
    const rotateTools = document.querySelector<HTMLElement>(`[data-rotate-tools="${id}"]`);

    const photoState = document.querySelector<HTMLElement>(`[data-photo-state="${id}"]`);
    if (photoState) photoState.textContent = thumbUrl ? 'Photo added' : 'No photo';
    if (thumbUrl) {
      const bust = `${thumbUrl}${thumbUrl.includes('?') ? '&' : '?'}v=${Date.now()}`;
      if (thumb) { thumb.src = bust; thumb.hidden = false; }
      if (preview) {
        preview.src = bust;
        preview.hidden = false;
        if (fullUrl) preview.dataset.fullUrl = fullUrl;
      }
      if (empty) empty.hidden = true;
      if (previewEmpty) previewEmpty.hidden = true;
      if (remove) remove.hidden = false;
      if (rotateTools) rotateTools.hidden = false;
    } else {
      if (thumb) { thumb.hidden = true; thumb.removeAttribute('src'); }
      if (preview) {
        preview.hidden = true;
        preview.removeAttribute('src');
        delete preview.dataset.fullUrl;
      }
      if (empty) empty.hidden = false;
      if (previewEmpty) previewEmpty.hidden = false;
      if (remove) remove.hidden = true;
      if (rotateTools) rotateTools.hidden = true;
    }
  }

  function lock(id: string, busy: boolean) {
    document.querySelectorAll<HTMLInputElement>(`[data-upload="${id}"]`).forEach((el) => { el.disabled = busy; });
    document.querySelectorAll<HTMLButtonElement>(`[data-rotate="${id}"], [data-remove="${id}"]`).forEach((el) => { el.disabled = busy; });
  }

  document.querySelectorAll<HTMLInputElement>('input[data-upload]').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      const id = input.dataset.upload!;
      if (!file) return;

      lock(id, true);
      toast('Resizing photo…', 'busy');
      try {
        const data = await uploadPhoto(id, file);
        paint(id, data.thumbUrl, data.fullUrl);
        toast(data.message ?? 'Photo saved.', 'ok');
      } catch (err) {
        toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      } finally {
        lock(id, false);
        input.value = '';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button[data-rotate]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.rotate!;
      const degrees = Number(btn.dataset.degrees ?? 0);
      const preview = document.querySelector<HTMLImageElement>(`[data-preview-for="${id}"]`);
      const fullUrl = preview?.dataset.fullUrl;
      if (!fullUrl) return toast('The original photo could not be loaded.', 'bad');

      lock(id, true);
      toast('Rotating photo…', 'busy');
      try {
        const source = await fetch(fullUrl, { cache: 'no-store' });
        if (!source.ok) throw new Error('The original photo could not be loaded.');
        const blob = await source.blob();
        const file = new File([blob], 'photo.webp', { type: blob.type || 'image/webp' });
        const data = await uploadPhoto(id, file, degrees);
        paint(id, data.thumbUrl, data.fullUrl);
        toast('Photo rotated.', 'ok');
      } catch (err) {
        toast(err instanceof PhotoError ? err.message : (err as Error).message, 'bad');
      } finally {
        lock(id, false);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button[data-remove]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.remove!;
      if (!confirm('Remove this photo?')) return;

      lock(id, true);
      toast('Removing…', 'busy');
      try {
        const body = new FormData();
        body.append('id', id);
        body.append('remove', '1');
        const res = await fetch('/api/menu-photo', { method: 'POST', body });
        const data = await readJson(res);
        if (!res.ok || !data.ok) throw new Error(data.error ?? 'Could not remove the photo.');
        paint(id, null);
        toast(data.message ?? 'Photo removed.', 'ok');
      } catch (err) {
        toast((err as Error).message, 'bad');
      } finally {
        lock(id, false);
      }
    });
  });

  const search = document.getElementById('item-search') as HTMLInputElement;
  const sectionFilter = document.getElementById('filter-section') as HTMLSelectElement;
  const visibilityFilter = document.getElementById('filter-visibility') as HTMLSelectElement;
  const lateFilter = document.getElementById('filter-late') as HTMLInputElement;
  const filterCount = document.getElementById('filter-count');
  function applyFilters() {
    const query = search.value.trim().toLocaleLowerCase();
    let matches = 0;
    document.querySelectorAll<HTMLElement>('.menu-item').forEach(item => {
      const match = (!query || `${item.dataset.itemName} ${item.dataset.description}`.toLocaleLowerCase().includes(query)) &&
        (!sectionFilter.value || item.dataset.section === sectionFilter.value) &&
        (visibilityFilter.value === 'all' || (item.dataset.active === '1') === (visibilityFilter.value === 'visible')) &&
        (!lateFilter.checked || item.dataset.late === '1');
      if (match) matches++;
      // Filters apply to every item, including one whose editor is open.
      item.hidden = !match;
    });
    document.querySelectorAll<HTMLElement>('.cat').forEach(category => {
      const hasVisible = [...category.querySelectorAll<HTMLElement>('.menu-item')].some(item => !item.hidden);
      const noFilters = !query && !sectionFilter.value && visibilityFilter.value === 'all' && !lateFilter.checked;
      category.hidden = !hasVisible && !noFilters && category.dataset.categoryId !== sectionFilter.value;
    });
    if (filterCount) filterCount.textContent = `${matches} matching item${matches === 1 ? '' : 's'}.`;
  }
  /** Whether an editor form differs from the values it was loaded or last saved with. */
  function isDirty(form: HTMLFormElement) {
    return [...form.elements].some((el) => {
      if (el instanceof HTMLInputElement) return el.type === 'checkbox' ? el.checked !== el.defaultChecked : el.type !== 'hidden' && el.value !== el.defaultValue;
      if (el instanceof HTMLTextAreaElement) return el.value !== el.defaultValue;
      if (el instanceof HTMLSelectElement) {
        const options = [...el.options];
        const hasDefault = options.some(option => option.defaultSelected);
        return options.some((option, index) => option.selected !== (hasDefault ? option.defaultSelected : index === 0));
      }
      return false;
    });
  }
  /** Close every open item editor, resetting it to its saved values. Unsaved changes are
   *  discarded only after staff confirm; returns false when they choose to keep them. */
  function closeItemEditors() {
    const open = [...document.querySelectorAll<HTMLDetailsElement>('.menu-item .editor[open]')];
    const unsaved = open.filter(editor => { const form = editor.querySelector<HTMLFormElement>('form.edit-form'); return !!form && isDirty(form); });
    if (unsaved.length) {
      const names = unsaved.map(editor => editor.closest<HTMLElement>('.menu-item')?.dataset.itemName).filter(Boolean).join(', ');
      if (!confirm(`Discard your unsaved changes to ${names}?`)) return false;
    }
    open.forEach(editor => { editor.querySelector<HTMLFormElement>('form.edit-form')?.reset(); editor.open = false; });
    return true;
  }
  // Choosing another section clears the item being edited, so only that section's items show.
  let currentSection = sectionFilter.value;
  sectionFilter.addEventListener('input', () => {
    if (sectionFilter.value === currentSection) return;
    if (!closeItemEditors()) { sectionFilter.value = currentSection; return; }
    currentSection = sectionFilter.value;
    applyFilters();
  });
  [search, visibilityFilter, lateFilter].forEach(control => control.addEventListener('input', applyFilters));
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    if (sectionFilter.value && !closeItemEditors()) return;
    search.value = ''; sectionFilter.value = ''; currentSection = ''; visibilityFilter.value = 'all'; lateFilter.checked = false;
    applyFilters(); search.focus();
  });
  document.querySelector<HTMLElement>('#menu-filters')!.hidden = false;
  if (createdItem && /^\d+$/.test(createdItem)) {
    const editor = document.getElementById(`item-${createdItem}`)?.querySelector<HTMLDetailsElement>('.editor');
    if (editor) editor.open = true;
  }
  applyFilters();

  // Section manager — edit panel toggle
  const smEditPanel = document.getElementById('sm-edit-panel') as HTMLElement | null;
  const smEditId = document.getElementById('sm-edit-id') as HTMLInputElement | null;
  const smName = document.getElementById('sm-name') as HTMLInputElement | null;
  const smSubtitle = document.getElementById('sm-subtitle') as HTMLInputElement | null;
  const smNote = document.getElementById('sm-note') as HTMLTextAreaElement | null;
  const smLoaded = (id: string, value: string | undefined) => { const input = document.getElementById(id) as HTMLInputElement | null; if (input) input.value = value ?? ''; };
  document.querySelectorAll<HTMLButtonElement>('.sm-edit-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (smEditId) smEditId.value = btn.dataset.id ?? '';
      if (smName) smName.value = btn.dataset.name ?? '';
      if (smSubtitle) smSubtitle.value = btn.dataset.subtitle ?? '';
      if (smNote) smNote.value = btn.dataset.note ?? '';
      // The values the page loaded; the save is refused if someone else changed them.
      smLoaded('sm-was-name', btn.dataset.name); smLoaded('sm-was-subtitle', btn.dataset.subtitle); smLoaded('sm-was-note', btn.dataset.note);
      if (smEditPanel) { smEditPanel.hidden = false; smEditPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
    });
  });
  document.getElementById('sm-cancel')?.addEventListener('click', () => { if (smEditPanel) smEditPanel.hidden = true; });
  document.getElementById('sm-edit-form')?.addEventListener('submit', (e) => {
    const clickedAction = (e.submitter as HTMLButtonElement | null)?.value;
    if (clickedAction === 'delete-section' && !confirm('Delete this section? This only works if the section has no menu items.')) e.preventDefault();
  });
  // A full-page options save or navigation must not silently lose another draft.
  const draftForms = () => [...document.querySelectorAll<HTMLFormElement>('.pizza-form, form.edit-form, #add-item-form, #sm-order-form, #sm-edit-form')]
    .filter(form => !form.hidden && isDirty(form));
  let leavingAfterSave = false;
  document.addEventListener('submit', (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.closest('.pizza-manager, .section-manager')) return;
    const others = draftForms().filter(other => other !== form);
    if (others.length && !confirm('Discard your other unsaved menu changes and save this form?')) {
      event.preventDefault();
      event.stopImmediatePropagation();
      return;
    }
    queueMicrotask(() => { leavingAfterSave = !event.defaultPrevented; });
  }, true);
  window.addEventListener('beforeunload', (event) => {
    if (!leavingAfterSave && draftForms().length) { event.preventDefault(); event.returnValue = ''; }
  });
</script>

<style>
  .pizza-manager{margin-bottom:20px;border:2px solid var(--ink);border-radius:10px;background:#fff}
