    border:2px solid rgba(36,22,16,.15)}
  .preview-empty{color:var(--ink-2);opacity:.6;font-style:italic;font-size:.9rem}
 .thumb img[hidden],
  .preview img[hidden]{display:none}
  .pick,.photo-tools{display:flex;gap:10px;flex-wrap:wrap}
  .rotate-photo{border:2px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;
    font-family:var(--label);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.75rem}
  .pick-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;
    min-height:44px;padding:11px 20px;border-radius:8px;cursor:pointer;
    border:2px solid var(--ink);background:transparent;color:var(--ink);
    font-family:var(--label);font-weight:700;letter-spacing:.1em;
    text-transform:uppercase;font-size:.8rem;transition:background .18s}
  .pick-btn:hover{background:rgba(36,22,16,.06)}
  .pick-btn:focus-within{outline:2px solid var(--crimson);outline-offset:2px}
  /* input stays focusable for keyboards, just visually invisible over the label */
  .pick-btn input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
  .pick-btn:has(input:disabled){opacity:.5;pointer-events:none}

  .back{text-align:center;margin-top:28px}
  .back-top{margin-top:10px}

  /* ---- toast ---- */
  .toast{position:fixed;left:50%;transform:translate(-50%,20px);
    bottom:calc(24px + env(safe-area-inset-bottom));
    z-index:200;max-width:min(92vw,420px);
    padding:14px 22px;border-radius:10px;text-align:center;
    font-family:var(--label);font-weight:700;letter-spacing:.04em;font-size:.95rem;
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    opacity:0;transition:opacity .22s ease, transform .22s ease;pointer-events:none}
  .toast.show{opacity:1;transform:translate(-50%,0)}
  .toast.ok{background:var(--gold);color:var(--ink)}
  .toast.bad{background:#8d1626;color:var(--cream)}
  .toast.busy{background:var(--ink);color:var(--cream)}

  @media (max-width:820px){
    /* clear the pinned action bar */
    .toast{bottom:calc(74px + env(safe-area-inset-bottom))}
  }

  @media (prefers-reduced-motion:reduce){
    .toast{transition:none}
  }

  @media (max-width:600px){
    .add-form,.edit-form{grid-template-columns:1fr}
    .row{flex-wrap:wrap}
    .row-actions{width:100%;justify-content:flex-start}
    .jump-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
    .jump-links a{white-space:normal;display:flex;align-items:center;justify-content:center;min-height:44px}
    .pick,.photo-tools{width:100%}
    .pick-btn,.rotate-photo{flex:1 1 100%}
  }

  .menu-admin{padding-block:28px}
  .admin-wrap{max-width:1120px}
  .add-disclosure{margin-bottom:16px;border:2px solid var(--crimson);border-radius:10px;background:#fff}
  .add-disclosure>summary{display:flex;justify-content:space-between;align-items:center;min-height:52px;padding:12px 18px;background:var(--crimson);color:#fff;cursor:pointer;font:700 1.05rem var(--label);letter-spacing:.06em;list-style:none}
  .add-disclosure>summary::-webkit-details-marker{display:none}
  .add-disclosure .add-form{margin:0;box-shadow:none}
  .add-photo-preview{width:100%;max-width:360px;max-height:240px;object-fit:contain;border-radius:8px}
  .menu-filters{padding:16px;background:var(--ink);color:var(--cream);border-radius:10px}
  .menu-filters .field label{color:var(--cream)}
  .filter-options{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end;margin-top:12px}
  .filter-late{display:flex;align-items:center;gap:8px;min-height:48px;cursor:pointer}
  .filter-late input{width:22px;height:22px;accent-color:var(--gold)}
  .filter-feedback{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:12px;font-size:.9rem}
  .filter-feedback button{color:var(--cream);border-color:var(--cream)}
  .field{min-width:0}
  .field input,.field select,.field textarea{font:400 16px var(--body);min-width:0;max-width:100%;min-height:48px}
  .field textarea{width:100%;resize:vertical;min-height:100px;padding:10px;border:2px solid rgba(36,22,16,.2);border-radius:8px;background:var(--cream);line-height:1.45}
  .field.check label{flex-wrap:wrap;min-height:48px}
  .field.check .hint{flex-basis:100%;opacity:1}
  .field.check input{min-height:20px}
  .cat li.menu-item{padding:16px;margin:12px 0;background:#fff;border:1px solid var(--cream-2);border-radius:10px;scroll-margin-block:150px}
  .cat li.inactive{opacity:1;border-left:4px solid var(--crimson)}
  .who strong,.desc,.item-section{overflow-wrap:anywhere}
  .who strong{font-size:1.1rem}
