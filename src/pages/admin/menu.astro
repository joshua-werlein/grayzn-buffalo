  .pizza-form{display:grid;gap:16px;box-shadow:none}
  .pizza-form p{line-height:1.5;overflow-wrap:anywhere}
  .pizza-form fieldset{min-width:0;border:1px solid var(--ink-2);padding:12px}
  .pizza-form legend{font-weight:700;padding:0 6px}
  .pizza-checks{display:flex;gap:8px 20px;flex-wrap:wrap}
  .pizza-checks label{display:flex;align-items:center;gap:8px;min-height:48px;cursor:pointer}
