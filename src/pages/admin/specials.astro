---
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { hasPriceNotation, isIsoCalendarDate } from '../../lib/weekly-specials';

const env = (Astro.locals as any).runtime?.env ?? {};
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
type DayValues = { lunch_content: string; nightly_content: string; allday_content: string };
const blankDay = (): DayValues => ({ lunch_content: '', nightly_content: '', allday_content: '' });
let notice = '';
let error = '';
let weekStart = '';
let weekEnd = '';
let dayValues = DAYS.map(blankDay);
const readValues = (form: FormData) => DAYS.map((_, day) => ({
  lunch_content: String(form.get(`lunch_${day}`) ?? '').trim(),
  nightly_content: String(form.get(`nightly_${day}`) ?? '').trim(),
  allday_content: String(form.get(`allday_${day}`) ?? '').trim(),
}));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  weekStart = String(form.get('week_start_date') ?? '').trim();
  weekEnd = String(form.get('week_end_date') ?? '').trim();
  dayValues = readValues(form);
  try {
    if (!isIsoCalendarDate(weekStart) || !isIsoCalendarDate(weekEnd)) throw new Error('Enter valid week start and end dates.');
    if (weekStart > weekEnd) throw new Error('Week start must be on or before week end.');
    const allContent = dayValues.flatMap((day) => [day.allday_content, day.lunch_content, day.nightly_content]);
    if (!allContent.some(Boolean)) throw new Error('Enter at least one weekly special before saving.');
    if (allContent.some((value) => value.length > 1800)) throw new Error('Each field must be 1,800 characters or fewer.');
    if (allContent.some(hasPriceNotation)) throw new Error('Do not enter prices. Remove dollar signs, cents, or written dollar amounts.');
    const overlap = await env.DB.prepare(
      `SELECT id FROM weekly_specials WHERE week_start_date <= ?2 AND week_end_date >= ?1
       AND NOT (week_start_date = ?1 AND week_end_date = ?2) LIMIT 1`,
    ).bind(weekStart, weekEnd).first();
    if (overlap) throw new Error('Those dates overlap another weekly entry. Choose a non-overlapping date range.');
    const existing = await env.DB.prepare(
      'SELECT id FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2',
    ).bind(weekStart, weekEnd).first();
    let weeklyId: number;
    if (existing) {
      weeklyId = Number((existing as any).id);
      await env.DB.prepare('UPDATE weekly_specials SET updated_at = CURRENT_TIMESTAMP WHERE id = ?1').bind(weeklyId).run();
    } else {
      const result = await env.DB.prepare('INSERT INTO weekly_specials (week_start_date, week_end_date) VALUES (?1, ?2)').bind(weekStart, weekEnd).run();
      weeklyId = Number(result.meta.last_row_id);
    }
    await env.DB.batch([
      env.DB.prepare('DELETE FROM weekly_special_days WHERE weekly_special_id = ?1').bind(weeklyId),
      ...dayValues.map((day, dayOfWeek) => env.DB.prepare(
        `INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, nightly_content, allday_content)
         VALUES (?1, ?2, ?3, ?4, ?5)`,
      ).bind(weeklyId, dayOfWeek, day.lunch_content, day.nightly_content, day.allday_content)),
    ]);
    notice = 'Weekly specials saved.';
  } catch (caught) { error = caught instanceof Error ? caught.message : 'Could not save weekly specials.'; }
}
if (!weekStart && !weekEnd) {
  try {
    const latest: any = await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials ORDER BY week_end_date DESC LIMIT 1').first();
    if (latest) {
      weekStart = String(latest.week_start_date); weekEnd = String(latest.week_end_date);
      const { results } = await env.DB.prepare('SELECT day_of_week, lunch_content, nightly_content, allday_content FROM weekly_special_days WHERE weekly_special_id = ?1').bind(latest.id).all();
      for (const row of results ?? []) dayValues[Number((row as any).day_of_week)] = {
        lunch_content: String((row as any).lunch_content ?? ''), nightly_content: String((row as any).nightly_content ?? ''), allday_content: String((row as any).allday_content ?? ''),
      };
    }
  } catch {}
}
if (Astro.request.method === 'POST' && Astro.request.headers.get('accept')?.includes('application/json')) {
  return new Response(JSON.stringify({ ok: !error, message: error || notice }), { status: error ? 400 : 200, headers: { 'Content-Type': 'application/json; charset=utf-8' } });
}
---
<Base title="Admin · Weekly Specials — Grayz'n Buffalo">
<section>
  <div class="section-head"><h2>Weekly Specials</h2><p class="back"><a href="/admin">← Back to admin</a></p>{notice && <p><strong>{notice}</strong></p>}{error && <p class="error"><strong>{error}</strong></p>}</div>
  <form method="post" class="weekly-form">
    <fieldset class="week-dates"><legend>Week dates</legend><label for="week-start">Week starting</label><input id="week-start" name="week_start_date" type="date" value={weekStart} required /><label for="week-end">Week ending</label><input id="week-end" name="week_end_date" type="date" value={weekEnd} required /></fieldset>
    <p class="instructions">Enter one day’s specials in each field. Nightly specials may use multiple lines. Do not enter prices.</p>
    <div class="day-grid">{DAYS.map((day, index) => (
      <fieldset class="day-fields"><legend>{day}</legend>
        <label for={`allday-${index}`}>All Day</label><textarea id={`allday-${index}`} name={`allday_${index}`} rows="2">{dayValues[index].allday_content}</textarea>
        <label for={`lunch-${index}`}>Lunch <span>11 AM–1:30 PM</span></label><textarea id={`lunch-${index}`} name={`lunch_${index}`} rows="2">{dayValues[index].lunch_content}</textarea>
        <label for={`nightly-${index}`}>Nightly <span>5–10 PM</span></label><textarea id={`nightly-${index}`} name={`nightly_${index}`} rows="3">{dayValues[index].nightly_content}</textarea>
      </fieldset>
    ))}</div>
    <button class="btn btn-primary" type="submit">Save All Weekly Specials</button>
  </form>
</section>
</Base>
<script>const form = document.querySelector<HTMLFormElement>('.weekly-form'); form?.addEventListener('submit', () => form.setAttribute('aria-busy', 'true'));</script>
<style>
  .weekly-form{max-width:1040px;margin:0 auto;background:#fff;border-radius:12px;padding:20px;box-shadow:0 6px 16px rgba(36,22,16,.1)}.week-dates{border:0;display:grid;grid-template-columns:auto minmax(150px,1fr) auto minmax(150px,1fr);gap:8px 12px;align-items:center}legend{font-family:var(--label);font-weight:700;letter-spacing:.1em;text-transform:uppercase}.week-dates legend{grid-column:1 / -1}label{font-family:var(--label);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.78rem}.day-fields label span{text-transform:none;letter-spacing:0;font-weight:400;color:var(--ink-2)}input,textarea{width:100%;padding:10px;border:2px solid rgba(36,22,16,.2);border-radius:8px;background:var(--cream);font:inherit;line-height:1.35}textarea{resize:vertical}.instructions{margin:18px 0;color:var(--ink-2)}.day-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.day-fields{min-width:0;border:1px solid rgba(36,22,16,.16);border-radius:10px;padding:14px;display:grid;gap:6px}.day-fields:nth-child(3n+1){border-top:4px solid var(--ochre)}.day-fields:nth-child(3n+2){border-top:4px solid var(--amber)}.day-fields:nth-child(3n){border-top:4px solid var(--crimson)}button{margin-top:20px}.error{color:var(--crimson)}.back{text-align:center;margin-top:10px}.weekly-form[aria-busy="true"]{opacity:.7}@media (max-width:680px){.weekly-form{padding:16px}.week-dates{grid-template-columns:1fr}.day-grid{grid-template-columns:1fr}}
</style>
