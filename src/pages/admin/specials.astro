---
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { isIsoCalendarDate, mondayForIsoDate, standardWeekEndDate } from '../../lib/weekly-specials';

const env = (Astro.locals as any).runtime?.env ?? {};
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');

const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const DAY_NUMBERS = [1, 2, 3, 4, 5, 6, 0];
const MAX_FIELD_LENGTH = 150;
const CHARACTER_LIMIT_ERROR = 'Each field must be 150 characters or fewer.';
const isWeekend = (index: number) => index >= 5;
const DAILY_SANDWICH_PRESETS = {
  'chicken-salad': 'Chicken Salad Sandwich with cup of Chili or Coleslaw $7.25',
  'grilled-ham-cheese': 'Grilled Ham & Cheese with cup of Chili or Coleslaw $7.25',
} as const;
type DayValues = { lunch_content: string; all_day_1_content: string; all_day_2_content: string; nightly_content: string };
const blankDays = () => DAYS.map((): DayValues => ({ lunch_content: '', all_day_1_content: '', all_day_2_content: '', nightly_content: '' }));
const copyDays = (days: DayValues[]) => days.map((day) => ({ ...day }));
const normalizeLineEndings = (value: string) => value.replace(/\r\n?/g, '\n');
const formValue = (form: FormData, name: string) => normalizeLineEndings(String(form.get(name) ?? ''));
const nullable = (value: string) => value === '' ? null : value;

const valuesFrom = (form: FormData) => DAYS.map((_, index): DayValues => ({
  lunch_content: formValue(form, `lunch_${index}`).trim(),
  all_day_1_content: formValue(form, `all_day_1_${index}`).trim(),
  all_day_2_content: formValue(form, `all_day_2_${index}`).trim(),
  nightly_content: isWeekend(index) ? '' : formValue(form, `nightly_${index}`).trim(),
}));

const recurringValuesFrom = (form: FormData) => {
  const dailySandwich = formValue(form, 'recurring_daily_sandwich').trim();
  return DAYS.map((_, index): DayValues => ({
    lunch_content: isWeekend(index) ? formValue(form, `recurring_lunch_${index}`).trim() : '',
    all_day_1_content: isWeekend(index) ? formValue(form, `recurring_all_day_1_${index}`).trim() : '',
    all_day_2_content: dailySandwich,
    nightly_content: isWeekend(index) ? '' : formValue(form, `recurring_nightly_${index}`).trim(),
  }));
};

const recurringRawValues = (form: FormData) => [
  formValue(form, 'recurring_daily_sandwich'),
  ...DAYS.slice(0, 5).map((_, index) => formValue(form, `recurring_nightly_${index}`)),
  ...DAYS.slice(5).flatMap((_, index) => {
    const dayIndex = index + 5;
    return [formValue(form, `recurring_lunch_${dayIndex}`), formValue(form, `recurring_all_day_1_${dayIndex}`)];
  }),
];

const loadRecurringDefaults = async (): Promise<DayValues[]> => {
  const defaults = blankDays();
  const { results } = await env.DB.prepare(
    'SELECT day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content FROM weekly_special_recurring_default_days',
  ).all();
  if (!results || results.length !== DAYS.length) throw new Error('Recurring defaults are unavailable.');
  for (const row of results) {
    const index = DAY_NUMBERS.indexOf(Number((row as any).day_of_week));
    if (index >= 0) {
      defaults[index] = {
        lunch_content: normalizeLineEndings(String((row as any).lunch_content ?? '')),
        all_day_1_content: normalizeLineEndings(String((row as any).all_day_1_content ?? '')),
        all_day_2_content: normalizeLineEndings(String((row as any).all_day_2_content ?? '')),
        nightly_content: isWeekend(index) ? '' : normalizeLineEndings(String((row as any).nightly_content ?? '')),
      };
    }
  }
  return defaults;
};

const saveRecurringDefaults = async (defaults: DayValues[]) => {
  const writes = defaults.map((day, index) => env.DB.prepare(
    `INSERT INTO weekly_special_recurring_default_days (
       day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content
     ) VALUES (?1, ?2, ?3, ?4, ?5)
     ON CONFLICT(day_of_week) DO UPDATE SET
       lunch_content = excluded.lunch_content,
       all_day_1_content = excluded.all_day_1_content,
       all_day_2_content = excluded.all_day_2_content,
       nightly_content = excluded.nightly_content`,
  ).bind(
    DAY_NUMBERS[index],
    nullable(day.lunch_content),
    nullable(day.all_day_1_content),
    nullable(day.all_day_2_content),
    nullable(day.nightly_content),
  ));
  await env.DB.batch(writes);
};

let notice = '', error = '', weekStart = '', weekEnd = '', editingId = '', dayValues = blankDays();
// Presentation state only; weekly persistence remains a single complete-week save.
let weeklyDirty = false;
let activeDay = 0;
let weeklySaveError = '';
let weeklySaveAttempted = false;
let weeklyScrollY = 0;
let savedSnapshot = '';
// Only persisted date/content values participate in dirty comparison.
const weekSnapshot = (start: string, days: DayValues[]) => JSON.stringify([start, days.map((day) =>
  [day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content].map((value) => normalizeLineEndings(value).trim()))]);
let recurringDefaults = blankDays();
let recurringDefaultsAvailable = true;
let recurringDefaultsError = '';
let recurringDefaultsOpen = false;
try {
  recurringDefaults = await loadRecurringDefaults();
} catch {
  recurringDefaultsAvailable = false;
  recurringDefaultsError = 'Recurring defaults could not be loaded. Reload before creating a new week.';
  recurringDefaultsOpen = true;
}

const readWeek = async (id: number) => {
  const week: any = await env.DB.prepare('SELECT id, week_start_date FROM weekly_specials WHERE id = ?1').bind(id).first();
  if (!week) throw new Error('That saved week no longer exists.');
  const start = mondayForIsoDate(String(week.week_start_date));
  const days = blankDays();
  const { results } = await env.DB.prepare('SELECT day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id).all();
  for (const row of results ?? []) {
    const index = DAY_NUMBERS.indexOf(Number((row as any).day_of_week));
    if (index >= 0) days[index] = { lunch_content: normalizeLineEndings(String((row as any).lunch_content ?? '')), all_day_1_content: normalizeLineEndings(String((row as any).all_day_1_content ?? '')), all_day_2_content: normalizeLineEndings(String((row as any).all_day_2_content ?? '')), nightly_content: isWeekend(index) ? '' : normalizeLineEndings(String((row as any).nightly_content ?? '')) };
  }
  return { id: String(week.id), start, days };
};

const loadWeek = async (id: number) => {
  const week = await readWeek(id);
  editingId = week.id;
  weekStart = week.start;
  weekEnd = standardWeekEndDate(weekStart);
  dayValues = week.days;
  savedSnapshot = weekSnapshot(week.start, week.days);
};

const keepWeeklyDraft = (form: FormData) => {
  weeklyDirty = true;
  weekStart = String(form.get('week_start_date') ?? '').trim();
  editingId = String(form.get('weekly_id') ?? '').trim();
  dayValues = valuesFrom(form);
  if (isIsoCalendarDate(weekStart)) {
    weekStart = mondayForIsoDate(weekStart);
    weekEnd = standardWeekEndDate(weekStart);
  } else {
    weekEnd = '';
  }
};

const restoreWeeklyDraft = (form: FormData) => {
  try {
    const parsed = JSON.parse(String(form.get('weekly_draft') ?? ''));
    if (!parsed || typeof parsed !== 'object' || !parsed.fields || typeof parsed.fields !== 'object') return;
    const fields = parsed.fields as Record<string, unknown>;
    weeklyDirty = parsed.dirty === true;
    activeDay = Number.isInteger(parsed.activeDay) && parsed.activeDay >= 0 && parsed.activeDay < 7 ? parsed.activeDay : 0;
    const draftValue = (name: string, maxLength = MAX_FIELD_LENGTH) => {
      const value = fields[name];
      if (typeof value !== 'string') return '';
      const normalized = normalizeLineEndings(value);
      return normalized.length <= maxLength ? normalized : '';
    };
    editingId = draftValue('weekly_id', 32);
    weekStart = draftValue('week_start_date', 32);
    dayValues = DAYS.map((_, index): DayValues => ({
      lunch_content: draftValue(`lunch_${index}`),
      all_day_1_content: draftValue(`all_day_1_${index}`),
      all_day_2_content: draftValue(`all_day_2_${index}`),
      nightly_content: isWeekend(index) ? '' : draftValue(`nightly_${index}`),
    }));
    weekEnd = isIsoCalendarDate(weekStart) ? standardWeekEndDate(mondayForIsoDate(weekStart)) : '';
  } catch {}
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'save-weekly-specials');
  const wantsJson = Astro.request.headers.get('accept')?.includes('application/json');

  if (action === 'save-recurring-defaults') {
    restoreWeeklyDraft(form);
    recurringDefaults = recurringValuesFrom(form);
    recurringDefaultsOpen = true;
    try {
      if (recurringRawValues(form).some((value) => value.length > MAX_FIELD_LENGTH)) throw new Error(CHARACTER_LIMIT_ERROR);
      await saveRecurringDefaults(recurringDefaults);
      recurringDefaultsAvailable = true;
      recurringDefaultsError = '';
      if (wantsJson) return new Response(JSON.stringify({ ok: true, message: 'Recurring defaults saved.' }), { headers: { 'content-type': 'application/json' } });
      notice = 'Recurring defaults saved.';
    } catch (caught) {
      const rdMsg = caught instanceof Error ? caught.message : 'Could not save recurring defaults.';
      if (wantsJson) return new Response(JSON.stringify({ ok: false, error: rdMsg }), { status: 400, headers: { 'content-type': 'application/json' } });
      error = rdMsg;
    }
  } else if (action === 'save-weekly-specials') {
    keepWeeklyDraft(form);
    weeklySaveAttempted = true;
    const postedDay = Number(form.get('weekly_active_day'));
    activeDay = Number.isInteger(postedDay) && postedDay >= 0 && postedDay < DAYS.length ? postedDay : 0;
    const postedScroll = Number(form.get('weekly_scroll_y'));
    weeklyScrollY = Number.isFinite(postedScroll) ? Math.max(0, Math.min(postedScroll, 100000)) : 0;
    const rawContent = DAYS.flatMap((_, index) => [
      formValue(form, `lunch_${index}`),
      formValue(form, `all_day_1_${index}`),
      formValue(form, `all_day_2_${index}`),
      isWeekend(index) ? '' : formValue(form, `nightly_${index}`),
    ]);
    try {
      if (!editingId && !recurringDefaultsAvailable) throw new Error(recurringDefaultsError);
      if (!isIsoCalendarDate(weekStart)) throw new Error('Enter a valid week start date.');
      weekStart = mondayForIsoDate(weekStart);
      weekEnd = standardWeekEndDate(weekStart);
      const content = dayValues.flatMap((day) => [day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content]);
      if (rawContent.some((value) => value.length > MAX_FIELD_LENGTH)) throw new Error(CHARACTER_LIMIT_ERROR);
      if (!content.some(Boolean)) throw new Error('Enter at least one weekly special before saving.');
      const id = editingId ? Number(editingId) : null;
      if (editingId && (!Number.isInteger(id) || id < 1)) throw new Error('Invalid saved week.');
      if (id) {
        const saved = await readWeek(id);
        savedSnapshot = weekSnapshot(saved.start, saved.days);
      }
      // A direct/repeated POST must not rewrite an unchanged existing week.
      if (id && weekSnapshot(weekStart, dayValues) === savedSnapshot) {
        weeklyDirty = false;
      } else {
        const overlap = await env.DB.prepare(`SELECT id FROM weekly_specials WHERE week_start_date <= ?2 AND week_end_date >= ?1${id ? ' AND id <> ?3' : ''} LIMIT 1`).bind(...(id ? [weekStart, weekEnd, id] : [weekStart, weekEnd])).first();
        if (overlap) throw new Error('Those dates overlap another weekly entry. Choose a non-overlapping date range.');
        const insert = (weeklyId: number | string, day: DayValues, dayNumber: number) => env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) VALUES (?1, ?2, ?3, ?4, ?5, ?6)').bind(weeklyId, dayNumber, day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content);
        const writes = id
          ? [env.DB.prepare('UPDATE weekly_specials SET week_start_date = ?1, week_end_date = ?2, updated_at = CURRENT_TIMESTAMP WHERE id = ?3').bind(weekStart, weekEnd, id), env.DB.prepare('DELETE FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id), ...dayValues.map((day, index) => insert(id, day, DAY_NUMBERS[index]))]
          : [env.DB.prepare('INSERT INTO weekly_specials (week_start_date, week_end_date) VALUES (?1, ?2)').bind(weekStart, weekEnd), ...dayValues.map((day, index) => env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) SELECT id, ?3, ?4, ?5, ?6, ?7 FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart, weekEnd, DAY_NUMBERS[index], day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content))];
        await env.DB.batch(writes);
        if (!id) { const created: any = await env.DB.prepare('SELECT id FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart, weekEnd).first(); editingId = String(created?.id ?? ''); }
        weeklyDirty = false;
        const wkSavedParam = id ? 'week-updated' : 'week-created';
        return Astro.redirect(editingId ? `/admin/specials?week=${editingId}&saved=${wkSavedParam}` : `/admin/specials?saved=${wkSavedParam}`, 303);
      }
    } catch (caught) {
      error = caught instanceof Error ? caught.message : 'Could not save weekly specials.';
      weeklySaveError = error;
    }
  } else {
    error = 'Invalid form action.';
  }
}

// One-time success feedback carried through a PRG redirect (save-weekly-specials).
if (Astro.request.method !== 'POST') {
  const wkSavedParam = Astro.url.searchParams.get('saved');
  if (wkSavedParam === 'week-updated') notice = 'Saved week updated.';
  else if (wkSavedParam === 'week-created') notice = 'New future week created.';
}

const savedWeeks: any[] = [];
try { savedWeeks.push(...((await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials ORDER BY week_start_date DESC').all()).results ?? [])); } catch {}
const requestedWeek = Astro.url.searchParams.get('week');
const requestedId = Number(requestedWeek ?? '');
if (Astro.request.method !== 'POST' && Number.isInteger(requestedId) && requestedId > 0) {
  try { await loadWeek(requestedId); } catch (caught) { error = caught instanceof Error ? caught.message : 'Could not load that saved week.'; }
} else if (Astro.request.method !== 'POST' && !Astro.url.searchParams.has('week')) {
  if (recurringDefaultsAvailable) dayValues = copyDays(recurringDefaults);
  else error = recurringDefaultsError;
}
// Preserve a real saved baseline after failed POSTs and recurring-form fallbacks.
if (editingId && !savedSnapshot && Number.isInteger(Number(editingId)) && Number(editingId) > 0) {
  try {
    const saved = await readWeek(Number(editingId));
    savedSnapshot = weekSnapshot(saved.start, saved.days);
  } catch { /* Keep the draft editable if the saved baseline cannot be read. */ }
}
if (savedSnapshot) weeklyDirty = weekSnapshot(weekStart, dayValues) !== savedSnapshot;
const selectedWeekIndex = savedWeeks.findIndex((week) => String(week.id) === editingId);
const savedWeeksExpanded = selectedWeekIndex >= 4;
const dailySandwichContent = recurringDefaults[0].all_day_2_content;
const dailySandwichPreset = dailySandwichContent === DAILY_SANDWICH_PRESETS['chicken-salad']
  ? 'chicken-salad'
  : dailySandwichContent === DAILY_SANDWICH_PRESETS['grilled-ham-cheese']
    ? 'grilled-ham-cheese'
    : 'custom';
---
<Base title="Admin · Weekly Specials — Grayz'n Buffalo">
  <section class="specials-admin">
    <div class="section-head"><h2>Weekly Specials</h2>{notice && <p class="specials-notice"><strong>{notice}</strong></p>}{error && <p class="error" data-character-limit-error={error === CHARACTER_LIMIT_ERROR ? 'true' : undefined}><strong>{error}</strong></p>}</div>
    <div class="week-picker"><label for="saved-week">Saved week to edit</label><select id="saved-week"><option value="">Select a saved week...</option>{savedWeeks.map((week, index) => <option value={week.id} data-older-week={index >= 4 ? 'true' : undefined} hidden={index >= 4 && !savedWeeksExpanded} selected={String(week.id) === editingId}>{week.week_start_date} – {week.week_end_date}</option>)}</select>{savedWeeks.length > 4 && <button id="saved-weeks-toggle" class="btn btn-ghost week-picker__action" type="button" aria-expanded={savedWeeksExpanded ? 'true' : 'false'} aria-controls="saved-week">{savedWeeksExpanded ? 'View fewer weeks' : 'View more weeks'}</button>}<a class="btn btn-ghost week-picker__action" href="/admin/specials?new=1">Create new week</a></div>
    <form method="post" class="recurring-defaults-form" id="recurring-defaults-form">
      <input id="weekly-draft" type="hidden" name="weekly_draft" value="" />
      <details class="recurring-defaults" open={recurringDefaultsOpen}>
        <summary>Recurring Defaults</summary>
        <div class="recurring-defaults__content">
          <p class="recurring-defaults__intro">These values prefill new weeks only. Changes do not affect saved weeks.</p>
          {recurringDefaultsError && <p class="error recurring-defaults__error"><strong>{recurringDefaultsError}</strong></p>}
          <fieldset class="recurring-defaults__shared">
            <legend>Daily Sandwich Special</legend>
            <div class="recurring-defaults__preset"><label for="recurring-daily-sandwich-preset">Preset</label><select id="recurring-daily-sandwich-preset"><option value="chicken-salad" data-special-text={DAILY_SANDWICH_PRESETS['chicken-salad']} selected={dailySandwichPreset === 'chicken-salad'}>Chicken Salad Sandwich</option><option value="grilled-ham-cheese" data-special-text={DAILY_SANDWICH_PRESETS['grilled-ham-cheese']} selected={dailySandwichPreset === 'grilled-ham-cheese'}>Grilled Ham &amp; Cheese</option><option value="custom" selected={dailySandwichPreset === 'custom'}>Custom</option></select></div>
            <label for="recurring-daily-sandwich">Second all-day special <span>Monday–Sunday</span></label><textarea id="recurring-daily-sandwich" name="recurring_daily_sandwich" rows="2" maxlength="150">{dailySandwichContent}</textarea><output class="count">0 / 150</output>
          </fieldset>
          <div class="recurring-defaults__grid">
            {DAYS.slice(0, 5).map((day, index) => <fieldset class="recurring-day-fields"><legend>{day}</legend><div class="service-group"><label for={`recurring-nightly-${index}`}>Nightly Specials <span>5–10 PM</span></label><textarea id={`recurring-nightly-${index}`} name={`recurring_nightly_${index}`} rows="2" maxlength="150">{recurringDefaults[index].nightly_content}</textarea><output class="count">0 / 150</output></div></fieldset>)}
            {DAYS.slice(5).map((day, weekendIndex) => { const index = weekendIndex + 5; const specialLabel = index === 5 ? 'Saturday Special' : 'Sunday Special'; return <fieldset class="recurring-day-fields"><legend>{day}</legend><div class="service-group"><label for={`recurring-lunch-${index}`}>{specialLabel}</label><textarea id={`recurring-lunch-${index}`} name={`recurring_lunch_${index}`} rows="2" maxlength="150">{recurringDefaults[index].lunch_content}</textarea><output class="count">0 / 150</output></div><div class="service-group"><label for={`recurring-all-day-1-${index}`}>First all-day special</label><textarea id={`recurring-all-day-1-${index}`} name={`recurring_all_day_1_${index}`} rows="2" maxlength="150">{recurringDefaults[index].all_day_1_content}</textarea><output class="count">0 / 150</output></div></fieldset>; })}
          </div>
          <p class="rd-flash" id="rd-flash" hidden></p>
          <button class="btn btn-primary recurring-defaults__save" type="submit" name="action" value="save-recurring-defaults" formnovalidate>Save Recurring Defaults</button>
        </div>
      </details>
    </form>
    <form method="post" class="weekly-form" id="weekly-form" data-dirty={String(weeklyDirty)} data-active-day={activeDay} data-saved-snapshot={savedSnapshot} data-save-attempted={String(weeklySaveAttempted)} data-scroll-y={weeklyScrollY}>
      <input type="hidden" name="weekly_id" value={editingId}/>
      <input type="hidden" name="weekly_active_day" value={activeDay}/>
      <input type="hidden" name="weekly_scroll_y" value={weeklyScrollY}/>
      <fieldset class="week-dates"><legend>{editingId ? 'Editing saved week' : 'New weekly specials'}</legend><div class="week-date-controls"><div class="week-date-group"><label for="week-start">Week starting</label><input id="week-start" name="week_start_date" type="date" value={weekStart} required/></div><div class="week-date-group week-date-group--end"><span class="week-end-label">Week ending</span><output id="week-end" class="week-end-value" aria-live="polite">{weekEnd || 'Choose a week'}</output><p class="week-end-helper">End date is filled automatically.</p></div></div><p>The standard week starts on Monday and runs seven days through Sunday. Specials will no longer be visible once the ending date passes.</p></fieldset>
      <p class="instructions">Each field allows 150 characters. Blank fields are not shown publicly.</p>
      <div class="day-navigation" hidden>
        <p id="day-progress" class="day-progress" role="status" aria-live="polite">{DAYS[activeDay]} · {activeDay + 1} of 7</p>
        <div class="day-selector" role="group" aria-label="Choose a day to edit">
          {DAYS.map((day, index) => <button type="button" data-day-select={index} aria-label={`Edit ${day}`} aria-controls={`weekly-day-${index}`} aria-pressed={index === activeDay ? 'true' : 'false'}>{day.slice(0, 3)}</button>)}
        </div>
        <p class="swipe-hint">Swipe the card heading or use the day buttons.</p>
      </div>
      <div class="week-actions">
        <div class="week-save-row"><div class="week-save-feedback"><p>All seven days save together</p><p id="weekly-save-status" role="status" aria-live="polite" aria-atomic="true">{!weeklyDirty ? 'No unsaved changes.' : 'Ready to save all seven days.'}</p></div><button class="btn btn-primary" type="submit" name="action" value="save-weekly-specials" aria-describedby="weekly-save-status weekly-save-error">Save Week</button></div>
        <p id="weekly-save-error" class="error" role="alert" aria-atomic="true" tabindex="-1" hidden={!weeklySaveError}>{weeklySaveError}</p>
        <div class="day-stepper" hidden><button type="button" id="previous-day">← Previous</button><button type="button" id="next-day">Next →</button></div>
      </div>
      <div class="day-grid">{DAYS.map((day, index) => <fieldset class="day-fields" id={`weekly-day-${index}`} data-day-name={day} tabindex="-1"><legend>{day}</legend><div class="service-group"><label for={`lunch-${index}`}>{index === 5 ? 'Saturday Special' : index === 6 ? 'Sunday Special' : <>Lunch <span>11 AM–1:30 PM</span></>}</label><textarea id={`lunch-${index}`} name={`lunch_${index}`} rows="2" maxlength="150">{dayValues[index].lunch_content}</textarea><output class="count">0 / 150</output></div><fieldset class="all-day-group"><legend>All Day Specials</legend><label for={`all-day-1-${index}`}>First all-day special</label><textarea id={`all-day-1-${index}`} name={`all_day_1_${index}`} rows="2" maxlength="150">{dayValues[index].all_day_1_content}</textarea><output class="count">0 / 150</output><label for={`all-day-2-${index}`}>Second all-day special</label><textarea id={`all-day-2-${index}`} name={`all_day_2_${index}`} rows="2" maxlength="150">{dayValues[index].all_day_2_content}</textarea><output class="count">0 / 150</output></fieldset>{!isWeekend(index) && <div class="service-group"><label for={`nightly-${index}`}>Nightly Specials <span>5–10 PM</span></label><textarea id={`nightly-${index}`} name={`nightly_${index}`} rows="2" maxlength="150">{dayValues[index].nightly_content}</textarea><output class="count">0 / 150</output></div>}</fieldset>)}</div>

    </form>
  </section>
</Base>
<script>
  const weeklyForm = document.getElementById('weekly-form') as HTMLFormElement | null;
  const recurringDefaultsForm = document.getElementById('recurring-defaults-form') as HTMLFormElement | null;
  const weeklyDraft = document.getElementById('weekly-draft') as HTMLInputElement | null;
  const start = document.getElementById('week-start') as HTMLInputElement | null;
  const end = document.getElementById('week-end');
  const picker = document.getElementById('saved-week') as HTMLSelectElement | null;
  const weeksToggle = document.getElementById('saved-weeks-toggle') as HTMLButtonElement | null;
  const dailySandwichPreset = document.getElementById('recurring-daily-sandwich-preset') as HTMLSelectElement | null;
  const dailySandwich = document.getElementById('recurring-daily-sandwich') as HTMLTextAreaElement | null;
  const monday = (value: string) => { const date = new Date(`${value}T12:00:00Z`); date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7)); return date.toISOString().slice(0, 10); };
  const standardEnd = (value: string) => { const date = new Date(`${value}T12:00:00Z`); date.setUTCDate(date.getUTCDate() + 6); return date.toISOString().slice(0, 10); };
  const updateEnd = () => { if (!start?.value || !end) return; start.value = monday(start.value); end.textContent = standardEnd(start.value); };
  start?.addEventListener('change', updateEnd);
  const initialPickerValue = picker?.value ?? '';
  picker?.addEventListener('change', () => {
    if (!confirmLeave()) { picker.value = initialPickerValue; return; }
    leaving = true;
    location.href = picker.value ? `/admin/specials?week=${encodeURIComponent(picker.value)}` : '/admin/specials?new=1';
  });
  weeksToggle?.addEventListener('click', () => {
    const expanded = weeksToggle.getAttribute('aria-expanded') !== 'true';
    document.querySelectorAll<HTMLOptionElement>('option[data-older-week]').forEach((option) => option.hidden = !expanded);
    weeksToggle.setAttribute('aria-expanded', String(expanded));
    weeksToggle.textContent = expanded ? 'View fewer weeks' : 'View more weeks';
  });
  const textareas = Array.from(document.querySelectorAll<HTMLTextAreaElement>('textarea[maxlength]'));
  const characterLimitError = document.querySelector<HTMLElement>('[data-character-limit-error]');
  const updateCharacterLimitError = () => { if (characterLimitError) characterLimitError.hidden = !textareas.some((input) => input.value.length > input.maxLength); };
  textareas.forEach((input) => {
    const output = input.nextElementSibling as HTMLOutputElement | null;
    if (!output) return;
    const update = () => output.textContent = `${input.value.length} / ${input.maxLength}`;
    input.addEventListener('input', update);
    input.addEventListener('input', updateCharacterLimitError);
    update();
  });
  dailySandwichPreset?.addEventListener('change', () => {
    const specialText = dailySandwichPreset.selectedOptions[0]?.dataset.specialText;
    if (dailySandwich && specialText !== undefined) {
      dailySandwich.value = specialText;
      dailySandwich.dispatchEvent(new Event('input', { bubbles: true }));
    }
  });
  dailySandwich?.addEventListener('input', () => {
    if (!dailySandwichPreset) return;
    const matchesPreset = Array.from(dailySandwichPreset.options).some((option) => option.dataset.specialText === dailySandwich.value);
    if (!matchesPreset) dailySandwichPreset.value = 'custom';
  });
  updateCharacterLimitError();
  // Hidden cards remain enabled successful controls in the one weekly form.
  const cards = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.day-fields'));
  const dayButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-day-select]'));
  const navigation = document.querySelector<HTMLElement>('.day-navigation');
  const stepper = document.querySelector<HTMLElement>('.day-stepper');
  const previous = document.getElementById('previous-day') as HTMLButtonElement | null;
  const next = document.getElementById('next-day') as HTMLButtonElement | null;
  const progress = document.getElementById('day-progress');
  const saveStatus = document.getElementById('weekly-save-status');
  const phone = window.matchMedia('(max-width: 680px)');
  let currentDay = Number(weeklyForm?.dataset.activeDay ?? 0);
  let dirty = weeklyForm?.dataset.dirty === 'true';
  let leaving = false;
  const saveError = document.getElementById('weekly-save-error');
  const isExistingWeek = !!weeklyForm?.querySelector<HTMLInputElement>('[name="weekly_id"]')?.value;
  const snapshot = () => {
    const fields = new FormData(weeklyForm!);
    const value = (name: string) => String(fields.get(name) ?? '').replace(/\r\n?/g, '\n').trim();
    return JSON.stringify([value('week_start_date'), cards.map((_, index) =>
      [value(`lunch_${index}`), value(`all_day_1_${index}`), value(`all_day_2_${index}`), index < 5 ? value(`nightly_${index}`) : ''])]);
  };
  // Initial recurring prefills are the clean baseline, not user edits.
  const initialValues = weeklyForm ? snapshot() : '';
  const restoredDirty = dirty;
  const baseline = weeklyForm?.dataset.savedSnapshot || initialValues;
  const updateSaveState = () => {
    const unchanged = !dirty;
    const needsSunday = phone.matches && currentDay !== cards.length - 1;
    if (saveBtn) saveBtn.disabled = unchanged || needsSunday;
    const message = unchanged ? 'No unsaved changes.' : needsSunday
      ? 'Review through Sunday before saving.' : 'Ready to save all seven days.';
    if (saveStatus && saveStatus.textContent !== message) saveStatus.textContent = message;
  };
  const updateDirty = () => {
    dirty = isExistingWeek
      ? (!!weeklyForm && snapshot() !== baseline) || (!weeklyForm?.dataset.savedSnapshot && restoredDirty)
      : restoredDirty || (!!weeklyForm && snapshot() !== initialValues);
    weeklyForm?.classList.toggle('is-dirty', dirty);
    updateSaveState();
  };
  const showSaveError = (message: string) => {
    if (!saveError) return;
    saveError.hidden = false;
    saveError.textContent = message;
  };
  const confirmLeave = () => !dirty || window.confirm('This week contains unsaved changes. Leave without saving the week?');
  weeklyForm?.addEventListener('input', updateDirty);
  weeklyForm?.addEventListener('change', updateDirty);
  window.addEventListener('beforeunload', (event) => {
    if (!dirty || leaving) return;
    event.preventDefault();
    event.returnValue = ''; // Legacy browser support alongside preventDefault().
  });
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.hasAttribute('download') || !['http:', 'https:'].includes(link.protocol) || link.target === '_blank' || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.defaultPrevented) return;
    const target = new URL(link.href, location.href);
    if (target.pathname === location.pathname && target.search === location.search && target.hash) return;
    if (!confirmLeave()) { event.preventDefault(); return; }
    leaving = true;
  });
  window.addEventListener('pageshow', () => {
    leaving = false;
    weeklyForm?.removeAttribute('aria-busy');
    recurringDefaultsForm?.removeAttribute('aria-busy');
    updateDirty();
  });

  const saveBtn = weeklyForm?.querySelector<HTMLButtonElement>('button[value="save-weekly-specials"]') ?? null;
  const showDay = (index: number, moveFocus = false) => {
    currentDay = Math.max(0, Math.min(cards.length - 1, index));
    const focusedCard = cards.find((card) => card.contains(document.activeElement));
    cards.forEach((card, day) => { card.hidden = phone.matches && day !== currentDay; });
    dayButtons.forEach((button, day) => button.setAttribute('aria-pressed', String(day === currentDay)));
    if (navigation) navigation.hidden = !phone.matches;
    if (stepper) stepper.hidden = !phone.matches;
    if (previous) previous.disabled = currentDay === 0;
    if (next) next.disabled = currentDay === cards.length - 1;
    if (progress) progress.textContent = `${cards[currentDay]?.dataset.dayName} · ${currentDay + 1} of 7`;
    updateSaveState();
    if (phone.matches && (moveFocus || focusedCard?.hidden)) {
      cards[currentDay]?.focus({ preventScroll: true });
    }
  };
  dayButtons.forEach((button, index) => button.addEventListener('click', () => showDay(index)));
  previous?.addEventListener('click', () => showDay(currentDay - 1, true));
  next?.addEventListener('click', () => showDay(currentDay + 1, true));
  phone.addEventListener('change', () => showDay(currentDay));
  // Reveal an invalid field before the browser tries to focus it.
  weeklyForm?.addEventListener('invalid', (event) => {
    const input = event.target as HTMLInputElement | HTMLTextAreaElement;
    const label = input.labels?.[0]?.textContent?.trim() || 'Weekly special';
    showSaveError(`${label}: ${input.validationMessage}`);
    if (phone.matches) {
      // Announce beside Save without native validation scrolling to another day/date.
      event.preventDefault();
    } else {
      const index = cards.findIndex((card) => card.contains(input));
      if (index >= 0) showDay(index);
    }
  }, true);
  let touchStart: { x: number; y: number } | null = null;
  const grid = document.querySelector<HTMLElement>('.day-grid');
  grid?.addEventListener('touchstart', (event) => {
    touchStart = null;
    if (!phone.matches || event.touches.length !== 1 ||
      (event.target as Element).closest('textarea,input,select,button,a,label')) return;
    touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY };
  }, { passive: true });
  grid?.addEventListener('touchmove', (event) => {
    if (touchStart && (event.touches.length !== 1 || Math.abs(event.touches[0].clientY - touchStart.y) > 40)) touchStart = null;
  }, { passive: true });
  grid?.addEventListener('touchend', (event) => {
    const origin = touchStart;
    touchStart = null;
    if (!origin || !event.changedTouches.length) return;
    const dx = event.changedTouches[0].clientX - origin.x;
    const dy = event.changedTouches[0].clientY - origin.y;
    if (Math.abs(dx) >= 36 && Math.abs(dx) > Math.abs(dy) * 1.8) showDay(currentDay + (dx < 0 ? 1 : -1), true);
  }, { passive: true });
  grid?.addEventListener('touchcancel', () => { touchStart = null; }, { passive: true });
  showDay(currentDay);
  updateDirty();
  weeklyForm?.addEventListener('submit', (event) => {
    updateDirty();
    if (!dirty || (phone.matches && currentDay !== cards.length - 1)) {
      event.preventDefault();
      return;
    }
    const dayInput = weeklyForm.querySelector<HTMLInputElement>('[name="weekly_active_day"]');
    const scrollInput = weeklyForm.querySelector<HTMLInputElement>('[name="weekly_scroll_y"]');
    if (dayInput) dayInput.value = String(currentDay);
    if (scrollInput) scrollInput.value = String(Math.round(window.scrollY));
    leaving = true;
    weeklyForm.setAttribute('aria-busy', 'true');
  });
  if (phone.matches && weeklyForm?.dataset.saveAttempted === 'true') {
    // Failed POSTs keep the current day and viewing position; successful PRG GETs skip this.
    requestAnimationFrame(() => {
      window.scrollTo({ top: Number(weeklyForm.dataset.scrollY) || 0, behavior: 'instant' });
      if (saveError && !saveError.hidden) saveError.focus({ preventScroll: true });
    });
  }
  // Recurring defaults — AJAX so the unsaved weekly draft is never lost.
  let rdFlashTimer: number | undefined;
  function showRdFlash(message: string, kind: 'ok' | 'bad') {
    const el = document.getElementById('rd-flash') as HTMLElement | null;
    if (!el) return;
    window.clearTimeout(rdFlashTimer);
    el.textContent = message;
    el.dataset.kind = kind;
    el.style.transition = '';
    el.style.opacity = '1';
    el.hidden = false;
    rdFlashTimer = window.setTimeout(() => {
      el.style.transition = 'opacity .4s';
      el.style.opacity = '0';
      window.setTimeout(() => { el.hidden = true; }, 400);
    }, 4000);
  }

  recurringDefaultsForm?.addEventListener('submit', async (event) => {
    // Serialize the weekly draft first — the hidden field is needed for the
    // noscript POST fallback path (event.preventDefault only runs with JS).
    if (weeklyForm && weeklyDraft) {
      const fields = Object.fromEntries(Array.from(new FormData(weeklyForm).entries()).filter(([, value]) => typeof value === 'string'));
      weeklyDraft.value = JSON.stringify({ fields, dirty, activeDay: currentDay });
    }
    event.preventDefault();
    const saveBtn = recurringDefaultsForm.querySelector<HTMLButtonElement>('button[value="save-recurring-defaults"]');
    if (saveBtn) saveBtn.disabled = true;
    recurringDefaultsForm.setAttribute('aria-busy', 'true');
    try {
      const body = new FormData(recurringDefaultsForm);
      body.set('action', 'save-recurring-defaults');
      const res = await fetch('/admin/specials', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body,
      });
      const data = await res.json() as { ok: boolean; message?: string; error?: string };
      if (!res.ok || !data.ok) throw new Error(data.error ?? 'Could not save recurring defaults.');
      showRdFlash(data.message ?? 'Recurring defaults saved.', 'ok');
    } catch (err) {
      showRdFlash((err as Error).message, 'bad');
    } finally {
      if (saveBtn) saveBtn.disabled = false;
      recurringDefaultsForm.removeAttribute('aria-busy');
    }
  });

  // Strip ?saved= from the URL after a save-weekly-specials PRG redirect and
  // auto-hide the page-level success notice.
  const specialsNotice = document.querySelector<HTMLElement>('.specials-notice');
  if (specialsNotice) {
    const specialsUrl = new URL(location.href);
    if (specialsUrl.searchParams.has('saved')) {
      specialsUrl.searchParams.delete('saved');
      history.replaceState(null, '', specialsUrl.toString());
    }
    window.setTimeout(() => {
      specialsNotice.style.transition = 'opacity .4s';
      specialsNotice.style.opacity = '0';
      window.setTimeout(() => { specialsNotice.hidden = true; }, 400);
    }, 4000);
  }
</script>
