---
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { hasPriceNotation, isIsoCalendarDate } from '../../lib/weekly-specials';
const env = (Astro.locals as any).runtime?.env ?? {};
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');
const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const DAY_NUMBERS = [1, 2, 3, 4, 5, 6, 0];
type DayValues = { lunch_content: string; all_day_1_content: string; all_day_2_content: string; nightly_content: string };
const blankDays = () => DAYS.map((): DayValues => ({ lunch_content: '', all_day_1_content: '', all_day_2_content: '', nightly_content: '' }));
let notice = ''; let error = ''; let weekStart = ''; let weekEnd = ''; let editingId = ''; let dayValues = blankDays();
const valuesFrom = (form: FormData) => DAYS.map((_, index) => ({ lunch_content: String(form.get(`lunch_${index}`) ?? '').trim(), all_day_1_content: String(form.get(`all_day_1_${index}`) ?? '').trim(), all_day_2_content: String(form.get(`all_day_2_${index}`) ?? '').trim(), nightly_content: String(form.get(`nightly_${index}`) ?? '').trim() }));
const loadWeek = async (id: number) => {
  const week: any = await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials WHERE id = ?1').bind(id).first();
  if (!week) throw new Error('That saved week no longer exists.');
  editingId = String(week.id); weekStart = String(week.week_start_date); weekEnd = String(week.week_end_date); dayValues = blankDays();
  const { results } = await env.DB.prepare('SELECT day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id).all();
  for (const row of results ?? []) { const index = DAY_NUMBERS.indexOf(Number((row as any).day_of_week)); if (index >= 0) dayValues[index] = { lunch_content: String((row as any).lunch_content ?? ''), all_day_1_content: String((row as any).all_day_1_content ?? ''), all_day_2_content: String((row as any).all_day_2_content ?? ''), nightly_content: String((row as any).nightly_content ?? '') }; }
};
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData(); weekStart = String(form.get('week_start_date') ?? '').trim(); weekEnd = String(form.get('week_end_date') ?? '').trim(); editingId = String(form.get('weekly_id') ?? '').trim(); dayValues = valuesFrom(form);
  try {
    if (!isIsoCalendarDate(weekStart) || !isIsoCalendarDate(weekEnd)) throw new Error('Enter valid week start and end dates.');
    if (weekStart > weekEnd) throw new Error('Week start must be on or before week end.');
    const content = dayValues.flatMap((day) => [day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content]);
    if (!content.some(Boolean)) throw new Error('Enter at least one weekly special before saving.');
    if (content.some((value) => value.length > 150)) throw new Error('Each field must be 150 characters or fewer.');
    if (content.some(hasPriceNotation)) throw new Error('Do not enter prices. Remove dollar signs, cents, or written dollar amounts.');
    const id = editingId ? Number(editingId) : null;
    if (editingId && (!Number.isInteger(id) || id < 1)) throw new Error('Invalid saved week.');
    if (id) { const exists = await env.DB.prepare('SELECT id FROM weekly_specials WHERE id = ?1').bind(id).first(); if (!exists) throw new Error('That saved week no longer exists.'); }
    const overlap = await env.DB.prepare(`SELECT id FROM weekly_specials WHERE week_start_date <= ?2 AND week_end_date >= ?1${id ? ' AND id <> ?3' : ''} LIMIT 1`).bind(...(id ? [weekStart, weekEnd, id] : [weekStart, weekEnd])).first();
    if (overlap) throw new Error('Those dates overlap another weekly entry. Choose a non-overlapping date range.');
    const writes = id
      ? [env.DB.prepare('UPDATE weekly_specials SET week_start_date = ?1, week_end_date = ?2, updated_at = CURRENT_TIMESTAMP WHERE id = ?3').bind(weekStart, weekEnd, id), env.DB.prepare('DELETE FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id), ...dayValues.map((day, index) => env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) VALUES (?1, ?2, ?3, ?4, ?5, ?6)').bind(id, DAY_NUMBERS[index], day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content))]
      : [env.DB.prepare('INSERT INTO weekly_specials (week_start_date, week_end_date) VALUES (?1, ?2)').bind(weekStart, weekEnd), ...dayValues.map((day, index) => env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) SELECT id, ?3, ?4, ?5, ?6, ?7 FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart, weekEnd, DAY_NUMBERS[index], day.lunch_content, day.all_day_1_content, day.all_day_2_content, day.nightly_content))];
    await env.DB.batch(writes); if (!id) { const created: any = await env.DB.prepare('SELECT id FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart, weekEnd).first(); editingId = String(created?.id ?? ''); }
    notice = id ? 'Saved week updated.' : 'New future week created.';
  } catch (caught) { error = caught instanceof Error ? caught.message : 'Could not save weekly specials.'; }
}
const savedWeeks: any[] = (() => [])();
try { savedWeeks.push(...((await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials ORDER BY week_start_date DESC').all()).results ?? [])); } catch {}
const requestedId = Number(Astro.url.searchParams.get('week') ?? '');
if (Astro.request.method !== 'POST' && Number.isInteger(requestedId) && requestedId > 0) { try { await loadWeek(requestedId); } catch (caught) { error = caught instanceof Error ? caught.message : 'Could not load that saved week.'; } }
---
<Base title="Admin · Weekly Specials — Grayz'n Buffalo"><section><div class="section-head"><h2>Weekly Specials</h2><p class="back"><a href="/admin">← Back to admin</a></p>{notice && <p><strong>{notice}</strong></p>}{error && <p class="error"><strong>{error}</strong></p>}</div>
  <div class="week-picker"><label for="saved-week">Saved week to edit</label><select id="saved-week"><option value="">Select a saved week…</option>{savedWeeks.map((week) => <option value={week.id} selected={String(week.id) === editingId}>{week.week_start_date} – {week.week_end_date}</option>)}</select><a class="btn btn-ghost" href="/admin/specials?new=1">Create new week</a></div>
  <form method="post" class="weekly-form"><input type="hidden" name="weekly_id" value={editingId} /><fieldset class="week-dates"><legend>{editingId ? 'Editing saved week' : 'New weekly specials'}</legend><label for="week-start">Week starting</label><input id="week-start" name="week_start_date" type="date" value={weekStart} required /><label for="week-end">Week ending</label><input id="week-end" name="week_end_date" type="date" value={weekEnd} required /><p>These dates control when this week’s specials appear on the website. After the ending date passes, the specials will no longer be shown as current.</p></fieldset><p class="instructions">Each field allows 150 characters. Nightly specials may use multiple lines. Do not enter prices.</p><div class="day-grid">{DAYS.map((day, index) => <fieldset class="day-fields"><legend>{day}</legend><label for={`lunch-${index}`}>Lunch <span>11 AM–1:30 PM</span></label><textarea id={`lunch-${index}`} name={`lunch_${index}`} rows="2" maxlength="150">{dayValues[index].lunch_content}</textarea><output class="count">0 / 150</output><label for={`all-day-1-${index}`}>All Day Special 1</label><textarea id={`all-day-1-${index}`} name={`all_day_1_${index}`} rows="2" maxlength="150">{dayValues[index].all_day_1_content}</textarea><output class="count">0 / 150</output><label for={`all-day-2-${index}`}>All Day Special 2</label><textarea id={`all-day-2-${index}`} name={`all_day_2_${index}`} rows="2" maxlength="150">{dayValues[index].all_day_2_content}</textarea><output class="count">0 / 150</output><label for={`nightly-${index}`}>Dinner/Nightly Specials <span>5–10 PM</span></label><textarea id={`nightly-${index}`} name={`nightly_${index}`} rows="2" maxlength="150">{dayValues[index].nightly_content}</textarea><output class="count">0 / 150</output></fieldset>)}</div><button class="btn btn-primary" type="submit">Save All Weekly Specials</button></form>
</section></Base>
<script>const form=document.querySelector<HTMLFormElement>('.weekly-form'),start=document.getElementById('week-start') as HTMLInputElement|null,end=document.getElementById('week-end') as HTMLInputElement|null,picker=document.getElementById('saved-week') as HTMLSelectElement|null;start?.addEventListener('change',()=>{if(!start.value||!end)return;const d=new Date(`${start.value}T12:00:00Z`);d.setUTCDate(d.getUTCDate()+6);end.value=d.toISOString().slice(0,10)});picker?.addEventListener('change',()=>{location.href=picker.value?`/admin/specials?week=${encodeURIComponent(picker.value)}`:'/admin/specials?new=1'});document.querySelectorAll<HTMLTextAreaElement>('textarea[maxlength]').forEach(input=>{const output=input.nextElementSibling as HTMLOutputElement,update=()=>output.textContent=`${input.value.length} / 150`;input.addEventListener('input',update);update()});form?.addEventListener('submit',()=>form.setAttribute('aria-busy','true'));</script>
<style>.week-picker,.weekly-form{max-width:1280px;margin:0 auto;background:#fff;border-radius:12px;padding:20px;box-shadow:0 6px 16px rgba(36,22,16,.1)}.week-picker{display:flex;align-items:end;gap:12px;margin-bottom:18px;flex-wrap:wrap}.week-picker label{width:100%}.week-picker select{min-width:280px}.week-dates{border:0;display:grid;grid-template-columns:auto minmax(150px,1fr) auto minmax(150px,1fr);gap:8px 12px;align-items:center}.week-dates p{grid-column:1/-1;margin:6px 0;color:var(--ink-2)}legend,label{font-family:var(--label);font-weight:700;letter-spacing:.08em;text-transform:uppercase}.week-dates legend{grid-column:1/-1}label{font-size:.78rem}.day-fields label span{text-transform:none;letter-spacing:0;font-weight:400;color:var(--ink-2)}input,select,textarea{padding:10px;border:2px solid rgba(36,22,16,.2);border-radius:8px;background:var(--cream);font:inherit}textarea{width:100%;resize:vertical}.instructions{margin:18px 0;color:var(--ink-2)}.day-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.day-fields{min-width:0;border:1px solid rgba(36,22,16,.16);border-radius:10px;padding:16px;display:grid;gap:6px}.count{justify-self:end;font-size:.75rem;color:var(--ink-2)}button{margin-top:20px}.error{color:var(--crimson)}.back{text-align:center;margin-top:10px}@media(max-width:900px){.day-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.weekly-form{padding:16px}.week-dates,.day-grid{grid-template-columns:1fr}.week-picker select{width:100%}}</style>
