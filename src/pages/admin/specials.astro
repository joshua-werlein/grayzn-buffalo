---
import Base from '../../layouts/Base.astro';
import GroupFields from '../../components/SpecialGroupFields.astro';
import { isAuthed } from '../../lib/auth';
import { isIsoCalendarDate, mondayForIsoDate, standardWeekEndDate } from '../../lib/weekly-specials';
import { DAY_NUMBERS, DAY_NAMES, blankGroup, newWeekFromDefaults, readCollection, readWeek, collectionFromForm, saveCollection, SpecialConflict, type SpecialCollection } from '../../lib/specials-store';
const env = (Astro.locals as any).runtime?.env ?? {};
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');
const empty = (kind: SpecialCollection['kind'], id=''): SpecialCollection => ({ id,kind,weekly_special_id:null,title:'',schedule:'',revision:0,groups:[] });
let defaults: SpecialCollection | null = null, mexican: SpecialCollection | null = null;
let weekly = empty('week'), weekStart='', weekEnd='', editingId='', notice='', error='', recurringError='';
let activeDay=0, weeklyDirty=false, weeklySaveAttempted=false, weeklyScrollY=0, weeklySaveError='';
let ready=true;
try { defaults=await readCollection(env,'defaults'); } catch { recurringError='Recurring defaults are unavailable. New weeks cannot be initialized.'; }
try { mexican=await readCollection(env,'mexican-night'); } catch { /* Weekly editing does not depend on section availability. */ }
const requestedId = Number(Astro.url.searchParams.get('week') ?? '');
if (Number.isSafeInteger(requestedId) && requestedId>0) {
  try { const saved=await readWeek(env,requestedId); weekly=saved.collection; editingId=String(saved.id); weekStart=saved.week_start_date; weekEnd=saved.week_end_date; }
  catch { ready=false; error='That saved week could not be loaded. Please reload.'; }
} else if (defaults) weekly=newWeekFromDefaults(defaults);
else ready=false;
if (Astro.request.method==='POST') {
  const form=await Astro.request.formData();
  const action=String(form.get('action') ?? 'save-weekly-specials');
  const json=Astro.request.headers.get('accept')?.includes('application/json');
  try {
    // Astro already checks form origins. This explicit check also covers future
    // content types; no separate CSRF framework or shared abstraction is needed.
    if (Astro.request.headers.get('origin') !== Astro.url.origin) throw new Error('Invalid request origin. Reload this page before saving.');
    if (action==='save-weekly-specials') {
      weeklySaveAttempted=true; weeklyDirty=true;
      editingId=String(form.get('weekly_id') ?? '');
      if (editingId && (!Number.isSafeInteger(Number(editingId)) || Number(editingId)<1)) throw new Error('Invalid saved week.');
      const baseline=editingId ? (await readWeek(env,Number(editingId))).collection : defaults ? newWeekFromDefaults(defaults) : null;
      if (!baseline) throw new Error(recurringError);
      // New draft IDs are client-local, not the IDs of the recurring templates.
      if (!editingId) baseline.groups=[];
      weekly=collectionFromForm(form,baseline);
      weekStart=String(form.get('week_start_date') ?? '');
      if (isIsoCalendarDate(weekStart)) { weekStart=mondayForIsoDate(weekStart); weekEnd=standardWeekEndDate(weekStart); }
      activeDay=Math.max(0,Math.min(6,Number(form.get('weekly_active_day')) || 0));
      weeklyScrollY=Math.max(0,Math.min(100000,Number(form.get('weekly_scroll_y')) || 0));
      const saved=await saveCollection(env,weekly,{start:weekStart,end:weekEnd});
      return Astro.redirect(`/admin/specials?week=${saved.id}&saved=1`,303);
    } else if (action==='save-recurring-defaults' || action==='save-mexican-night') {
      const baseline=action==='save-recurring-defaults' ? defaults : mexican;
      if (!baseline) throw new Error('This editor is unavailable. Reload before saving.');
      const next=collectionFromForm(form,baseline);
      if (action==='save-recurring-defaults') defaults=next; else mexican=next;
      const saved=await saveCollection(env,next);
      if (json) return Response.json({ok:true,message:'Saved.',revision:saved.revision,groupIds:saved.groupIds});
      return Astro.redirect('/admin/specials?saved=1',303);
    } else throw new Error('Invalid form action.');
  } catch (caught) {
    const message=caught instanceof Error ? caught.message : 'Could not save specials.';
    if (json) return Response.json({ok:false,error:message},{status:caught instanceof SpecialConflict ? 409 : 400});
    error=message; if (weeklySaveAttempted) weeklySaveError=message;
  }
}
if (Astro.url.searchParams.get('saved')) notice='Specials saved.';
const savedWeeks: any[] = [];
try { savedWeeks.push(...((await env.DB.prepare('SELECT id,week_start_date,week_end_date FROM weekly_specials ORDER BY week_start_date DESC').all()).results ?? [])); } catch {}
const DAYS=DAY_NUMBERS.map(day=>DAY_NAMES[day]);
const savedWeeksExpanded=savedWeeks.findIndex(week=>String(week.id)===editingId)>=4;
if (mexican && !mexican.groups.length) mexican.groups=[blankGroup(-1)];
---
<Base title="Admin · Weekly Specials — Grayz'n Buffalo">
<section class="specials-admin">
  <div class="section-head"><h2>Weekly Specials</h2>{notice && <p class="specials-notice" role="status">{notice}</p>}{error && <p class="error" role="alert">{error}</p>}</div>
  <div class="week-picker"><label for="saved-week">Saved week to edit</label><select id="saved-week"><option value="">Select a saved week...</option>{savedWeeks.map((week,index)=><option value={week.id} data-older-week={index>=4 ? 'true' : undefined} hidden={index>=4 && !savedWeeksExpanded} selected={String(week.id)===editingId}>{week.week_start_date} – {week.week_end_date}</option>)}</select>{savedWeeks.length>4 && <button id="saved-weeks-toggle" type="button" class="btn btn-ghost week-picker__action" aria-expanded={savedWeeksExpanded}>View {savedWeeksExpanded ? 'fewer' : 'more'} weeks</button>}<a class="btn btn-ghost week-picker__action" href="/admin/specials?new=1">Create new week</a></div>
  {ready && <form method="post" id="weekly-form" class="weekly-form" data-dirty={String(weeklyDirty)} data-active-day={activeDay} data-save-attempted={String(weeklySaveAttempted)} data-scroll-y={weeklyScrollY}>
    <input type="hidden" name="weekly_id" value={editingId}/><input type="hidden" name="revision" value={weekly.revision}/><input type="hidden" name="group_count" value={weekly.groups.length}/>
    <input type="hidden" name="weekly_active_day" value={activeDay}/><input type="hidden" name="weekly_scroll_y" value={weeklyScrollY}/>
    <fieldset class="week-dates"><legend>{editingId ? 'Editing saved week' : 'New weekly specials'}</legend><div class="week-date-controls"><label class="week-date-group">Week starting<input id="week-start" type="date" name="week_start_date" value={weekStart} required/></label><div class="week-date-group"><span>Week ending</span><output id="week-end">{weekEnd || 'Choose a week'}</output></div></div><p>Monday through Sunday. Recurring defaults prefill new weeks only.</p></fieldset>
    <p class="instructions">Each group has four optional slots. Special text and price together allow 150 characters. Blank slots are hidden publicly.</p>
    <div class="day-navigation" hidden><p id="day-progress" class="day-progress" role="status">{DAYS[activeDay]} · {activeDay+1} of 7</p><div class="day-selector">{DAYS.map((day,index)=><button type="button" data-day-select={index} aria-controls={`weekly-day-${index}`} aria-pressed={index===activeDay}>{day.slice(0,3)}</button>)}</div><p class="swipe-hint">Swipe the card heading or use the day buttons.</p></div>
    <div class="week-actions"><div class="week-save-row"><div><p>All seven days save together</p><p id="weekly-save-status" role="status">No unsaved changes.</p></div><button class="btn btn-primary" type="submit" name="action" value="save-weekly-specials">Save Week</button></div><p id="weekly-save-error" class="error" role="alert" tabindex="-1" hidden={!weeklySaveError}>{weeklySaveError}</p><div class="day-stepper" hidden><button type="button" id="previous-day">← Previous</button><button type="button" id="next-day">Next →</button></div></div>
    <div class="day-grid">{DAY_NUMBERS.map((day,index)=><fieldset class="day-fields" id={`weekly-day-${index}`} data-day-name={DAYS[index]} tabindex="-1"><legend>{DAYS[index]}</legend>{weekly.groups.map((group,i)=>group.day_of_week===day && <GroupFields group={group} index={i} formPrefix="weekly"/>)}<button type="button" class="btn btn-ghost" data-add-group={day}>Add service/group</button></fieldset>)}</div>
  </form>}
  {recurringError && <p class="error">{recurringError}</p>}
  {defaults && <form method="post" id="recurring-defaults-form" class="recurring-defaults-form"><input type="hidden" name="action" value="save-recurring-defaults"/><input type="hidden" name="revision" value={defaults.revision}/><input type="hidden" name="group_count" value={defaults.groups.length}/><details class="recurring-defaults"><summary>Recurring Defaults</summary><div class="recurring-defaults__content"><p>These values prefill new weeks only. Saved weeks and intentional blanks are never changed.</p><label>Daily sandwich preset<select id="sandwich-preset"><option value="">Choose a preset…</option><option value="Chicken Salad Sandwich with cup of Chili or Coleslaw $7.25">Chicken Salad Sandwich</option><option value="Grilled Ham &amp; Cheese with cup of Chili or Coleslaw $7.25">Grilled Ham &amp; Cheese</option></select></label>{DAY_NUMBERS.map(day=><details class="default-day"><summary>{DAY_NAMES[day]}</summary>{defaults!.groups.map((group,index)=>group.day_of_week===day && <><GroupFields group={group} index={index} defaults formPrefix="defaults"/>{group.service==='all-day' && <span hidden data-sandwich-index={index}/>}</>)}<button type="button" class="btn btn-ghost" data-add-group={day}>Add service/group</button></details>)}<p class="rd-flash" id="rd-flash" role="status" hidden/><button class="btn btn-primary recurring-defaults__save" type="submit" name="action" value="save-recurring-defaults">Save Recurring Defaults</button></div></details></form>}
  {mexican && <form method="post" id="mexican-form" class="recurring-defaults-form"><input type="hidden" name="action" value="save-mexican-night"/><input type="hidden" name="revision" value={mexican.revision}/><input type="hidden" name="group_count" value={mexican.groups.length}/><details class="recurring-defaults"><summary>Mexican Night menu</summary><div class="recurring-defaults__content"><p>Published separately at <a href="/specials#mexican-night">Mexican Night</a>. Add only confirmed menu items. This does not change saved Tuesday specials.</p><label>Title<input name="title" maxlength="80" value={mexican.title}/></label><label>Schedule<input name="schedule" maxlength="80" value={mexican.schedule}/></label><div class="section-groups">{mexican.groups.map((group,index)=><GroupFields group={group} index={index} formPrefix="mexican"/>)}<button type="button" class="btn btn-ghost" data-add-group="-1">Add menu group</button></div><p id="mexican-status" role="status"/><button class="btn btn-primary" type="submit">Save Mexican Night</button></div></details></form>}
  <template id="group-template"><GroupFields group={blankGroup(-1)} index={0} formPrefix="template"/></template>
</section>
</Base>
<script>
  const weeklyForm = document.getElementById('weekly-form') as HTMLFormElement | null;
  const recurringDefaultsForm = document.getElementById('recurring-defaults-form') as HTMLFormElement | null;
  const weeklyDraft = document.getElementById('weekly-draft') as HTMLInputElement | null;
  const start = document.getElementById('week-start') as HTMLInputElement | null;
  const end = document.getElementById('week-end');
  const picker = document.getElementById('saved-week') as HTMLSelectElement | null;
  const weeksToggle = document.getElementById('saved-weeks-toggle') as HTMLButtonElement | null;
  const monday = (value: string) => { const date = new Date(`${value}T12:00:00Z`); date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7)); return date.toISOString().slice(0, 10); };
  const standardEnd = (value: string) => { const date = new Date(`${value}T12:00:00Z`); date.setUTCDate(date.getUTCDate() + 6); return date.toISOString().slice(0, 10); };
  const updateEnd = () => { if (!start?.value || !end) return; start.value = monday(start.value); end.textContent = standardEnd(start.value); };
  start?.addEventListener('change', updateEnd);
  const initialPickerValue = picker?.value ?? '';
  picker?.addEventListener('change', () => {
    if (!confirmLeave()) { picker.value = initialPickerValue; return; }
    leaving = true;
    location.href = picker.value ? `/admin/specials?week=${encodeURIComponent(picker.value)}` : '/admin/specials?new=1';
  });
  weeksToggle?.addEventListener('click', () => {
    const expanded = weeksToggle.getAttribute('aria-expanded') !== 'true';
    document.querySelectorAll<HTMLOptionElement>('option[data-older-week]').forEach((option) => option.hidden = !expanded);
    weeksToggle.setAttribute('aria-expanded', String(expanded));
    weeksToggle.textContent = expanded ? 'View fewer weeks' : 'View more weeks';
  });
  const textareas = Array.from(document.querySelectorAll<HTMLTextAreaElement>('textarea[maxlength]'));
  const characterLimitError = document.querySelector<HTMLElement>('[data-character-limit-error]');
  const updateCharacterLimitError = () => { if (characterLimitError) characterLimitError.hidden = !textareas.some((input) => input.value.length > input.maxLength); };
  const updateCounts = () => document.querySelectorAll<HTMLElement>('.slot-fields').forEach(slot => {
    const text = slot.querySelector<HTMLTextAreaElement>('[data-content]');
    const price = slot.querySelector<HTMLInputElement>('[data-price]');
    const count = slot.querySelector<HTMLOutputElement>('[data-count]');
    const length = [text?.value || '', price?.value || ''].filter(Boolean).join(' ').length;
    if (count) count.textContent = `${length} / 150`;
    price?.setCustomValidity(length > 150 ? 'Special and price together must be 150 characters or fewer.' : '');
  });
  document.addEventListener('input', updateCounts);
  updateCounts();
  document.addEventListener('click', event => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-move]');
    const slot = button?.closest<HTMLElement>('.slot-fields');
    if (!button || !slot) return;
    const siblings = Array.from(slot.parentElement!.querySelectorAll<HTMLElement>(':scope > .slot-fields'));
    const other = siblings[siblings.indexOf(slot) + Number(button.dataset.move)];
    if (!other) return;
    (slot as HTMLDetailsElement).open = true;
    (other as HTMLDetailsElement).open = true;
    for (const selector of ['[data-content]', '[data-price]', '[data-link]', '[data-unavailable]']) {
      const a = slot.querySelector<HTMLInputElement>(selector), b = other.querySelector<HTMLInputElement>(selector);
      if (!a || !b) continue;
      if (a.type === 'checkbox') [a.checked, b.checked] = [b.checked, a.checked];
      else [a.value,b.value] = [b.value,a.value];
    }
    slot.dispatchEvent(new Event('input', { bubbles: true }));
    updateCounts();
  });
  updateCharacterLimitError();
  // Hidden cards remain enabled successful controls in the one weekly form.
  const cards = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.day-fields'));
  const dayButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-day-select]'));
  const navigation = document.querySelector<HTMLElement>('.day-navigation');
  const stepper = document.querySelector<HTMLElement>('.day-stepper');
  const previous = document.getElementById('previous-day') as HTMLButtonElement | null;
  const next = document.getElementById('next-day') as HTMLButtonElement | null;
  const progress = document.getElementById('day-progress');
  const saveStatus = document.getElementById('weekly-save-status');
  const phone = window.matchMedia('(max-width: 680px)');
  let currentDay = Number(weeklyForm?.dataset.activeDay ?? 0);
  let dirty = weeklyForm?.dataset.dirty === 'true';
  let leaving = false;
  const saveError = document.getElementById('weekly-save-error');
  const isExistingWeek = !!weeklyForm?.querySelector<HTMLInputElement>('[name="weekly_id"]')?.value;
  const snapshot = () => {
    const fields = new FormData(weeklyForm!);
    return JSON.stringify(Array.from(fields.entries()).filter(([name]) => name === 'week_start_date' || name.startsWith('g')).map(([name, value]) => [name, String(value)]));
  };
  // Initial recurring prefills are the clean baseline, not user edits.
  const initialValues = weeklyForm ? snapshot() : '';
  const restoredDirty = dirty;
  const baseline = weeklyForm?.dataset.savedSnapshot || initialValues;
  const updateSaveState = () => {
    const unchanged = !dirty;
    const needsSunday = phone.matches && currentDay !== cards.length - 1;
    if (saveBtn) saveBtn.disabled = unchanged || needsSunday;
    const message = unchanged ? 'No unsaved changes.' : needsSunday
      ? 'Review through Sunday before saving.' : 'Ready to save all seven days.';
    if (saveStatus && saveStatus.textContent !== message) saveStatus.textContent = message;
  };
  const updateDirty = () => {
    dirty = isExistingWeek
      ? (!!weeklyForm && snapshot() !== baseline) || (!weeklyForm?.dataset.savedSnapshot && restoredDirty)
      : restoredDirty || (!!weeklyForm && snapshot() !== initialValues);
    weeklyForm?.classList.toggle('is-dirty', dirty);
    updateSaveState();
  };
  const showSaveError = (message: string) => {
    if (!saveError) return;
    saveError.hidden = false;
    saveError.textContent = message;
  };
  const recurringSnapshot = () => JSON.stringify(recurringDefaultsForm
    ? Array.from(new FormData(recurringDefaultsForm).entries())
      .filter(([name, value]) => (name.startsWith('g') || name === 'title' || name === 'schedule') && typeof value === 'string')
      .map(([name, value]) => [name, String(value).replace(/\r\n?/g, '\n').trim()])
    : []);
  let recurringBaseline = recurringSnapshot();
  let recurringDirty = false;
  let sectionDirty = false;
  const updateRecurringDirty = () => { recurringDirty = recurringSnapshot() !== recurringBaseline; };
  recurringDefaultsForm?.addEventListener('input', updateRecurringDirty);
  recurringDefaultsForm?.addEventListener('change', updateRecurringDirty);
  const confirmLeave = () => {
    updateRecurringDirty();
    if (!dirty && !recurringDirty && !sectionDirty) return true;
    const message = recurringDirty
      ? dirty ? 'This week and Recurring Defaults contain unsaved changes. Leave without saving?'
        : 'Recurring Defaults contain unsaved changes. Leave without saving them?'
      : sectionDirty ? 'Mexican Night contains unsaved changes. Leave without saving?' : 'This week contains unsaved changes. Leave without saving the week?';
    return window.confirm(message);
  };
  weeklyForm?.addEventListener('input', updateDirty);
  weeklyForm?.addEventListener('change', updateDirty);
  window.addEventListener('beforeunload', (event) => {
    updateRecurringDirty();
    if ((!dirty && !recurringDirty && !sectionDirty) || leaving) return;
    event.preventDefault();
    event.returnValue = ''; // Legacy browser support alongside preventDefault().
  });
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.hasAttribute('download') || !['http:', 'https:'].includes(link.protocol) || link.target === '_blank' || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.defaultPrevented) return;
    const target = new URL(link.href, location.href);
    if (target.pathname === location.pathname && target.search === location.search && target.hash) return;
    if (!confirmLeave()) { event.preventDefault(); return; }
    leaving = true;
  });
  window.addEventListener('pageshow', () => {
    leaving = false;
    weeklyForm?.removeAttribute('aria-busy');
    recurringDefaultsForm?.removeAttribute('aria-busy');
    updateDirty();
    updateRecurringDirty();
  });

  const saveBtn = weeklyForm?.querySelector<HTMLButtonElement>('button[value="save-weekly-specials"]') ?? null;
  const showDay = (index: number, moveFocus = false) => {
    currentDay = Math.max(0, Math.min(cards.length - 1, index));
    const focusedCard = cards.find((card) => card.contains(document.activeElement));
    cards.forEach((card, day) => { card.hidden = phone.matches && day !== currentDay; });
    dayButtons.forEach((button, day) => button.setAttribute('aria-pressed', String(day === currentDay)));
    if (navigation) navigation.hidden = !phone.matches;
    if (stepper) stepper.hidden = !phone.matches;
    if (previous) previous.disabled = currentDay === 0;
    if (next) next.disabled = currentDay === cards.length - 1;
    if (progress) progress.textContent = `${cards[currentDay]?.dataset.dayName} · ${currentDay + 1} of 7`;
    updateSaveState();
    if (phone.matches && (moveFocus || focusedCard?.hidden)) {
      cards[currentDay]?.focus({ preventScroll: true });
    }
  };
  dayButtons.forEach((button, index) => button.addEventListener('click', () => showDay(index)));
  previous?.addEventListener('click', () => showDay(currentDay - 1, true));
  next?.addEventListener('click', () => showDay(currentDay + 1, true));
  phone.addEventListener('change', () => showDay(currentDay));
  // Reveal an invalid field before the browser tries to focus it.
  weeklyForm?.addEventListener('invalid', (event) => {
    const input = event.target as HTMLInputElement | HTMLTextAreaElement;
    const label = input.labels?.[0]?.textContent?.trim() || 'Weekly special';
    showSaveError(`${label}: ${input.validationMessage}`);
    if (phone.matches) {
      // Announce beside Save without native validation scrolling to another day/date.
      event.preventDefault();
    } else {
      const index = cards.findIndex((card) => card.contains(input));
      if (index >= 0) showDay(index);
    }
  }, true);
  let touchStart: { x: number; y: number } | null = null;
  const grid = document.querySelector<HTMLElement>('.day-grid');
  grid?.addEventListener('touchstart', (event) => {
    touchStart = null;
    if (!phone.matches || event.touches.length !== 1 ||
      (event.target as Element).closest('textarea,input,select,button,a,label')) return;
    touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY };
  }, { passive: true });
  grid?.addEventListener('touchmove', (event) => {
    if (touchStart && (event.touches.length !== 1 || Math.abs(event.touches[0].clientY - touchStart.y) > 40)) touchStart = null;
  }, { passive: true });
  grid?.addEventListener('touchend', (event) => {
    const origin = touchStart;
    touchStart = null;
    if (!origin || !event.changedTouches.length) return;
    const dx = event.changedTouches[0].clientX - origin.x;
    const dy = event.changedTouches[0].clientY - origin.y;
    if (Math.abs(dx) >= 36 && Math.abs(dx) > Math.abs(dy) * 1.8) showDay(currentDay + (dx < 0 ? 1 : -1), true);
  }, { passive: true });
  grid?.addEventListener('touchcancel', () => { touchStart = null; }, { passive: true });
  showDay(currentDay);
  updateDirty();
  weeklyForm?.addEventListener('submit', (event) => {
    updateDirty();
    if (!dirty || (phone.matches && currentDay !== cards.length - 1)) {
      event.preventDefault();
      return;
    }
    // Saving the week navigates away too; it does not save recurring edits.
    updateRecurringDirty();
    if ((recurringDirty || sectionDirty) && !window.confirm('Recurring Defaults or Mexican Night contain unsaved changes. Save the week and leave without saving those changes?')) {
      event.preventDefault();
      return;
    }
    const dayInput = weeklyForm.querySelector<HTMLInputElement>('[name="weekly_active_day"]');
    const scrollInput = weeklyForm.querySelector<HTMLInputElement>('[name="weekly_scroll_y"]');
    if (dayInput) dayInput.value = String(currentDay);
    if (scrollInput) scrollInput.value = String(Math.round(window.scrollY));
    leaving = true;
    weeklyForm.setAttribute('aria-busy', 'true');
  });
  if (phone.matches && weeklyForm?.dataset.saveAttempted === 'true') {
    // Failed POSTs keep the current day and viewing position; successful PRG GETs skip this.
    requestAnimationFrame(() => {
      window.scrollTo({ top: Number(weeklyForm.dataset.scrollY) || 0, behavior: 'instant' });
      if (saveError && !saveError.hidden) saveError.focus({ preventScroll: true });
    });
  }
  // Recurring defaults — AJAX so the unsaved weekly draft is never lost.
  let rdFlashTimer: number | undefined;
  function showRdFlash(message: string, kind: 'ok' | 'bad') {
    const el = document.getElementById('rd-flash') as HTMLElement | null;
    if (!el) return;
    window.clearTimeout(rdFlashTimer);
    el.textContent = message;
    el.dataset.kind = kind;
    el.style.transition = '';
    el.style.opacity = '1';
    el.hidden = false;
    rdFlashTimer = window.setTimeout(() => {
      el.style.transition = 'opacity .4s';
      el.style.opacity = '0';
      window.setTimeout(() => { el.hidden = true; }, 400);
    }, 4000);
  }

  recurringDefaultsForm?.addEventListener('submit', async (event) => {
    // Serialize the draft for the server's POST restoration support. This
    // JavaScript handler sends AJAX; without JavaScript the hidden draft is empty.
    if (weeklyForm && weeklyDraft) {
      const fields = Object.fromEntries(Array.from(new FormData(weeklyForm).entries()).filter(([, value]) => typeof value === 'string'));
      weeklyDraft.value = JSON.stringify({ fields, dirty, activeDay: currentDay });
    }
    event.preventDefault();
    const saveBtn = recurringDefaultsForm.querySelector<HTMLButtonElement>('button[value="save-recurring-defaults"]');
    if (saveBtn) saveBtn.disabled = true;
    recurringDefaultsForm.setAttribute('aria-busy', 'true');
    try {
      const submittedSnapshot = recurringSnapshot();
      const body = new FormData(recurringDefaultsForm);
      body.set('action', 'save-recurring-defaults');
      const res = await fetch('/admin/specials', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body,
      });
      const data = await res.json() as { ok: boolean; message?: string; error?: string; revision?: number; groupIds?: Record<string,string> };
      if (!res.ok || !data.ok) throw new Error(data.error ?? 'Could not save recurring defaults.');
      const revision = recurringDefaultsForm.querySelector<HTMLInputElement>('[name="revision"]');
      if (revision && data.revision !== undefined) revision.value = String(data.revision);
      for (const [temporary, saved] of Object.entries(data.groupIds || {})) {
        recurringDefaultsForm.querySelectorAll<HTMLInputElement>('input[name$="_id"]').forEach(input => { if (input.value === temporary) input.value = saved; });
      }
      recurringBaseline = submittedSnapshot;
      for (const [temporary, saved] of Object.entries(data.groupIds || {})) recurringBaseline = recurringBaseline.replaceAll(temporary,saved);
      updateRecurringDirty(); // Edits made while the request was in flight remain unsaved.
      showRdFlash(data.message ?? 'Recurring defaults saved.', 'ok');
    } catch (err) {
      showRdFlash((err as Error).message, 'bad');
    } finally {
      if (saveBtn) saveBtn.disabled = false;
      recurringDefaultsForm.removeAttribute('aria-busy');
    }
  });

  // Strip ?saved= from the URL after a save-weekly-specials PRG redirect and
  // auto-hide the page-level success notice.
  const specialsNotice = document.querySelector<HTMLElement>('.specials-notice');
  if (specialsNotice) {
    const specialsUrl = new URL(location.href);
    if (specialsUrl.searchParams.has('saved')) {
      specialsUrl.searchParams.delete('saved');
      history.replaceState(null, '', specialsUrl.toString());
    }
    window.setTimeout(() => {
      specialsNotice.style.transition = 'opacity .4s';
      specialsNotice.style.opacity = '0';
      window.setTimeout(() => { specialsNotice.hidden = true; }, 400);
    }, 4000);
  }

  const sectionForm = document.getElementById('mexican-form') as HTMLFormElement | null;
  sectionForm?.addEventListener('input', () => sectionDirty = true);
  sectionForm?.addEventListener('change', () => sectionDirty = true);
  document.querySelectorAll<HTMLButtonElement>('[data-add-group]').forEach(button => button.addEventListener('click', () => {
    const form = button.closest('form')!;
    const count = form.querySelector<HTMLInputElement>('[name="group_count"]')!;
    const index = Number(count.value);
    if (index >= 84) return;
    const template = document.getElementById('group-template') as HTMLTemplateElement;
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const group = fragment.querySelector<HTMLElement>('.group-fields')!;
    group.dataset.groupIndex = String(index);
    group.dataset.groupDay = button.dataset.addGroup!;
    group.querySelectorAll<HTMLInputElement>('[name]').forEach(input => {
      input.name = input.name.replace(/^g0_/, `g${index}_`);
      if (input.name.endsWith('_id')) input.value = `new:${crypto.randomUUID()}`;
      if (input.name.endsWith('_day')) input.value = button.dataset.addGroup!;
    });
    group.querySelectorAll<HTMLElement>('[id]').forEach(input => input.id = `${form.id}-${index}-${input.id}`);
    group.querySelectorAll<HTMLLabelElement>('label[for]').forEach(label => label.htmlFor = `${form.id}-${index}-${label.htmlFor}`);
    button.before(fragment);
    count.value = String(index + 1);
    form.dispatchEvent(new Event('input', { bubbles: true }));
    updateCounts();
  }));
  const preset = document.getElementById('sandwich-preset') as HTMLSelectElement | null;
  preset?.addEventListener('change', () => {
    if (!preset.value || !recurringDefaultsForm) return;
    recurringDefaultsForm.querySelectorAll<HTMLElement>('[data-sandwich-index]').forEach(marker => {
      const prefix = `g${marker.dataset.sandwichIndex}_2_`;
      const input = recurringDefaultsForm.querySelector<HTMLTextAreaElement>(`[name="${prefix}content"]`)!;
      input.value = preset.value;
      recurringDefaultsForm.querySelector<HTMLInputElement>(`[name="${prefix}price"]`)!.value = '';
      recurringDefaultsForm.querySelector<HTMLInputElement>(`[name="${prefix}unavailable"]`)!.checked = false;
    });
    recurringDefaultsForm.dispatchEvent(new Event('input', { bubbles: true }));
    updateCounts();
  });
  sectionForm?.addEventListener('submit', async event => {
    event.preventDefault();
    const message = document.getElementById('mexican-status')!;
    const button = sectionForm.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const body = new FormData(sectionForm);
    const submitted = JSON.stringify([...body]);
    button.disabled = true;
    try {
      const response = await fetch('/admin/specials', { method:'POST', headers:{ accept:'application/json' }, body });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Could not save Mexican Night.');
      // Newly created group IDs are returned so a second save edits the same rows.
      sectionDirty = JSON.stringify([...new FormData(sectionForm)]) !== submitted;
      for (const [temporary, saved] of Object.entries(result.groupIds || {})) {
        sectionForm.querySelectorAll<HTMLInputElement>('input[name$="_id"]').forEach(input => { if (input.value===temporary) input.value=String(saved); });
      }
      sectionForm.querySelector<HTMLInputElement>('[name="revision"]')!.value = String(result.revision);
      message.textContent = 'Mexican Night saved.';
    } catch (error) { message.textContent = (error as Error).message; }
    finally { button.disabled = false; }
  });

</script>
