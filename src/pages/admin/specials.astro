---
import Base from '../../layouts/Base.astro';
import { isAuthed } from '../../lib/auth';
import { isIsoCalendarDate, mondayForIsoDate, standardWeekEndDate } from '../../lib/weekly-specials';
const env = (Astro.locals as any).runtime?.env ?? {};
if (!(await isAuthed(Astro.cookies, env))) return Astro.redirect('/admin');
const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const DAY_NUMBERS = [1, 2, 3, 4, 5, 6, 0];
const isWeekend = (index:number) => index >= 5;
type DayValues = { lunch_content:string; all_day_1_content:string; all_day_2_content:string; nightly_content:string };
const blankDays = () => DAYS.map(():DayValues => ({lunch_content:'',all_day_1_content:'',all_day_2_content:'',nightly_content:''}));
let notice='',error='',weekStart='',weekEnd='',editingId='',dayValues=blankDays(),endIsCustom=false;
const valuesFrom = (form:FormData) => DAYS.map((_,i):DayValues => ({lunch_content:String(form.get(`lunch_${i}`)??'').trim(),all_day_1_content:String(form.get(`all_day_1_${i}`)??'').trim(),all_day_2_content:String(form.get(`all_day_2_${i}`)??'').trim(),nightly_content:isWeekend(i)?'':String(form.get(`nightly_${i}`)??'').trim()}));
const loadWeek = async (id:number) => {const week:any=await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials WHERE id = ?1').bind(id).first();if(!week)throw new Error('That saved week no longer exists.');editingId=String(week.id);weekStart=String(week.week_start_date);weekEnd=String(week.week_end_date);endIsCustom=weekEnd!==standardWeekEndDate(mondayForIsoDate(weekStart));dayValues=blankDays();const {results}=await env.DB.prepare('SELECT day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id).all();for(const row of results??[]){const i=DAY_NUMBERS.indexOf(Number((row as any).day_of_week));if(i>=0)dayValues[i]={lunch_content:String((row as any).lunch_content??''),all_day_1_content:String((row as any).all_day_1_content??''),all_day_2_content:String((row as any).all_day_2_content??''),nightly_content:isWeekend(i)?'':String((row as any).nightly_content??'')};}};
if(Astro.request.method==='POST'){const form=await Astro.request.formData();weekStart=String(form.get('week_start_date')??'').trim();weekEnd=String(form.get('week_end_date')??'').trim();editingId=String(form.get('weekly_id')??'').trim();endIsCustom=form.get('end_is_custom')==='1';dayValues=valuesFrom(form);try{if(!isIsoCalendarDate(weekStart)||!isIsoCalendarDate(weekEnd))throw new Error('Enter valid week start and end dates.');weekStart=mondayForIsoDate(weekStart);if(!endIsCustom)weekEnd=standardWeekEndDate(weekStart);if(weekStart>weekEnd)throw new Error('Week start must be on or before week end.');const content=dayValues.flatMap(d=>[d.lunch_content,d.all_day_1_content,d.all_day_2_content,d.nightly_content]);if(!content.some(Boolean))throw new Error('Enter at least one weekly special before saving.');if(content.some(v=>v.length>150))throw new Error('Each field must be 150 characters or fewer.');const id=editingId?Number(editingId):null;if(editingId&&(!Number.isInteger(id)||id<1))throw new Error('Invalid saved week.');if(id&&!await env.DB.prepare('SELECT id FROM weekly_specials WHERE id = ?1').bind(id).first())throw new Error('That saved week no longer exists.');const overlap=await env.DB.prepare(`SELECT id FROM weekly_specials WHERE week_start_date <= ?2 AND week_end_date >= ?1${id?' AND id <> ?3':''} LIMIT 1`).bind(...(id?[weekStart,weekEnd,id]:[weekStart,weekEnd])).first();if(overlap)throw new Error('Those dates overlap another weekly entry. Choose a non-overlapping date range.');const insert=(weeklyId:number|string,d:DayValues,day:number)=>env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) VALUES (?1, ?2, ?3, ?4, ?5, ?6)').bind(weeklyId,day,d.lunch_content,d.all_day_1_content,d.all_day_2_content,d.nightly_content);const writes=id?[env.DB.prepare('UPDATE weekly_specials SET week_start_date = ?1, week_end_date = ?2, updated_at = CURRENT_TIMESTAMP WHERE id = ?3').bind(weekStart,weekEnd,id),env.DB.prepare('DELETE FROM weekly_special_days WHERE weekly_special_id = ?1').bind(id),...dayValues.map((d,i)=>insert(id,d,DAY_NUMBERS[i]))]:[env.DB.prepare('INSERT INTO weekly_specials (week_start_date, week_end_date) VALUES (?1, ?2)').bind(weekStart,weekEnd),...dayValues.map((d,i)=>env.DB.prepare('INSERT INTO weekly_special_days (weekly_special_id, day_of_week, lunch_content, all_day_1_content, all_day_2_content, nightly_content) SELECT id, ?3, ?4, ?5, ?6, ?7 FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart,weekEnd,DAY_NUMBERS[i],d.lunch_content,d.all_day_1_content,d.all_day_2_content,d.nightly_content))];await env.DB.batch(writes);if(!id){const created:any=await env.DB.prepare('SELECT id FROM weekly_specials WHERE week_start_date = ?1 AND week_end_date = ?2').bind(weekStart,weekEnd).first();editingId=String(created?.id??'');}notice=id?'Saved week updated.':'New future week created.';}catch(caught){error=caught instanceof Error?caught.message:'Could not save weekly specials.';}}
const savedWeeks:any[]=[];try{savedWeeks.push(...((await env.DB.prepare('SELECT id, week_start_date, week_end_date FROM weekly_specials ORDER BY week_start_date DESC').all()).results??[]));}catch{}const requestedId=Number(Astro.url.searchParams.get('week')??'');if(Astro.request.method!=='POST'&&Number.isInteger(requestedId)&&requestedId>0){try{await loadWeek(requestedId)}catch(caught){error=caught instanceof Error?caught.message:'Could not load that saved week.';}}
---
<Base title="Admin · Weekly Specials — Grayz'n Buffalo"><section><div class="section-head"><h2>Weekly Specials</h2><p class="back"><a href="/admin">← Back to admin</a></p>{notice&&<p><strong>{notice}</strong></p>}{error&&<p class="error"><strong>{error}</strong></p>}</div><div class="week-picker"><label for="saved-week">Saved week to edit</label><select id="saved-week"><option value="">Select a saved week…</option>{savedWeeks.map(w=><option value={w.id} selected={String(w.id)===editingId}>{w.week_start_date} – {w.week_end_date}</option>)}</select><a class="btn btn-ghost" href="/admin/specials?new=1">Create new week</a></div><form method="post" class="weekly-form"><input type="hidden" name="weekly_id" value={editingId}/><input id="end-is-custom" type="hidden" name="end_is_custom" value={endIsCustom?'1':'0'}/><fieldset class="week-dates"><legend>{editingId?'Editing saved week':'New weekly specials'}</legend><label for="week-start">Week starting</label><input id="week-start" name="week_start_date" type="date" value={weekStart} required/><label for="week-end">Week ending</label><div class="end-control"><input id="week-end" name="week_end_date" type="date" value={weekEnd} required/><button id="reset-standard-week" class="btn btn-ghost" type="button">Reset to standard week</button></div><p>The standard week runs seven days. The end date is filled automatically, but you may change it for a custom date range. Specials stop being current after the ending date.</p></fieldset><p class="instructions">Each field allows 150 characters. Blank fields are not shown publicly.</p><div class="day-grid">{DAYS.map((day,i)=><fieldset class="day-fields"><legend>{day}</legend><label for={`lunch-${i}`}>{i===5?'Saturday Special':i===6?'Sunday Special':<>Lunch <span>11 AM–1:30 PM</span></>}</label><textarea id={`lunch-${i}`} name={`lunch_${i}`} rows="2" maxlength="150">{dayValues[i].lunch_content}</textarea><output class="count">0 / 150</output><label for={`all-day-1-${i}`}>All Day Special 1</label><textarea id={`all-day-1-${i}`} name={`all_day_1_${i}`} rows="2" maxlength="150">{dayValues[i].all_day_1_content}</textarea><output class="count">0 / 150</output><label for={`all-day-2-${i}`}>All Day Special 2</label><textarea id={`all-day-2-${i}`} name={`all_day_2_${i}`} rows="2" maxlength="150">{dayValues[i].all_day_2_content}</textarea><output class="count">0 / 150</output>{!isWeekend(i)&&<><label for={`nightly-${i}`}>Dinner/Nightly Specials <span>5–10 PM</span></label><textarea id={`nightly-${i}`} name={`nightly_${i}`} rows="2" maxlength="150">{dayValues[i].nightly_content}</textarea><output class="count">0 / 150</output></>}</fieldset>)}</div><button class="btn btn-primary" type="submit">Save All Weekly Specials</button></form></section></Base>
<script>const form=document.querySelector<HTMLFormElement>('.weekly-form'),start=document.getElementById('week-start') as HTMLInputElement|null,end=document.getElementById('week-end') as HTMLInputElement|null,custom=document.getElementById('end-is-custom') as HTMLInputElement|null,reset=document.getElementById('reset-standard-week'),picker=document.getElementById('saved-week') as HTMLSelectElement|null;const monday=(v:string)=>{const d=new Date(`${v}T12:00:00Z`);d.setUTCDate(d.getUTCDate()-((d.getUTCDay()+6)%7));return d.toISOString().slice(0,10)},standardEnd=(v:string)=>{const d=new Date(`${v}T12:00:00Z`);d.setUTCDate(d.getUTCDate()+6);return d.toISOString().slice(0,10)};start?.addEventListener('change',()=>{if(!start.value)return;start.value=monday(start.value);if(end&&custom?.value!=='1')end.value=standardEnd(start.value)});end?.addEventListener('change',()=>{if(custom)custom.value='1'});reset?.addEventListener('click',()=>{if(!start?.value||!end)return;start.value=monday(start.value);end.value=standardEnd(start.value);if(custom)custom.value='0'});picker?.addEventListener('change',()=>{location.href=picker.value?`/admin/specials?week=${encodeURIComponent(picker.value)}`:'/admin/specials?new=1'});document.querySelectorAll<HTMLTextAreaElement>('textarea[maxlength]').forEach(input=>{const output=input.nextElementSibling as HTMLOutputElement,update=()=>output.textContent=`${input.value.length} / 150`;input.addEventListener('input',update);update()});form?.addEventListener('submit',()=>form.setAttribute('aria-busy','true'));</script>
<style>.week-picker,.weekly-form{width:100%;max-width:1440px;margin:0 auto;background:#fff;border-radius:12px;padding:20px;box-shadow:0 6px 16px rgba(36,22,16,.1)}.week-picker{display:flex;align-items:end;gap:12px;margin-bottom:18px;flex-wrap:wrap}.week-picker label{width:100%}.week-picker select{min-width:280px}.week-dates{border:0;display:grid;grid-template-columns:auto minmax(150px,1fr) auto minmax(150px,1fr);gap:8px 12px;align-items:center}.end-control{display:flex;gap:8px;align-items:center}.end-control button{margin:0;white-space:nowrap}.week-dates p{grid-column:1/-1;margin:6px 0;color:var(--ink-2)}legend,label{font-family:var(--label);font-weight:700;letter-spacing:.08em;text-transform:uppercase}.week-dates legend{grid-column:1/-1}label{font-size:.78rem}.day-fields label span{text-transform:none;letter-spacing:0;font-weight:400;color:var(--ink-2)}input,select,textarea{padding:10px;border:2px solid rgba(36,22,16,.2);border-radius:8px;background:var(--cream);font:inherit}textarea{width:100%;resize:vertical}.instructions{margin:18px 0;color:var(--ink-2)}.day-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.day-fields{min-width:0;border:1px solid rgba(36,22,16,.16);border-radius:10px;padding:16px;display:grid;gap:6px}.count{justify-self:end;font-size:.75rem;color:var(--ink-2)}button{margin-top:20px}.error{color:var(--crimson)}.back{text-align:center;margin-top:10px}@media(min-width:1280px){.day-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:900px){.day-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.weekly-form{padding:16px}.week-dates,.day-grid{grid-template-columns:1fr}.end-control{align-items:stretch;flex-direction:column}.week-picker select{width:100%}}</style>
