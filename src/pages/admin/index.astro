---
import Base from '../../layouts/Base.astro';
import { isAuthed, login, logout, verifyTurnstile } from '../../lib/auth';
import { getSetting, setSetting } from '../../lib/db';

const env = (Astro.locals as any).runtime?.env ?? {};
const sitekey = env.TURNSTILE_SITEKEY;
const turnstileOn = Boolean(sitekey && env.TURNSTILE_SECRET);

let authed = await isAuthed(Astro.cookies, env);
let error = '';
let notice = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'login') {
    // Turnstile FIRST — a bot without a valid token never reaches the password
    // comparison and never touches KV.
    const ip = Astro.request.headers.get('CF-Connecting-IP') ?? undefined;
    const human = turnstileOn
      ? await verifyTurnstile(String(form.get('cf-turnstile-response') ?? ''), env, ip)
      : true;

    if (!human) {
      error = 'Verification failed. Reload the page and try again.';
    } else if (await login(String(form.get('password') ?? ''), Astro.cookies, env)) {
      return Astro.redirect('/admin/specials', 303);
    } else {
      error = 'Wrong password.';
    }

  } else if (action === 'logout') {
    await logout(Astro.cookies, env);
    authed = false;

  } else if (action === 'save-announcements' && authed) {
    try {
      await Promise.all([
        setSetting(env, 'announcement_1', String(form.get('announcement_1') ?? '').trim()),
        setSetting(env, 'announcement_2', String(form.get('announcement_2') ?? '').trim()),
        setSetting(env, 'announcement_3', String(form.get('announcement_3') ?? '').trim()),
      ]);
      notice = 'Announcements saved.';
    } catch {
      notice = 'Database not connected yet — see README.';
    }

  } else if (action === 'save-delivery-status' && authed) {
    try {
      const deliveryDisplay = String(form.get('delivery_display') ?? 'available');
      if (!['available', 'unavailable', 'hidden'].includes(deliveryDisplay)) throw new Error('Invalid delivery setting.');
      await setSetting(env, 'delivery_display', deliveryDisplay);
      notice = deliveryDisplay === 'hidden' ? 'Delivery announcement hidden.' : `Delivery marked ${deliveryDisplay}.`;
    } catch {
      notice = 'Database not connected yet — see README.';
    }
  }
}

const announcements = authed
  ? await Promise.all(['announcement_1', 'announcement_2', 'announcement_3'].map((key) => getSetting(env, key, '')))
  : ['', '', ''];
const deliveryDisplay = authed ? await getSetting(env, 'delivery_display', 'available') : 'available';
---
<Base title={authed ? "Admin Settings — Grayz'n Buffalo" : "Staff Sign In — Grayz'n Buffalo"}>
<section class="settings-page">
  <div class="section-head">
    <h2>{authed ? 'Admin Settings' : 'Staff Sign In'}</h2>
    {notice && <p><strong>{notice}</strong></p>}
  </div>
  {authed ? (
    <div class="panel admin-dashboard">
      <p class="settings-intro">Manage announcements and delivery. Use the staff navigation for specials, menu items, and photos.</p>

      <form method="post" class="announce-form">
        <input type="hidden" name="action" value="save-announcements" />
        <fieldset>
          <legend>Announcement banner</legend>
          <p class="hint">Optional, static messages shown across the top of every page. Leave all three empty to show only the delivery status. Good for happy hour, closures, or a quick notice.</p>
          <label for="announcement-1">Announcement 1</label>
          <input id="announcement-1" name="announcement_1" type="text" maxlength="140"
                 value={announcements[0]} placeholder="e.g. Happy Hour M-F 5–6:30 PM" />
          <label for="announcement-2">Announcement 2</label>
          <input id="announcement-2" name="announcement_2" type="text" maxlength="140"
                 value={announcements[1]} placeholder="e.g. Lunch Specials 11 AM–1:30 PM" />
          <label for="announcement-3">Announcement 3</label>
          <input id="announcement-3" name="announcement_3" type="text" maxlength="140"
                 value={announcements[2]} placeholder="e.g. Nightly Specials 5–10 PM" />
        </fieldset>
        <button class="btn btn-primary" type="submit">Save announcements</button>
      </form>

      <form method="post" class="delivery-form">
        <input type="hidden" name="action" value="save-delivery-status" />
        <p class="delivery-title">Delivery status</p>
        <p class="hint">Choose whether to show availability, an unavailable message, or no delivery announcement at all.</p>
        <label for="delivery-display">Delivery display</label>
        <select id="delivery-display" name="delivery_display">
          <option value="available" selected={deliveryDisplay === 'available'}>Available — show hours</option>
          <option value="unavailable" selected={deliveryDisplay === 'unavailable'}>Unavailable — show notice</option>
          <option value="hidden" selected={deliveryDisplay === 'hidden'}>Hidden — no announcement</option>
        </select>
        <button class="btn btn-primary" type="submit">Save delivery status</button>
      </form>

      <form method="post" class="signout-form">
        <p>Finished managing the site?</p>
        <input type="hidden" name="action" value="logout" />
        <button class="btn btn-ghost" type="submit">Sign out</button>
      </form>
    </div>
  ) : (
    <form method="post" class="panel">
      <input type="hidden" name="action" value="login" />
      <label for="password">Password</label>
      <input id="password" type="password" name="password" required autocomplete="current-password" />
      {turnstileOn
        ? <div class="cf-turnstile" data-sitekey={sitekey} data-size="compact"></div>
        : <p class="warn">Bot protection is off — Turnstile isn't configured.</p>}
      {error && <p class="err">{error}</p>}
      <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
  )}
</section>
</Base>

{!authed && turnstileOn && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<style>
  .panel{max-width:460px;margin:0 auto;background:#fff;border-radius:14px;padding:28px;box-shadow:0 8px 22px rgba(36,22,16,.12);text-align:center}
  .admin-dashboard{max-width:1040px}
  .panel label,.panel legend{display:block;text-align:left;margin-bottom:6px;font-family:var(--label);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}
  .panel input,.panel select{display:block;width:100%;margin:6px 0 14px;padding:12px;border:2px solid rgba(36,22,16,.2);border-radius:8px;font-size:1rem;background:var(--cream)}
  .admin-links{list-style:none;display:flex;gap:12px;justify-content:center;margin-top:16px;flex-wrap:wrap}
  .announce-form{margin-top:26px;padding-top:22px;border-top:1px solid rgba(36,22,16,.12);text-align:left}
  .announce-form fieldset{border:0;padding:0;margin:0}
  .announce-form .hint,.delivery-form .hint{font-size:.85rem;color:var(--ink-2);margin:0 0 10px}
  .delivery-form{margin-top:26px;padding-top:22px;border-top:1px solid rgba(36,22,16,.12);text-align:left}
  .delivery-title{font-family:var(--label);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}
  .cf-turnstile{margin:0 0 16px;display:flex;justify-content:center;min-height:65px}
  .err{color:var(--crimson);font-weight:600;margin-bottom:12px}
  .warn{background:var(--amber);color:var(--ink);font-weight:700;padding:8px 12px;border-radius:8px;margin-bottom:14px;font-size:.9rem}

  .settings-page{padding-block:28px}
  .admin-dashboard{max-width:760px;text-align:left}
  .settings-intro{color:var(--ink-2);font-size:1rem}
  .panel input,.panel select{min-width:0;min-height:48px;max-width:100%}
  .signout-form{margin-top:30px;padding-top:22px;border-top:2px solid var(--cream-2);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .signout-form p{color:var(--ink-2)}
  .signout-form button{border-color:var(--crimson);color:var(--crimson)}
  .cf-turnstile{min-height:140px}
  @media(max-width:680px){
    .settings-page{padding:24px 12px 32px}
    .panel{padding:16px;border-radius:10px}
    .section-head{margin-bottom:20px}
    .panel .btn{width:100%;padding-inline:12px;letter-spacing:.04em}
    .panel input,.panel select{font-size:16px}
    .signout-form{display:block}
    .signout-form p{margin-bottom:10px}
  }
</style>
