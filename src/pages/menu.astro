---
import Base from '../layouts/Base.astro';
import { getMenu, thumbKey } from '../lib/db';
 
const env = (Astro.locals as any).runtime?.env ?? {};
const { categories, items } = await getMenu(env);
 
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
 
// Group active items by category, preserving category order; drop empty sections.
type Group = { cat: { id: number; name: string }; items: typeof items };
const daily: Group[] = categories
  .map((c) => ({ cat: c, items: items.filter((it) => it.category_id === c.id) }))
  .filter((g) => g.items.length > 0);
 
const lateNight: Group[] = categories
  .map((c) => ({ cat: c, items: items.filter((it) => it.category_id === c.id && it.late_night === 1) }))
  .filter((g) => g.items.length > 0);

const splitColumns = (groups: Group[]) => {
  const left = groups.filter((_, index) => index % 2 === 0);
  const right = groups.filter((_, index) => index % 2 === 1);
  const lighterSide = left.find((group) => group.cat.name === 'On The Lighter Side');

  // Keep this short final category with Loaded Tot Baskets instead of leaving it alone.
  return lighterSide
    ? [left.filter((group) => group !== lighterSide), [...right, lighterSide]]
    : [left, right];
};
const dailyColumns = splitColumns(daily);
const lateNightColumns = splitColumns(lateNight);
---
<Base
  title="Menu — Grayz'n Buffalo Bar & Grill"
  description="Full menu for Grayz'n Buffalo Bar & Grill in Mondovi, WI — burgers, pizzas, baskets, wraps, salads and more. Plus a late-night menu available after 10 PM."
>
<section class="menu-top section-parchment">
  <div class="section-head interior-heading">
    <span class="kicker">From the kitchen</span>
    <h1>The Menu</h1>
    <span class="vintage-rule" aria-hidden="true"></span>
    <p>No prices here — ask at the bar.</p>
  </div>
 
  <div class="tabs" role="tablist" aria-label="Menu type">
    <button
      class="tab"
      id="tab-daily"
      role="tab"
      data-panel="daily"
      aria-controls="panel-daily"
      aria-selected="true"
      tabindex="0"
    >
      Daily
    </button>

    <button
      class="tab"
      id="tab-late-night"
      role="tab"
      data-panel="late-night"
      aria-controls="panel-late-night"
      aria-selected="false"
      tabindex="-1"
    >
      Late Night
    </button>
  </div>
 
  <!-- ── Daily ─────────────────────────────────────────────────────────── -->
  <div id="panel-daily" role="tabpanel" class="panel" aria-labelledby="tab-daily" tabindex="0">
    <nav class="chips" aria-label="Jump to a section">
      <div class="chip-links">
        {daily.map((g) => (
          <a href={`#sec-${slug(g.cat.name)}`}>{g.cat.name}</a>
        ))}
      </div>
      <label class="sr-only" for="category-jump">Jump to a menu section</label>
      <select class="chip-select" id="category-jump">
        <option value="" selected disabled>Jump to a section</option>
        {daily.map((g) => (
          <option value={`#sec-${slug(g.cat.name)}`}>{g.cat.name}</option>
        ))}
      </select>
    </nav>
 
    <div class="menu-columns">
      {dailyColumns.map((column) => (
        <div class="menu-column">
          {column.map((g) => (
            <section class="cat-section" id={`sec-${slug(g.cat.name)}`}>
              <h3>{g.cat.name}</h3>
              <ul class="menu-list">
                {g.items.map((it) => (
                  <li class="item" id={`menu-item-${it.id}`}>
                    {it.photo_key && (
                      <button class="item-photo-trigger" type="button" data-lightbox-src={`/img/${it.photo_key}`} data-lightbox-alt={it.name} aria-label={`View larger photo of ${it.name}`}>
                        <img class="item-photo" src={`/img/${thumbKey(it.photo_key)}`} alt="" width="72" height="56" loading="lazy" decoding="async" />
                      </button>
                    )}
                      <div class="item-copy">
                      <strong>{it.name}</strong>
                      {it.description && <span>{it.description}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))}
    </div>
  </div>
 
  <!-- ── Late Night ────────────────────────────────────────────────────── -->
  <div id="panel-late-night" role="tabpanel" class="panel" tabindex="0" hidden>
    <p class="late-note">Available after 10 PM — pizza, pizza fries &amp; appetizers.</p>
    {lateNight.length === 0 ? (
      <p class="empty">Late-night items are being set up. Check back soon.</p>
    ) : (
      <div class="menu-columns">
        {lateNightColumns.map((column) => (
          <div class="menu-column">
            {column.map((g) => (
              <section class="cat-section">
                <h3>{g.cat.name}</h3>
                <ul class="menu-list">
                  {g.items.map((it) => (
                    <li class="item">
                      {it.photo_key && (
                        <button class="item-photo-trigger" type="button" data-lightbox-src={`/img/${it.photo_key}`} data-lightbox-alt={it.name} aria-label={`View larger photo of ${it.name}`}>
                          <img class="item-photo" src={`/img/${thumbKey(it.photo_key)}`} alt="" width="72" height="56" loading="lazy" decoding="async" />
                        </button>
                      )}
                      <div class="item-copy">
                      <strong>{it.name}</strong>
                      {it.description && <span>{it.description}</span>}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
</Base>
 
<style>
  .menu-top{padding-top:clamp(28px,4vw,48px)}

  /* ── tabs ── */
  .tabs{display:flex;justify-content:center;gap:10px;margin-bottom:26px;flex-wrap:wrap}
  .tabs .tab{font-family:var(--label);font-weight:700;letter-spacing:.14em;
    text-transform:uppercase;font-size:1rem;padding:12px 28px;border-radius:999px;
    border:2px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;
    transition:background .2s,color .2s,border-color .2s}
  /* Active pill uses a darker crimson + near-white bold so contrast passes AA
     (plain crimson + cream is the ~3.2:1 failure flagged site-wide in CLAUDE.md
     §9 — fix that globally in .btn-primary too). */
  .tabs .tab[aria-selected="true"]{background:#b0182b;border-color:#b0182b;color:#fff5e9}
  .tabs .tab:focus-visible{outline:2px solid var(--crimson);outline-offset:2px}
 
  /* ── sticky section chips (Daily) ── */
  .chips{position:sticky;top:0;z-index:5;padding:10px 2px;margin:0 auto 8px;
    max-width:1120px;background:var(--cream)}
  /* If the header overlaps the chips, bump this top offset to the header height. */
  .chip-links{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}
  .chips a{font-family:var(--label);font-weight:600;letter-spacing:.08em;
    text-transform:uppercase;font-size:.78rem;white-space:nowrap;
    padding:8px 14px;border-radius:999px;border:1.5px solid rgba(36,22,16,.28);
    color:var(--ink);text-decoration:none;transition:background .18s,border-color .18s}
  .chips a:hover,.chips a:focus-visible{background:rgba(36,22,16,.06);border-color:var(--ink)}
  .chips a:focus-visible{outline:2px solid var(--crimson);outline-offset:2px}
  .chip-select{display:none;width:100%;min-height:46px;padding:0 42px 0 14px;
    border:2px solid var(--ink);border-radius:8px;background:var(--cream);color:var(--ink);
    font-family:var(--label);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.9rem}
  .chip-select:focus-visible{outline:2px solid var(--crimson);outline-offset:2px}
 
  /* ── sections + items ── */
  .menu-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px;
    max-width:1120px;margin:0 auto}
  .menu-column{min-width:0}
  .cat-section{scroll-margin-top:120px}
  .cat-section h3{font-family:var(--display);font-weight:400;font-size:1.5rem;
    margin:30px 0 6px;padding-bottom:6px;border-bottom:2px solid rgba(36,22,16,.15)}
 
  .menu-list{list-style:none;margin:0;padding:0}
  .item{display:flex;align-items:center;gap:14px;
    padding:14px 4px;border-bottom:1px dashed rgba(36,22,16,.22);scroll-margin-top:84px}
  .item:target{outline:3px solid var(--gold);outline-offset:5px;border-radius:6px}
  .item:last-child{border-bottom:none}
  .item-photo-trigger{flex:0 0 72px;width:72px;height:56px;padding:0;border:0;border-radius:8px;background:transparent;cursor:zoom-in}
  .item-photo-trigger:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  .item-photo{width:72px;height:56px;object-fit:cover;
    border-radius:8px;display:block;background:rgba(36,22,16,.08)}
  .item-copy{min-width:0}
  .item-copy strong{display:block;font-family:var(--label);font-weight:700;font-size:1.12rem;line-height:1.2}
  .item-copy span{display:block;color:var(--ink-2);font-size:.92rem;margin-top:2px}
 
  .late-note{max-width:720px;margin:0 auto 6px;text-align:center;
    color:var(--ink-2);font-family:var(--label);letter-spacing:.04em;font-size:.95rem}
  .empty{max-width:720px;margin:24px auto;text-align:center;color:var(--ink-2)}
 
  @media (max-width:600px){
    .chips{max-width:720px;padding:8px 0}
    .chip-links{display:none}
    .chip-select{display:block}
    .menu-columns{grid-template-columns:1fr}
    .item-photo-trigger{flex-basis:60px;width:60px;height:48px}
    .item-photo{width:60px;height:48px}
    .cat-section h3{font-size:1.3rem}
  }

  .menu-top{padding-top:clamp(32px,5vw,54px)}
  .interior-heading{margin-bottom:24px}.interior-heading .vintage-rule{background:var(--brick)}
  .tabs{gap:0;margin-bottom:20px}.tabs .tab{min-height:48px;border-radius:0;border:1px solid var(--ink);padding:11px 26px;background:var(--surface-parchment)}
  .tabs .tab + .tab{border-left:0}.tabs .tab[aria-selected="true"]{background:var(--brick);border-color:var(--brick);color:var(--cream)}
  .chips{max-width:var(--content-wide);padding:10px 0;background:var(--page-parchment);border-bottom:1px solid var(--rule)}
  .chip-links{gap:0}.chips a{border:0;border-radius:0;padding:7px 10px;color:var(--text-muted);text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px}.chips a:hover,.chips a:focus-visible{background:transparent;color:var(--brick);text-decoration-color:currentColor}
  .menu-columns{max-width:var(--content-wide);gap:0 clamp(28px,5vw,64px)}.cat-section{margin-bottom:20px}.cat-section h3{margin:24px 0 4px;padding:0 0 8px;border-bottom:2px solid var(--ochre);font-size:clamp(1.35rem,2.4vw,1.8rem)}
  .item{gap:12px;padding:12px 2px;border-bottom:1px solid var(--rule)}.item-photo-trigger,.item-photo{border-radius:var(--control-radius)}.item-copy strong{font-size:1.05rem}.item-copy span{color:var(--text-muted)}
  .late-note{margin:0 auto 18px;padding:10px;border-bottom:1px solid var(--rule)}

  .menu-top{background-color:var(--page-parchment);background-image:radial-gradient(rgba(76,45,24,.08) .65px,transparent .75px),linear-gradient(90deg,rgba(92,54,27,.07),transparent 16%,transparent 84%,rgba(92,54,27,.06));background-size:5px 5px,100% 100%}
  .interior-heading .kicker{color:var(--denim)}.interior-heading .vintage-rule{width:15rem;background:linear-gradient(90deg,transparent,var(--brick) 15%,var(--brick) 85%,transparent)}
  .tabs{position:relative}.tabs::before,.tabs::after{content:'★';align-self:center;color:var(--ochre);padding-inline:10px}.tabs .tab{background:#f6ead1;border-color:var(--ink);box-shadow:inset 0 0 0 1px rgba(255,255,255,.55)}.tabs .tab[aria-selected="true"]{background:var(--denim);border-color:var(--ink);color:var(--cream)}
  .chips{background:rgba(244,231,206,.96);border-top:1px solid var(--rule);border-bottom:2px double var(--ink)}.chip-links{justify-content:center}.chips a{font-family:var(--label);letter-spacing:.12em}.chips a:hover,.chips a:focus-visible{color:var(--brick);text-decoration-color:var(--brick)}
  .menu-columns{padding:clamp(14px,2vw,24px);border:2px solid var(--ink);box-shadow:5px 5px 0 rgba(43,27,20,.2);background-color:var(--surface-parchment);background-image:linear-gradient(90deg,rgba(89,50,24,.06),transparent 12%,transparent 88%,rgba(89,50,24,.05))}
  .cat-section h3{color:var(--denim);border-bottom:2px solid var(--ink);position:relative}.cat-section h3::after{content:'★';float:right;color:var(--brick);font-size:.8rem;padding-top:.35em}.item{border-bottom:1px dashed rgba(43,27,20,.42)}.item-photo-trigger,.item-photo{border-radius:0}.item-photo{border:3px solid #f7ecd6;box-shadow:2px 2px 0 rgba(43,27,20,.2)}
</style>
 
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs .tab'));

  const panels: Record<string, HTMLElement | null> = {
    daily: document.getElementById('panel-daily'),
    'late-night': document.getElementById('panel-late-night'),
  };

  function show(name: string) {
    tabs.forEach((t) => {
      const active = t.dataset.panel === name;
      t.setAttribute('aria-selected', active ? 'true' : 'false');
      t.setAttribute('tabindex', active ? '0' : '-1');
    });

    Object.entries(panels).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
  }

  tabs.forEach((t, index) => {
    t.addEventListener('click', () => show(t.dataset.panel!));

    t.addEventListener('keydown', (e) => {
      let next = index;

      if (e.key === 'ArrowRight') {
        next = (index + 1) % tabs.length;
      }

      if (e.key === 'ArrowLeft') {
        next = (index - 1 + tabs.length) % tabs.length;
      }

      if (e.key === 'Home') {
        next = 0;
      }

      if (e.key === 'End') {
        next = tabs.length - 1;
      }

      if (next !== index) {
        e.preventDefault();
        tabs[next].focus();
        show(tabs[next].dataset.panel!);
      }
    });
  });

  const categoryJump = document.querySelector<HTMLSelectElement>('#category-jump');

  categoryJump?.addEventListener('change', () => {
    if (categoryJump.value) location.hash = categoryJump.value;
  });

  // Deep links: #late-night opens that tab; a #sec-* chip link stays on Daily.
  if (location.hash === '#late-night') {
    show('late-night');
  } else if (location.hash.startsWith('#sec-')) {
    show('daily');
  }
</script>
