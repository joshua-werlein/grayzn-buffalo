---
import Base from '../layouts/Base.astro';
import { getMenu, thumbKey } from '../lib/db';
 
const env = (Astro.locals as any).runtime?.env ?? {};
const { categories, items } = await getMenu(env);
 
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
 
// Group active items by category, preserving category order; drop empty sections.
type Group = { cat: { id: number; name: string }; items: typeof items };
const daily: Group[] = categories
  .map((c) => ({ cat: c, items: items.filter((it) => it.category_id === c.id) }))
  .filter((g) => g.items.length > 0);
 
const lateNight: Group[] = categories
  .map((c) => ({ cat: c, items: items.filter((it) => it.category_id === c.id && it.late_night === 1) }))
  .filter((g) => g.items.length > 0);

const splitColumns = (groups: Group[]) => {
  const left = groups.filter((_, index) => index % 2 === 0);
  const right = groups.filter((_, index) => index % 2 === 1);
  const lighterSide = left.find((group) => group.cat.name === 'On The Lighter Side');

  // Keep this short final category with Loaded Tot Baskets instead of leaving it alone.
  return lighterSide
    ? [left.filter((group) => group !== lighterSide), [...right, lighterSide]]
    : [left, right];
};
const dailyColumns = splitColumns(daily);
const lateNightColumns = splitColumns(lateNight);
---
<Base
  title="Menu — Grayz'n Buffalo Bar & Grill"
  description="Full menu for Grayz'n Buffalo Bar & Grill in Mondovi, WI — burgers, pizzas, baskets, wraps, salads and more. Plus a late-night menu available after 10 PM."
>
<section class="menu-top section-parchment">
  <div class="menu-sheet">
  <svg class="corner-flourish corner-flourish--top-left" viewBox="0 0 72 72" aria-hidden="true">
    <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
    <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
  </svg>
  <svg class="corner-flourish corner-flourish--top-right" viewBox="0 0 72 72" aria-hidden="true">
    <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
    <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
  </svg>
  <svg class="corner-flourish corner-flourish--bottom-left" viewBox="0 0 72 72" aria-hidden="true">
    <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
    <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
  </svg>
  <svg class="corner-flourish corner-flourish--bottom-right" viewBox="0 0 72 72" aria-hidden="true">
    <path d="M6 61c17-1 22-11 20-23-2-11 3-22 15-28 10-5 21-1 23 8 2 7-3 13-9 13-5 0-8-4-7-8 1-4 5-6 9-3" />
    <path d="M11 53c8-3 11-10 10-18M31 14c4 5 9 7 15 7" />
  </svg>
  <div class="section-head interior-heading">
    <span class="kicker">From the kitchen</span>
    <h1>The Menu</h1>
    <span class="vintage-rule" aria-hidden="true"></span>
    <p>No prices here — ask at the bar.</p>
  </div>
 
  <div class="tabs" role="tablist" aria-label="Menu type">
    <button
      class="tab"
      id="tab-daily"
      role="tab"
      data-panel="daily"
      aria-controls="panel-daily"
      aria-selected="true"
      tabindex="0"
    >
      Daily
    </button>

    <button
      class="tab"
      id="tab-late-night"
      role="tab"
      data-panel="late-night"
      aria-controls="panel-late-night"
      aria-selected="false"
      tabindex="-1"
    >
      Late Night
    </button>
  </div>
 
  <!-- ── Daily ─────────────────────────────────────────────────────────── -->
  <div id="panel-daily" role="tabpanel" class="panel" aria-labelledby="tab-daily" tabindex="0">
    <nav class="chips" aria-label="Jump to a section">
      <div class="chip-links">
        {daily.map((g) => (
          <a href={`#sec-${slug(g.cat.name)}`}>{g.cat.name}</a>
        ))}
      </div>
      <label class="sr-only" for="category-jump">Jump to a menu section</label>
      <select class="chip-select" id="category-jump">
        <option value="" selected disabled>Jump to a section</option>
        {daily.map((g) => (
          <option value={`#sec-${slug(g.cat.name)}`}>{g.cat.name}</option>
        ))}
      </select>
    </nav>
 
    <div class="menu-columns">
      {dailyColumns.map((column) => (
        <div class="menu-column">
          {column.map((g) => (
            <section class="cat-section" id={`sec-${slug(g.cat.name)}`}>
              <h3>{g.cat.name}</h3>
              <ul class="menu-list">
                {g.items.map((it) => (
                  <li class="item" id={`menu-item-${it.id}`}>
                    {it.photo_key && (
                      <button class="item-photo-trigger" type="button" data-lightbox-src={`/img/${it.photo_key}`} data-lightbox-alt={it.name} aria-label={`View larger photo of ${it.name}`}>
                        <img class="item-photo" src={`/img/${thumbKey(it.photo_key)}`} alt="" width="72" height="56" loading="lazy" decoding="async" />
                      </button>
                    )}
                      <div class="item-copy">
                      <strong>{it.name}</strong>
                      {it.description && <span>{it.description}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))}
    </div>
  </div>
 
  <!-- ── Late Night ────────────────────────────────────────────────────── -->
  <div id="panel-late-night" role="tabpanel" class="panel" aria-labelledby="tab-late-night" tabindex="0" hidden>
    <p class="late-note">Available after 10 PM — pizza, pizza fries &amp; appetizers.</p>
    {lateNight.length === 0 ? (
      <p class="empty">Late-night items are being set up. Check back soon.</p>
    ) : (
      <div class="menu-columns">
        {lateNightColumns.map((column) => (
          <div class="menu-column">
            {column.map((g) => (
              <section class="cat-section">
                <h3>{g.cat.name}</h3>
                <ul class="menu-list">
                  {g.items.map((it) => (
                    <li class="item">
                      {it.photo_key && (
                        <button class="item-photo-trigger" type="button" data-lightbox-src={`/img/${it.photo_key}`} data-lightbox-alt={it.name} aria-label={`View larger photo of ${it.name}`}>
                          <img class="item-photo" src={`/img/${thumbKey(it.photo_key)}`} alt="" width="72" height="56" loading="lazy" decoding="async" />
                        </button>
                      )}
                      <div class="item-copy">
                      <strong>{it.name}</strong>
                      {it.description && <span>{it.description}</span>}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>
  </div>
</section>
</Base>
 
<style>
  .menu-top{
    --footer-blend-height:clamp(40px,3vw,56px);
    padding:clamp(28px,5vw,68px) clamp(14px,4vw,56px) calc(var(--footer-blend-height) + clamp(12px,1.5vw,20px));
    background-color:var(--surface-parchment);
    background-image:linear-gradient(to bottom,rgba(91,50,24,.08) 0,rgba(91,50,24,.08) calc(100% - var(--footer-blend-height)),rgba(91,50,24,0) 100%),url('/parchment-texture.webp');
    background-position:center top,left bottom;
    background-size:auto,512px 512px;
    background-repeat:no-repeat,repeat;
  }

  .menu-sheet{
    position:relative;
    isolation:isolate;
    width:min(100%,1180px);
    margin:0 auto;
    padding:clamp(30px,5vw,68px) clamp(20px,5.5vw,72px) clamp(38px,6vw,76px);
    color:#291912;
    background-color:#f8ecd3;
    background-image:radial-gradient(rgba(74,40,19,.055) .65px,transparent .8px),linear-gradient(105deg,rgba(143,91,37,.055),transparent 30%,rgba(143,91,37,.035) 78%,transparent);
    background-size:5px 5px,100% 100%;
    border:7px double #291912;
    box-shadow:0 12px 30px rgba(53,29,14,.24);
  }
  .menu-sheet > :not(.corner-flourish){position:relative;z-index:1}
  .corner-flourish{
    position:absolute;
    z-index:0;
    width:clamp(48px,5vw,70px);
    height:auto;
    color:var(--brick);
    fill:none;
    stroke:currentColor;
    stroke-width:2.2;
    stroke-linecap:round;
    stroke-linejoin:round;
    opacity:.68;
    pointer-events:none;
  }
  .corner-flourish--top-left{top:11px;left:11px}
  .corner-flourish--top-right{top:11px;right:11px;transform:scaleX(-1)}
  .corner-flourish--bottom-left{bottom:11px;left:11px;transform:scaleY(-1)}
  .corner-flourish--bottom-right{right:11px;bottom:11px;transform:scale(-1)}

  .interior-heading{margin-bottom:clamp(22px,3vw,34px)}
  .interior-heading .kicker{display:block;color:var(--brick);font-size:.82rem}
  .interior-heading h1{
    margin:8px 0 5px;
    color:#291912;
    font-size:clamp(3rem,8vw,6.4rem);
    line-height:.98;
    letter-spacing:.025em;
    text-transform:uppercase;
  }
  .interior-heading .vintage-rule{
    width:min(100%,28rem);
    height:5px;
    margin-top:18px;
    background:linear-gradient(to bottom,#291912 0 1px,transparent 1px 3px,#291912 3px 4px,transparent 4px);
  }
  .interior-heading p{margin-top:11px;color:#583e30;font-family:var(--label);font-weight:600;letter-spacing:.06em;text-transform:uppercase}

  /* Menu-type tabs keep the existing keyboard behavior while reading like print labels. */
  .tabs{display:flex;justify-content:center;align-items:center;gap:0;margin:0 auto 22px;flex-wrap:wrap}
  .tabs::before,.tabs::after{content:'★';padding-inline:clamp(8px,2vw,18px);color:var(--brick);font-size:1rem;line-height:1}
  .tabs .tab{
    min-height:48px;
    padding:10px clamp(22px,3vw,34px);
    border:1px solid #291912;
    border-radius:0;
    background:#f8ecd3;
    color:#291912;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.5);
    font-family:var(--label);
    font-size:1rem;
    font-weight:700;
    letter-spacing:.16em;
    text-transform:uppercase;
    cursor:pointer;
    transition:background-color .18s,color .18s;
  }
  .tabs .tab + .tab{border-left:0}
  .tabs .tab[aria-selected="true"]{background:#183e50;color:#f8ecd3}
  .tabs .tab:hover{background:#ead9b7}
  .tabs .tab[aria-selected="true"]:hover{background:#123141}
  .tabs .tab:focus-visible{outline:3px solid var(--brick);outline-offset:3px}

  /* Daily category links remain sticky; mobile still swaps these for the jump select. */
  .chips{
    position:sticky;
    top:0;
    z-index:5;
    max-width:100%;
    margin:0 auto 10px;
    padding:10px 2px;
    background:rgba(248,236,211,.97);
    border-top:1px solid rgba(41,25,18,.32);
    border-bottom:2px solid #291912;
  }
  .chip-links{display:flex;justify-content:center;gap:0;flex-wrap:wrap}
  .chips a{
    padding:7px 10px;
    color:#4f362a;
    font-family:var(--label);
    font-size:.76rem;
    font-weight:700;
    letter-spacing:.11em;
    line-height:1.2;
    text-decoration:underline;
    text-decoration-color:transparent;
    text-underline-offset:4px;
    text-transform:uppercase;
    white-space:nowrap;
  }
  .chips a:hover,.chips a:focus-visible{color:var(--brick);text-decoration-color:currentColor}
  .chips a:focus-visible{outline:2px solid var(--brick);outline-offset:2px}
  .chip-select{
    display:none;
    width:100%;
    min-height:48px;
    padding:0 42px 0 14px;
    border:2px solid #291912;
    border-radius:0;
    background:#f8ecd3;
    color:#291912;
    font-family:var(--label);
    font-size:.9rem;
    font-weight:700;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  .chip-select:focus-visible{outline:3px solid var(--brick);outline-offset:3px}

  .panel:focus{outline:none}
  .panel:focus-visible{outline:3px solid var(--brick);outline-offset:8px}
  .menu-columns{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    align-items:start;
    gap:0 clamp(42px,6vw,78px);
    max-width:100%;
    margin:0 auto;
  }
  .menu-column{min-width:0}
  .menu-column + .menu-column{position:relative}
  .menu-column + .menu-column::before{
    content:'';
    position:absolute;
    top:30px;
    bottom:12px;
    left:calc(clamp(42px,6vw,78px) / -2);
    width:1px;
    background:rgba(41,25,18,.24);
  }
  .cat-section{margin:0 0 clamp(24px,4vw,40px);padding:0;scroll-margin-top:120px}
  .cat-section h3{
    position:relative;
    display:block;
    margin:24px 0 6px;
    padding:0 0 13px;
    color:var(--denim);
    background:linear-gradient(to right,var(--denim) 0 calc(50% - 10px),transparent calc(50% - 10px) calc(50% + 10px),var(--denim) calc(50% + 10px) 100%) left bottom / 100% 1px no-repeat;
    font-family:var(--display);
    font-size:clamp(1.35rem,2.2vw,1.8rem);
    font-weight:400;
    line-height:1.08;
    letter-spacing:.01em;
    text-transform:uppercase;
  }
  .cat-section h3::before{
    content:'';
    position:absolute;
    left:50%;
    bottom:-3px;
    width:7px;
    height:7px;
    background:var(--brick);
    transform:translateX(-50%) rotate(45deg);
  }

  .menu-list{list-style:none;margin:0;padding:0}
  .item{
    display:flex;
    align-items:center;
    gap:14px;
    min-width:0;
    padding:13px 2px;
    border-bottom:1px solid rgba(41,25,18,.2);
    scroll-margin-top:84px;
  }
  .item:last-child{border-bottom:0}
  .item:target{outline:3px solid var(--gold);outline-offset:4px;background:rgba(178,138,79,.1)}
  .item-photo-trigger{flex:0 0 72px;width:72px;height:56px;padding:0;border:0;background:transparent;cursor:zoom-in}
  .item-photo-trigger:focus-visible{outline:3px solid var(--brick);outline-offset:3px}
  .item-photo{display:block;width:72px;height:56px;object-fit:cover;border:3px solid #f8ecd3;background:rgba(41,25,18,.08);box-shadow:0 0 0 1px rgba(41,25,18,.38),2px 2px 0 rgba(41,25,18,.17)}
  .item-copy{min-width:0;overflow-wrap:anywhere}
  .item-copy strong{display:block;color:#291912;font-family:var(--label);font-size:1.12rem;font-weight:700;line-height:1.2}
  .item-copy span{display:block;margin-top:3px;color:#583e30;font-size:.94rem;line-height:1.43}

  .late-note{max-width:720px;margin:0 auto 12px;padding:0 10px 14px;border-bottom:1px solid rgba(41,25,18,.28);color:#583e30;text-align:center;font-family:var(--label);font-size:.95rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase}
  .empty{max-width:720px;margin:26px auto;text-align:center;color:#583e30}

  @media (max-width:760px){
    .menu-top{--footer-blend-height:clamp(32px,10vw,44px);padding:18px 10px calc(var(--footer-blend-height) + 14px)}
    .menu-sheet{padding:28px 16px 44px;border-width:5px;box-shadow:0 8px 20px rgba(53,29,14,.2)}
    .corner-flourish{width:40px;stroke-width:2.4;opacity:.58}
    .corner-flourish--top-left{top:8px;left:8px}
    .corner-flourish--top-right{top:8px;right:8px}
    .corner-flourish--bottom-left{bottom:8px;left:8px}
    .corner-flourish--bottom-right{right:8px;bottom:8px}
    .interior-heading h1{font-size:clamp(2.75rem,17vw,4.8rem)}
    .tabs::before,.tabs::after{padding-inline:7px;font-size:.82rem}
    .tabs .tab{padding-inline:15px;font-size:.88rem}
    .chips{padding:8px 0}
    .chip-links{display:none}
    .chip-select{display:block}
    .menu-columns{grid-template-columns:1fr}
    .menu-column + .menu-column::before{content:none}
    .cat-section{margin-bottom:24px}
    .cat-section h3{font-size:clamp(1.35rem,6vw,1.8rem)}
    .item-photo-trigger{flex-basis:60px;width:60px;height:48px}
    .item-photo{width:60px;height:48px}
  }

  @media (max-width:390px){
    .menu-sheet{padding-inline:12px}
    .tabs{display:grid;grid-template-columns:1fr 1fr;width:100%}
    .tabs::before,.tabs::after{content:none}
    .tabs .tab{width:100%;padding-inline:8px}
  }
</style>
 
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs .tab'));

  const panels: Record<string, HTMLElement | null> = {
    daily: document.getElementById('panel-daily'),
    'late-night': document.getElementById('panel-late-night'),
  };

  function show(name: string) {
    tabs.forEach((t) => {
      const active = t.dataset.panel === name;
      t.setAttribute('aria-selected', active ? 'true' : 'false');
      t.setAttribute('tabindex', active ? '0' : '-1');
    });

    Object.entries(panels).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
  }

  tabs.forEach((t, index) => {
    t.addEventListener('click', () => show(t.dataset.panel!));

    t.addEventListener('keydown', (e) => {
      let next = index;

      if (e.key === 'ArrowRight') {
        next = (index + 1) % tabs.length;
      }

      if (e.key === 'ArrowLeft') {
        next = (index - 1 + tabs.length) % tabs.length;
      }

      if (e.key === 'Home') {
        next = 0;
      }

      if (e.key === 'End') {
        next = tabs.length - 1;
      }

      if (next !== index) {
        e.preventDefault();
        tabs[next].focus();
        show(tabs[next].dataset.panel!);
      }
    });
  });

  const categoryJump = document.querySelector<HTMLSelectElement>('#category-jump');

  categoryJump?.addEventListener('change', () => {
    if (categoryJump.value) location.hash = categoryJump.value;
  });

  // Deep links: #late-night opens that tab; a #sec-* chip link stays on Daily.
  if (location.hash === '#late-night') {
    show('late-night');
  } else if (location.hash.startsWith('#sec-')) {
    show('daily');
  }
</script>
