---
import {splitMexicanItem,MEXICAN_ITEM_LIMIT} from '../lib/mexican-item.js';
interface Props { content: string; prefix: string; fieldId: string; priceFree?: boolean }
const {content, prefix, fieldId, priceFree=false} = Astro.props;
const {title, description} = splitMexicanItem(content);
---
<div class="mexican-item-fields" data-price-free={priceFree ? 'true' : undefined}>
  <label for={fieldId}>{priceFree ? 'Item name / sizes (no prices)' : 'Item / price'}<input id={fieldId} name={prefix+'title'} value={title} maxlength={MEXICAN_ITEM_LIMIT} data-mexican-title /></label>
  <label for={fieldId+'-description'}>Description (optional)<textarea id={fieldId+'-description'} name={prefix+'description'} rows="3" maxlength={MEXICAN_ITEM_LIMIT} data-mexican-description>{description}</textarea></label>
  <output data-mexican-count>{content.length} / {MEXICAN_ITEM_LIMIT} total</output>
</div>
<style>
  .mexican-item-fields{display:grid;gap:8px;min-width:0}
  label{display:grid;gap:4px;font-weight:600}
  input,textarea{box-sizing:border-box;width:100%;min-width:0;padding:10px;border:2px solid #b8aa98;border-radius:6px;background:var(--cream);font:inherit;font-size:16px}
  textarea{resize:vertical}output{justify-self:end;font-size:.8rem}
</style>
<script>
  import {composeMexicanItem,assertPriceFreeMexicanDefault,MEXICAN_ITEM_LIMIT} from '../lib/mexican-item.js';
  function updateMexicanCounts() {
    document.querySelectorAll<HTMLElement>('.mexican-item-fields').forEach(slot => {
      const title = slot.querySelector<HTMLInputElement>('[data-mexican-title]')!;
      const description = slot.querySelector<HTMLTextAreaElement>('[data-mexican-description]')!;
      const length = title.value.length + (description.value ? 1 + description.value.length : 0);
      slot.querySelector('output')!.textContent = `${length} / ${MEXICAN_ITEM_LIMIT} total`;
      try {
        const content=composeMexicanItem(title.value, description.value);
        if (slot.dataset.priceFree === 'true') assertPriceFreeMexicanDefault(content);
        title.setCustomValidity('');
      }
      catch (error) { title.setCustomValidity((error as Error).message); }
    });
  }
  document.addEventListener('input', updateMexicanCounts);
  updateMexicanCounts();
</script>
