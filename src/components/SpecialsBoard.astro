---
import { getSpecials } from '../lib/db';
const env = (Astro.locals as any).runtime?.env ?? {};
const specials = await getSpecials(env);
---
<div class="board reveal" aria-label="Daily specials" data-specials={JSON.stringify(specials)}>
  <div class="board-days" id="dayTabs" role="tablist" aria-label="Choose a day for specials"></div>
  <div class="board-body">
    <div class="board-day-label" id="boardDay"></div>
    <div class="board-services">
      <article class="service-card lunch-service">
        <p class="service-label">Lunch Special <span>11 AM–1:30 PM</span></p>
        <h3 class="board-special" id="lunchName"></h3>
        <p class="board-desc" id="lunchDesc"></p>
        <span class="tag" id="lunchTag" hidden></span>
      </article>
      <article class="service-card night-service">
        <p class="service-label">Nightly Special <span>5–10 PM</span></p>
        <h3 class="board-special" id="nightName"></h3>
        <p class="board-desc" id="nightDesc"></p>
        <span class="tag" id="nightTag" hidden></span>
      </article>
    </div>
  </div>
</div>

<style>
  .board{max-width:900px;margin:0 auto;background:var(--ink-2);border:3px solid var(--gold);border-radius:14px;overflow:hidden;box-shadow:0 16px 44px rgba(0,0,0,.45)}
  .board-days{display:flex;flex-wrap:wrap;border-bottom:3px solid var(--gold)}
  .board-days :global(button){flex:1 1 0;min-width:78px;padding:13px 6px;background:transparent;border:none;cursor:pointer;
    font-family:var(--label);font-weight:700;letter-spacing:.14em;font-size:.95rem;color:var(--cream-2);
    text-transform:uppercase;transition:background .2s,color .2s}
  .board-days :global(button:hover){background:rgba(255,210,63,.12);color:var(--gold)}
  .board-days :global(button[aria-selected="true"]){background:var(--btn-crimson);color:var(--cream)}
  .board-days :global(.today-dot){display:block;font-size:.62rem;letter-spacing:.2em;color:var(--gold)}
  .board-body{padding:clamp(24px,5vw,48px);text-align:center}
  .board-day-label{font-family:var(--label);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--amber);font-size:.9rem}
  .board-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:18px}
  .service-card{min-width:0;padding:18px;border:1px solid rgba(247,234,211,.18);border-radius:10px;background:rgba(0,0,0,.12)}
  .lunch-service{border-top:4px solid var(--amber)}
  .night-service{border-top:4px solid var(--crimson)}
  .service-label{font-family:var(--label);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-size:.8rem}
  .service-label span{display:block;margin-top:2px;font-size:.72rem;color:var(--cream-2);letter-spacing:.07em}
  .board-special{font-family:var(--display);font-weight:400;font-size:clamp(1.3rem,3vw,2rem);color:var(--cream);margin:10px 0 6px;line-height:1.15}
  .board-desc{color:var(--cream-2);max-width:520px;margin:0 auto;font-size:1.02rem}
  .tag{display:inline-block;margin-top:16px;font-family:var(--label);font-weight:700;font-size:.8rem;
    letter-spacing:.18em;text-transform:uppercase;color:var(--ink);background:var(--gold);padding:5px 14px;border-radius:999px}
  .tag[hidden]{display:none}
  @media (max-width:620px){.board-services{grid-template-columns:1fr}.service-card{text-align:left}}
</style>

<script>
  const board = document.querySelector('.board') as HTMLElement;
  const SPECIALS = JSON.parse(board.dataset.specials || '[]');
  const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const todayIdx = new Date().getDay();
  const tabs = document.getElementById('dayTabs')!;
  const elDay = document.getElementById('boardDay')!;
  const parts = {
    lunch: {
      name: document.getElementById('lunchName')!, desc: document.getElementById('lunchDesc')!, tag: document.getElementById('lunchTag')! as HTMLElement,
      fallbackName: 'Lunch special', fallbackDesc: 'Ask at the bar about today’s lunch special.',
    },
    night: {
      name: document.getElementById('nightName')!, desc: document.getElementById('nightDesc')!, tag: document.getElementById('nightTag')! as HTMLElement,
      fallbackName: 'Nightly special', fallbackDesc: 'Ask at the bar about tonight’s special.',
    },
  };

  function bydow(i:number){ return SPECIALS.find((s:any)=>s.day_of_week===i) || {}; }
  function showPart(key: 'lunch' | 'night', special: any) {
    const part = parts[key];
    const prefix = key === 'lunch' ? 'lunch' : 'night';
    part.name.textContent = special[`${prefix}_name`] || part.fallbackName;
    part.desc.textContent = special[`${prefix}_description`] || part.fallbackDesc;
    const tag = special[`${prefix}_tag`];
    part.tag.textContent = tag || '';
    part.tag.hidden = !tag;
  }
  function show(i:number){
    const s = bydow(i);
    elDay.textContent = (i === todayIdx ? 'Today · ' : '') + DAYS[i];
    showPart('lunch', s);
    showPart('night', s);
    [...tabs.children].forEach((b,bi)=>{
      const selected = bi === i;
      b.setAttribute('aria-selected', selected ? 'true' : 'false');
      b.setAttribute('tabindex', selected ? '0' : '-1');
    });
  }
  DAYS.forEach((d,i)=>{
    const b = document.createElement('button');
    b.setAttribute('role','tab');
    b.setAttribute('aria-controls', 'specialsPanel');
    b.innerHTML = d.slice(0,3) + (i===todayIdx ? '<span class="today-dot">today</span>' : '');
    b.addEventListener('click', ()=>show(i));
    tabs.appendChild(b);
  });
  const panel = document.querySelector('.board-body')!;
  panel.id = 'specialsPanel';
  panel.setAttribute('role', 'tabpanel');
  show(todayIdx);
</script>
