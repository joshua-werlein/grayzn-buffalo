---
import { getSpecials } from '../lib/db';
const env = (Astro.locals as any).runtime?.env ?? {};
const specials = await getSpecials(env);
---
<div class="board reveal" aria-label="Daily specials" data-specials={JSON.stringify(specials)}>
  <div class="board-days" id="dayTabs" role="tablist" aria-label="Choose a day for specials"></div>
  <div class="board-body">
    <div class="board-day-label" id="boardDay"></div>
    <div class="board-allday" id="alldayBlock" hidden>
      <p class="board-allday__label">All Day</p>
      <h3 class="board-allday__name" id="alldayName"></h3>
      <p class="board-allday__desc" id="alldayDesc"></p>
      <span class="tag" id="alldayTag" hidden></span>
    </div>
    <div class="board-services">
      <article class="service-card lunch-service">
        <p class="service-label">Lunch Special <span>11 AM–1:30 PM</span></p>
        <h3 class="board-special" id="lunchName"></h3>
        <p class="board-desc" id="lunchDesc"></p>
        <span class="tag" id="lunchTag" hidden></span>
      </article>
      <article class="service-card night-service">
        <p class="service-label">Nightly Special <span>5–10 PM</span></p>
        <h3 class="board-special" id="nightName"></h3>
        <p class="board-desc" id="nightDesc"></p>
        <span class="tag" id="nightTag" hidden></span>
      </article>
    </div>
  </div>
</div>

<style>
  .board{max-width:var(--content-standard);margin:0 auto;background-color:var(--denim);background-image:linear-gradient(110deg,rgba(255,255,255,.04),transparent 30%,rgba(0,0,0,.2)),repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 5px);border:2px solid var(--ochre);border-radius:0;overflow:hidden;box-shadow:0 4px 0 #120d0a,0 14px 28px rgba(0,0,0,.28)}
  .board-days{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--rule-light);background:rgba(13,26,34,.35)}
  .board-days :global(button){flex:1 1 0;min-width:78px;padding:13.5px 6px;background:transparent;border:0;border-right:1px solid var(--rule-light);cursor:pointer;
    font-family:var(--label);font-weight:700;letter-spacing:.12em;font-size:.88rem;color:var(--cream-2);
    text-transform:uppercase;transition:background .2s,color .2s}
  .board-days :global(button:hover){background:rgba(196,151,75,.18);color:var(--cream)}
  .board-days :global(button[aria-selected="true"]){background:var(--brick);color:var(--cream)}
  .board-days :global(button:focus-visible){outline:3px solid var(--ochre);outline-offset:-3px}
  .board-days :global(.today-dot){display:block;font-size:.58rem;letter-spacing:.16em;color:var(--ochre)}
  .board-body{padding:clamp(22px,4vw,38px);text-align:center;background:linear-gradient(90deg,transparent,rgba(255,248,222,.035),transparent)}
  .board-day-label{font-family:var(--label);font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--ochre);font-size:.82rem}
  .board-allday{margin-top:16px;padding:10px clamp(16px,3vw,24px);border:1px solid var(--ochre);border-left:4px solid var(--ochre);background:rgba(196,151,75,.1);display:flex;flex-wrap:wrap;align-items:baseline;justify-content:center;column-gap:14px;row-gap:2px;text-align:left}
  .board-allday[hidden]{display:none}
  .board-allday__label{margin:0;flex:0 0 auto;font-family:var(--label);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--brick);font-size:.76rem}
  .board-allday__name{margin:0;flex:0 0 auto;font-family:var(--display);font-weight:400;font-size:clamp(1.05rem,2vw,1.3rem);color:var(--cream)}
  .board-allday__desc{margin:0;flex:1 1 220px;color:var(--cream-2);font-size:.92rem}
  .board-allday .tag{margin-top:0;flex:0 0 auto}
  .board-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin-top:16px;border-top:1px solid var(--rule-light);border-bottom:1px solid var(--rule-light)}
  .service-card{min-width:0;padding:clamp(18px,3vw,26px);border:0;border-radius:0;background:rgba(4,20,30,.16)}
  .service-card + .service-card{border-left:1px solid var(--rule-light)}
  .lunch-service{border-top:4px solid var(--ochre)}
  .night-service{border-top:4px solid var(--brick)}
  .service-label{font-family:var(--label);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-size:.8rem}
  .service-label span{display:block;margin-top:2px;font-size:.72rem;color:var(--cream-2);letter-spacing:.07em}
  .board-special{font-family:var(--display);font-weight:400;font-size:clamp(1.3rem,3vw,2rem);color:var(--cream);margin:10px 0 6px;line-height:1.15}
  .board-desc{color:var(--cream-2);max-width:520px;margin:0 auto;font-size:1.02rem}
  .tag{display:inline-block;margin-top:16px;font-family:var(--label);font-weight:700;font-size:.76rem;
    letter-spacing:.15em;text-transform:uppercase;color:var(--ink);background:var(--ochre);padding:5px 10px;border-radius:2px}
  .tag[hidden]{display:none}
  @media (max-width:620px){.board-services{grid-template-columns:1fr}.service-card + .service-card{border-left:0;border-top:1px solid var(--rule-light)}.service-card{text-align:left}}
</style>

<script>
  const board = document.querySelector('.board') as HTMLElement;
  const SPECIALS = JSON.parse(board.dataset.specials || '[]');
  const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const todayIdx = new Date().getDay();
  const tabs = document.getElementById('dayTabs')!;
  const elDay = document.getElementById('boardDay')!;
  const PREFIX: Record<'lunch' | 'night' | 'allday', string> = { lunch: 'lunch', night: 'night', allday: 'allday' };
  const parts = {
    lunch: {
      name: document.getElementById('lunchName')!, desc: document.getElementById('lunchDesc')!, tag: document.getElementById('lunchTag')! as HTMLElement,
      fallbackName: 'Lunch special', fallbackDesc: 'Ask at the bar about today’s lunch special.',
    },
    night: {
      name: document.getElementById('nightName')!, desc: document.getElementById('nightDesc')!, tag: document.getElementById('nightTag')! as HTMLElement,
      fallbackName: 'Nightly special', fallbackDesc: 'Ask at the bar about tonight’s special.',
    },
  };
  const alldayBlock = document.getElementById('alldayBlock')! as HTMLElement;
  const alldayName = document.getElementById('alldayName')!;
  const alldayDesc = document.getElementById('alldayDesc')!;
  const alldayTag = document.getElementById('alldayTag')! as HTMLElement;

  function bydow(i:number){ return SPECIALS.find((s:any)=>s.day_of_week===i) || {}; }
  function showPart(key: 'lunch' | 'night', special: any) {
    const part = parts[key];
    const prefix = PREFIX[key];
    part.name.textContent = special[`${prefix}_name`] || part.fallbackName;
    part.desc.textContent = special[`${prefix}_description`] || part.fallbackDesc;
    const tag = special[`${prefix}_tag`];
    part.tag.textContent = tag || '';
    part.tag.hidden = !tag;
  }
  function showAllday(special: any) {
    const name = special[`${PREFIX.allday}_name`];
    alldayBlock.hidden = !name;
    if (!name) return;
    alldayName.textContent = name;
    alldayDesc.textContent = special[`${PREFIX.allday}_description`] || '';
    const tag = special[`${PREFIX.allday}_tag`];
    alldayTag.textContent = tag || '';
    alldayTag.hidden = !tag;
  }
  function show(i:number){
    const s = bydow(i);
    elDay.textContent = (i === todayIdx ? 'Today · ' : '') + DAYS[i];
    showPart('lunch', s);
    showPart('night', s);
    showAllday(s);
    [...tabs.children].forEach((b,bi)=>{
      const selected = bi === i;
      b.setAttribute('aria-selected', selected ? 'true' : 'false');
      b.setAttribute('tabindex', selected ? '0' : '-1');
    });
  }
  DAYS.forEach((d,i)=>{
    const b = document.createElement('button');
    b.setAttribute('role','tab');
    b.setAttribute('aria-controls', 'specialsPanel');
    b.innerHTML = d.slice(0,3) + (i===todayIdx ? '<span class="today-dot">today</span>' : '');
    b.addEventListener('click', ()=>show(i));
    tabs.appendChild(b);
  });
  const panel = document.querySelector('.board-body')!;
  panel.id = 'specialsPanel';
  panel.setAttribute('role', 'tabpanel');
  show(todayIdx);
</script>
