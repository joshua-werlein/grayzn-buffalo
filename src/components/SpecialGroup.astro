---
import { visibleSlots, type SpecialGroup } from '../lib/specials-store';
import {presentHomeSpecial,presentSpecial} from '../lib/section-links.js';
interface Props { group: SpecialGroup; showTime?: boolean; sections?: string[]; wing?: {lines: string[]; priced: boolean; source: string} | null; homeCard?: boolean }
const { group, showTime = true, sections = [], wing = null, homeCard = false } = Astro.props;
const present = homeCard ? presentHomeSpecial : presentSpecial;
// One link per promotion: a second special naming it reads normally.
const linked = new Set<string>();
const slots = (group.enabled ? visibleSlots(group) : []).map(slot => {
  const shown = present(group, slot, sections.filter(id => !linked.has(id)), wing);
  if (shown.link) linked.add(shown.link.id);
  return shown;
});
---
{slots.length > 0 && <section class="special-group">
  <p class="special-group__label">{group.label}{showTime && group.service_time && <span>{group.service_time}</span>}</p>
  <ul class="special-group__items">{slots.map(({link, text}) => <li>{link && <a class="special-group__section-link" href={link.href} data-section-link={link.id}>{link.label}</a>}{text && <span class:list={{'special-group__linked-text': link}}>{text}</span>}</li>)}</ul>
</section>}
<style>
.special-group{min-width:0;align-self:start}
.special-group__label{
  margin:0 0 10px;padding-bottom:6px;
  border-bottom:1px solid var(--sg-rule,rgba(41,25,18,.15));
  display:flex;align-items:baseline;flex-wrap:wrap;gap:0 8px;
  font:700 .88rem/1 var(--label);letter-spacing:.14em;text-transform:uppercase;
  color:var(--sg-label,var(--brick));
}
.special-group__label span{
  display:inline;font-size:.88em;font-weight:600;letter-spacing:.07em;
  color:var(--sg-time,var(--denim));opacity:1;
}
.special-group__items{display:grid;gap:10px;list-style:none;padding:0;margin:0}
.special-group__items li{
  margin:0;white-space:pre-line;overflow-wrap:anywhere;
  line-height:1.55;font-size:1.1rem;
  color:var(--sg-text,#291912);
}
.special-group__items li+li{border-top:1px dashed var(--sg-rule,rgba(41,25,18,.16));padding-top:10px}
.special-group__section-link{
  display:inline-block;max-width:100%;padding:4px 0;
  font:700 1.2rem/1.3 var(--label);letter-spacing:.04em;
  color:var(--sg-link,var(--brick));
  text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:3px;
}
.special-group__section-link:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.special-group__linked-text{display:block;margin-top:4px}
</style>
