---
interface Props { model: any }
const {model}=Astro.props;
const current=model.collection.groups.filter((g: any)=>g.enabled===1).flatMap((g: any)=>g.slots.filter((s: any)=>s.content).map((s: any)=>({label:g.label,position:s.position,content:[s.content,s.price].filter(Boolean).join(' ')})));
// Mexican Night is approved as one menu, so staff confirm a protected replacement once for the menu.
const menuNeedsConfirm=model.mexican && (model.menuProtected || model.entries.some((e: any)=>!e.done && e.protected));
---
<details class="approval-panel">
  <summary>Review &amp; approve {model.mexican?'the Mexican Night menu':'these specials'}</summary>
  <form data-approval-form data-import-id={model.source.id} data-revision={model.collection.revision} data-day={model.day} data-evidence-hash={model.evidenceHash} data-request-id={model.requestId}>
    <p>{model.mexican?'Fix any wording below, then approve the whole menu. Items on the website that aren’t in this post will stay.':'Tick each special you want to publish, fix its wording if needed, and choose where it goes. Specials you don’t tick are left alone.'}</p>
    {model.mexican && <details><summary>Mexican Night menu on the website now</summary><ul>{current.map((s: any)=><li><strong>{s.label} · {s.position}</strong><p class="menu-text">{s.content}</p></li>)}</ul></details>}
    {model.entries.map((entry: any,index: number)=>{
      const suggested=model.destinations.find((d: any)=>d.service===entry.suggestedService && d.position===entry.suggestedPosition);
      const field=`approval-${model.source.id}-${index}`;
      return <fieldset data-entry data-key={entry.key} data-protected={model.mexican && (entry.protected || model.menuProtected)?'yes':'no'} disabled={entry.done}>
        <legend>{model.mexican?entry.label:`Special ${index+1}`}{entry.done?' · Already approved':''}</legend>
        {!model.mexican && <label class="check"><input type="checkbox" data-selected/> Publish this special</label>}
        {model.mexican?<>
          <label for={`${field}-title`}>Item and prices<input id={`${field}-title`} data-title value={entry.title} maxlength="300" required/></label>
          <label for={`${field}-description`}>Description<textarea id={`${field}-description`} data-description rows="4" maxlength="300">{entry.description}</textarea></label>
          <input type="hidden" data-label value={entry.label}/>
          {entry.current && <p>On the website now{entry.protected && <span class="tag">Edited by staff</span>}: <span class="menu-text">{entry.current}</span></p>}
        </>:<>
          <label for={`${field}-content`}>Special and price<textarea id={`${field}-content`} data-content rows="3" maxlength="150">{entry.content}</textarea></label>
          <label for={`${field}-destination`}>Where it goes on the website<select id={`${field}-destination`} data-destination>
            <option value="" selected={!suggested}>Choose a spot</option>
            {model.destinations.map((d: any)=><option value={d.id} selected={d.id===suggested?.id} data-current={d.current} data-protected={d.protected?'yes':'no'}>{d.label}{d.protected?' · edited by staff':''}</option>)}
          </select></label>
          <p>Currently there: <span data-current-value class="menu-text">{suggested?.current||'(empty)'}</span></p>
          <div class="protected-confirm" data-protected-confirm hidden={!suggested?.protected}>
            <p><strong>This special was edited by staff. Replace it?</strong></p>
            <label class="check"><input type="checkbox" data-override/> Yes, replace the staff-edited special</label>
          </div>
        </>}
        {entry.uncertainties.length>0 && <div class="warning"><strong>Double-check against the Facebook post:</strong><ul>{entry.uncertainties.map((u: string)=><li>{u}</li>)}</ul></div>}
        <details><summary>Text read from the Facebook post</summary><p class="menu-text">{entry.evidence||'No text was saved. Check the Facebook post image.'}</p></details>
      </fieldset>;
    })}
    {menuNeedsConfirm && <div class="protected-confirm">
      <p><strong>This menu was edited by staff. Replace it?</strong></p>
      <p>The next step shows each current item next to its new version.</p>
      <label class="check"><input type="checkbox" data-menu-override/> Yes, replace the staff-edited menu items</label>
    </div>}
    <label class="check"><input type="checkbox" data-verified required/> I checked the descriptions, prices, sizes and placement against the Facebook post.</label>
    <p class="approval-status" data-approval-status role="status" aria-live="polite"></p>
    <button type="submit" class="btn btn-primary">Review changes</button>
    <noscript>JavaScript is required to review changes here. You can also use the Specials editor.</noscript>
    <dialog aria-label="Confirm changes before publishing">
      <h3 tabindex="-1" data-dialog-heading>Confirm changes</h3>
      <p>Check each change below. After you publish, these specials are marked Staff Approved and automation won’t change them.</p>
      <div data-confirmation-rows></div>
      <div class="confirmation-actions"><button type="button" class="btn btn-ghost" data-cancel>Keep editing</button><button type="button" class="btn btn-primary" data-publish>Approve &amp; Publish</button></div>
      <p data-dialog-status role="alert"></p>
    </dialog>
  </form>
</details>
<script>
  import {confirmationRows} from '../lib/approval-confirmation';
  document.querySelectorAll<HTMLFormElement>('[data-approval-form]').forEach(form=>{
    const status=form.querySelector<HTMLElement>('[data-approval-status]')!;
    const dialog=form.querySelector<HTMLDialogElement>('dialog')!;
    const previewButton=form.querySelector<HTMLButtonElement>('[type=submit]')!;
    const publish=form.querySelector<HTMLButtonElement>('[data-publish]')!;
    const cancel=form.querySelector<HTMLButtonElement>('[data-cancel]')!;
    let pending: any=null,busy=false;
    const field=(entry: Element,name: string)=>(entry.querySelector(`[data-${name}]`) as HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement|null)?.value??'';
    const checked=(entry: Element,name: string)=>(entry.querySelector(`[data-${name}]`) as HTMLInputElement|null)?.checked===true;
    // A replacement confirmation is only asked for (and sent) when the target is staff-protected.
    const needsConfirm=(e: HTMLElement)=>e.querySelector('[data-title]')?e.dataset.protected==='yes':e.querySelector<HTMLElement>('[data-protected-confirm]')?.hidden===false;
    const confirmedReplace=(e: HTMLElement)=>e.querySelector('[data-title]')?checked(form,'menu-override'):checked(e,'override');
    const send=async(mode: string,input: any)=>{
      const response=await fetch('/admin/automation/approve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode,input})});
      const result=await response.json();if(!response.ok||!result.ok)throw Error(result.error??'Could not save. Your draft is preserved.');return result;
    };
    const text=(tag: string,value: string,className='')=>{const node=document.createElement(tag);node.textContent=value;if(className)node.className=className;return node;};
    form.querySelectorAll<HTMLSelectElement>('[data-destination]').forEach(select=>select.addEventListener('change',()=>{
      const entry=select.closest<HTMLElement>('[data-entry]')!,option=select.selectedOptions[0];
      entry.querySelector('[data-current-value]')!.textContent=option?.dataset.current||'(empty)';
      const confirm=entry.querySelector<HTMLElement>('[data-protected-confirm]')!;
      confirm.hidden=option?.dataset.protected!=='yes';
      confirm.querySelector<HTMLInputElement>('[data-override]')!.checked=false;
    }));
    form.addEventListener('submit',async event=>{
      event.preventDefault();if(busy)return;
      const entries=Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-entry]')).filter(e=>!e.disabled && (e.querySelector('[data-title]')||checked(e,'selected')));
      const unconfirmed=entries.find(e=>needsConfirm(e) && !confirmedReplace(e));
      if(unconfirmed){
        status.textContent=unconfirmed.querySelector('[data-title]')?'This menu was edited by staff. Tick “Yes, replace” to continue.':'A spot you chose was edited by staff. Tick “Yes, replace” or choose a different spot.';
        (unconfirmed.querySelector<HTMLInputElement>('[data-override]')??form.querySelector<HTMLInputElement>('[data-menu-override]'))?.focus();return;
      }
      status.textContent='Checking the latest saved values…';busy=true;previewButton.disabled=true;
      const rows=entries.map(e=>({key:e.dataset.key,
        ...(e.querySelector('[data-title]')?{title:field(e,'title'),description:field(e,'description'),label:field(e,'label')}:{content:field(e,'content'),destination:field(e,'destination')}),override:needsConfirm(e) && confirmedReplace(e)}));
      pending={importId:form.dataset.importId,revision:Number(form.dataset.revision),day:form.dataset.day,evidenceHash:form.dataset.evidenceHash,requestId:form.dataset.requestId,rows,confirmed:checked(form,'verified')};
      try {
        const result=await send('preview',pending);
        if(result.duplicate){status.textContent='This was already approved. Reload to see the saved values.';return;}
        const list=form.querySelector('[data-confirmation-rows]')!;list.replaceChildren();
        for(const row of confirmationRows(result.audit.rows)){
          const section=document.createElement('div');section.className='confirmation-row';
          section.append(text('p',row.place,'place'));
          if(row.staffEdited) section.append(text('p','Edited by staff — this replaces their version.','flag'));
          if(row.changed) {
            const change=document.createElement('div');change.className='change';
            for(const [label,value] of [['Current',row.current],['→ New',row.next]]) {const p=text('p','','menu-text');p.append(text('span',label,'change-label'),text('span',value));change.append(p);}
            section.append(change);
          } else section.append(text('p',`No change: ${row.next}. It will be marked Staff Approved.`,'menu-text'));
          list.append(section);
        }
        form.querySelector('[data-dialog-status]')!.textContent='';status.textContent='Check the changes, then choose Approve & Publish.';dialog.showModal();
        dialog.querySelector<HTMLElement>('[data-dialog-heading]')!.focus({preventScroll:true});dialog.scrollTop=0;
      }catch(error){status.textContent=(error as Error).message;pending=null;}
      finally{busy=false;previewButton.disabled=false;}
    });
    cancel.addEventListener('click',()=>{if(!busy){dialog.close();pending=null;}});
    dialog.addEventListener('cancel',event=>{if(busy)event.preventDefault();else pending=null;});
    publish.addEventListener('click',async()=>{
      if(busy||!pending)return;busy=true;publish.disabled=true;cancel.disabled=true;form.setAttribute('aria-busy','true');
      const message=form.querySelector('[data-dialog-status]')!;message.textContent='Publishing…';
      try {await send('publish',pending);window.location.assign(`/admin/automation?date=${encodeURIComponent(form.dataset.day!)}&approved=1#import-${encodeURIComponent(form.dataset.importId!)}`);}
      catch(error){message.textContent=(error as Error).message;}
      finally{busy=false;publish.disabled=false;cancel.disabled=false;form.removeAttribute('aria-busy');}
    });
  });
</script>
<style>
  .approval-panel{margin-top:1rem;border-top:1px solid #847252;padding-top:.5rem;min-width:0}
  summary{cursor:pointer;min-height:44px;padding:.5rem 0;font-weight:700}
  form,fieldset,label{display:grid;gap:.6rem;min-width:0}form{gap:1rem}fieldset{border:1px solid #847252;border-radius:6px;padding:.75rem;margin:0}legend{padding:0 .3rem;font-weight:700}
  input:not([type=checkbox]),select,textarea{box-sizing:border-box;width:100%;min-width:0;max-width:100%;min-height:44px;padding:.65rem;font:inherit;font-size:16px;background:var(--cream);color:var(--ink);border:1px solid #847252;border-radius:5px}
  textarea{resize:vertical}.check{display:flex;gap:.6rem;align-items:flex-start;font-size:.95rem;line-height:1.5;min-height:44px}.check input{flex:0 0 22px;width:22px;height:22px;margin-top:.2rem}
  .menu-text{white-space:pre-wrap;overflow-wrap:anywhere}.warning{border-left:4px solid #a05c18;padding:.65rem;background:#fff3d6;color:#412b13}.warning ul{padding-left:1.1rem}
  .protected-confirm{border-left:4px solid #7a1f1a;padding:.65rem;background:#f7dcd8;color:#3d1210}.protected-confirm p{margin:0 0 .4rem}.protected-confirm[hidden]{display:none}
  .tag{display:inline-block;margin-left:.4rem;padding:0 .45rem;border-radius:999px;border:1px solid currentColor;background:#f7dcd8;color:#7a1f1a;font-size:.8rem;font-weight:700}
  dialog{position:fixed;inset:0;margin:auto;box-sizing:border-box;width:calc(100% - 1rem);max-width:650px;max-height:85dvh;overflow:auto;border:2px solid #847252;border-radius:8px;background:var(--cream);color:var(--ink);padding:1rem}dialog::backdrop{background:rgba(0,0,0,.65)}
  [data-confirmation-rows] :global(.confirmation-row){border-top:1px solid #847252;padding:.5rem 0}
  [data-confirmation-rows] :global(p){white-space:pre-wrap;overflow-wrap:anywhere;margin:.4rem 0}
  [data-confirmation-rows] :global(.place){font-weight:700}
  [data-confirmation-rows] :global(.flag){display:inline-block;padding:.15rem .5rem;border-radius:4px;background:#f7dcd8;color:#7a1f1a;font-weight:700}
  [data-confirmation-rows] :global(.change){display:grid;gap:.25rem}
  [data-confirmation-rows] :global(.change-label){display:inline-block;min-width:4.5rem;font-weight:700;margin-right:.4rem}
  .confirmation-actions{display:flex;flex-wrap:wrap;gap:.75rem}.confirmation-actions button{flex:1;min-height:48px;margin:0;white-space:normal}.approval-status{margin:0;font-weight:600}
</style>
