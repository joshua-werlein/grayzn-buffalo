---
import { PIZZA_SCOPE } from '../lib/pizza-options.js';
const { options } = Astro.props;
---
<aside class="pizza-options" aria-label="Pizza choices">
  <p class="pizza-scope">{PIZZA_SCOPE}</p>
  <dl>
    {options.sizes.length > 0 && <div><dt>Sizes</dt><dd>{options.sizes.join(' · ')}</dd></div>}
    {options.crusts.length > 0 && <div><dt>Crusts</dt><dd>{options.crusts.join(' · ')}</dd></div>}
    {options.toppings.length > 0 && <div><dt>Additional toppings</dt><dd><ul>{options.toppings.map(topping => <li>{topping}</li>)}</ul></dd></div>}
  </dl>
</aside>
<style>
  .pizza-options{margin:14px 0 10px;padding:14px;border:1px solid #80634f;background:rgba(255,255,255,.3);color:#583e30;overflow-wrap:anywhere}
  dl{margin:0;display:grid;gap:12px}
  dt{font:700 1rem var(--label);color:#291912}
  dd{margin:3px 0 0;line-height:1.5}
  ul{list-style:none;display:flex;gap:6px 16px;flex-wrap:wrap;margin:0;padding:0}
  .pizza-scope{margin:0 0 12px;font-size:.88rem;line-height:1.5}
</style>
