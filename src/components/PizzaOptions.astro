---
import OptionsPanel from './OptionsPanel.astro';
import { PIZZA_SCOPE } from '../lib/pizza-options.js';
const { options } = Astro.props;
---
<OptionsPanel class="pizza-options" label="Pizza choices">
  <p class="options-note">{PIZZA_SCOPE}</p>
  <dl>
    {options.sizes.length > 0 && <div><dt>Sizes</dt><dd>{options.sizes.join(' · ')}</dd></div>}
    {options.crusts.length > 0 && <div><dt>Crusts</dt><dd>{options.crusts.join(' · ')}</dd></div>}
    {options.toppings.length > 0 && <div><dt>Additional toppings</dt><dd><ul class="options-list">{options.toppings.map(topping => <li>{topping}</li>)}</ul></dd></div>}
  </dl>
</OptionsPanel>
