<div class="image-lightbox" data-image-lightbox hidden>
  <div class="image-lightbox__backdrop" data-lightbox-close></div>
  <section class="image-lightbox__dialog" role="dialog" aria-modal="true" aria-labelledby="image-lightbox-title" tabindex="-1">
    <h2 id="image-lightbox-title" class="sr-only" data-lightbox-title>Image preview</h2>
    <button class="image-lightbox__close" type="button" data-lightbox-close aria-label="Close image preview">&times;</button>
    <img class="image-lightbox__image" data-lightbox-image alt="" />
    <p class="image-lightbox__caption" data-lightbox-caption hidden></p>
    <p class="image-lightbox__text" data-lightbox-text hidden></p>
    <a class="image-lightbox__action btn btn-primary" data-lightbox-action hidden></a>
  </section>
</div>

<script>
  function initImageLightbox() {
    const lightbox = document.querySelector<HTMLElement>('[data-image-lightbox]');
    if (!lightbox) return;

    const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const closeButton = lightbox.querySelector<HTMLButtonElement>('.image-lightbox__close');
    const title = lightbox.querySelector<HTMLElement>('[data-lightbox-title]');
    const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
    const text = lightbox.querySelector<HTMLElement>('[data-lightbox-text]');
    const action = lightbox.querySelector<HTMLAnchorElement>('[data-lightbox-action]');
    if (!image || !closeButton || !title || !caption || !text || !action) return;
    let trigger: HTMLElement | null = null;
    let closeTimer: number | undefined;

    const focusable = () => Array.from(lightbox.querySelectorAll<HTMLElement>(
      'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )).filter((element) => !element.hasAttribute('hidden'));

    const close = () => {
      if (lightbox.hidden) return;
      const closingTrigger = trigger;
      lightbox.classList.remove('is-open');
      lightbox.classList.remove('has-caption');
      lightbox.classList.remove('is-facebook-image');
      lightbox.classList.remove('is-facebook-caption');
      lightbox.classList.remove('is-facebook-text');
      document.body.classList.remove('lightbox-open');
      document.dispatchEvent(new CustomEvent('image-lightbox:close', { detail: { trigger: closingTrigger } }));
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        lightbox.hidden = true;
        image.removeAttribute('src');
        image.hidden = false;
        caption.textContent = '';
        caption.hidden = true;
        text.textContent = '';
        text.hidden = true;
        title.textContent = 'Image preview';
        closeButton.setAttribute('aria-label', 'Close image preview');
        action.removeAttribute('href');
        action.hidden = true;
      }, 180);
      trigger?.focus();
    };

    const open = (nextTrigger: HTMLElement) => {
      const src = nextTrigger.dataset.lightboxSrc;
      const textContent = nextTrigger.dataset.lightboxText;
      const isTextMode = nextTrigger.dataset.lightboxLayout === 'facebook-text' && Boolean(textContent);
      const isFacebookImage = nextTrigger.dataset.lightboxLayout === 'facebook-image' || nextTrigger.dataset.lightboxLayout === 'facebook-caption';
      if (!src && !isTextMode) return;
      window.clearTimeout(closeTimer);
      trigger = nextTrigger;
      image.hidden = isTextMode;
      if (src) {
        image.src = src;
        image.alt = nextTrigger.dataset.lightboxAlt ?? '';
      } else {
        image.removeAttribute('src');
        image.alt = '';
      }
      const captionText = nextTrigger.dataset.lightboxCaption;
      caption.textContent = captionText ?? '';
      caption.hidden = !captionText || isTextMode;
      text.textContent = isTextMode ? textContent ?? '' : '';
      text.hidden = !isTextMode;
      title.textContent = isTextMode ? 'Facebook post' : 'Image preview';
      closeButton.setAttribute('aria-label', isTextMode ? 'Close Facebook post' : 'Close image preview');
      lightbox.classList.toggle('has-caption', Boolean(captionText));
      lightbox.classList.toggle('is-facebook-image', isFacebookImage && !isTextMode);
      lightbox.classList.toggle('is-facebook-caption', nextTrigger.dataset.lightboxLayout === 'facebook-caption' && Boolean(captionText));
      lightbox.classList.toggle('is-facebook-text', isTextMode);
      const actionUrl = nextTrigger.dataset.lightboxActionUrl;
      if (actionUrl) {
        action.href = actionUrl;
        action.textContent = nextTrigger.dataset.lightboxActionLabel ?? 'View details';
        action.setAttribute('aria-label', action.textContent);
        if (nextTrigger.dataset.lightboxActionNewTab === 'true') {
          action.target = '_blank';
          action.rel = 'noopener';
        } else {
          action.removeAttribute('target');
          action.removeAttribute('rel');
        }
        action.hidden = false;
      } else {
        action.removeAttribute('href');
        action.hidden = true;
      }
      lightbox.hidden = false;
      document.body.classList.add('lightbox-open');
      document.dispatchEvent(new CustomEvent('image-lightbox:open', { detail: { trigger: nextTrigger } }));
      requestAnimationFrame(() => lightbox.classList.add('is-open'));
      closeButton.focus();
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const opener = target.closest<HTMLElement>('[data-lightbox-src], [data-lightbox-text]');
      if (opener) {
        event.preventDefault();
        open(opener);
        return;
      }
      if (target.closest('[data-lightbox-close]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== 'Tab') return;

      const controls = focusable();
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }

  try {
    initImageLightbox();
  } catch (error) {
    console.error('Image lightbox disabled after an initialization error.', error);
  }
</script>

<style>
  .image-lightbox{--lightbox-gutter:clamp(18px,4vw,56px);position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:var(--lightbox-gutter);overflow-y:auto;overscroll-behavior:contain;opacity:0;pointer-events:none;transition:opacity .18s ease}
  .image-lightbox[hidden]{display:none}
  .image-lightbox.is-open{opacity:1;pointer-events:auto}
  .image-lightbox__backdrop{position:absolute;inset:0;background:rgba(20,12,8,.82)}
  .image-lightbox__dialog{position:relative;display:grid;place-items:center;max-width:min(1100px,100%);max-height:100%;min-height:0;margin:auto;transform:scale(.97);transition:transform .18s ease}
  .image-lightbox.is-open .image-lightbox__dialog{transform:scale(1)}
  .image-lightbox__image{display:block;max-width:100%;max-height:calc(100vh - (var(--lightbox-gutter) * 2) - 80px);width:auto;height:auto;border-radius:10px;box-shadow:0 18px 56px rgba(0,0,0,.5);background:var(--ink)}
  .image-lightbox.has-caption .image-lightbox__image{max-height:calc(100vh - (var(--lightbox-gutter) * 2) - 180px)}
  .image-lightbox__close{position:absolute;top:10px;right:10px;z-index:1;width:44px;height:44px;border:2px solid var(--cream);border-radius:50%;background:var(--ink);color:var(--cream);font:400 2rem/1 var(--body);cursor:pointer;box-shadow:0 3px 14px rgba(0,0,0,.4)}
  .image-lightbox__close:hover{background:var(--btn-crimson)}
  .image-lightbox__close:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  .image-lightbox__caption{width:min(100%,760px);margin:14px auto 0;padding:10px 14px;border:1px solid rgba(238,224,196,.36);background:rgba(38,23,17,.88);color:var(--cream);font:400 clamp(.9rem,1.4vw,1rem)/1.45 var(--body);text-align:left;white-space:pre-line}
  .image-lightbox__caption[hidden]{display:none}
  .image-lightbox__text[hidden]{display:none}
  .image-lightbox__action{margin-top:14px;text-align:center}
  .image-lightbox__action[hidden]{display:none}
  /* Facebook images with copy use the dialog height as a shared budget, not a fixed caption deduction. */
  .image-lightbox:is(.is-facebook-image,.is-facebook-text){--facebook-surface:linear-gradient(rgba(247,234,211,.9),rgba(229,203,158,.92)),url('/images/facebook/facebook-caption-1.webp') center / cover}
  .image-lightbox.is-facebook-image{overflow:hidden}
  .image-lightbox.is-facebook-image:not(.is-facebook-caption) .image-lightbox__dialog{display:grid;grid-template-rows:minmax(0,1fr) auto;width:min(1100px,100%);height:min(780px,calc(100dvh - (var(--lightbox-gutter) * 2)));max-height:calc(100dvh - (var(--lightbox-gutter) * 2));padding:clamp(22px,3vw,34px);box-sizing:border-box;border:1px solid rgba(83,51,26,.5);border-radius:14px;background:var(--facebook-surface);box-shadow:0 22px 70px rgba(0,0,0,.56)}
  .image-lightbox.is-facebook-image:not(.is-facebook-caption) .image-lightbox__image{max-width:100%;max-height:100%;object-fit:contain}
  .image-lightbox.is-facebook-image:not(.is-facebook-caption) .image-lightbox__action{margin:14px 0 0}
  .image-lightbox.is-facebook-caption{overflow:hidden}
  .image-lightbox.is-facebook-caption .image-lightbox__dialog{display:grid;grid-template-columns:minmax(0,62fr) minmax(260px,38fr);grid-template-rows:minmax(0,1fr) auto;column-gap:clamp(20px,3vw,42px);width:min(1320px,100%);height:min(780px,calc(100dvh - (var(--lightbox-gutter) * 2)));max-height:calc(100dvh - (var(--lightbox-gutter) * 2));padding:clamp(22px,2.5vw,34px);box-sizing:border-box;border:1px solid rgba(83,51,26,.5);border-radius:14px;background:var(--facebook-surface);box-shadow:0 22px 70px rgba(0,0,0,.56)}
  .image-lightbox.is-facebook-caption .image-lightbox__image{grid-column:1;grid-row:1 / span 2;align-self:center;justify-self:center;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
  .image-lightbox.is-facebook-caption .image-lightbox__caption{grid-column:2;grid-row:1;align-self:stretch;width:auto;min-height:0;max-height:100%;margin:0;padding:clamp(52px,5vw,60px) clamp(14px,1.8vw,20px) clamp(14px,1.8vw,20px);overflow:auto;border-color:rgba(83,51,26,.36);background:rgba(247,234,211,.7);color:var(--ink);font-size:clamp(.94rem,1.15vw,1.05rem);line-height:1.55;scrollbar-color:var(--gold) rgba(83,51,26,.16)}
  .image-lightbox.is-facebook-caption .image-lightbox__action{grid-column:2;grid-row:2;justify-self:start;margin:14px 0 0}
  .image-lightbox.is-facebook-caption .image-lightbox__close{top:12px;right:12px}
  .image-lightbox.is-facebook-text{overflow:hidden}
  .image-lightbox.is-facebook-text .image-lightbox__dialog{display:grid;grid-template-rows:minmax(0,1fr) auto;width:min(720px,100%);height:min(780px,calc(100dvh - (var(--lightbox-gutter) * 2)));max-height:calc(100dvh - (var(--lightbox-gutter) * 2));padding:clamp(38px,4.5vw,48px) clamp(22px,4vw,46px) clamp(22px,4vw,32px);box-sizing:border-box;border:1px solid rgba(83,51,26,.5);border-radius:14px;background:var(--facebook-surface);box-shadow:0 22px 70px rgba(0,0,0,.56)}
  .image-lightbox.is-facebook-text .image-lightbox__text{align-self:start;justify-self:center;width:min(100%,34rem);max-height:100%;min-height:0;margin:0;overflow:auto;color:var(--ink);font:400 clamp(1rem,1.6vw,1.12rem)/1.6 var(--body);text-align:center;white-space:pre-wrap;scrollbar-color:var(--gold) rgba(83,51,26,.16)}
  .image-lightbox.is-facebook-text .image-lightbox__action{justify-self:center;margin:14px 0 0}
  .image-lightbox.is-facebook-text .image-lightbox__close{top:12px;right:12px}
  :global(body.lightbox-open){overflow:hidden}
  @supports (height:100dvh){.image-lightbox__image{max-height:calc(100dvh - (var(--lightbox-gutter) * 2) - 80px)}.image-lightbox.has-caption .image-lightbox__image{max-height:calc(100dvh - (var(--lightbox-gutter) * 2) - 180px)}}
  @media (max-width:800px){.image-lightbox.is-facebook-caption .image-lightbox__dialog{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;row-gap:12px;width:min(680px,100%);height:calc(100dvh - (var(--lightbox-gutter) * 2));padding:clamp(16px,4vw,24px)}.image-lightbox.is-facebook-caption .image-lightbox__image{grid-column:1;grid-row:1;max-height:min(34dvh,290px)}.image-lightbox.is-facebook-caption .image-lightbox__caption{grid-column:1;grid-row:2;max-height:none;padding:12px 14px;font-size:clamp(.9rem,3.8vw,1rem);line-height:1.48}.image-lightbox.is-facebook-caption .image-lightbox__action{grid-column:1;grid-row:3;justify-self:center;margin:0}.image-lightbox.is-facebook-caption .image-lightbox__close{top:8px;right:8px}.image-lightbox.is-facebook-text .image-lightbox__dialog{height:calc(100dvh - (var(--lightbox-gutter) * 2));padding:clamp(40px,9vw,48px) clamp(18px,6vw,26px) clamp(18px,5vw,24px)}.image-lightbox.is-facebook-text .image-lightbox__text{font-size:clamp(.98rem,4vw,1.06rem);line-height:1.55}.image-lightbox.is-facebook-text .image-lightbox__close{top:8px;right:8px}}
  @media (prefers-reduced-motion:reduce){.image-lightbox,.image-lightbox__dialog{transition:none}}
</style>
