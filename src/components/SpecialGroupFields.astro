---
import { displayedSpecial, specialInputCount, type SpecialGroup } from '../lib/specials-store';
import MexicanItemFields from './MexicanItemFields.astro';
interface Props { group: SpecialGroup; index: number; defaults?: boolean; formPrefix: string }
const { group, index, defaults = false, formPrefix } = Astro.props;
const p = `g${index}_`;
const capacity = specialInputCount(group);
const section = group.day_of_week === -1;
---
<fieldset class="group-fields" data-group-index={index} data-group-day={group.day_of_week} data-service={group.service} hidden={capacity === 0}>
  <legend>{group.label || 'New group'}{!section && group.service_time && <span> · {group.service_time}</span>}</legend>
  <input type="hidden" name={p+'id'} value={group.id}/><input type="hidden" name={p+'day'} value={group.day_of_week}/><input type="hidden" name={p+'service'} value={group.service}/>
  {section ? <>
    <label>Group label<input name={p+'label'} value={group.label} maxlength="80" /></label>
    <label>Service time <span>(optional)</span><input name={p+'time'} value={group.service_time} maxlength="80" /></label>
    <label class="check"><input type="checkbox" name={p+'enabled'} checked={group.enabled === 1}/> Show this group when it has specials</label>
  </> : <>
    <input type="hidden" name={p+'label'} value={group.label}/><input type="hidden" name={p+'time'} value={group.service_time}/>
    {group.enabled === 1 && <input type="hidden" name={p+'enabled'} value="on"/>}
  </>}
  {group.slots.map(slot => slot.position <= capacity ? <div class="slot-fields">
    {formPrefix==='mexican' ? <MexicanItemFields content={displayedSpecial(slot)} prefix={p+slot.position+'_'} fieldId={`${formPrefix}-${index}-${slot.position}`}/> : <>
    <label for={`${formPrefix}-${index}-${slot.position}`}>{capacity === 1 ? 'Special' : `${slot.position === 1 ? 'First' : slot.position === 2 ? 'Second' : slot.position === 3 ? 'Third' : 'Fourth'} special`} <span>(optional)</span></label>
    <textarea id={`${formPrefix}-${index}-${slot.position}`} name={p+slot.position+'_content'} rows="2" maxlength="150" data-content>{displayedSpecial(slot)}</textarea>
    <output class="count" data-count>0 / 150</output>
    </>}
  </div> : <>
    {/* Retain existing extra content without exposing extra editing slots. */}
    <input type="hidden" name={p+slot.position+'_content'} value={displayedSpecial(slot)}/>
  </>)}
  {group.slots.map(slot => <input type="hidden" name={p+slot.position+'_link'} value={slot.section_link}/>)}
</fieldset>
<style>
  .group-fields{min-width:0;display:grid;gap:10px;padding:12px;border:1px solid #c8bba6;border-radius:8px;background:white;margin:0}.group-fields[hidden]{display:none}.group-fields legend{font-weight:700;padding:0 5px}.group-fields legend span{font-size:.8em;font-weight:400}.group-fields label{display:grid;gap:4px;font-weight:600}.group-fields label span{font-weight:400;font-size:.85em}.group-fields input:not([type=checkbox]),.group-fields textarea{box-sizing:border-box;width:100%;min-width:0;max-width:100%;padding:10px;border:2px solid #b8aa98;border-radius:6px;background:var(--cream);font:inherit;font-size:16px}.group-fields textarea{resize:vertical}.group-fields .check{display:flex;gap:8px;align-items:center;font-size:.88rem}.check input{width:20px;height:20px;flex-shrink:0}.slot-fields{display:grid;gap:6px}.count{justify-self:end;font-size:.8rem}
</style>
