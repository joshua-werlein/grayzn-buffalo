---
import {isSoupGroup} from '../lib/daily-soup.js';
import type {SpecialGroup} from '../lib/specials-store';
interface Props { groups: SpecialGroup[] }
const soup=Astro.props.groups.find(group=>isSoupGroup(group) && group.enabled===1);
const value=soup?.slots.find(slot=>slot.position===1)?.content?.trim();
---
{value && <p class="daily-soup"><strong>Soup:</strong>{' '}{value}</p>}
<style>
  .daily-soup{grid-column:1 / -1;margin:0;min-width:0;text-align:center;overflow-wrap:anywhere;font-size:.95rem;line-height:1.4;color:inherit}
</style>
