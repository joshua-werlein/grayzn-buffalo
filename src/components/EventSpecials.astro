---
// Special events above the ordinary specials on the homepage and /specials.
// One antique-gold card style for every event type; no animation. Events are
// never part of a day's specials card, so "Today" appears only on an active event:
// before its start time a timed event is "Later Today", and before its date "Upcoming".
// The state badge sits on the card's top border, like the daily specials' TODAY tag.
import { eventAvailability, eventState, formatEventDate, splitTrailingPrice, type SpecialEvent } from '../lib/special-events';
interface Props { events: SpecialEvent[]; now?: Date; headingId: string }
const { events, now = new Date(), headingId } = Astro.props;
const BADGES = { active: 'Today', later: 'Later Today', upcoming: 'Upcoming', expired: 'Upcoming' } as const;
// "Wednesday · Nov 11" (shown in capitals): the weekday in full, then the short date.
const dateLabel = (date: string) => {
  const day = new Date(`${date}T12:00:00Z`);
  const part = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-US', { ...options, timeZone: 'UTC' }).format(day);
  return `${part({ weekday: 'long' })} · ${part({ month: 'short', day: 'numeric' })}`;
};
const cards = events.map(event => ({
  event, active: eventState(event, now) === 'active', badge: BADGES[eventState(event, now)],
  when: eventAvailability(event),
  datetime: event.start_time ? `${event.event_date}T${event.start_time}` : event.event_date,
  offers: event.offers.map(splitTrailingPrice),
}));
---
{cards.length > 0 && <section class="event-specials" aria-labelledby={headingId}>
  <h2 class="event-specials__heading" id={headingId}>Special Events</h2>
  <ul class="event-specials__list">
    {cards.map(({ event, active, badge, when, datetime, offers }) => (
      <li>
        <article class="event-card" aria-label={`${event.title}, ${formatEventDate(event.event_date, 'long')}`}>
          <span class:list={['event-card__badge', { 'event-card__badge--today': active }]}>{badge}</span>
          <div class="event-card__name">
            <p class="event-card__when">
              <time datetime={datetime}>{dateLabel(event.event_date)}</time>
              {when && <span class="event-card__time">{when}</span>}
            </p>
            <h3 class="event-card__title">{event.title}</h3>
          </div>
          <div class="event-card__offers">
            <ul>
              {offers.map(offer => <li><span class="event-card__offer">{offer.text}</span>{offer.price && <span class="event-card__price">{offer.price}</span>}</li>)}
            </ul>
            {event.details && <p class="event-card__details">{event.details}</p>}
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>}
<style>
  .event-specials{
    --event-surface:#d6b878; --event-surface-2:#cfae6a; --event-edge:var(--gold,#b28a4f);
    --event-ink:var(--ink,#261711); --event-price:var(--btn-crimson-hover,#632521);
    /* Opt out of the global section padding (Base.astro) so events use the same
       content width as the weekly specials below them. */
    margin:clamp(10px,1.2vw,14px) 0 clamp(14px,1.8vw,22px);padding:0;min-width:0;text-align:left;
  }
  .event-specials__heading{
    margin:0 0 10px;font:700 .9rem/1.2 var(--label);letter-spacing:.15em;text-transform:uppercase;color:inherit;text-align:center;
  }
  /* Room above each card for the badge that overlaps its top border. */
  .event-specials__list{display:grid;gap:18px;list-style:none;margin:0;padding:10px 0 0;min-width:0}
  .event-card{
    position:relative;
    display:grid;grid-template-columns:minmax(11rem,1fr) minmax(0,2.6fr);
    gap:8px clamp(16px,2.2vw,32px);align-items:center;min-width:0;
    padding:clamp(14px,1.4vw,20px);
    border:2px solid var(--event-edge);border-radius:0;
    background:linear-gradient(180deg,var(--event-surface),var(--event-surface-2));
    color:var(--event-ink);
  }
  .event-card__name,.event-card__offers{min-width:0}
  /* Same tag as the daily specials' TODAY (index.astro .home-weekly__today). */
  .event-card__badge{
    position:absolute;top:-10px;left:12px;padding:2px 6px;
    font:700 .65rem var(--label);letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;
    background:var(--event-ink);color:var(--cream,#f4e5c5);
  }
  .event-card__badge--today{background:var(--brick,#8b3a2a)}
  .event-card__when{display:grid;gap:2px;margin:0 0 6px;font:700 .82rem/1.3 var(--label);letter-spacing:.1em;text-transform:uppercase;overflow-wrap:anywhere}
  .event-card__time{font-weight:600}
  .event-card__title{margin:0;font:400 clamp(1.3rem,2vw,1.6rem)/1.15 var(--display);color:var(--event-ink);overflow-wrap:anywhere}
  .event-card__offers ul{display:grid;gap:6px;list-style:none;margin:0;padding:0}
  .event-card__offers li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;align-items:baseline;
    font:600 1.1rem/1.4 var(--body);white-space:pre-line}
  .event-card__offer{min-width:0;overflow-wrap:anywhere}
  .event-card__price{font:700 1.15rem/1.3 var(--label);letter-spacing:.03em;color:var(--event-price);white-space:nowrap;text-align:right}
  .event-card__details{margin:6px 0 0;font:italic 400 .9rem/1.4 var(--body);color:rgba(38,23,17,.78);white-space:pre-line;overflow-wrap:anywhere}
  @media (max-width:599px){
    .event-card{grid-template-columns:minmax(0,1fr);gap:10px;padding:16px 14px 14px}
    .event-card__when{display:flex;flex-wrap:wrap;gap:0 10px;margin-bottom:4px}
    .event-card__title{font-size:clamp(1.2rem,5.5vw,1.4rem)}
    .event-card__offers li{font-size:1rem}
    .event-card__price{font-size:1.05rem}
  }
</style>
