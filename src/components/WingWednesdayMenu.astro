---
import { visibleGroups, visibleSlots, type SpecialGroup } from '../lib/specials-store';
import {splitMexicanItem} from '../lib/mexican-item.js';
import {isWingSauceGroup,parseWingSauces,splitWingPrice} from '../lib/wing-wednesday.js';
interface Props { groups: SpecialGroup[] }
const groups = visibleGroups(Astro.props.groups);
const itemsFor = (group: SpecialGroup) => visibleSlots(group).map(slot => {
  const {title, description} = splitMexicanItem(slot.content);
  return {...splitWingPrice([title, slot.price].filter(Boolean).join(' ')), description};
});
const sauces = groups.filter(isWingSauceGroup).flatMap(group => visibleSlots(group).flatMap(slot => parseWingSauces(slot.content)));
const sauceLabel = groups.find(isWingSauceGroup)?.label || 'Sauces';
const itemGroups = groups.filter(group => !isWingSauceGroup(group)).map(group => ({label: group.label, items: itemsFor(group)}));
// Never a guessed price: until both are verified, say where this week's price is.
const priced = itemGroups.flatMap(group => group.items).slice(0, 2).every(item => item.price);
---
<div class="wing-menu">
  {itemGroups.map(group => <section aria-label={group.label}>
    <header class="wing-heading"><h3>{group.label}</h3></header>
    <ul class="wing-options">{group.items.map(item => <li><strong class="wing-option">{item.name}</strong>{item.price && <span class="wing-price">{item.price}</span>}{item.description && <p class="wing-description">{item.description}</p>}</li>)}</ul>
  </section>)}
  {!priced && <p class="wing-note">Call or check Facebook for this week’s prices.</p>}
  {sauces.length > 0 && <section class="wing-sauces" aria-labelledby="wing-sauces-heading">
    <header class="wing-heading"><h3 id="wing-sauces-heading">{sauceLabel}</h3></header>
    <ul class="wing-sauce-list">{sauces.map(sauce => <li>{sauce}</li>)}</ul>
  </section>}
</div>
<style>
  .wing-menu{color:var(--cream)}
  .wing-menu section{padding:0}
  .wing-heading{text-align:center;margin:0 0 18px}
  .wing-heading h3{margin:0;font:700 clamp(1.1rem,2vw,1.4rem)/1.5 var(--label);color:var(--cream);overflow-wrap:anywhere}
  .wing-options{list-style:none;padding:0;margin:0 auto;display:grid;grid-template-columns:1fr;gap:16px 28px;max-width:760px}
  .wing-options li{min-width:0;border-top:1px solid var(--rule-light);padding-top:16px;text-align:center;overflow-wrap:anywhere}
  .wing-option{display:block;font-size:1.25rem;line-height:1.4}
  .wing-price{display:block;margin-top:4px;color:var(--wing-accent);font:700 1.15rem/1.3 var(--label);letter-spacing:.04em}
  .wing-description{margin:8px 0 0;font-size:1rem;line-height:1.55;font-style:italic;opacity:.85;white-space:pre-wrap}
  .wing-note{margin:16px 0 0;text-align:center;font-size:.95rem;font-style:italic;opacity:.85}
  .wing-menu .wing-sauces{margin-top:26px;padding-top:20px;border-top:1px solid var(--wing-accent)}
  .wing-sauce-list{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
  .wing-sauce-list li{display:flex;align-items:center;justify-content:center;min-width:0;padding:10px 8px;border:1px solid var(--rule-light);text-align:center;font-weight:500;font-size:1rem;line-height:1.3;overflow-wrap:anywhere}
  /* The specials cards' denim, brick and saddle, deepened so cream text stays above 7:1. */
  .wing-sauce-list li:nth-child(3n+1){background:#1d4a5e;border-top:3px solid #6fa3b5}
  .wing-sauce-list li:nth-child(3n+2){background:#5e2a26;border-top:3px solid #c98a6e}
  .wing-sauce-list li:nth-child(3n){background:#4d3a1c;border-top:3px solid #d9a95c}
  @media(min-width:681px){.wing-options{grid-template-columns:repeat(2,minmax(0,1fr))}.wing-sauce-list{grid-template-columns:repeat(4,minmax(0,1fr))}}
</style>
