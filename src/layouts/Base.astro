---
import { getSetting } from '../lib/db';
import ImageLightbox from '../components/ImageLightbox.astro';
import '@fontsource/alfa-slab-one/latin-400.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
interface Props { title?: string; description?: string; }
const { title = "Grayz'n Buffalo Bar & Grill — Mondovi, WI",
        description = "Grayz'n Buffalo Bar & Grill in Mondovi, WI. Burgers, Wraps, Pizzas & cold ones — open daily 10 AM to 2 AM." } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/specials', label: 'Specials' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const noindex = path.startsWith('/admin');
const isHome = path === '/';
const env = (Astro.locals as any).runtime?.env ?? {};
const [announcement1, announcement2, announcement3, deliveryPaused] = await Promise.all([
  getSetting(env, 'announcement_1', ''),
  getSetting(env, 'announcement_2', ''),
  getSetting(env, 'announcement_3', ''),
  getSetting(env, 'delivery_paused', '0'),
]);
const announcements = [announcement1, announcement2, announcement3]
  .map((message) => message.trim())
  .filter(Boolean);
// Delivery is always shown. Running copy is split so the city-limits qualifier
// breaks to its own line on mobile and never breaks mid-phrase. 
const deliveryPausedFlag = deliveryPaused === '1';
const deliveryPausedMsg = 'Delivery is unavailable at this time';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#241610" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{isHome && <link rel="preload" as="image" href="/logo-ink-600.webp" imagesrcset="/logo-ink-600.webp 600w, /logo-ink.webp 900w" imagesizes="(max-width: 640px) 88vw, min(78vw, 560px)" fetchpriority="high" />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BarOrPub",
  "name": "Grayz'n Buffalo Bar & Grill",
  "address": { "@type": "PostalAddress", "streetAddress": "102 S Eau Claire St", "addressLocality": "Mondovi", "addressRegion": "WI", "postalCode": "54755", "addressCountry": "US" },
  "telephone": "+1-715-926-4431",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "10:00",
      "closes": "02:00"
    }
  ],
  "servesCuisine": "American",
  "menu": "https://grayznbuffalo.com/menu",
  "url": "https://grayznbuffalo.com",
  "image": "https://grayznbuffalo.com/apple-touch-icon.png",
  "sameAs": ["https://www.facebook.com/grayznbuffalo"]
})} />
<style is:global>
  :root{
    --ink:#241610; --ink-2:#33221a;
    --crimson:#d7263d; --flame:#ff6b35; --amber:#ffb627; --gold:#ffd23f;
    --cream:#f7ead3; --cream-2:#efdfc2; --denim:#3f5e8c;--btn-crimson:#bf1e33;--btn-crimson-hover:#a8112e;
    --display:'Alfa Slab One', serif; --body:'Barlow', sans-serif; --label:'Barlow Condensed', sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth;overflow-x:clip}
  body{font-family:var(--body);background:var(--cream);color:var(--ink);line-height:1.6;
    min-height:100vh;display:flex;flex-direction:column;overflow-x:clip;width:100%}
  .announce{background:var(--gold);color:var(--ink);text-align:center;
    padding:9px clamp(16px,4vw,48px);font-family:var(--label);font-weight:700;
    letter-spacing:.04em;font-size:.95rem;line-height:1.35;
    box-shadow:0 2px 8px rgba(0,0,0,.22)}
  .announce-list{max-width:1100px;margin:0 auto;padding:0;list-style:none;display:flex;justify-content:center;align-items:center;gap:5px 22px;flex-wrap:wrap}
  .announce-list li{margin:0}
  .announce-list .delivery-notice{font-weight:700}
  /* keep each phrase of the delivery line whole; qualifier follows a comma on desktop */
  .delivery-notice .dmain,
  .delivery-notice .qualifier{white-space:nowrap}
  .delivery-notice .qualifier::before{content:", "}
  main{flex:1 0 auto;width:100%}
  img,iframe{max-width:100%}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .checker{height:14px;background:repeating-conic-gradient(var(--ink) 0% 25%, var(--cream) 0% 50%) 0 0/28px 28px}
  section{padding:clamp(56px,9vw,110px) clamp(20px,6vw,72px)}
  .section-head{max-width:760px;margin:0 auto 44px;text-align:center}
  .kicker{font-family:var(--label);font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:color:var(--btn-crimson);font-size:.85rem}
  h2{font-family:var(--display);font-size:clamp(1.8rem,4vw,2.8rem);margin:10px 0 8px;color:var(--ink)}
  .section-head p{color:var(--ink-2);font-size:1.05rem}
  .btn{font-family:var(--label);font-weight:700;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;
       padding:14px 30px;border-radius:8px;font-size:1rem;display:inline-block;border:none;cursor:pointer;
       transition:transform .18s ease, box-shadow .18s ease, background .18s}
  .btn-primary{background:var(--btn-crimson);color:var(--cream);box-shadow:0 6px 0 #8d1626}
  .btn-primary:hover{background:var(--btn-crimson-hover);transform:translateY(-3px);box-shadow:0 9px 0 #8d1626}
  .btn-ghost{background:rgba(247,234,211,.85);color:var(--ink);border:2px solid var(--ink)}
  .btn-ghost:hover{background:var(--cream);transform:translateY(-3px)}
  .reveal{opacity:0;transform:translateY(30px);transition:opacity .7s ease, transform .7s ease}
  .reveal.in{opacity:1;transform:none}
  nav.site{position:sticky;top:0;z-index:50;background:var(--ink);display:flex;align-items:center;justify-content:space-between;
      padding:0 clamp(16px,4vw,48px);height:66px;box-shadow:0 2px 12px rgba(0,0,0,.35)}
  nav.site .brand img{height:64px;width:auto;display:block}
  nav.site ul{display:flex;gap:clamp(10px,2.5vw,34px);list-style:none}
  nav.site a.link{font-family:var(--label);font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--cream);text-decoration:none;font-size:.95rem;padding:5px 2px;transition:color .2s}
  nav.site a.link:hover,nav.site a.link:focus-visible{color:var(--gold);text-decoration:underline;text-decoration-color:var(--crimson);text-decoration-thickness:2px;text-underline-offset:5px;outline:none}
  nav.site a.link.active{color:var(--gold);text-decoration:underline;text-decoration-color:var(--crimson);text-decoration-thickness:2px;text-underline-offset:5px}
  footer{background:#1a100b;color:var(--cream-2);text-align:center;padding:8px 20px 16px;font-size:.88rem;flex-shrink:0}
  footer a{color:var(--gold);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px;}
  footer a:hover,
  footer a:focus-visible{color:var(--cream);text-decoration-thickness:2px;}
  .footer-layout{position:relative;max-width:1100px;margin:0 auto}
  .footer-center{display:flex;flex-direction:column;align-items:center;min-width:0}
  .footer-copy{margin:0}
  .footer-social{display:inline-flex;align-items:center;justify-content:center;color:#1877F2;line-height:22px;transition:opacity .2s}
  .footer-social:hover{opacity:.8}
  .footer-social:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
  .footer-credit{position:absolute;right:0;bottom:0;margin:0;line-height:22px;opacity:.6;white-space:nowrap}
  .footer-credit a{color:inherit}
  .footer-legal{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px;margin:7px 0;}
  .footer-legal a{color:var(--cream-2);font-size:.78rem;text-underline-offset:3px;}
  .footer-legal a:hover,
  .footer-legal a:focus-visible{color:var(--gold);}
  footer .nowrap{white-space:nowrap}
  /* staff door: deliberately quiet, generous tap target for phones */
  .staff-door{
    position:absolute;left:0;bottom:-10px;
    display:inline-flex;align-items:center;justify-content:center;
    margin:0;padding:10px;
    opacity:.3;text-decoration:none;border-radius:8px;line-height:0;
    transition:opacity .2s;
  }
  .staff-door img{width:40px;height:auto;display:block}
  .staff-door:hover,
  .staff-door:focus-visible{opacity:1}
  .staff-door:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
  /* Offset the tap padding so the visible buffalo aligns with Facebook's edge. */
  .staff-door{left:-10px}
  .install-prompt{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));z-index:70;
    width:min(calc(100% - 32px),420px);padding:16px;border:1px solid rgba(255,210,63,.45);border-radius:12px;
    background:var(--ink);color:var(--cream);box-shadow:0 16px 38px rgba(0,0,0,.34);transform:translateX(-50%)}
  .install-prompt[hidden]{display:none}
  .install-prompt__copy{margin:0 42px 12px 0;line-height:1.35}
  .install-prompt__title{display:block;font-family:var(--label);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}
  .install-prompt__actions{display:flex;align-items:center;gap:10px}
  .install-prompt__install{padding:9px 13px;border:0;border-radius:7px;background:var(--btn-crimson);color:var(--cream);font:700 .82rem/1 var(--label);letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
  .install-prompt__install:hover,.install-prompt__install:focus-visible{background:var(--btn-crimson-hover)}
  .install-prompt__dismiss{position:absolute;top:10px;right:10px;width:30px;height:30px;border:0;border-radius:50%;background:transparent;color:var(--cream);font-size:1.35rem;line-height:1;cursor:pointer}
  .install-prompt__dismiss:hover,.install-prompt__dismiss:focus-visible{background:rgba(247,234,211,.15)}
  .install-prompt button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
  @media (max-width:820px){ nav.site .brand img{height:52px} nav.site ul{gap:14px} nav.site a.link{font-size:.8rem} }
  @media (prefers-reduced-motion: reduce){
    .reveal{transition:none;opacity:1;transform:none}
    html{scroll-behavior:auto}
  }

  /* ---- announcement banner: stack on mobile ---- */
  @media (max-width:640px){
    .announce-list{flex-direction:column;gap:6px}
    .delivery-notice{display:block;text-align:center}
    .delivery-notice .qualifier{display:block}
    .delivery-notice .qualifier::before{content:""}
  }

  /* ---- top bar hide-on-scroll (mobile only) ---- */
  nav.site{transition:transform .28s ease}
  nav.site.hidden{transform:translateY(-100%)}

  /* ---- mobile top bar: logo returns home; Contact stays available ---- */
  @media (max-width:820px){
    nav.site li[data-nav="home"],
    nav.site li[data-nav="menu"],
    nav.site li[data-nav="specials"]{display:none}
  }

  /* ---- pinned bottom action bar ---- */
  .action-bar{display:none}
  @media (max-width:820px){
    .action-bar{
      display:grid;grid-template-columns:repeat(3,1fr);
      position:fixed;left:0;right:0;bottom:0;z-index:60;
      background:var(--ink);
      border-top:2px solid rgba(247,234,211,.15);
      box-shadow:0 -2px 14px rgba(0,0,0,.4);
      padding-bottom:env(safe-area-inset-bottom);
    }
    .action-bar a{
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
      min-height:58px;padding:8px 4px;text-decoration:none;color:var(--cream);
      font-family:var(--label);font-weight:600;letter-spacing:.1em;
      text-transform:uppercase;font-size:.7rem;line-height:1;
    }
    .action-bar a svg{width:21px;height:21px;fill:currentColor;display:block}
    .action-bar a.primary{background:var(--btn-crimson)}
    .action-bar a:active{background:var(--btn-crimson-hover);}
    .action-bar a.primary:active{background:#b81f33}
    .action-bar a:focus-visible{outline:2px solid var(--gold);outline-offset:-3px}
    .action-bar a[aria-current="page"]{color:var(--gold)}

    /* keep the footer clear of the bar */
    body{padding-bottom:calc(58px + env(safe-area-inset-bottom))}

    .footer-social svg{width:24px;height:24px}
    .install-prompt{bottom:calc(78px + env(safe-area-inset-bottom))}
  }

  /* On narrow phones, give Facebook the maker-credit corner instead. */
  @media (max-width:500px){
    .footer-credit{display:none}
    .footer-social{position:absolute;right:0;bottom:0}
  }

  /* ---- reduced motion: top bar stays put ---- */
  @media (prefers-reduced-motion:reduce){
    nav.site{transition:none}
    nav.site.hidden{transform:none}
  }

</style>
</head>
<body>
<nav class="site">
  <a class="brand" href="/" aria-label="Grayz'n Buffalo home">
    <img src="/buffalo-mark.svg" alt="Grayz'n Buffalo Bar & Grill logo" width="100" height="70" />
  </a>
  <ul>
    {nav.map(n => (
      <li data-nav={n.label.toLowerCase()}><a class={"link" + (path === n.href ? " active" : "")} href={n.href}>{n.label}</a></li>
    ))}
  </ul>
</nav>
  <div class="announce" role="region" aria-label="Announcement">
    <ul class="announce-list">
      <li class="delivery-notice">
        {deliveryPausedFlag
          ? deliveryPausedMsg
          : (<><span class="dmain">Delivery M–F 11 AM–1:30 PM</span><span class="qualifier">within Mondovi city limits</span></>)}
      </li>
      {announcements.map((message) => <li>{message}</li>)}
    </ul>
  </div>
<nav class="action-bar" aria-label="Quick actions">
  <a href="/menu" aria-current={path === '/menu' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm2 4v2h12V7H6zm0 4v2h12v-2H6zm0 4v2h8v-2H6z"/></svg>
    <span>Menu</span>
  </a>
  <a href="tel:+17159264431" class="primary">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
    <span>Call</span>
  </a>
  <a href="/specials" aria-current={path === '/specials' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2v2H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 8v9H5v-9h14z"/></svg>
    <span>Specials</span>
  </a>
</nav>

<main><slot /></main>

<ImageLightbox />

<footer>
  <div class="footer-layout">
    <div class="footer-center">
      <p class="footer-copy">© {new Date().getFullYear()} Grayz'n Buffalo Bar &amp; Grill · <a class="nowrap" href="https://www.google.com/maps/search/?api=1&query=102+S+Eau+Claire+St,+Mondovi,+WI+54755" target="_blank" rel="noopener">102 S Eau Claire St, Mondovi, WI</a> · <a class="nowrap" href="tel:+17159264431">(715) 926-4431</a></p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/accessibility">Accessibility</a>
      </nav>
      <a href="https://www.facebook.com/grayznbuffalo/" aria-label="Grayz'n Buffalo on Facebook" class="footer-social">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"/>
        </svg>
      </a>
    </div>
    <a class="staff-door" href="/admin" rel="nofollow" aria-label="Staff login">
      <img src="/buffalo-mark.svg" alt="" width="40" height="23" loading="lazy" />
    </a>
    <p class="footer-credit">Built by <a href="https://joshuawerlein.com">Joshua Werlein</a></p>
  </div>
</footer>

<aside class="install-prompt" id="installPrompt" hidden aria-labelledby="installPromptTitle">
  <button class="install-prompt__dismiss" type="button" aria-label="Dismiss install suggestion">×</button>
  <p class="install-prompt__copy"><strong class="install-prompt__title" id="installPromptTitle">Add Grayz'n to your phone</strong><span id="installPromptMessage"></span></p>
  <div class="install-prompt__actions" id="installPromptActions" hidden>
    <button class="install-prompt__install" id="installPromptInstall" type="button">Install App</button>
  </div>
</aside>

<script>
  type BeforeInstallPromptEvent = Event & {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed'; platform: string }>;
  };

  const installPrompt = document.getElementById('installPrompt');
  const installPromptMessage = document.getElementById('installPromptMessage');
  const installPromptActions = document.getElementById('installPromptActions');
  const installPromptInstall = document.getElementById('installPromptInstall');
  const installDismiss = installPrompt?.querySelector('.install-prompt__dismiss');
  const installDismissKey = 'grayzn-install-prompt-dismissed';
  const iosNavigator = window.navigator as Navigator & { standalone?: boolean };
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || iosNavigator.standalone === true;
  const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !('MSStream' in window);
  const isAndroid = /Android/.test(navigator.userAgent);
  const isMobile = (isIos || isAndroid) && window.matchMedia('(max-width: 820px)').matches;
  let deferredInstallPrompt: BeforeInstallPromptEvent | null = null;
  let installHintReady = false;

  function hideInstallPrompt(remember = false) {
    installPrompt?.setAttribute('hidden', '');
    if (remember) localStorage.setItem(installDismissKey, '1');
  }

  function showInstallPrompt(message: string, showInstallButton = false) {
    if (!installPrompt || !installPromptMessage || localStorage.getItem(installDismissKey) || isStandalone) return;
    installPromptMessage.textContent = message;
    installPromptActions?.toggleAttribute('hidden', !showInstallButton);
    installPrompt.removeAttribute('hidden');
    window.setTimeout(() => hideInstallPrompt(true), 20000);
  }

  installDismiss?.addEventListener('click', () => hideInstallPrompt(true));

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js').catch(() => {}));
  }

  window.addEventListener('beforeinstallprompt', (event) => {
    if (!isAndroid || !isMobile || isStandalone) return;
    event.preventDefault();
    deferredInstallPrompt = event as BeforeInstallPromptEvent;
    if (installHintReady) {
      showInstallPrompt('Add Grayz’n Buffalo to your home screen for quick access to specials and the menu.', true);
    }
  });

  installPromptInstall?.addEventListener('click', async () => {
    if (!deferredInstallPrompt) return;
    await deferredInstallPrompt.prompt();
    await deferredInstallPrompt.userChoice;
    deferredInstallPrompt = null;
    hideInstallPrompt(true);
  });

  window.addEventListener('appinstalled', () => hideInstallPrompt(true));

  if (isMobile && !isStandalone) {
    window.setTimeout(() => {
      installHintReady = true;
      if (isIos) {
        showInstallPrompt('Tap Share → Add to Home Screen.');
      } else if (deferredInstallPrompt) {
        showInstallPrompt('Add Grayz’n Buffalo to your home screen for quick access to specials and the menu.', true);
      }
    }, 15000);
  }

  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  },{threshold:.14});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  const header = document.querySelector('nav.site')!;
  const HIDE_THRESHOLD = 10;  // px of movement before we react — kills iOS jitter
  const TOP_ZONE = 80;        // always visible this close to the top
  let lastY = window.scrollY;
  let ticking = false;

  function updateHeader() {
    const y = window.scrollY;
    const atBottom = window.innerHeight + y >= document.documentElement.scrollHeight - 2;

    if (y < TOP_ZONE || atBottom) {
      header.classList.remove('hidden');
      lastY = y;
      return;
    }

    const delta = y - lastY;
    // Below threshold: do NOT update lastY, so small moves accumulate
    if (Math.abs(delta) < HIDE_THRESHOLD) return;

    header.classList.toggle('hidden', delta > 0);
    lastY = y;
  }

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { updateHeader(); ticking = false; });
  }, { passive: true });
</script>
</body>
</html>
